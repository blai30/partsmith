{
  "name": "@partsmith/ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT OR Apache-2.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "check:dist": "node scripts/check-dist.mjs dist",
    "preview": "vite preview",
    "lint": "oxlint --deny-warnings && oxfmt --check",
    "format": "oxfmt",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:scripts": "node --test \"scripts/**/*.test.mjs\"",
    "e2e": "playwright test",
    "generate:protocol": "node scripts/generate-protocol-types.mjs"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "lucide-react": "1.55.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.2",
    "json-schema-to-typescript": "16.0.0",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  },
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  }
}
