{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "singleQuote": true,
  "printWidth": 100,
  "trailingComma": "all",
  "sortPackageJson": false,
  "ignorePatterns": [
    "dist",
    "public/core",
    "src/generated",
    "pnpm-lock.yaml",
    "test-results",
    "playwright-report"
  ]
}
