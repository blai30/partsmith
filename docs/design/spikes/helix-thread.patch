 //! The web core module `partsmith_core`: an Emscripten executable whose runtime stays alive after `main` returns, so JavaScript can call `ps_alloc`, `ps_free` and `ps_call` (protocol.md section 2.10, ADR 0009).
 
+use std::hint::black_box;
+
+use partsmith_occt_sys::{
+    CheckedOperation, Helix, Interrupt, LoftLayout, Plane, ThreadConstruction, ThreadKind,
+    ThreadSpec, WrapCurve, WrapSurface, checked_boolean, edge_points, make_cylinder,
+    modeled_thread, wrap_curves,
+};
+
 fn main() {
     // Creating the session here pays its setup cost while the module is instantiated. Calling into the library also keeps it, and with it the three exports, in the link.
     partsmith_wasm::initialize_session();
+    keep_helix_thread_spike();
+}
+
+/// Calls each function of the helix-thread spike once on a small input, so the linker keeps their code for the size measurement (kernel spec section 8.1 items 2 and 4).
+fn keep_helix_thread_spike() {
+    let surface = WrapSurface::Cylinder {
+        frame: Plane::XY,
+        radius: 5.0,
+    };
+    let helix = WrapCurve::Helix(Helix {
+        phase: 0.0,
+        height: 0.0,
+        pitch: 1.0,
+        turns: 1.0,
+    });
+    if let Ok(edges) = wrap_curves(&surface, &[helix]) {
+        black_box(edge_points(&edges, 1, 2).ok());
+    }
+    let Ok(rod) = make_cylinder(&Plane::XY, 5.0, 3.0) else {
+        return;
+    };
+    let spec = ThreadSpec {
+        frame: Plane::XY,
+        inner_radius: 5.0,
+        depth: 0.5,
+        half_angle: 0.0,
+        pitch: 1.0,
+        inner_width: 0.75,
+        outer_width: 0.125,
+        phase: 0.0,
+        start: 0.25,
+        turns: 1.0,
+    };
+    let interrupt = Interrupt::new();
+    let constructions = [
+        ThreadConstruction::Lofted {
+            layout: LoftLayout::DividedPerTurn,
+        },
+        ThreadConstruction::Swept { overlap: 0.05 },
+    ];
+    for construction in constructions {
+        if let Ok(thread) = modeled_thread(
+            &rod.shape,
+            &spec,
+            ThreadKind::External,
+            construction,
+            &interrupt,
+        ) {
+            black_box(
+                checked_boolean(
+                    CheckedOperation::Cut,
+                    &thread.shape,
+                    &thread.thread,
+                    &interrupt,
+                )
+                .ok(),
+            );
+        }
+    }
 }
