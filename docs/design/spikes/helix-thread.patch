diff --git a/crates/partsmith-occt-sys/src/parameter_plane.rs b/crates/partsmith-occt-sys/src/parameter_plane.rs
new file mode 100644
index 0000000..d0dd488
--- /dev/null
+++ b/crates/partsmith-occt-sys/src/parameter_plane.rs
@@ -0,0 +1,254 @@
+//! The parameter-plane map of a cylinder or a cone (kernel spec sections 8.2 and 8.3): points of
+//! the developed plane and helices become lines of the surface's parameter plane, and edges on
+//! the surface with exact curves on it. The helix-thread spike's thread and the wrap-emboss
+//! spike's emboss share this code path.
+
+use std::f64::consts::FRAC_PI_2;
+
+use crate::error::{KernelError, Operation, call};
+use crate::ffi::bridge as sys;
+use crate::shape::Shape;
+use crate::values::{Plane, Point2, check_finite, is_positive_length};
+
+/// A cylinder or a cone about the normal of its frame. Angles on it start at the frame's x axis
+/// and heights at its origin.
+#[derive(Debug, Clone, Copy, PartialEq)]
+pub enum WrapSurface {
+    /// A cylinder.
+    Cylinder {
+        /// The axis frame.
+        frame: Plane,
+        /// The radius.
+        radius: f64,
+    },
+    /// A cone whose radius grows by the tangent of `half_angle` per millimeter along the normal;
+    /// a negative angle narrows it.
+    Cone {
+        /// The axis frame.
+        frame: Plane,
+        /// The radius at the frame's origin.
+        radius: f64,
+        /// The angle between the cone's lines and its axis, in radians.
+        half_angle: f64,
+    },
+}
+
+/// A helix on a cylinder or a cone: from angle `phase` at `height` along the axis, it rises
+/// `pitch` along the axis per turn for `turns` turns. A positive pitch is right-handed.
+#[derive(Debug, Clone, Copy, PartialEq)]
+pub struct Helix {
+    /// The angle of its start from the frame's x axis, in radians.
+    pub phase: f64,
+    /// The height of its start along the axis.
+    pub height: f64,
+    /// Its rise along the axis per turn.
+    pub pitch: f64,
+    /// Its number of turns.
+    pub turns: f64,
+}
+
+/// A curve of the parameter-plane map.
+#[derive(Debug, Clone, Copy, PartialEq)]
+pub enum WrapCurve {
+    /// A straight segment of the developed plane: the plane tangent to the surface along its line
+    /// at angle 0, with x along the circle at height 0 and y along the line. It maps exactly onto
+    /// a cylinder only; the wrap-emboss spike adds the cone's approximation (section 8.3).
+    Segment {
+        /// Its start in the developed plane.
+        start: Point2,
+        /// Its end in the developed plane.
+        end: Point2,
+    },
+    /// A helix, a line of the parameter plane on both surfaces.
+    Helix(Helix),
+}
+
+const RADIUS_MESSAGE: &str = "A wrap surface needs a radius greater than 0 mm.";
+const HALF_ANGLE_MESSAGE: &str =
+    "A cone needs a half-angle between 0 and 90 degrees, other than 0, on either side.";
+const SEGMENT_ON_CONE_MESSAGE: &str =
+    "A segment of the developed plane maps exactly only onto a cylinder.";
+const SHORT_SEGMENT_MESSAGE: &str = "A segment needs a length greater than 0 mm.";
+const TURNS_MESSAGE: &str = "A helix needs more than 0 turns.";
+const APEX_MESSAGE: &str = "A helix on a cone must stay on one side of the cone's apex.";
+
+impl WrapSurface {
+    /// Checks the surface (section 3.1 items 4 to 6) and returns its bridge form.
+    pub(crate) fn to_ffi(self, operation: Operation) -> Result<sys::WrapSurfaceData, KernelError> {
+        let (frame, radius, half_angle) = match self {
+            WrapSurface::Cylinder { frame, radius } => (frame, radius, 0.0),
+            WrapSurface::Cone {
+                frame,
+                radius,
+                half_angle,
+            } => (frame, radius, half_angle),
+        };
+        check_finite(operation, &[radius, half_angle])?;
+        let frame = frame.frame(operation)?;
+        if !is_positive_length(radius) {
+            return Err(KernelError::invalid_input(operation, RADIUS_MESSAGE));
+        }
+        let is_cone = matches!(self, WrapSurface::Cone { .. });
+        if is_cone && !(half_angle != 0.0 && half_angle.abs() < FRAC_PI_2) {
+            return Err(KernelError::invalid_input(operation, HALF_ANGLE_MESSAGE));
+        }
+        Ok(sys::WrapSurfaceData {
+            frame: frame.to_ffi(),
+            radius,
+            half_angle,
+        })
+    }
+
+    /// The radius at `height` along the axis.
+    fn radius_at(surface: &sys::WrapSurfaceData, height: f64) -> f64 {
+        surface.radius + height * surface.half_angle.tan()
+    }
+}
+
+impl WrapCurve {
+    /// Checks the curve on `surface` and returns its bridge form.
+    fn to_ffi(
+        self,
+        operation: Operation,
+        surface: &sys::WrapSurfaceData,
+    ) -> Result<sys::WrapCurveData, KernelError> {
+        let mut data = sys::WrapCurveData {
+            kind: sys::WrapCurveType::Segment,
+            start_x: 0.0,
+            start_y: 0.0,
+            end_x: 0.0,
+            end_y: 0.0,
+            phase: 0.0,
+            height: 0.0,
+            pitch: 0.0,
+            turns: 0.0,
+        };
+        match self {
+            WrapCurve::Segment { start, end } => {
+                check_finite(operation, &[start.x, start.y, end.x, end.y])?;
+                if surface.half_angle != 0.0 {
+                    return Err(KernelError::invalid_input(
+                        operation,
+                        SEGMENT_ON_CONE_MESSAGE,
+                    ));
+                }
+                if !is_positive_length(start.distance(end)) {
+                    return Err(KernelError::invalid_input(operation, SHORT_SEGMENT_MESSAGE));
+                }
+                (data.start_x, data.start_y, data.end_x, data.end_y) =
+                    (start.x, start.y, end.x, end.y);
+            }
+            WrapCurve::Helix(helix) => {
+                check_helix(operation, surface, &helix)?;
+                data.kind = sys::WrapCurveType::Helix;
+                (data.phase, data.height, data.pitch, data.turns) =
+                    (helix.phase, helix.height, helix.pitch, helix.turns);
+            }
+        }
+        Ok(data)
+    }
+}
+
+/// Checks a helix on `surface`: finite, more than 0 turns, and on a cone where the radius stays
+/// above 0 from its start to its end.
+pub(crate) fn check_helix(
+    operation: Operation,
+    surface: &sys::WrapSurfaceData,
+    helix: &Helix,
+) -> Result<(), KernelError> {
+    check_finite(
+        operation,
+        &[helix.phase, helix.height, helix.pitch, helix.turns],
+    )?;
+    if helix.turns <= 0.0 {
+        return Err(KernelError::invalid_input(operation, TURNS_MESSAGE));
+    }
+    let end = helix.height + helix.pitch * helix.turns;
+    if [helix.height, end]
+        .iter()
+        .any(|height| !is_positive_length(WrapSurface::radius_at(surface, *height)))
+    {
+        return Err(KernelError::invalid_input(operation, APEX_MESSAGE));
+    }
+    Ok(())
+}
+
+/// Maps each curve onto the parameter plane of `surface` and returns a compound of one edge per
+/// curve, in order. Each edge has its line of the parameter plane as its curve on the surface,
+/// and a 3D curve that `BRepLib::BuildCurves3d` approximates within 1e-7 mm.
+pub fn wrap_curves(surface: &WrapSurface, curves: &[WrapCurve]) -> Result<Shape, KernelError> {
+    let operation = Operation::WrapCurves;
+    let surface = surface.to_ffi(operation)?;
+    let curves = curves
+        .iter()
+        .map(|curve| curve.to_ffi(operation, &surface))
+        .collect::<Result<Vec<_>, KernelError>>()?;
+    let shape = call(operation, || sys::wrap_curves(&surface, &curves))?;
+    Shape::from_ffi(operation, shape)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::KernelErrorKind;
+
+    fn cone(half_angle: f64) -> WrapSurface {
+        WrapSurface::Cone {
+            frame: Plane::XY,
+            radius: 10.0,
+            half_angle,
+        }
+    }
+
+    #[test]
+    fn a_cone_without_a_half_angle_is_refused() {
+        let error = wrap_curves(&cone(0.0), &[]).expect_err("no half-angle");
+
+        assert_eq!(error.message, HALF_ANGLE_MESSAGE);
+        assert_eq!(error.kind, KernelErrorKind::InvalidInput);
+    }
+
+    #[test]
+    fn a_segment_on_a_cone_is_refused() {
+        let segment = WrapCurve::Segment {
+            start: Point2 { x: 0.0, y: 0.0 },
+            end: Point2 { x: 1.0, y: 0.0 },
+        };
+
+        let error = wrap_curves(&cone(0.1), &[segment]).expect_err("a cone");
+
+        assert_eq!(error.message, SEGMENT_ON_CONE_MESSAGE);
+    }
+
+    #[test]
+    fn a_helix_through_the_apex_is_refused() {
+        let helix = WrapCurve::Helix(Helix {
+            phase: 0.0,
+            height: 0.0,
+            pitch: -20.0,
+            turns: 10.0,
+        });
+
+        let error = wrap_curves(&cone(0.1), &[helix]).expect_err("through the apex");
+
+        assert_eq!(error.message, APEX_MESSAGE);
+    }
+
+    #[test]
+    fn a_helix_without_turns_is_refused() {
+        let helix = WrapCurve::Helix(Helix {
+            phase: 0.0,
+            height: 0.0,
+            pitch: 1.0,
+            turns: 0.0,
+        });
+        let cylinder = WrapSurface::Cylinder {
+            frame: Plane::XY,
+            radius: 5.0,
+        };
+
+        let error = wrap_curves(&cylinder, &[helix]).expect_err("no turns");
+
+        assert_eq!(error.message, TURNS_MESSAGE);
+    }
+}
diff --git a/crates/partsmith-occt-sys/src/thread.rs b/crates/partsmith-occt-sys/src/thread.rs
new file mode 100644
index 0000000..360a077
--- /dev/null
+++ b/crates/partsmith-occt-sys/src/thread.rs
@@ -0,0 +1,555 @@
+//! The modeled thread of the helix-thread spike (kernel spec section 8.2): a tooth between two
+//! coaxial cylinders or cones, built along helices by construction (a) or (b), then fused to its
+//! base for an external thread or cut from it for an internal one. The result reports the
+//! construction's roles from OCCT's history, both validity checks and the call's polls.
+
+use std::time::Duration;
+
+use crate::error::{KernelError, Operation, call};
+use crate::ffi::bridge as sys;
+use crate::history::{History, OpResult, op_result_from_ffi};
+use crate::interrupt::Interrupt;
+use crate::parameter_plane::{Helix, WrapSurface, check_helix};
+use crate::shape::{Shape, SubShape, SubShapeKind};
+use crate::values::{Plane, Point, check_finite, is_positive_length};
+
+/// A thread's tooth: in each axial half-plane a trapezoid whose inner side, `inner_width` wide,
+/// lies on the inner cylinder or cone and whose outer side, `outer_width` wide and centered on
+/// it, lies `depth` further out. Its inner lower corner runs along a helix.
+#[derive(Debug, Clone, Copy, PartialEq)]
+pub struct ThreadSpec {
+    /// The axis frame: the axis along its normal, angle 0 along its x axis, height 0 at its
+    /// origin.
+    pub frame: Plane,
+    /// The radius of the inner side at height 0: the root of an external thread, the crest of an
+    /// internal one.
+    pub inner_radius: f64,
+    /// The radial distance from the inner side to the outer side.
+    pub depth: f64,
+    /// The half-angle of both cones, 0 for cylinders, in radians.
+    pub half_angle: f64,
+    /// The rise along the axis per turn.
+    pub pitch: f64,
+    /// The axial width of the inner side.
+    pub inner_width: f64,
+    /// The axial width of the outer side.
+    pub outer_width: f64,
+    /// The angle of the thread's start from the frame's x axis, in radians.
+    pub phase: f64,
+    /// The height of the inner lower corner at the start.
+    pub start: f64,
+    /// The number of turns.
+    pub turns: f64,
+}
+
+/// Which boolean joins the thread to its base.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
+pub enum ThreadKind {
+    /// The tooth is fused to the base.
+    External,
+    /// The tooth is cut from the base.
+    Internal,
+}
+
+/// How the tooth is built (section 8.2).
+#[derive(Debug, Clone, Copy, PartialEq)]
+pub enum ThreadConstruction {
+    /// (a): `BRepOffsetAPI_ThruSections`, ruled, between helical wires on the inner and outer
+    /// sides, each helix a `Geom2d_Line` of the side's parameter plane, laid out by `layout`.
+    Lofted {
+        /// How the helices are cut into edges and the lofts into turns.
+        layout: LoftLayout,
+    },
+    /// (b): `BRepOffsetAPI_MakePipeShell` of the profile along the helix of its inner lower
+    /// corner, approximated by `GeomAPI_PointsToBSpline` within 1e-4 mm, in binormal mode along
+    /// the axis. Cylinders only. Its flanks run on into the base by `overlap`.
+    Swept {
+        /// The radial distance the flanks run on inward, 0 for the plain profile.
+        overlap: f64,
+    },
+}
+
+/// How construction (a) cuts its helices into edges and its lofts into turns.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
+pub enum LoftLayout {
+    /// One loft between wires with one edge per helix: its inner and outer faces span every turn.
+    Whole,
+    /// One loft between wires with one edge per turn of each helix.
+    EdgePerTurn,
+    /// `EdgePerTurn`, then `ShapeUpgrade_ShapeDivideAngle` divides the inner and outer faces at
+    /// every turn, so each spans one turn.
+    DividedPerTurn,
+}
+
+/// What an element of a thread's construction is.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, PartialOrd, Ord, Hash)]
+pub enum ThreadPart {
+    /// The face on the inner cylinder or cone.
+    InnerFace,
+    /// The face on the outer cylinder or cone.
+    OuterFace,
+    /// The flank from the inner lower to the outer lower helix.
+    LowerFlank,
+    /// The flank from the inner upper to the outer upper helix.
+    UpperFlank,
+    /// The face that closes the thread at its start.
+    StartFace,
+    /// The face that closes the thread at its end.
+    EndFace,
+    /// The helix of the inner lower corner.
+    InnerLower,
+    /// The helix of the inner upper corner.
+    InnerUpper,
+    /// The helix of the outer lower corner.
+    OuterLower,
+    /// The helix of the outer upper corner.
+    OuterUpper,
+    /// An edge of the start face.
+    StartEdge,
+    /// An edge of the end face.
+    EndEdge,
+    /// An edge across a flank between two pieces of its helices.
+    Ruling,
+    /// A corner at the start.
+    StartVertex,
+    /// A corner at the end.
+    EndVertex,
+    /// A vertex between two pieces of a helix.
+    RulingVertex,
+}
+
+/// The OCCT history that named an element of a thread's construction.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, PartialOrd, Ord, Hash)]
+pub enum HistorySource {
+    /// The edge or vertex of a section wire, in the result itself.
+    Section,
+    /// `FirstShape` of the builder, or a face of it.
+    FirstShape,
+    /// `LastShape` of the builder, or a face of it.
+    LastShape,
+    /// `BRepOffsetAPI_ThruSections::GeneratedFace` of a section edge.
+    GeneratedFace,
+    /// `Generated` of a profile edge.
+    GeneratedFromEdge,
+    /// `Generated` of a section or profile vertex.
+    GeneratedFromVertex,
+    /// An edge or vertex of `FirstShape` or `LastShape`.
+    CapElement,
+}
+
+/// The role of one element of a thread's construction.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
+pub struct ThreadRole {
+    /// The element of the construction.
+    pub element: SubShape,
+    /// What it is.
+    pub part: ThreadPart,
+    /// The turn from the start that its piece covers, 0 for a whole helix or flank.
+    pub piece: u32,
+    /// The history that named it.
+    pub source: HistorySource,
+}
+
+/// How a shape passed the checks of `BRepCheck_Analyzer` (section 8.1 item 4).
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
+pub enum Validity {
+    /// Valid as built.
+    AsBuilt,
+    /// Valid after `ShapeFix_Shape`.
+    AfterRepair,
+    /// Invalid after `ShapeFix_Shape`.
+    Invalid,
+}
+
+/// The polls of one call with an interrupt that is never requested (section 8.1 item 4).
+#[derive(Debug, Clone, Copy, PartialEq)]
+pub struct PollRecord {
+    /// The number of `UserBreak` calls.
+    pub count: u64,
+    /// From the call's start to its first poll.
+    pub first: Duration,
+    /// The longest gap between two polls.
+    pub longest: Duration,
+    /// From the last poll to the call's end.
+    pub last: Duration,
+    /// The whole call in the shim.
+    pub total: Duration,
+}
+
+/// A modeled thread joined to its base.
+#[derive(Debug, Clone)]
+pub struct ThreadResult {
+    /// The base with the thread.
+    pub shape: Shape,
+    /// The history of the boolean. Inputs: [base, thread].
+    pub history: History,
+    /// The thread's construction alone.
+    pub thread: Shape,
+    /// The roles of the construction's elements, from its builder's history.
+    pub roles: Vec<ThreadRole>,
+    /// The check of the construction.
+    pub thread_validity: Validity,
+    /// The check of the whole result of the boolean.
+    pub result_validity: Validity,
+    /// The polls of the call.
+    pub polls: PollRecord,
+}
+
+/// A boolean of the spike's later steps, with the check of its whole result.
+#[derive(Debug, Clone)]
+pub struct CheckedBoolean {
+    /// The result with its history. Inputs: [target, tool].
+    pub result: OpResult,
+    /// The check of the whole result.
+    pub validity: Validity,
+}
+
+/// Which boolean a checked boolean runs.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
+pub enum CheckedOperation {
+    /// The target with the tool.
+    Fuse,
+    /// The target without the tool.
+    Cut,
+}
+
+const SIZE_MESSAGE: &str = "A thread needs a radius, a depth and a pitch greater than 0 mm.";
+const WIDTH_MESSAGE: &str = "A thread's outer side must be narrower than its inner side, which must be narrower than its pitch.";
+const SWEPT_CONE_MESSAGE: &str = "The swept thread is measured on cylinders only.";
+const OVERLAP_MESSAGE: &str =
+    "A thread's overlap must be at least 0 mm and less than its inner radius.";
+const NO_SOLID_MESSAGE: &str = "A thread needs a base with a solid.";
+
+impl ThreadSpec {
+    /// Checks the spec (section 3.1 items 4 to 6) and returns its bridge form.
+    fn to_ffi(
+        self,
+        operation: Operation,
+        construction: ThreadConstruction,
+    ) -> Result<sys::ThreadSpecData, KernelError> {
+        check_finite(
+            operation,
+            &[
+                self.inner_radius,
+                self.depth,
+                self.half_angle,
+                self.pitch,
+                self.inner_width,
+                self.outer_width,
+                self.phase,
+                self.start,
+                self.turns,
+            ],
+        )?;
+        if ![self.inner_radius, self.depth, self.pitch]
+            .into_iter()
+            .all(is_positive_length)
+        {
+            return Err(KernelError::invalid_input(operation, SIZE_MESSAGE));
+        }
+        if !(is_positive_length(self.outer_width)
+            && is_positive_length(self.inner_width - self.outer_width)
+            && is_positive_length(self.pitch - self.inner_width))
+        {
+            return Err(KernelError::invalid_input(operation, WIDTH_MESSAGE));
+        }
+        let surface = if self.half_angle == 0.0 {
+            WrapSurface::Cylinder {
+                frame: self.frame,
+                radius: self.inner_radius,
+            }
+        } else {
+            WrapSurface::Cone {
+                frame: self.frame,
+                radius: self.inner_radius,
+                half_angle: self.half_angle,
+            }
+        }
+        .to_ffi(operation)?;
+        let helix = Helix {
+            phase: self.phase,
+            height: self.start,
+            pitch: self.pitch,
+            turns: self.turns,
+        };
+        check_helix(operation, &surface, &helix)?;
+        let (method, layout, overlap) = match construction {
+            ThreadConstruction::Lofted { layout } => {
+                let layout = match layout {
+                    LoftLayout::Whole => sys::LoftLayoutType::Whole,
+                    LoftLayout::EdgePerTurn => sys::LoftLayoutType::EdgePerTurn,
+                    LoftLayout::DividedPerTurn => sys::LoftLayoutType::DividedPerTurn,
+                };
+                (sys::ThreadMethod::Lofted, layout, 0.0)
+            }
+            ThreadConstruction::Swept { overlap } => {
+                check_finite(operation, &[overlap])?;
+                if self.half_angle != 0.0 {
+                    return Err(KernelError::invalid_input(operation, SWEPT_CONE_MESSAGE));
+                }
+                if !(overlap >= 0.0 && overlap < self.inner_radius) {
+                    return Err(KernelError::invalid_input(operation, OVERLAP_MESSAGE));
+                }
+                (
+                    sys::ThreadMethod::Swept,
+                    sys::LoftLayoutType::Whole,
+                    overlap,
+                )
+            }
+        };
+        Ok(sys::ThreadSpecData {
+            frame: surface.frame,
+            inner_radius: self.inner_radius,
+            depth: self.depth,
+            half_angle: self.half_angle,
+            pitch: self.pitch,
+            inner_width: self.inner_width,
+            outer_width: self.outer_width,
+            phase: self.phase,
+            start: self.start,
+            turns: self.turns,
+            method,
+            layout,
+            overlap,
+        })
+    }
+}
+
+impl Validity {
+    fn from_ffi(
+        operation: Operation,
+        validity: sys::ValidityType,
+    ) -> Result<Validity, KernelError> {
+        match validity {
+            sys::ValidityType::AsBuilt => Ok(Validity::AsBuilt),
+            sys::ValidityType::AfterRepair => Ok(Validity::AfterRepair),
+            sys::ValidityType::Invalid => Ok(Validity::Invalid),
+            _ => Err(KernelError::unknown_from_shim(
+                operation,
+                "validity",
+                validity.repr,
+            )),
+        }
+    }
+}
+
+impl ThreadRole {
+    fn from_ffi(
+        operation: Operation,
+        role: sys::ThreadRoleData,
+    ) -> Result<ThreadRole, KernelError> {
+        let part = match role.part {
+            sys::ThreadPart::InnerFace => ThreadPart::InnerFace,
+            sys::ThreadPart::OuterFace => ThreadPart::OuterFace,
+            sys::ThreadPart::LowerFlank => ThreadPart::LowerFlank,
+            sys::ThreadPart::UpperFlank => ThreadPart::UpperFlank,
+            sys::ThreadPart::StartFace => ThreadPart::StartFace,
+            sys::ThreadPart::EndFace => ThreadPart::EndFace,
+            sys::ThreadPart::InnerLower => ThreadPart::InnerLower,
+            sys::ThreadPart::InnerUpper => ThreadPart::InnerUpper,
+            sys::ThreadPart::OuterLower => ThreadPart::OuterLower,
+            sys::ThreadPart::OuterUpper => ThreadPart::OuterUpper,
+            sys::ThreadPart::StartEdge => ThreadPart::StartEdge,
+            sys::ThreadPart::EndEdge => ThreadPart::EndEdge,
+            sys::ThreadPart::Ruling => ThreadPart::Ruling,
+            sys::ThreadPart::StartVertex => ThreadPart::StartVertex,
+            sys::ThreadPart::EndVertex => ThreadPart::EndVertex,
+            sys::ThreadPart::RulingVertex => ThreadPart::RulingVertex,
+            _ => {
+                return Err(KernelError::unknown_from_shim(
+                    operation,
+                    "thread part",
+                    role.part.repr,
+                ));
+            }
+        };
+        let source = match role.source {
+            sys::HistorySource::Section => HistorySource::Section,
+            sys::HistorySource::FirstShape => HistorySource::FirstShape,
+            sys::HistorySource::LastShape => HistorySource::LastShape,
+            sys::HistorySource::GeneratedFace => HistorySource::GeneratedFace,
+            sys::HistorySource::GeneratedFromEdge => HistorySource::GeneratedFromEdge,
+            sys::HistorySource::GeneratedFromVertex => HistorySource::GeneratedFromVertex,
+            sys::HistorySource::CapElement => HistorySource::CapElement,
+            _ => {
+                return Err(KernelError::unknown_from_shim(
+                    operation,
+                    "history source",
+                    role.source.repr,
+                ));
+            }
+        };
+        Ok(ThreadRole {
+            element: SubShape {
+                kind: SubShapeKind::from_ffi(operation, role.kind)?,
+                index: role.index,
+            },
+            part,
+            piece: role.piece,
+            source,
+        })
+    }
+}
+
+impl PollRecord {
+    fn from_ffi(polls: sys::PollData) -> PollRecord {
+        let duration = |milliseconds: f64| Duration::from_secs_f64(milliseconds.max(0.0) / 1000.0);
+        PollRecord {
+            count: polls.count,
+            first: duration(polls.first),
+            longest: duration(polls.longest),
+            last: duration(polls.last),
+            total: duration(polls.total),
+        }
+    }
+}
+
+/// Builds the thread `spec` describes with `construction`, checks it, and fuses it to `base`
+/// (`External`) or cuts it from it (`Internal`) with the settings of section 3.4.5, checking the
+/// whole result. A construction that stays invalid after repair fails with `InvalidResult`; a
+/// result that does reports `Validity::Invalid`.
+pub fn modeled_thread(
+    base: &Shape,
+    spec: &ThreadSpec,
+    kind: ThreadKind,
+    construction: ThreadConstruction,
+    interrupt: &Interrupt,
+) -> Result<ThreadResult, KernelError> {
+    let operation = Operation::Thread;
+    let data = spec.to_ffi(operation, construction)?;
+    if base.count(SubShapeKind::Solid) == 0 {
+        return Err(KernelError::invalid_input(operation, NO_SOLID_MESSAGE));
+    }
+    let external = kind == ThreadKind::External;
+    let data = call(operation, || {
+        sys::modeled_thread(base.inner(), &data, external, interrupt)
+    })?;
+    let result = op_result_from_ffi(operation, data.result)?;
+    Ok(ThreadResult {
+        shape: result.shape,
+        history: result.history,
+        thread: Shape::from_ffi(operation, data.thread)?,
+        roles: data
+            .roles
+            .into_iter()
+            .map(|role| ThreadRole::from_ffi(operation, role))
+            .collect::<Result<_, KernelError>>()?,
+        thread_validity: Validity::from_ffi(operation, data.thread_validity)?,
+        result_validity: Validity::from_ffi(operation, data.result_validity)?,
+        polls: PollRecord::from_ffi(data.polls),
+    })
+}
+
+/// Runs `operation` of `target` and `tool` as `fuse` or `cut` do, then checks the whole result
+/// and repairs it, reporting which (section 8.1 item 4).
+pub fn checked_boolean(
+    operation: CheckedOperation,
+    target: &Shape,
+    tool: &Shape,
+    interrupt: &Interrupt,
+) -> Result<CheckedBoolean, KernelError> {
+    let (facade_operation, fuse) = match operation {
+        CheckedOperation::Fuse => (Operation::Fuse, true),
+        CheckedOperation::Cut => (Operation::Cut, false),
+    };
+    if [target, tool]
+        .iter()
+        .any(|shape| shape.count(SubShapeKind::Solid) == 0)
+    {
+        return Err(KernelError::invalid_input(
+            facade_operation,
+            NO_SOLID_MESSAGE,
+        ));
+    }
+    let data = call(facade_operation, || {
+        sys::checked_boolean(target.inner(), tool.inner(), fuse, interrupt)
+    })?;
+    Ok(CheckedBoolean {
+        result: op_result_from_ffi(facade_operation, data.result)?,
+        validity: Validity::from_ffi(facade_operation, data.validity)?,
+    })
+}
+
+/// `count` points of edge `edge` of `shape`, equally spaced in its curve's parameter from its
+/// start to its end (1-based index).
+pub fn edge_points(shape: &Shape, edge: u32, count: u32) -> Result<Vec<Point>, KernelError> {
+    let operation = Operation::Query;
+    shape.check_index(operation, SubShapeKind::Edge, edge)?;
+    let points = call(operation, || sys::edge_points(shape.inner(), edge, count))?;
+    Ok(points.into_iter().map(Point::from_ffi).collect())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::KernelErrorKind;
+
+    fn spec() -> ThreadSpec {
+        ThreadSpec {
+            frame: Plane::XY,
+            inner_radius: 3.0,
+            depth: 0.7,
+            half_angle: 0.0,
+            pitch: 1.25,
+            inner_width: 0.9375,
+            outer_width: 0.15625,
+            phase: 0.0,
+            start: 0.3,
+            turns: 2.0,
+        }
+    }
+
+    fn refusal(spec: &ThreadSpec, construction: ThreadConstruction) -> KernelError {
+        let base = Shape::empty();
+        modeled_thread(
+            &base,
+            spec,
+            ThreadKind::External,
+            construction,
+            &Interrupt::new(),
+        )
+        .expect_err("the spec is refused")
+    }
+
+    #[test]
+    fn a_tooth_wider_than_its_pitch_is_refused() {
+        let wide = ThreadSpec {
+            inner_width: 1.3,
+            ..spec()
+        };
+
+        let error = refusal(
+            &wide,
+            ThreadConstruction::Lofted {
+                layout: LoftLayout::Whole,
+            },
+        );
+
+        assert_eq!(error.message, WIDTH_MESSAGE);
+        assert_eq!(error.kind, KernelErrorKind::InvalidInput);
+    }
+
+    #[test]
+    fn a_swept_thread_on_a_cone_is_refused() {
+        let tapered = ThreadSpec {
+            half_angle: 0.1,
+            ..spec()
+        };
+
+        let error = refusal(&tapered, ThreadConstruction::Swept { overlap: 0.0 });
+
+        assert_eq!(error.message, SWEPT_CONE_MESSAGE);
+    }
+
+    #[test]
+    fn a_base_without_a_solid_is_refused() {
+        let error = refusal(
+            &spec(),
+            ThreadConstruction::Lofted {
+                layout: LoftLayout::DividedPerTurn,
+            },
+        );
+
+        assert_eq!(error.message, NO_SOLID_MESSAGE);
+    }
+}
