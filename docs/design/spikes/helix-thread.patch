+//! The inputs of the helix-thread spike (kernel spec section 8.2), shared by its tests and the
+//! budgets bench, which includes this module with `#[path]`.
+//!
+//! Every thread has ISO 68-1's basic profile with 0.2 mm of radial clearance: its tooth is 3P/4
+//! wide at the minor diameter (the root flat is P/4) and P/8 at the major diameter, 5H/8 deep, H
+//! the height of the fundamental triangle. External threads sit on rods of their root radius,
+//! internal threads are cut from square blocks with a bore of their crest radius. On a threaded
+//! length L, the tooth runs from P/4 above the base's bottom to P/4 below its top, so it touches
+//! neither end, and its end lies at 45 degrees from the x axis.
+
+// The tests and the bench each use only some of these.
+#![allow(dead_code)]
+
+use std::f64::consts::{FRAC_PI_4, TAU};
+
+use partsmith_occt_sys::{
+    Interrupt, LoftLayout, Plane, Point, Shape, ThreadConstruction, ThreadKind, ThreadSpec, Vector,
+    cut, extrude, make_box, make_cone, make_cylinder, make_profile,
+};
+
+use crate::common::{UP, circle, rectangle, region_with_holes, xy_plane_at};
+
+/// The radial clearance of every thread.
+pub const CLEARANCE: f64 = 0.2;
+
+/// The threaded length of the rods and blocks.
+pub const LENGTH: f64 = 20.0;
+
+/// The longer threaded length whose crest and root faces are counted too.
+pub const LONG_LENGTH: f64 = 30.0;
+
+/// The threaded length of the cap and its neck.
+pub const CAP_LENGTH: f64 = 12.0;
+
+/// The angle of every thread's end from the x axis.
+pub const END_ANGLE: f64 = FRAC_PI_4;
+
+/// How far the overlapping profile of construction (b) runs into the base.
+pub const OVERLAP: f64 = 0.05;
+
+/// The constructions the spike tried, with their names in records: (a) as section 8.2 states it
+/// (`lofted-whole`), with one edge per turn, and with its faces on the cylinders or cones divided
+/// at every turn; (b) with the plain profile and with the profile running into the base.
+pub const CONSTRUCTIONS: [(&str, ThreadConstruction); 5] = [
+    (
+        "lofted-divided",
+        ThreadConstruction::Lofted {
+            layout: LoftLayout::DividedPerTurn,
+        },
+    ),
+    (
+        "lofted-whole",
+        ThreadConstruction::Lofted {
+            layout: LoftLayout::Whole,
+        },
+    ),
+    (
+        "lofted-edge-per-turn",
+        ThreadConstruction::Lofted {
+            layout: LoftLayout::EdgePerTurn,
+        },
+    ),
+    ("swept", ThreadConstruction::Swept { overlap: 0.0 }),
+    (
+        "swept-overlap",
+        ThreadConstruction::Swept { overlap: OVERLAP },
+    ),
+];
+
+/// A thread size: its nominal major diameter and its pitch.
+#[derive(Debug, Clone, Copy, PartialEq)]
+pub struct Size {
+    /// The size's name.
+    pub name: &'static str,
+    /// The nominal major diameter.
+    pub major_diameter: f64,
+    /// The pitch.
+    pub pitch: f64,
+}
+
+/// ISO 261 M3 x 0.5 to M30 x 2 and ASME B1.1 1/4-20 UNC.
+pub const SIZES: [Size; 7] = [
+    Size {
+        name: "M3x0.5",
+        major_diameter: 3.0,
+        pitch: 0.5,
+    },
+    Size {
+        name: "M5x0.8",
+        major_diameter: 5.0,
+        pitch: 0.8,
+    },
+    Size {
+        name: "M8x1.25",
+        major_diameter: 8.0,
+        pitch: 1.25,
+    },
+    Size {
+        name: "M12x1.75",
+        major_diameter: 12.0,
+        pitch: 1.75,
+    },
+    Size {
+        name: "M20x2.5",
+        major_diameter: 20.0,
+        pitch: 2.5,
+    },
+    Size {
+        name: "M30x2",
+        major_diameter: 30.0,
+        pitch: 2.0,
+    },
+    Size {
+        name: "1/4-20UNC",
+        major_diameter: 6.35,
+        pitch: 1.27,
+    },
+];
+
+/// M8 x 1.25, the size of the 300 ms criterion.
+pub const M8: Size = SIZES[2];
+
+/// M30 x 2, the size of the cap.
+pub const M30: Size = SIZES[5];
+
+/// The outer radius of the cap.
+pub const CAP_RADIUS: f64 = 18.0;
+
+/// The cap's wall above its thread.
+pub const CAP_TOP: f64 = 2.0;
+
+/// The inner radius of the neck, a tube.
+pub const NECK_BORE: f64 = 11.0;
+
+/// The cone of the coil: half-angle 5 degrees, root radius 10 mm at height 0, pitch 2 mm, 5 turns.
+pub const COIL_HALF_ANGLE: f64 = 5.0 * std::f64::consts::PI / 180.0;
+/// The root radius of the coil at height 0.
+pub const COIL_RADIUS: f64 = 10.0;
+/// The pitch of the coil.
+pub const COIL_PITCH: f64 = 2.0;
+/// The turns of the coil.
+pub const COIL_TURNS: f64 = 5.0;
+
+/// The depth of ISO 68-1's basic profile: 5H/8, H = sqrt(3)/2 P.
+pub fn depth(pitch: f64) -> f64 {
+    5.0 / 8.0 * 3.0_f64.sqrt() / 2.0 * pitch
+}
+
+/// The basic minor radius of a size.
+pub fn minor_radius(size: Size) -> f64 {
+    size.major_diameter / 2.0 - depth(size.pitch)
+}
+
+/// The tooth on a threaded length: from P/4 above height 0 to P/4 below `length`, ending at
+/// `END_ANGLE`. Its inner side lies at `inner_radius`.
+pub fn tooth(inner_radius: f64, pitch: f64, length: f64, half_angle: f64) -> ThreadSpec {
+    let inner_width = 0.75 * pitch;
+    let turns = (length - 0.5 * pitch - inner_width) / pitch;
+    ThreadSpec {
+        frame: Plane::XY,
+        inner_radius,
+        depth: depth(pitch),
+        half_angle,
+        pitch,
+        inner_width,
+        outer_width: pitch / 8.0,
+        phase: (END_ANGLE - TAU * turns).rem_euclid(TAU),
+        start: pitch / 4.0,
+        turns,
+    }
+}
+
+/// The spec of a size's thread on `length`: the root radius less the clearance for an external
+/// thread, the crest radius plus the clearance for an internal one.
+pub fn size_spec(size: Size, kind: ThreadKind, length: f64) -> ThreadSpec {
+    let inner_radius = match kind {
+        ThreadKind::External => minor_radius(size) - CLEARANCE,
+        ThreadKind::Internal => minor_radius(size) + CLEARANCE,
+    };
+    tooth(inner_radius, size.pitch, length, 0.0)
+}
+
+/// The coil's spec: the tooth of a 2 mm pitch on the cone, 5 turns.
+pub fn coil_spec() -> ThreadSpec {
+    let length = (COIL_TURNS + 1.25) * COIL_PITCH;
+    tooth(COIL_RADIUS, COIL_PITCH, length, COIL_HALF_ANGLE)
+}
+
+/// The threaded length a spec's tooth covers.
+pub fn threaded_length(spec: &ThreadSpec) -> f64 {
+    (spec.turns + 1.25) * spec.pitch
+}
+
+/// A rod of the spec's inner radius from height 0 to `length`.
+pub fn rod(spec: &ThreadSpec, length: f64) -> Shape {
+    make_cylinder(&Plane::XY, spec.inner_radius, length)
+        .expect("the rod builds")
+        .shape
+}
+
+/// A square block 10 mm wider than the size, from height 0 to `length`, with a bore of the
+/// spec's inner radius along the z axis.
+pub fn block(size: Size, spec: &ThreadSpec, length: f64) -> Shape {
+    let half = size.major_diameter / 2.0 + 5.0;
+    let holed = region_with_holes(
+        rectangle((-half, -half), (half, half)),
+        vec![vec![circle(5, (0.0, 0.0), spec.inner_radius)]],
+    );
+    let profile = make_profile(&Plane::XY, &[holed]).expect("the block's profile builds");
+    extrude(&profile, UP, 0.0, length, &Interrupt::new())
+        .expect("the block extrudes")
+        .shape
+}
+
+/// The base of a size's thread: a rod for an external thread, a block for an internal one.
+pub fn size_base(size: Size, spec: &ThreadSpec, kind: ThreadKind, length: f64) -> Shape {
+    match kind {
+        ThreadKind::External => rod(spec, length),
+        ThreadKind::Internal => block(size, spec, length),
+    }
+}
+
+/// The cap: a cylinder of radius 18 mm, its bore of the spec's inner radius open at height 0 and
+/// 12 mm deep, with a 2 mm top.
+pub fn cap(spec: &ThreadSpec) -> Shape {
+    let outside = make_cylinder(&Plane::XY, CAP_RADIUS, CAP_LENGTH + CAP_TOP)
+        .expect("the cap's outside builds")
+        .shape;
+    let bore = make_cylinder(
+        &xy_plane_at(0.0, 0.0, -1.0),
+        spec.inner_radius,
+        CAP_LENGTH + 1.0,
+    )
+    .expect("the cap's bore builds")
+    .shape;
+    cut(&outside, &[bore], &Interrupt::new())
+        .expect("the cap's bore cuts")
+        .shape
+}
+
+/// The neck: a tube of the spec's inner radius around a bore of 11 mm, 12 mm long.
+pub fn neck(spec: &ThreadSpec) -> Shape {
+    let ring = region_with_holes(
+        vec![circle(1, (0.0, 0.0), spec.inner_radius)],
+        vec![vec![circle(2, (0.0, 0.0), NECK_BORE)]],
+    );
+    let profile = make_profile(&Plane::XY, &[ring]).expect("the neck's profile builds");
+    extrude(&profile, UP, 0.0, CAP_LENGTH, &Interrupt::new())
+        .expect("the neck extrudes")
+        .shape
+}
+
+/// The coil's base: the frustum of the coil's root cone over its threaded length.
+pub fn frustum(spec: &ThreadSpec) -> Shape {
+    let length = threaded_length(spec);
+    let top = spec.inner_radius + length * spec.half_angle.tan();
+    make_cone(&Plane::XY, spec.inner_radius, top, length)
+        .expect("the frustum builds")
+        .shape
+}
+
+/// The radius of the spec's outer side at `height`.
+pub fn outer_radius(spec: &ThreadSpec, height: f64) -> f64 {
+    spec.inner_radius + spec.depth + height * spec.half_angle.tan()
+}
+
+/// The 2 mm slot across the threaded part: from below the base to half its threaded length,
+/// across the x axis and through the whole thread.
+pub fn slot(spec: &ThreadSpec) -> Shape {
+    let length = threaded_length(spec);
+    let reach = outer_radius(spec, length.max(0.0)).max(outer_radius(spec, 0.0)) + 6.0;
+    make_box(
+        &xy_plane_at(-1.0, -reach, -1.0),
+        2.0,
+        2.0 * reach,
+        length / 2.0 + 1.0,
+    )
+    .expect("the slot builds")
+    .shape
+}
+
+/// The box that touches the thread's end face from outside the material: from half the depth
+/// inside the inner side to half the depth outside the outer side, 0.5 mm wide along the turn,
+/// and P/16 beyond the end face's axial ends.
+pub fn end_box(spec: &ThreadSpec, kind: ThreadKind) -> Shape {
+    let end_angle = spec.phase + TAU * spec.turns;
+    let end_height = spec.start + spec.pitch * spec.turns;
+    let radial = Vector::new(end_angle.cos(), end_angle.sin(), 0.0);
+    let width = 0.5;
+    let inner = spec.inner_radius + end_height * spec.half_angle.tan() - spec.depth / 2.0;
+    let outer = outer_radius(spec, end_height + spec.inner_width) + spec.depth / 2.0;
+    let margin = spec.pitch / 16.0;
+    // Past the end for the tooth of an external thread, inside the groove of an internal one.
+    let along = match kind {
+        ThreadKind::External => 0.0,
+        ThreadKind::Internal => -width,
+    };
+    let tangent = Vector::new(-end_angle.sin(), end_angle.cos(), 0.0);
+    let origin = Point::new(0.0, 0.0, end_height - margin)
+        .offset(radial.scaled(inner))
+        .offset(tangent.scaled(along));
+    let placement = Plane {
+        origin,
+        normal: UP,
+        x_axis: radial,
+    };
+    make_box(
+        &placement,
+        outer - inner,
+        width,
+        spec.inner_width + 2.0 * margin,
+    )
+    .expect("the end box builds")
+    .shape
+}
+
+/// One input of the spike: a name, the thread's spec and kind, and its base.
+pub struct Input {
+    /// The input's name in records.
+    pub name: String,
+    /// The tooth.
+    pub spec: ThreadSpec,
+    /// Fused or cut.
+    pub kind: ThreadKind,
+    /// The base.
+    pub base: Shape,
+}
+
+impl Input {
+    /// A size's thread on a rod or in a block of `length`.
+    pub fn size(size: Size, kind: ThreadKind, length: f64) -> Input {
+        let spec = size_spec(size, kind, length);
+        let place = match kind {
+            ThreadKind::External => "rod",
+            ThreadKind::Internal => "block",
+        };
+        Input {
+            name: format!("{} {place} {length}", size.name),
+            base: size_base(size, &spec, kind, length),
+            spec,
+            kind,
+        }
+    }
+
+    /// The cap's internal M30 x 2 thread, 12 mm long.
+    pub fn cap() -> Input {
+        let spec = size_spec(M30, ThreadKind::Internal, CAP_LENGTH);
+        Input {
+            name: "cap M30x2 12".to_owned(),
+            base: cap(&spec),
+            spec,
+            kind: ThreadKind::Internal,
+        }
+    }
+
+    /// The neck's external M30 x 2 thread, 12 mm long.
+    pub fn neck() -> Input {
+        let spec = size_spec(M30, ThreadKind::External, CAP_LENGTH);
+        Input {
+            name: "neck M30x2 12".to_owned(),
+            base: neck(&spec),
+            spec,
+            kind: ThreadKind::External,
+        }
+    }
+
+    /// The coil: 5 turns on a frustum of half-angle 5 degrees.
+    pub fn coil() -> Input {
+        let spec = coil_spec();
+        Input {
+            name: "coil cone 5deg".to_owned(),
+            base: frustum(&spec),
+            spec,
+            kind: ThreadKind::External,
+        }
+    }
+}
diff --git a/crates/partsmith-occt-sys/tests/threads.rs b/crates/partsmith-occt-sys/tests/threads.rs
new file mode 100644
index 0000000..2ddec79
--- /dev/null
+++ b/crates/partsmith-occt-sys/tests/threads.rs
@@ -0,0 +1,886 @@
+//! The helix-thread spike (kernel spec section 8.2): constructions (a) and (b) on every input,
+//! measured as section 8.1 item 4 asks. Each test prints its measurements, with one canonical
+//! `parity` line per shape that the native and WebAssembly runs compare (ADR 0042), and pins the
+//! outcomes the spike recorded.
+
+use std::collections::{BTreeMap, BTreeSet};
+use std::f64::consts::TAU;
+
+use partsmith_mesh::{TessellationTolerance, WELD_TOLERANCE};
+use partsmith_occt_sys::{
+    CheckedOperation, Helix, HistorySource, Interrupt, KernelError, Plane, Point, Point2, Shape,
+    SubShapeKind, ThreadConstruction, ThreadKind, ThreadPart, ThreadResult, ThreadSpec, Validity,
+    WrapCurve, WrapSurface, checked_boolean, edge_points, modeled_thread, wrap_curves,
+};
+
+use crate::common::assert_closed;
+use crate::thread_inputs::{
+    CONSTRUCTIONS, Input, LENGTH, LONG_LENGTH, M8, SIZES, end_box, slot, threaded_length,
+};
+
+/// The tolerance of tests 137 and 138: 0.05 mm and 5 degrees.
+const FINE: TessellationTolerance = TessellationTolerance {
+    chord_deviation: 0.05,
+    angular_deviation: 0.087_266_462_599_716_48,
+};
+
+/// The points sampled along each crest and root edge.
+const SAMPLES: u32 = 20;
+
+/// The exactness tolerance of construction (a) and the helix tolerance of construction (b).
+const LOFTED_TOLERANCE: f64 = 1e-6;
+const SWEPT_TOLERANCE: f64 = 1e-4;
+
+/// The tolerance a construction's crest and root edges are checked with.
+fn helix_tolerance(construction: ThreadConstruction) -> f64 {
+    match construction {
+        ThreadConstruction::Lofted { .. } => LOFTED_TOLERANCE,
+        ThreadConstruction::Swept { .. } => SWEPT_TOLERANCE,
+    }
+}
+
+/// The canonical summary of a shape that the native and WebAssembly runs compare.
+fn parity_line(key: &str, stage: &str, shape: &Shape) -> String {
+    let volume = shape.volume().expect("the shape is measured");
+    let area = shape.area().expect("the shape is measured");
+    let Ok(bounds) = shape.bounding_box() else {
+        return format!("parity {key} {stage}: empty");
+    };
+    format!(
+        "parity {key} {stage}: faces={} edges={} vertices={} volume={volume:?} area={area:?} min={:?} max={:?}",
+        shape.count(SubShapeKind::Face),
+        shape.count(SubShapeKind::Edge),
+        shape.count(SubShapeKind::Vertex),
+        bounds.min,
+        bounds.max
+    )
+}
+
+/// The undirected edges of the welded mesh that are not used by exactly two triangles, or the
+/// tessellation's error.
+fn open_mesh_edges(shape: &Shape) -> Result<usize, String> {
+    let mesh = shape
+        .tessellate(&FINE, &Interrupt::new())
+        .map_err(|error| error.detail())?;
+    let welded = mesh
+        .weld(WELD_TOLERANCE)
+        .expect("WELD_TOLERANCE is a valid weld tolerance")
+        .mesh;
+    let triangles: Vec<[usize; 3]> = welded
+        .triangles()
+        .iter()
+        .map(|corners| corners.map(|vertex| vertex as usize))
+        .collect();
+    let mut uses: BTreeMap<(usize, usize), usize> = BTreeMap::new();
+    for [first, second, third] in &triangles {
+        for (start, end) in [(*first, *second), (*second, *third), (*third, *first)] {
+            *uses.entry((start.min(end), start.max(end))).or_insert(0) += 1;
+        }
+    }
+    let open = uses.values().filter(|count| **count != 2).count();
+    if open == 0 {
+        assert_closed(&triangles);
+    }
+    Ok(open)
+}
+
+/// A corner of the tooth, whose helix an edge follows.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, PartialOrd, Ord)]
+enum Corner {
+    InnerLower,
+    InnerUpper,
+    OuterLower,
+    OuterUpper,
+}
+
+impl Corner {
+    /// The corner of a helix part of the construction.
+    fn of_part(part: ThreadPart) -> Option<Corner> {
+        match part {
+            ThreadPart::InnerLower => Some(Corner::InnerLower),
+            ThreadPart::InnerUpper => Some(Corner::InnerUpper),
+            ThreadPart::OuterLower => Some(Corner::OuterLower),
+            ThreadPart::OuterUpper => Some(Corner::OuterUpper),
+            _ => None,
+        }
+    }
+
+    /// The corner between a flank and the inner (`outer` false) or outer side.
+    fn between(flank: ThreadPart, outer: bool) -> Option<Corner> {
+        match (flank, outer) {
+            (ThreadPart::LowerFlank, false) => Some(Corner::InnerLower),
+            (ThreadPart::UpperFlank, false) => Some(Corner::InnerUpper),
+            (ThreadPart::LowerFlank, true) => Some(Corner::OuterLower),
+            (ThreadPart::UpperFlank, true) => Some(Corner::OuterUpper),
+            _ => None,
+        }
+    }
+
+    /// The corner's radius at height 0 and its axial offset from the inner lower corner.
+    fn placement(self, spec: &ThreadSpec) -> (f64, f64) {
+        let outer_lower = (spec.inner_width - spec.outer_width) / 2.0;
+        match self {
+            Corner::InnerLower => (spec.inner_radius, 0.0),
+            Corner::InnerUpper => (spec.inner_radius, spec.inner_width),
+            Corner::OuterLower => (spec.inner_radius + spec.depth, outer_lower),
+            Corner::OuterUpper => (
+                spec.inner_radius + spec.depth,
+                outer_lower + spec.outer_width,
+            ),
+        }
+    }
+}
+
+/// The distance of `point` from the exact helix of a corner, computed from its radius, pitch and
+/// phase: the helix's point at the point's own angle, the turn picked from its height. This is
+/// at least the distance to the nearest point of the helix.
+fn helix_deviation(spec: &ThreadSpec, corner: Corner, point: Point) -> f64 {
+    let (radius, offset) = corner.placement(spec);
+    let base = spec.start + offset;
+    let estimate = spec.phase + TAU * (point.z - base) / spec.pitch;
+    let angle = point.y.atan2(point.x);
+    let angle = angle + TAU * ((estimate - angle) / TAU).round();
+    let height = base + spec.pitch * (angle - spec.phase) / TAU;
+    let radius = radius + height * spec.half_angle.tan();
+    let exact = Point::new(radius * angle.cos(), radius * angle.sin(), height);
+    point.distance(exact)
+}
+
+/// The largest deviation of `SAMPLES` points of an edge from its corner's exact helix.
+fn edge_deviation(shape: &Shape, edge: u32, spec: &ThreadSpec, corner: Corner) -> f64 {
+    edge_points(shape, edge, SAMPLES)
+        .expect("the edge is sampled")
+        .into_iter()
+        .map(|point| helix_deviation(spec, corner, point))
+        .fold(0.0, f64::max)
+}
+
+/// The volume of a tooth, exactly. Each axial section of the tooth is its start's trapezoid moved
+/// along the axis by the pitch per turn and, on cones, out by the cones' slope, so the volume is
+/// the trapezoid's area times the length its centroid travels (Pappus, for a screw motion).
+fn exact_tooth_volume(spec: &ThreadSpec) -> f64 {
+    let (wide, narrow) = (spec.inner_width, spec.outer_width);
+    let area = (wide + narrow) / 2.0 * spec.depth;
+    let slope = spec.half_angle.tan();
+    let centroid = spec.inner_radius
+        + spec.depth * (wide + 2.0 * narrow) / (3.0 * (wide + narrow))
+        + (spec.start + wide / 2.0) * slope;
+    let angle = TAU * spec.turns;
+    area * angle * (centroid + slope * spec.pitch * angle / (2.0 * TAU))
+}
+
+/// The relative difference of two values.
+fn relative(actual: f64, expected: f64) -> f64 {
+    (actual - expected).abs() / expected.abs()
+}
+
+/// The largest relative difference of a volume from its exact value that passes: the agreement
+/// section 8.2's Checks ask of the two constructions, measured and not a criterion of its Pass.
+const VOLUME_TOLERANCE: f64 = 1e-3;
+
+/// What a result element descends from.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, PartialOrd, Ord)]
+enum Origin {
+    /// An element of the base.
+    Base,
+    /// An element of the construction, with its part and the history that named it, and
+    /// whether the boolean kept it whole (`true`) or made it one of several images.
+    Thread(ThreadPart, HistorySource, bool),
+    /// Only generated by the boolean, or nothing at all.
+    New,
+}
+
+/// The origins of every element of a thread's result, by kind and index.
+fn origins(result: &ThreadResult) -> BTreeMap<(SubShapeKind, u32), Vec<Origin>> {
+    let roles: BTreeMap<(SubShapeKind, u32), (ThreadPart, HistorySource)> = result
+        .roles
+        .iter()
+        .map(|role| {
+            (
+                (role.element.kind, role.element.index),
+                (role.part, role.source),
+            )
+        })
+        .collect();
+    let mut origins = BTreeMap::new();
+    for kind in [SubShapeKind::Face, SubShapeKind::Edge, SubShapeKind::Vertex] {
+        for index in 1..=result.shape.count(kind) {
+            let mut list: Vec<Origin> = result
+                .history
+                .modified_from(kind, index)
+                .into_iter()
+                .map(|origin| {
+                    if origin.input == 0 {
+                        return Origin::Base;
+                    }
+                    let fates = &result.history.inputs[1];
+                    let fate = match kind {
+                        SubShapeKind::Face => &fates.faces,
+                        SubShapeKind::Edge => &fates.edges,
+                        _ => &fates.vertices,
+                    }[origin.element.index as usize - 1]
+                        .clone();
+                    match roles.get(&(origin.element.kind, origin.element.index)) {
+                        Some((part, source)) => {
+                            Origin::Thread(*part, *source, fate.modified.len() == 1)
+                        }
+                        None => Origin::New,
+                    }
+                })
+                .collect();
+            if list.is_empty() {
+                list.push(Origin::New);
+            }
+            list.sort();
+            list.dedup();
+            origins.insert((kind, index), list);
+        }
+    }
+    origins
+}
+
+/// The measurements of one construction on one input.
+#[derive(Debug, Default)]
+struct Measurement {
+    lines: Vec<String>,
+    failure: Option<String>,
+    thread_validity: Option<Validity>,
+    thread_open: Option<usize>,
+    thread_volume_error: Option<f64>,
+    construction_deviation: f64,
+    result_validity: Option<Validity>,
+    result_open: Option<usize>,
+    result_volume_error: f64,
+    result_volume: f64,
+    result_deviation: f64,
+    result_helix_edges: usize,
+    slot_validity: Option<Validity>,
+    slot_open: Option<usize>,
+    slot_volume: f64,
+    box_validity: Option<Validity>,
+    box_open: Option<usize>,
+    box_volume: f64,
+}
+
+/// True for a later boolean that is valid as built or after repair.
+fn is_valid(validity: Option<Validity>) -> bool {
+    matches!(validity, Some(Validity::AsBuilt | Validity::AfterRepair))
+}
+
+impl Measurement {
+    /// The criteria of section 8.2's Pass but time and parity that the input fails: the
+    /// construction and the thread with its boolean valid as built, both later booleans valid,
+    /// and the exactness check of the construction's and the result's crest and root edges. A
+    /// result without crest or root edges has lost its thread and fails the check.
+    fn failures(&self, tolerance: f64) -> Vec<String> {
+        if let Some(failure) = &self.failure {
+            return vec![failure.clone()];
+        }
+        failed([
+            (
+                self.thread_validity == Some(Validity::AsBuilt),
+                "the construction is not valid as built",
+            ),
+            (
+                self.construction_deviation <= tolerance,
+                "a construction's crest or root edge is off its helix",
+            ),
+            (
+                self.result_validity == Some(Validity::AsBuilt),
+                "the thread with its boolean is not valid as built",
+            ),
+            (
+                self.result_helix_edges > 0 && self.result_deviation <= tolerance,
+                "the result's crest or root edges are missing or off their helices",
+            ),
+            (is_valid(self.slot_validity), "the slot's cut is not valid"),
+            (is_valid(self.box_validity), "the box's fuse is not valid"),
+        ])
+    }
+
+    /// The volume checks the input fails: measured, not a criterion of section 8.2's Pass. A
+    /// valid result that lost the tooth or the base fails them, and so does a `Shape::volume`
+    /// that is off on faces spanning many turns.
+    fn volume_failures(&self) -> Vec<String> {
+        if self.failure.is_some() {
+            return Vec::new();
+        }
+        failed([
+            (
+                self.thread_volume_error
+                    .is_none_or(|error| error <= VOLUME_TOLERANCE),
+                "the construction's volume is not the tooth's",
+            ),
+            (
+                self.result_volume_error <= VOLUME_TOLERANCE,
+                "the result's volume is not the base's with the tooth",
+            ),
+            (
+                self.slot_volume > 0.0 && self.slot_volume < self.result_volume,
+                "the slot's cut removed nothing or everything",
+            ),
+            (
+                self.box_volume > self.slot_volume,
+                "the box's fuse added nothing",
+            ),
+        ])
+    }
+
+    /// The meshes of section 8.1 item 4 that are not closed: measured, not a criterion of
+    /// section 8.2.
+    fn open_meshes(&self) -> Vec<&'static str> {
+        [
+            (self.thread_open, "construction"),
+            (self.result_open, "result"),
+            (self.slot_open, "slot"),
+            (self.box_open, "box"),
+        ]
+        .into_iter()
+        .filter(|(open, _)| *open != Some(0))
+        .map(|(_, stage)| stage)
+        .collect()
+    }
+}
+
+/// The failures of the checks that do not pass.
+fn failed<const COUNT: usize>(checks: [(bool, &str); COUNT]) -> Vec<String> {
+    checks
+        .into_iter()
+        .filter(|(passes, _)| !passes)
+        .map(|(_, failure)| failure.to_owned())
+        .collect()
+}
+
+/// The record of a failed call.
+fn failure(error: &KernelError) -> String {
+    format!("{:?} {}", error.kind, error.detail())
+}
+
+/// Measures one construction on one input.
+fn measure(input: &Input, name: &str, construction: ThreadConstruction) -> Measurement {
+    let key = format!("{} {name}", input.name);
+    let mut measurement = Measurement::default();
+    let result = match modeled_thread(
+        &input.base,
+        &input.spec,
+        input.kind,
+        construction,
+        &Interrupt::new(),
+    ) {
+        Ok(result) => result,
+        Err(error) => {
+            measurement.failure = Some(failure(&error));
+            measurement
+                .lines
+                .push(format!("{key}: thread failed: {}", failure(&error)));
+            return measurement;
+        }
+    };
+    let spec = &input.spec;
+    let tolerance = helix_tolerance(construction);
+
+    // The construction.
+    measurement.thread_validity = Some(result.thread_validity);
+    measurement.thread_open = open_mesh_edges(&result.thread).ok();
+    let thread_volume = result.thread.volume().expect("the thread is measured");
+    let exact_volume = exact_tooth_volume(spec);
+    // The overlapping profile is larger than the tooth, and its inner helices run inside the
+    // base: the boolean's intersection edges are the thread's inner crest or root edges instead.
+    let overlaps = matches!(construction, ThreadConstruction::Swept { overlap } if overlap > 0.0);
+    measurement.thread_volume_error = (!overlaps).then(|| relative(thread_volume, exact_volume));
+    let mut construction_helix_edges = 0;
+    for role in &result.roles {
+        if let (SubShapeKind::Edge, Some(corner)) = (role.element.kind, Corner::of_part(role.part))
+        {
+            if overlaps && matches!(corner, Corner::InnerLower | Corner::InnerUpper) {
+                continue;
+            }
+            construction_helix_edges += 1;
+            measurement.construction_deviation = measurement.construction_deviation.max(
+                edge_deviation(&result.thread, role.element.index, spec, corner),
+            );
+        }
+    }
+    measurement.lines.push(format!(
+        "{key}: thread {:?}, is_valid {}, open mesh edges {:?}, volume {thread_volume:?} (exact {exact_volume:?}, relative {:?}), helix edges {construction_helix_edges} worst {:e} mm",
+        result.thread_validity,
+        result.thread.is_valid().expect("the thread is checked"),
+        measurement.thread_open,
+        relative(thread_volume, exact_volume),
+        measurement.construction_deviation
+    ));
+    measurement
+        .lines
+        .push(parity_line(&key, "thread", &result.thread));
+
+    // The result: its crest and root edges are the edges between a flank and a side.
+    let origins = origins(&result);
+    let topology = result.shape.topology().expect("the topology is read");
+    let face_origins = |face: u32| origins[&(SubShapeKind::Face, face)].clone();
+    let is_part = |face: u32, wanted: ThreadPart| {
+        face_origins(face)
+            .iter()
+            .any(|origin| matches!(origin, Origin::Thread(part, _, _) if *part == wanted))
+    };
+    let is_base = |face: u32| face_origins(face).contains(&Origin::Base);
+    for (position, edge) in topology.edges.iter().enumerate() {
+        let [first, second] = edge.faces[..] else {
+            continue;
+        };
+        for (flank, side) in [(first, second), (second, first)] {
+            for flank_part in [ThreadPart::LowerFlank, ThreadPart::UpperFlank] {
+                if !is_part(flank, flank_part) {
+                    continue;
+                }
+                let outer = is_part(side, ThreadPart::OuterFace);
+                if !(outer || is_base(side) || is_part(side, ThreadPart::InnerFace)) {
+                    continue;
+                }
+                let corner = Corner::between(flank_part, outer).expect("a flank and a side");
+                let index = u32::try_from(position + 1).expect("edge indices fit u32");
+                measurement.result_helix_edges += 1;
+                measurement.result_deviation = measurement.result_deviation.max(edge_deviation(
+                    &result.shape,
+                    index,
+                    spec,
+                    corner,
+                ));
+            }
+        }
+    }
+    // Crest and root faces: the outer side's images, and the base's faces along the inner side.
+    let outer_faces = (1..=result.shape.count(SubShapeKind::Face))
+        .filter(|face| is_part(*face, ThreadPart::OuterFace))
+        .count();
+    let inner_faces = (1..=result.shape.count(SubShapeKind::Face))
+        .filter(|face| {
+            (is_base(*face) || is_part(*face, ThreadPart::InnerFace))
+                && topology.faces[*face as usize - 1].edges.iter().any(|edge| {
+                    topology.edges[*edge as usize - 1]
+                        .faces
+                        .iter()
+                        .any(|other| {
+                            is_part(*other, ThreadPart::LowerFlank)
+                                || is_part(*other, ThreadPart::UpperFlank)
+                        })
+                })
+        })
+        .count();
+    let (crest_faces, root_faces) = match input.kind {
+        ThreadKind::External => (outer_faces, inner_faces),
+        ThreadKind::Internal => (inner_faces, outer_faces),
+    };
+    measurement.result_validity = Some(result.result_validity);
+    measurement.result_open = open_mesh_edges(&result.shape).ok();
+    measurement.result_volume = result.shape.volume().expect("the result is measured");
+    let base_volume = input.base.volume().expect("the base is measured");
+    let expected_volume = match input.kind {
+        ThreadKind::External => base_volume + exact_volume,
+        ThreadKind::Internal => base_volume - exact_volume,
+    };
+    measurement.result_volume_error = relative(measurement.result_volume, expected_volume);
+    measurement.lines.push(format!(
+        "{key}: result {:?}, is_valid {}, open mesh edges {:?}, volume {:?} (expected {expected_volume:?}, relative {:?}), crest and root edges {} worst {:e} mm, crest faces {crest_faces} root faces {root_faces}",
+        result.result_validity,
+        result.shape.is_valid().expect("the result is checked"),
+        measurement.result_open,
+        measurement.result_volume,
+        measurement.result_volume_error,
+        measurement.result_helix_edges,
+        measurement.result_deviation
+    ));
+    measurement
+        .lines
+        .push(parity_line(&key, "result", &result.shape));
+    measurement.lines.push(format!(
+        "{key}: polls {} first {:?} longest {:?} last {:?} total {:?} (debug build)",
+        result.polls.count,
+        result.polls.first,
+        result.polls.longest,
+        result.polls.last,
+        result.polls.total
+    ));
+
+    // The history of each result element.
+    let mut counts: BTreeMap<(String, Vec<Origin>), usize> = BTreeMap::new();
+    for ((kind, _), list) in &origins {
+        *counts
+            .entry((format!("{kind:?}"), list.clone()))
+            .or_insert(0) += 1;
+    }
+    for ((kind, list), count) in &counts {
+        measurement
+            .lines
+            .push(format!("{key}: history {kind} x{count} from {list:?}"));
+    }
+    let mut thread_counts: BTreeMap<(String, ThreadPart, HistorySource), usize> = BTreeMap::new();
+    for role in &result.roles {
+        *thread_counts
+            .entry((format!("{:?}", role.element.kind), role.part, role.source))
+            .or_insert(0) += 1;
+    }
+    for ((kind, part, source), count) in &thread_counts {
+        measurement.lines.push(format!(
+            "{key}: construction {kind} {part:?} x{count} by {source:?}"
+        ));
+    }
+    // The result's edges that no history names, by the origins of the faces on their sides.
+    let mut unnamed: BTreeMap<Vec<Vec<Origin>>, usize> = BTreeMap::new();
+    for (position, edge) in topology.edges.iter().enumerate() {
+        let index = u32::try_from(position + 1).expect("edge indices fit u32");
+        if origins[&(SubShapeKind::Edge, index)] == [Origin::New] {
+            let mut sides: Vec<Vec<Origin>> =
+                edge.faces.iter().map(|face| face_origins(*face)).collect();
+            sides.sort();
+            *unnamed.entry(sides).or_insert(0) += 1;
+        }
+    }
+    for (sides, count) in &unnamed {
+        measurement.lines.push(format!(
+            "{key}: history new Edge x{count} between {sides:?}"
+        ));
+    }
+    // The construction's elements that more than one role names.
+    let mut names: BTreeMap<(SubShapeKind, u32), BTreeSet<String>> = BTreeMap::new();
+    for role in &result.roles {
+        names
+            .entry((role.element.kind, role.element.index))
+            .or_default()
+            .insert(format!(
+                "{:?} {} by {:?}",
+                role.part, role.piece, role.source
+            ));
+    }
+    for ((kind, _), roles) in names.iter().filter(|(_, roles)| roles.len() > 1) {
+        measurement
+            .lines
+            .push(format!("{key}: construction {kind:?} named by {roles:?}"));
+    }
+
+    // The later booleans: the slot, then the box at the end face.
+    match checked_boolean(
+        CheckedOperation::Cut,
+        &result.shape,
+        &slot(spec),
+        &Interrupt::new(),
+    ) {
+        Ok(slotted) => {
+            measurement.slot_validity = Some(slotted.validity);
+            measurement.slot_open = open_mesh_edges(&slotted.result.shape).ok();
+            measurement.slot_volume = slotted
+                .result
+                .shape
+                .volume()
+                .expect("the slot's cut is measured");
+            measurement.lines.push(format!(
+                "{key}: slot {:?}, open mesh edges {:?}, volume {:?}",
+                slotted.validity, measurement.slot_open, measurement.slot_volume
+            ));
+            measurement
+                .lines
+                .push(parity_line(&key, "slot", &slotted.result.shape));
+            match checked_boolean(
+                CheckedOperation::Fuse,
+                &slotted.result.shape,
+                &end_box(spec, input.kind),
+                &Interrupt::new(),
+            ) {
+                Ok(boxed) => {
+                    measurement.box_validity = Some(boxed.validity);
+                    measurement.box_open = open_mesh_edges(&boxed.result.shape).ok();
+                    measurement.box_volume = boxed
+                        .result
+                        .shape
+                        .volume()
+                        .expect("the box's fuse is measured");
+                    measurement.lines.push(format!(
+                        "{key}: box {:?}, open mesh edges {:?}, volume {:?}",
+                        boxed.validity, measurement.box_open, measurement.box_volume
+                    ));
+                    measurement
+                        .lines
+                        .push(parity_line(&key, "box", &boxed.result.shape));
+                }
+                Err(error) => measurement
+                    .lines
+                    .push(format!("{key}: box failed: {}", failure(&error))),
+            }
+        }
+        Err(error) => measurement
+            .lines
+            .push(format!("{key}: slot failed: {}", failure(&error))),
+    }
+    measurement.lines.push(format!(
+        "{key}: fails {:?}",
+        measurement.failures(tolerance)
+    ));
+    measurement.lines.push(format!(
+        "{key}: volume checks fail {:?}",
+        measurement.volume_failures()
+    ));
+    measurement.lines.push(format!(
+        "{key}: open or missing meshes {:?}",
+        measurement.open_meshes()
+    ));
+    measurement
+}
+
+/// Measures one construction on one input, prints the record, and checks that the input passes
+/// the criteria of section 8.2's Pass but time and parity exactly when the spike recorded that it
+/// does (`passes`).
+fn check(input: &Input, name: &str, construction: ThreadConstruction, passes: bool) {
+    let measurement = measure(input, name, construction);
+    println!("{}", measurement.lines.join("\n"));
+    let failures = measurement.failures(helix_tolerance(construction));
+    assert_eq!(
+        failures.is_empty(),
+        passes,
+        "{} {name}: {failures:?}",
+        input.name
+    );
+}
+
+/// The tests of one input, one per construction, each with whether the spike recorded that the
+/// construction passes on it: `lofted_divided`, `lofted_whole`, `lofted_edge_per_turn`, `swept`
+/// and `swept_overlap`. The plain profile of `swept` nearly coincides with the base along its
+/// root, and its booleans run for minutes and, on blocks, past 6 GB of memory: those tests are
+/// ignored, and the spike ran each alone with a limit of 6 GB and 300 s.
+macro_rules! input_tests {
+    ($module:ident, $input:expr, [$($construction:ident: $passes:expr $(, $ignore:meta)?;)*]) => {
+        mod $module {
+            use super::*;
+
+            $(
+                #[test]
+                $(#[$ignore])?
+                fn $construction() {
+                    let (name, construction) = construction(stringify!($construction));
+                    check(&$input, name, construction, $passes);
+                }
+            )*
+        }
+    };
+}
+
+/// The construction a test is named after.
+fn construction(test: &str) -> (&'static str, ThreadConstruction) {
+    let name = test.replace('_', "-");
+    CONSTRUCTIONS
+        .into_iter()
+        .find(|(known, _)| *known == name)
+        .expect("each test is named after a construction")
+}
+
