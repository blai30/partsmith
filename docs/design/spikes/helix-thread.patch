+/// The bare helix of the coil: 5 turns on the cone of half-angle 5 degrees, one edge.
+#[test]
+fn cone_helix_is_exact() {
+    let input = Input::coil();
+    let spec = input.spec;
+    let surface = WrapSurface::Cone {
+        frame: Plane::XY,
+        radius: spec.inner_radius,
+        half_angle: spec.half_angle,
+    };
+    let helix = Helix {
+        phase: spec.phase,
+        height: spec.start,
+        pitch: spec.pitch,
+        turns: spec.turns,
+    };
+    let edges = wrap_curves(&surface, &[WrapCurve::Helix(helix)]).expect("the helix maps");
+
+    let deviation = edge_deviation(&edges, 1, &spec, Corner::InnerLower);
+
+    println!("cone helix: 1 edge, worst {deviation:e} mm");
+    println!("{}", parity_edge_line("cone helix", &edges));
+    assert!(deviation <= LOFTED_TOLERANCE, "{deviation:e}");
+}
+
+/// A segment of the developed plane of a cylinder, a helix of 5 turns, maps onto its exact helix.
+#[test]
+fn developed_segment_is_a_helix() {
+    let input = Input::size(M8, ThreadKind::External, LENGTH);
+    let spec = ThreadSpec {
+        phase: 0.0,
+        ..input.spec
+    };
+    let surface = WrapSurface::Cylinder {
+        frame: Plane::XY,
+        radius: spec.inner_radius,
+    };
+    let turns = 5.0;
+    let segment = WrapCurve::Segment {
+        start: Point2 {
+            x: 0.0,
+            y: spec.start,
+        },
+        end: Point2 {
+            x: TAU * spec.inner_radius * turns,
+            y: spec.start + spec.pitch * turns,
+        },
+    };
+    let edges = wrap_curves(&surface, &[segment]).expect("the segment maps");
+
+    let deviation = edge_deviation(&edges, 1, &spec, Corner::InnerLower);
+
+    println!("developed segment: worst {deviation:e} mm");
+    assert!(deviation <= LOFTED_TOLERANCE, "{deviation:e}");
+}
+
+/// The summary of a shape of edges, without volume and area.
+fn parity_edge_line(key: &str, shape: &Shape) -> String {
+    let bounds = shape.bounding_box().expect("the shape has bounds");
+    format!(
+        "parity {key}: edges={} vertices={} min={:?} max={:?}",
+        shape.count(SubShapeKind::Edge),
+        shape.count(SubShapeKind::Vertex),
+        bounds.min,
+        bounds.max
+    )
+}
+
+/// Every thread ends above the slot, which reaches half its threaded length.
+#[test]
+fn inputs_end_above_the_slot() {
+    for size in SIZES {
+        let input = Input::size(size, ThreadKind::External, LENGTH);
+        let end = input.spec.start + input.spec.pitch * input.spec.turns;
+        assert!(end > threaded_length(&input.spec) / 2.0, "{}", input.name);
+    }
+}
