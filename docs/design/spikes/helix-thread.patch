+
+namespace partsmith {
+namespace occt {
+
+using namespace detail;
+
+namespace {
+
+using Clock = std::chrono::steady_clock;
+
+// The milliseconds of a duration.
+double milliseconds(Clock::duration duration) {
+  return std::chrono::duration<double, std::milli>(duration).count();
+}
+
+// The spike's indicator: answers as the shim's indicator does, and records the time of each
+// poll, so the spike can report the polls of a call and the longest gap between them.
+class PollRecorder : public Interruption {
+ public:
+  explicit PollRecorder(const Interrupt &interrupt)
+      : Interruption(interrupt), start_(Clock::now()), last_(start_) {}
+
+  Standard_Boolean UserBreak() override {
+    const Clock::time_point now = Clock::now();
+    if (count_ == 0) {
+      first_ = now - start_;
+    } else {
+      longest_ = std::max(longest_, now - last_);
+    }
+    last_ = now;
+    ++count_;
+    return Interruption::UserBreak();
+  }
+
+  // The polls so far, with the time from the last one to now as the end of the call.
+  PollData data() const {
+    const Clock::time_point now = Clock::now();
+    return PollData{count_, milliseconds(first_), milliseconds(longest_),
+                    milliseconds(now - last_), milliseconds(now - start_)};
+  }
+
+ private:
+  Clock::time_point start_;
+  Clock::time_point last_;
+  Clock::duration first_{};
+  Clock::duration longest_{};
+  std::uint64_t count_ = 0;
+};
+
+// The samples per turn of the helix that construction (b) approximates, and the tolerance and
+// degrees of the approximation (kernel spec section 8.2).
+constexpr int kSpinePointsPerTurn = 32;
+constexpr double kSpineTolerance = 1e-4;
+constexpr int kSpineLeastDegree = 3;
+constexpr int kSpineMostDegree = 8;
+
+// A construction element with its role.
+struct Role {
+  TopoDS_Shape element;
+  ThreadPart part;
+  std::uint32_t piece;
+  HistorySource source;
+};
+
+// A tooth with the roles of its elements, read from the history of the builder that made it.
+struct Tooth {
+  TopoDS_Shape shape;
+  std::vector<Role> roles;
+};
+
+// The axial positions of the tooth's four corners relative to its inner lower corner.
+struct Corners {
+  double inner_lower;
+  double inner_upper;
+  double outer_lower;
+  double outer_upper;
+};
+
+Corners corners_of(const ThreadSpecData &spec) {
+  const double outer_lower = (spec.inner_width - spec.outer_width) / 2.0;
+  return Corners{0.0, spec.inner_width, outer_lower, outer_lower + spec.outer_width};
+}
+
+// The surface of the tooth's inner side (`outer` false) or outer side, in the spec's frame turned
+// about its normal to the thread's phase.
+WrapSurfaceData side_surface(const ThreadSpecData &spec, bool outer) {
+  const gp_Ax3 axes = to_ax3(spec.frame);
+  const gp_Dir x_axis = axes.XDirection().Rotated(axes.Axis(), spec.phase);
+  Frame frame = spec.frame;
+  frame.x_axis = Vec3{x_axis.X(), x_axis.Y(), x_axis.Z()};
+  return WrapSurfaceData{frame, spec.inner_radius + (outer ? spec.depth : 0.0),
+                         spec.half_angle};
+}
+
+// The parameters along a helix line where its pieces end: one piece per turn from the start
+// unless the layout makes each helix one edge; the last parameter is the helix's end.
+std::vector<double> piece_ends(const ThreadSpecData &spec, double turn_length) {
+  std::vector<double> ends;
+  if (spec.layout != LoftLayoutType::Whole) {
+    for (int turn = 1; turn < spec.turns - 1e-9; ++turn) {
+      ends.push_back(turn * turn_length);
+    }
+  }
+  ends.push_back(spec.turns * turn_length);
+  return ends;
+}
+
+// The helical edges of one side of the tooth, piece by piece, with the vertices at their ends,
+// and the segments of the parameter plane from the lower helix up to the upper one at the start
+// and the end. Vertex `k` is at the start of piece `k`; the last ones are at the end.
+struct Side {
+  bool outer;
+  std::vector<TopoDS_Vertex> lower_vertices;
+  std::vector<TopoDS_Vertex> upper_vertices;
+  std::vector<TopoDS_Edge> lower_edges;
+  std::vector<TopoDS_Edge> upper_edges;
+  TopoDS_Edge start_segment;
+  TopoDS_Edge end_segment;
+
+  std::size_t pieces() const { return lower_edges.size(); }
+};
+
+// The edges of one side: each helix a line of the side's parameter plane made edges piece by
+// piece. The side's frame turns to the thread's phase, so its helices start at angle 0 of its
+// parameter plane, where ShapeUpgrade_ShapeDivideAngle divides its faces.
+Side side_of(const ThreadSpecData &spec, bool outer) {
+  const WrapSurfaceData surface = side_surface(spec, outer);
+  const Handle(Geom_Surface) geometry = wrap_surface(surface);
+  const Corners corners = corners_of(spec);
+  const double lower = spec.start + (outer ? corners.outer_lower : corners.inner_lower);
+  const double upper = spec.start + (outer ? corners.outer_upper : corners.inner_upper);
+  const HelixLine lower_helix = helix_line(surface, 0.0, lower, spec.pitch);
+  const HelixLine upper_helix = helix_line(surface, 0.0, upper, spec.pitch);
+  const std::vector<double> ends = piece_ends(spec, lower_helix.turn_length);
+
+  Side side{outer, {}, {}, {}, {}, {}, {}};
+  auto helix_vertices = [&](const HelixLine &helix) {
+    std::vector<TopoDS_Vertex> vertices{vertex_on_surface(geometry, helix.line->Value(0.0))};
+    for (double end : ends) {
+      vertices.push_back(vertex_on_surface(geometry, helix.line->Value(end)));
+    }
+    return vertices;
+  };
+  side.lower_vertices = helix_vertices(lower_helix);
+  side.upper_vertices = helix_vertices(upper_helix);
+  auto helix_edges = [&](const HelixLine &helix, const std::vector<TopoDS_Vertex> &vertices) {
+    std::vector<TopoDS_Edge> edges;
+    double previous = 0.0;
+    for (std::size_t piece = 0; piece < ends.size(); ++piece) {
+      const double turns = (ends[piece] - previous) / helix.turn_length;
+      edges.push_back(edge_on_surface(geometry, helix.line, vertices[piece], vertices[piece + 1],
+                                      previous, ends[piece], turns));
+      previous = ends[piece];
+    }
+    return edges;
+  };
+  side.lower_edges = helix_edges(lower_helix, side.lower_vertices);
+  side.upper_edges = helix_edges(upper_helix, side.upper_vertices);
+  // The segments rise from the lower helix to the upper one, `turns` turns from the start.
+  const double length = parameter_height(surface, upper) - parameter_height(surface, lower);
+  auto segment = [&](double turns, const TopoDS_Vertex &from, const TopoDS_Vertex &to) {
+    const gp_Pnt2d start(2.0 * M_PI * turns, parameter_height(surface, lower + spec.pitch * turns));
+    const Handle(Geom2d_Line) line = new Geom2d_Line(start, gp_Dir2d(0.0, 1.0));
+    return edge_on_surface(geometry, line, from, to, 0.0, length, 0.0);
+  };
+  side.start_segment = segment(0.0, side.lower_vertices.front(), side.upper_vertices.front());
+  side.end_segment = segment(spec.turns, side.lower_vertices.back(), side.upper_vertices.back());
+  return side;
+}
+
+// The closed wire of a side: the lower helix forward, the segment at the end, the upper helix
+// back and the segment at the start, which rises and so is walked in reverse.
+TopoDS_Wire band_wire(const Side &side) {
+  BRep_Builder builder;
+  TopoDS_Wire wire;
+  builder.MakeWire(wire);
+  for (const TopoDS_Edge &edge : side.lower_edges) {
+    builder.Add(wire, edge);
+  }
+  builder.Add(wire, side.end_segment);
+  for (std::size_t piece = side.pieces(); piece-- > 0;) {
+    builder.Add(wire, side.upper_edges[piece].Reversed());
+  }
+  builder.Add(wire, side.start_segment.Reversed());
+  wire.Closed(Standard_True);
+  return wire;
+}
+
+// The part of a vertex at `position` along a side's helices: its start, its end, or between two
+// pieces.
+ThreadPart vertex_part(const Side &side, std::size_t position) {
+  return position == 0               ? ThreadPart::StartVertex
+         : position == side.pieces() ? ThreadPart::EndVertex
+                                     : ThreadPart::RulingVertex;
+}
+
+// The roles of a side's section edges and vertices, which are elements of the tooth themselves.
+void add_section_roles(const Side &side, std::vector<Role> &roles) {
+  const ThreadPart lower = side.outer ? ThreadPart::OuterLower : ThreadPart::InnerLower;
+  const ThreadPart upper = side.outer ? ThreadPart::OuterUpper : ThreadPart::InnerUpper;
+  for (std::size_t piece = 0; piece < side.pieces(); ++piece) {
+    const auto number = static_cast<std::uint32_t>(piece);
+    roles.push_back({side.lower_edges[piece], lower, number, HistorySource::Section});
+    roles.push_back({side.upper_edges[piece], upper, number, HistorySource::Section});
+  }
+  roles.push_back({side.start_segment, ThreadPart::StartEdge, 0, HistorySource::Section});
+  roles.push_back({side.end_segment, ThreadPart::EndEdge, 0, HistorySource::Section});
+  for (std::size_t position = 0; position <= side.pieces(); ++position) {
+    for (const TopoDS_Vertex &vertex :
+         {side.lower_vertices[position], side.upper_vertices[position]}) {
+      roles.push_back({vertex, vertex_part(side, position), static_cast<std::uint32_t>(position),
+                       HistorySource::Section});
+    }
+  }
+}
+
+// Replaces each role's element by its images in `history`, dropping removed elements.
+void follow(std::vector<Role> &roles, const Handle(BRepTools_History) &history) {
+  std::vector<Role> followed;
+  for (const Role &role : roles) {
+    if (history->IsRemoved(role.element)) {
+      continue;
+    }
+    const TopTools_ListOfShape &images = history->Modified(role.element);
+    if (images.IsEmpty()) {
+      followed.push_back(role);
+    }
+    for (const TopoDS_Shape &image : images) {
+      followed.push_back({image, role.part, role.piece, role.source});
+    }
+  }
+  roles = std::move(followed);
+}
+
+// Construction (a): BRepOffsetAPI_ThruSections, ruled and solid, between the helical wires on
+// the inner and outer sides, the construction of OCCT's bottle tutorial. The roles come from its
+// history: the caps (`FirstShape`, `LastShape`), the face each inner section edge generates
+// (`GeneratedFace`), the edge each inner section vertex generates (`Generated`) and the section
+// edges and vertices themselves. With `DividedPerTurn`, ShapeUpgrade_ShapeDivideAngle then
+// divides the faces on the cylinders or cones at every turn, and the roles follow its history.
+Tooth lofted_tooth(const ThreadSpecData &spec, Polls &polls) {
+  polls.before("BRepBuilderAPI_MakeEdge");
+  const Side inner = side_of(spec, false);
+  polls.before("BRepBuilderAPI_MakeEdge");
+  const Side outer = side_of(spec, true);
+  BRepOffsetAPI_ThruSections loft(Standard_True, Standard_True, kLinear);
+  loft.AddWire(band_wire(inner));
+  loft.AddWire(band_wire(outer));
+  loft.CheckCompatibility(Standard_False);
+  polls.run("BRepOffsetAPI_ThruSections",
+            [&](const Message_ProgressRange &range) { loft.Build(range); });
+  if (!loft.IsDone()) {
+    raise_not_done("BRepOffsetAPI_ThruSections failed with status " +
+                   std::to_string(static_cast<int>(loft.GetStatus())));
+  }
+  Tooth tooth{loft.Shape(), {}};
+  std::vector<Role> &roles = tooth.roles;
+  add_section_roles(inner, roles);
+  add_section_roles(outer, roles);
+  roles.push_back({loft.FirstShape(), ThreadPart::InnerFace, 0, HistorySource::FirstShape});
+  roles.push_back({loft.LastShape(), ThreadPart::OuterFace, 0, HistorySource::LastShape});
+  for (std::size_t piece = 0; piece < inner.pieces(); ++piece) {
+    const auto number = static_cast<std::uint32_t>(piece);
+    roles.push_back({loft.GeneratedFace(inner.lower_edges[piece]), ThreadPart::LowerFlank, number,
+                     HistorySource::GeneratedFace});
+    roles.push_back({loft.GeneratedFace(inner.upper_edges[piece]), ThreadPart::UpperFlank, number,
+                     HistorySource::GeneratedFace});
+  }
+  roles.push_back({loft.GeneratedFace(inner.start_segment), ThreadPart::StartFace, 0,
+                   HistorySource::GeneratedFace});
+  roles.push_back({loft.GeneratedFace(inner.end_segment), ThreadPart::EndFace, 0,
+                   HistorySource::GeneratedFace});
+  for (std::size_t position = 0; position <= inner.pieces(); ++position) {
+    const ThreadPart part = position == 0               ? ThreadPart::StartEdge
+                            : position == inner.pieces() ? ThreadPart::EndEdge
+                                                         : ThreadPart::Ruling;
+    for (const TopoDS_Vertex &vertex :
+         {inner.lower_vertices[position], inner.upper_vertices[position]}) {
+      for (const TopoDS_Shape &edge : loft.Generated(vertex)) {
+        roles.push_back({edge, part, static_cast<std::uint32_t>(position),
+                         HistorySource::GeneratedFromVertex});
+      }
+    }
+  }
+  if (spec.layout == LoftLayoutType::DividedPerTurn) {
+    polls.before("ShapeUpgrade_ShapeDivideAngle");
+    ShapeUpgrade_ShapeDivideAngle divide(2.0 * M_PI, tooth.shape);
+    divide.Perform();
+    if (divide.Status(ShapeExtend_FAIL)) {
+      raise_not_done("ShapeUpgrade_ShapeDivideAngle failed");
+    }
+    tooth.shape = divide.Result();
+    follow(roles, divide.GetContext()->History());
+  }
+  return tooth;
+}
+
+// Construction (b): BRepOffsetAPI_MakePipeShell sweeps the tooth's profile along the helix of its
+// inner lower corner, approximated by GeomAPI_PointsToBSpline, in binormal mode along the axis.
+// With `overlap`, the profile's flanks run on into the base by that radial distance.
+Tooth swept_tooth(const ThreadSpecData &spec, Polls &polls) {
+  const gp_Ax3 frame = to_ax3(spec.frame);
+  // From the frame's coordinates to the model's.
+  const gp_Trsf placement = [&] {
+    gp_Trsf transformation;
+    transformation.SetTransformation(frame);
+    return transformation.Inverted();
+  }();
+  const Corners corners = corners_of(spec);
+  const int points = static_cast<int>(std::ceil(spec.turns * kSpinePointsPerTurn)) + 1;
+  TColgp_Array1OfPnt helix(1, points);
+  for (int point = 0; point < points; ++point) {
+    const double turn = spec.turns * point / (points - 1);
+    const double angle = spec.phase + 2.0 * M_PI * turn;
+    helix.SetValue(point + 1, gp_Pnt(spec.inner_radius * std::cos(angle),
+                                     spec.inner_radius * std::sin(angle),
+                                     spec.start + spec.pitch * turn)
+                                  .Transformed(placement));
+  }
+  polls.before("GeomAPI_PointsToBSpline");
+  GeomAPI_PointsToBSpline approximation(helix, kSpineLeastDegree, kSpineMostDegree, GeomAbs_C2,
+                                        kSpineTolerance);
+  if (!approximation.IsDone()) {
+    raise_not_done("GeomAPI_PointsToBSpline failed");
+  }
+  const TopoDS_Wire spine =
+      BRepBuilderAPI_MakeWire(BRepBuilderAPI_MakeEdge(approximation.Curve())).Wire();
+
+  // The profile in the half-plane at the phase angle, its flanks run on inward by the overlap.
+  const double inner = spec.inner_radius - spec.overlap;
+  const double outer = spec.inner_radius + spec.depth;
+  const double lower_run = spec.overlap * corners.outer_lower / spec.depth;
+  const double upper_run = spec.overlap * (corners.inner_upper - corners.outer_upper) / spec.depth;
+  auto profile_point = [&](double radius, double height) {
+    return gp_Pnt(radius * std::cos(spec.phase), radius * std::sin(spec.phase), height)
+        .Transformed(placement);
+  };
+  BRepBuilderAPI_MakePolygon polygon(
+      profile_point(inner, spec.start - lower_run),
+      profile_point(outer, spec.start + corners.outer_lower),
+      profile_point(outer, spec.start + corners.outer_upper),
+      profile_point(inner, spec.start + corners.inner_upper + upper_run), Standard_True);
+  const TopoDS_Wire profile = polygon.Wire();
+
+  BRepOffsetAPI_MakePipeShell pipe(spine);
+  pipe.SetMode(frame.Direction());
+  pipe.Add(profile);
+  polls.run("BRepOffsetAPI_MakePipeShell",
+            [&](const Message_ProgressRange &range) { pipe.Build(range); });
+  if (!pipe.IsDone()) {
+    raise_not_done("BRepOffsetAPI_MakePipeShell failed with status " +
+                   std::to_string(static_cast<int>(pipe.GetStatus())));
+  }
+  polls.before("BRepOffsetAPI_MakePipeShell::MakeSolid");
+  if (!pipe.MakeSolid()) {
+    raise_not_done("BRepOffsetAPI_MakePipeShell::MakeSolid failed");
+  }
+  Tooth tooth{pipe.Shape(), {}};
+  // The profile's edges from its first vertex: lower flank, outer side, upper flank, inner side.
+  const ThreadPart face_parts[] = {ThreadPart::LowerFlank, ThreadPart::OuterFace,
+                                   ThreadPart::UpperFlank, ThreadPart::InnerFace};
+  // Its vertices in the same order: the inner lower, outer lower, outer upper and inner upper
+  // corners.
+  const ThreadPart edge_parts[] = {ThreadPart::InnerLower, ThreadPart::OuterLower,
+                                   ThreadPart::OuterUpper, ThreadPart::InnerUpper};
+  std::size_t position = 0;
+  for (BRepTools_WireExplorer explorer(profile); explorer.More(); explorer.Next(), ++position) {
+    for (const TopoDS_Shape &face : pipe.Generated(explorer.Current())) {
+      tooth.roles.push_back({face, face_parts[position], 0, HistorySource::GeneratedFromEdge});
+    }
+    for (const TopoDS_Shape &edge : pipe.Generated(explorer.CurrentVertex())) {
+      tooth.roles.push_back({edge, edge_parts[position], 0, HistorySource::GeneratedFromVertex});
+    }
+  }
+  const std::pair<TopoDS_Shape, ThreadPart> caps[] = {
+      {pipe.FirstShape(), ThreadPart::StartFace}, {pipe.LastShape(), ThreadPart::EndFace}};
+  for (const auto &[cap, part] : caps) {
+    const bool start = part == ThreadPart::StartFace;
+    for (TopExp_Explorer face(cap, TopAbs_FACE); face.More(); face.Next()) {
+      tooth.roles.push_back({face.Current(), part, 0,
+                             start ? HistorySource::FirstShape : HistorySource::LastShape});
+    }
+    for (TopExp_Explorer edge(cap, TopAbs_EDGE); edge.More(); edge.Next()) {
+      tooth.roles.push_back({edge.Current(), start ? ThreadPart::StartEdge : ThreadPart::EndEdge,
+                             0, HistorySource::CapElement});
+    }
+    for (TopExp_Explorer vertex(cap, TopAbs_VERTEX); vertex.More(); vertex.Next()) {
+      tooth.roles.push_back({vertex.Current(),
+                             start ? ThreadPart::StartVertex : ThreadPart::EndVertex, 0,
+                             HistorySource::CapElement});
+    }
+  }
+  return tooth;
+}
+
+// The kind of a face, edge or vertex; nothing for other types.
+std::optional<ElementKind> element_kind(TopAbs_ShapeEnum type) {
+  switch (type) {
+    case TopAbs_FACE:
+      return ElementKind::Face;
+    case TopAbs_EDGE:
+      return ElementKind::Edge;
+    case TopAbs_VERTEX:
+      return ElementKind::Vertex;
+    default:
+      return std::nullopt;
+  }
+}
+
+// Checks a whole shape and repairs it when it is not valid, as section 3.5 does, recording which.
+ValidityType check_and_repair(TopoDS_Shape &shape, const Handle(BRepTools_History) &history,
+                              Polls &polls) {
+  polls.before("BRepCheck_Analyzer");
+  if (BRepCheck_Analyzer(shape).IsValid()) {
+    return ValidityType::AsBuilt;
+  }
+  return repair(shape, history, polls) ? ValidityType::AfterRepair : ValidityType::Invalid;
+}
+
+// The boolean of section 3.4.5 on copies of `target` and `tool`, its whole result checked and
+// repaired. History inputs: [target, tool].
+CheckedBooleanData boolean_of(const Shape &target, const Shape &tool, bool fuse, Polls &polls) {
+  polls.before("BRepBuilderAPI_Copy");
+  const Shape target_copy = copy_elements(target);
+  polls.before("BRepBuilderAPI_Copy");
+  const Shape tool_copy = copy_elements(tool);
+  TopTools_ListOfShape tools;
+  tools.Append(tool_copy.get());
+  Handle(BRepTools_History) history = new BRepTools_History;
+  TopoDS_Shape result = solids_only(run_boolean(fuse ? BOPAlgo_FUSE : BOPAlgo_CUT,
+                                                target_copy.get(), tools, true, history, polls));
+  const ValidityType validity = check_and_repair(result, history, polls);
+  return CheckedBooleanData{op_result(result, history, {target_copy.get(), tool_copy.get()}),
+                            validity};
+}
+
+}  // namespace
+
+ThreadData modeled_thread(const Shape &base, const ThreadSpecData &spec, bool external,
+                          const Interrupt &interrupt) {
+  const Handle(PollRecorder) recorder = new PollRecorder(interrupt);
+  Polls polls{Handle(Interruption)(recorder)};
+  Tooth tooth = spec.method == ThreadMethod::Lofted ? lofted_tooth(spec, polls)
+                                                    : swept_tooth(spec, polls);
+  Handle(BRepTools_History) repair_history = new BRepTools_History;
+  const ValidityType thread_validity = check_and_repair(tooth.shape, repair_history, polls);
+  if (thread_validity == ValidityType::Invalid) {
+    raise_invalid_result("the thread construction stays invalid after ShapeFix_Shape");
+  }
+  const std::shared_ptr<Shape> thread_shape = make_shape(tooth.shape);
+  CheckedBooleanData boolean = boolean_of(base, *thread_shape, external, polls);
+
+  // The roles of the construction's elements, through the repair when it ran.
+  follow(tooth.roles, repair_history);
+  rust::Vec<ThreadRoleData> roles;
+  for (const Role &role : tooth.roles) {
+    const std::optional<ElementKind> kind =
+        role.element.IsNull() ? std::nullopt : element_kind(role.element.ShapeType());
+    const int index = kind ? thread_shape->map(*kind).FindIndex(role.element) : 0;
+    if (index > 0) {
+      roles.push_back(ThreadRoleData{*kind, static_cast<std::uint32_t>(index), role.part,
+                                     role.piece, role.source});
+    }
+  }
+  return ThreadData{std::move(boolean.result), thread_shape, std::move(roles), thread_validity,
+                    boolean.validity, recorder->data()};
+}
+
+CheckedBooleanData checked_boolean(const Shape &target, const Shape &tool, bool fuse,
+                                   const Interrupt &interrupt) {
+  Polls polls(interrupt);
+  return boolean_of(target, tool, fuse, polls);
+}
+
+rust::Vec<Vec3> edge_points(const Shape &shape, std::uint32_t edge, std::uint32_t count) {
+  const BRepAdaptor_Curve curve(TopoDS::Edge(element_at(shape, ElementKind::Edge, edge)));
+  const double first = curve.FirstParameter();
+  const double last = curve.LastParameter();
+  rust::Vec<Vec3> points;
+  for (std::uint32_t point = 0; point < count; ++point) {
+    const double parameter = count == 1 ? first : first + (last - first) * point / (count - 1);
+    points.push_back(to_vec3(curve.Value(parameter).XYZ()));
+  }
+  return points;
+}
