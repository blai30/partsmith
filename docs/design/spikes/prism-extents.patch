diff --git a/crates/partsmith-wasm/src/main.rs b/crates/partsmith-wasm/src/main.rs
index fa319e9..1cc58d9 100644
--- a/crates/partsmith-wasm/src/main.rs
+++ b/crates/partsmith-wasm/src/main.rs
@@ -1,6 +1,94 @@
 //! The web core module `partsmith_core`: an Emscripten executable whose runtime stays alive after `main` returns, so JavaScript can call `ps_alloc`, `ps_free` and `ps_call` (protocol.md section 2.10, ADR 0009).
 
+use std::hint::black_box;
+
+use partsmith_occt_sys::{
+    ExtentEnd, FeatureBasis, Interrupt, PlanarCurve, PlanarLoop, PlanarRegion, Plane, Point,
+    Point2, PrimitiveFace, TaggedCurve, Vector, extrude_drafted, extrude_feature, extrude_lofted,
+    extrude_split, make_box, make_profile, surface_distance,
+};
+
 fn main() {
     // Creating the session here pays its setup cost while the module is instantiated. Calling into the library also keeps it, and with it the three exports, in the link.
     partsmith_wasm::initialize_session();
+    keep_prism_extents_spike();
+}
+
+/// The square 2 mm across with its lower left corner at the origin of `Plane::XY`, its lines tagged 1 to 4 counterclockwise.
+fn square() -> PlanarRegion {
+    let corners = [(0.0, 0.0), (2.0, 0.0), (2.0, 2.0), (0.0, 2.0)];
+    let curves = (0..corners.len())
+        .map(|corner| {
+            let (x, y) = corners[corner];
+            let (next_x, next_y) = corners[(corner + 1) % corners.len()];
+            TaggedCurve {
+                tag: u32::try_from(corner + 1).expect("four sides"),
+                curve: PlanarCurve::Line {
+                    start: Point2 { x, y },
+                    end: Point2 {
+                        x: next_x,
+                        y: next_y,
+                    },
+                },
+            }
+        })
+        .collect();
+    PlanarRegion {
+        outer: PlanarLoop { curves },
+        holes: Vec::new(),
+    }
+}
+
+/// Calls the prism-extents spike's functions on a small input so the linker keeps their code for the size measurement (kernel spec section 8.1 items 2 and 4): each construction once for each extent below, and `surface_distance` once on each prism that builds.
+fn keep_prism_extents_spike() {
+    let Ok(profile) = make_profile(&Plane::XY, &[square()]) else {
+        return;
+    };
+    let placement = Plane {
+        origin: Point::new(-1.0, -1.0, 3.0),
+        ..Plane::XY
+    };
+    let Ok(block) = make_box(&placement, 4.0, 4.0, 1.0) else {
+        return;
+    };
+    let Some(bottom) = block
+        .faces
+        .iter()
+        .position(|face| *face == PrimitiveFace::Bottom)
+        .and_then(|position| u32::try_from(position + 1).ok())
+    else {
+        return;
+    };
+    let up = Vector::new(0.0, 0.0, 1.0);
+    let face = ExtentEnd::UpToFace {
+        body: block.shape.clone(),
+        face: bottom,
+    };
+    let body = ExtentEnd::UpToBody(block.shape.clone());
+    let length = ExtentEnd::Length(1.0);
+    let taper = 5.0_f64.to_radians();
+    let interrupt = Interrupt::new();
+    let results = [
+        extrude_feature(&profile, up, &face, 0.0, FeatureBasis::Body, &interrupt),
+        extrude_feature(&profile, up, &body, 0.0, FeatureBasis::Nothing, &interrupt),
+        extrude_feature(
+            &profile,
+            up,
+            &length,
+            taper,
+            FeatureBasis::Nothing,
+            &interrupt,
+        ),
+        extrude_split(&profile, up, &face, &interrupt),
+        extrude_split(&profile, up, &body, &interrupt),
+        extrude_drafted(&profile, up, &length, taper, &interrupt),
+        extrude_drafted(&profile, up, &face, taper, &interrupt),
+        extrude_lofted(&profile, up, &length, taper, &interrupt),
+        extrude_lofted(&profile, up, &face, taper, &interrupt),
+    ];
+    for result in results {
+        if let Ok(result) = black_box(result) {
+            let _ = black_box(surface_distance(&result.shape, 1, &block.shape, bottom));
+        }
+    }
 }
