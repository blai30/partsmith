+/// The runs of each row of the prism-extents spike (kernel spec section 8.1 item 4).
+const SPIKE_RUNS: usize = 5;
+
+/// The median of a row's values over its runs, and the largest.
+fn median_and_most(values: impl IntoIterator<Item = Duration>) -> (Duration, Duration) {
+    let mut values: Vec<Duration> = values.into_iter().collect();
+    values.sort();
+    (values[values.len() / 2], values[values.len() - 1])
+}
+
+/// The rows of the prism-extents spike: for each input and construction, the median of 5 runs of
+/// the call, and the polls of those runs with an interrupt that is never requested, with the time
+/// each run spends in the facade outside the shim, whose polls cover only the call inside it.
+/// Natively the rows that section 8.5 times have its limits; the other rows, and every row under
+/// Node, print their medians. A run that fails prints its error: the input that the profile
+/// reaches only in part fails by design. A row that builds also prints how far its end faces lie
+/// from their target's surface in the build it times.
+fn measure_prism_extents(report: &mut Report) {
+    for run in prism_inputs::runs() {
+        let row = format!("prism-extents {} {}", run.input, run.construction);
+        if !report.includes(&row) {
+            continue;
+        }
+        let mut polls: Vec<PollRecord> = Vec::with_capacity(SPIKE_RUNS);
+        let mut outside = Vec::with_capacity(SPIKE_RUNS);
+        let mut times = Vec::with_capacity(SPIKE_RUNS);
+        let mut last = None;
+        let time = median(SPIKE_RUNS, |_| {
+            let start = Instant::now();
+            let result = extrude_to(&run.profile, &run.spec, &Interrupt::new());
+            let elapsed = start.elapsed();
+            match result {
+                Ok(result) => {
+                    outside.push(elapsed.saturating_sub(result.polls.total));
+                    polls.push(result.polls);
+                    last = Some(result);
+                }
+                Err(error) if run.in_part => {
+                    println!("{row}: fails, as it must: {}", error.detail())
+                }
+                Err(error) => println!("{row}: {}", error.detail()),
+            }
+            times.push(elapsed);
+            elapsed
+        });
+        if !polls.is_empty() {
+            let (longest, most) = median_and_most(polls.iter().map(|record| record.longest));
+            let (first, first_most) = median_and_most(polls.iter().map(|record| record.first));
+            let (last, last_most) = median_and_most(polls.iter().map(|record| record.last));
+            let (outside, outside_most) = median_and_most(outside);
+            let after: Vec<u64> = polls.iter().map(|record| record.longest_after).collect();
+            println!(
+                "{row}: polls {} first {first:.3?} (most {first_most:.3?}) longest {longest:.3?} (most {most:.3?}, after polls {after:?}) last {last:.3?} (most {last_most:.3?}) outside the shim {outside:.3?} (most {outside_most:.3?})",
+                polls[0].count
+            );
+        }
+        println!("{row}: runs {times:.3?}");
+        if let Some(result) = last {
+            let distance = result
+                .end
+                .iter()
+                .map(|face| {
+                    surface_distance(&result.shape, *face, &run.target.shape, run.target.face)
+                        .expect("the end face's distance can be measured")
+                })
+                .fold(0.0, f64::max);
+            println!(
+                "{row}: end faces {:?} at most {distance:?} mm from the target's surface",
+                result.end
+            );
+        }
+        match run.budget {
+            Some(budget) if cfg!(not(target_os = "emscripten")) => {
+                report.record_time(&row, time, budget);
+            }
+            _ => println!("{row}: median {time:.3?} (no limit)"),
+        }
+    }
+}
