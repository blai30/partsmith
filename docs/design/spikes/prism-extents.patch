+#[test]
+fn prism_extents_meet_the_recorded_outcomes() {
+    let mut report = String::new();
+    let mut outcomes = Vec::new();
+    for run in runs() {
+        let result = extrude_to(&run.profile, &run.spec, &Interrupt::new());
+        match &result {
+            Ok(built) => {
+                writeln!(
+                    report,
+                    "{} {}: {}; start faces {:?}, end faces {:?}; native time limit {:?}",
+                    run.input,
+                    run.construction,
+                    measure(&run, built).describe(),
+                    built.start,
+                    built.end,
+                    run.budget
+                )
+                .expect("a string takes text");
+            }
+            Err(error) => writeln!(
+                report,
+                "{} {}: {}",
+                run.input,
+                run.construction,
+                error.detail()
+            )
+            .expect("a string takes text"),
+        }
+        outcomes.push((run.input, run.construction, outcome(&run, &result)));
+    }
+    println!("{report}");
+    let recorded: Vec<(&str, &str, String)> = RECORDED
+        .iter()
+        .map(|(input, construction, outcome)| (*input, *construction, (*outcome).to_owned()))
+        .collect();
+    assert_eq!(outcomes, recorded);
+}
+
+/// The names OCCT's history gives each face, edge and vertex of a prism, one line per element.
+fn names(result: &ExtentResult) -> String {
+    let mut text = String::new();
+    for kind in [SubShapeKind::Face, SubShapeKind::Edge, SubShapeKind::Vertex] {
+        for index in 1..=result.shape.count(kind) {
+            let element = SubShape { kind, index };
+            let mut parts = Vec::new();
+            if kind == SubShapeKind::Face && result.start.contains(&index) {
+                parts.push("start".to_owned());
+            }
+            if kind == SubShapeKind::Face && result.end.contains(&index) {
+                parts.push("end".to_owned());
+            }
+            for cap in result.caps.iter().filter(|cap| cap.element == element) {
+                let side = if cap.end { "end" } else { "start" };
+                parts.push(format!(
+                    "{side} of profile {:?} {}",
+                    cap.input.kind, cap.input.index
+                ));
+            }
+            let input_name = |input: usize| if input == 0 { "profile" } else { "body" };
+            for origin in result.history.modified_from(kind, index) {
+                parts.push(format!(
+                    "modified {} {:?} {}",
+                    input_name(origin.input),
+                    origin.element.kind,
+                    origin.element.index
+                ));
+            }
+            for origin in result.history.generated_from(kind, index) {
+                parts.push(format!(
+                    "generated {} {:?} {}",
+                    input_name(origin.input),
+                    origin.element.kind,
+                    origin.element.index
+                ));
+            }
+            writeln!(text, "  {kind:?} {index}: {}", parts.join(", "))
+                .expect("a string takes text");
+        }
+    }
+    text
+}
+
+#[test]
+fn prism_extents_history_names_for_the_record() {
+    for run in runs() {
+        if let Ok(result) = extrude_to(&run.profile, &run.spec, &Interrupt::new()) {
+            println!(
+                "history {} {}:\n{}",
+                run.input,
+                run.construction,
+                names(&result)
+            );
+        }
+    }
+}
+
+#[test]
+fn prism_extents_summaries_for_parity() {
+    for run in runs() {
+        match extrude_to(&run.profile, &run.spec, &Interrupt::new()) {
+            Ok(result) => {
+                let shape = &result.shape;
+                let bounds = shape.bounding_box().expect("the prism has bounds");
+                println!(
+                    "parity {} {}: faces {} edges {} vertices {} volume {:?} area {:?} min {:?} max {:?}",
+                    run.input,
+                    run.construction,
+                    shape.count(SubShapeKind::Face),
+                    shape.count(SubShapeKind::Edge),
+                    shape.count(SubShapeKind::Vertex),
+                    shape.volume().expect("the prism has a volume"),
+                    shape.area().expect("the prism has an area"),
+                    bounds.min,
+                    bounds.max
+                );
+            }
+            Err(error) => println!(
+                "parity {} {}: fails {}",
+                run.input,
+                run.construction,
+                error.detail()
+            ),
+        }
+    }
+}
diff --git a/crates/partsmith-occt-sys/tests/prism_inputs.rs b/crates/partsmith-occt-sys/tests/prism_inputs.rs
