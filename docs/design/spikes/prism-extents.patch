+// The images of `element` in `history`: its Modified images, or itself when the history keeps
+// it.
+TopTools_ListOfShape images_of(const TopoDS_Shape &element,
+                               const Handle(BRepTools_History) &history) {
+  TopTools_ListOfShape images = history->Modified(element);
+  if (images.IsEmpty() && !history->IsRemoved(element)) {
+    images.Append(element);
+  }
+  return images;
+}
+
+// The 1-based indices in `faces` of the images of `named` in `history`, ascending and once each.
+rust::Vec<std::uint32_t> face_indices(const TopTools_ListOfShape &named,
+                                      const Handle(BRepTools_History) &history,
+                                      const TopTools_IndexedMapOfShape &faces) {
+  std::vector<std::uint32_t> indices;
+  for (const TopoDS_Shape &face : named) {
+    for (const TopoDS_Shape &image : images_of(face, history)) {
+      const int index = faces.FindIndex(image);
+      if (index > 0) {
+        indices.push_back(static_cast<std::uint32_t>(index));
+      }
+    }
+  }
+  std::sort(indices.begin(), indices.end());
+  indices.erase(std::unique(indices.begin(), indices.end()), indices.end());
+  rust::Vec<std::uint32_t> result;
+  for (const std::uint32_t index : indices) {
+    result.push_back(index);
+  }
+  return result;
+}
+
+// The one face of a profile. Raises Partsmith_InvalidInput for a profile of several regions.
+TopoDS_Face profile_face(const TopoDS_Shape &profile) {
+  TopExp_Explorer faces(profile, TopAbs_FACE);
+  if (!faces.More()) {
+    raise_invalid_input("The extrude needs a profile with one region.");
+  }
+  const TopoDS_Face face = TopoDS::Face(faces.Current());
+  faces.Next();
+  if (faces.More()) {
+    raise_invalid_input("The extrude needs a profile with one region.");
+  }
+  return face;
+}
+
+// The plane of a profile's face, with its normal on the side the face's orientation gives.
+gp_Pln profile_plane(const TopoDS_Face &face) {
+  gp_Pln plane = BRepAdaptor_Surface(face, Standard_False).Plane();
+  if (face.Orientation() == TopAbs_REVERSED) {
+    plane.SetAxis(plane.Axis().Reversed());
+  }
+  return plane;
+}
+
+// The length of a prism of `profile` along `direction` that passes through `body`: to the
+// farthest corner of their bounding box, and kThroughMargin past it.
+double through_length(const TopoDS_Face &profile, const TopoDS_Shape &body,
+                      const gp_Dir &direction) {
+  Bnd_Box box;
+  BRepBndLib::Add(profile, box);
+  BRepBndLib::Add(body, box);
+  const gp_Pnt start = profile_plane(profile).Location();
+  double farthest = 0.0;
+  for (const double x : {box.CornerMin().X(), box.CornerMax().X()}) {
+    for (const double y : {box.CornerMin().Y(), box.CornerMax().Y()}) {
+      for (const double z : {box.CornerMin().Z(), box.CornerMax().Z()}) {
+        farthest = std::max(farthest, gp_Vec(start, gp_Pnt(x, y, z)).Dot(gp_Vec(direction)));
+      }
+    }
+  }
+  return farthest + kThroughMargin;
+}
+
+// The parameter bounds on `surface` of the corners of `box`, kCuttingMargin wider on each side.
+void corner_parameters(const BRepAdaptor_Surface &surface, const Bnd_Box &box, double &u_min,
+                       double &u_max, double &v_min, double &v_max) {
+  u_min = v_min = RealLast();
+  u_max = v_max = RealFirst();
+  for (const double x : {box.CornerMin().X(), box.CornerMax().X()}) {
+    for (const double y : {box.CornerMin().Y(), box.CornerMax().Y()}) {
+      for (const double z : {box.CornerMin().Z(), box.CornerMax().Z()}) {
+        const gp_Pnt corner(x, y, z);
+        double u_parameter = 0.0;
+        double v_parameter = 0.0;
+        switch (surface.GetType()) {
+          case GeomAbs_Plane:
+            ElSLib::Parameters(surface.Plane(), corner, u_parameter, v_parameter);
+            break;
+          case GeomAbs_Cylinder:
+            ElSLib::Parameters(surface.Cylinder(), corner, u_parameter, v_parameter);
+            break;
+          default:
+            ElSLib::Parameters(surface.Cone(), corner, u_parameter, v_parameter);
+            break;
+        }
+        u_min = std::min(u_min, u_parameter);
+        u_max = std::max(u_max, u_parameter);
+        v_min = std::min(v_min, v_parameter);
+        v_max = std::max(v_max, v_parameter);
+      }
+    }
+  }
+  u_min -= kCuttingMargin;
+  u_max += kCuttingMargin;
+  v_min -= kCuttingMargin;
+  v_max += kCuttingMargin;
+}
+
+// A face on the surface of `target` that reaches past everything in `box`, so it cuts a prism
+// within `box` wherever the prism crosses the surface. Planes, cylinders and cones only.
+TopoDS_Face cutting_face(const TopoDS_Face &target, const TopoDS_Shape &prism) {
+  Bnd_Box box;
+  BRepBndLib::Add(prism, box);
+  const BRepAdaptor_Surface surface(target, Standard_False);
+  double u_min = 0.0;
+  double u_max = 0.0;
+  double v_min = 0.0;
+  double v_max = 0.0;
+  switch (surface.GetType()) {
+    case GeomAbs_Plane:
+      corner_parameters(surface, box, u_min, u_max, v_min, v_max);
+      return BRepBuilderAPI_MakeFace(surface.Plane(), u_min, u_max, v_min, v_max).Face();
+    case GeomAbs_Cylinder:
+      corner_parameters(surface, box, u_min, u_max, v_min, v_max);
+      return BRepBuilderAPI_MakeFace(surface.Cylinder(), 0.0, 2.0 * M_PI, v_min, v_max).Face();
+    case GeomAbs_Cone:
+      corner_parameters(surface, box, u_min, u_max, v_min, v_max);
+      return BRepBuilderAPI_MakeFace(surface.Cone(), 0.0, 2.0 * M_PI, v_min, v_max).Face();
+    default:
+      raise_invalid_input("The extrude reaches planar, cylindrical and conical faces only.");
+  }
+}
+
+// A prism of `profile` along `along` (BRepPrimAPI_MakePrism, which copies the profile), with its
+// history, its two caps and their edges and vertices (FirstShape and LastShape).
+Built make_prism(const TopoDS_Face &profile, const gp_Vec &along, Polls &polls) {
+  // The prism builds in its constructor, which takes no progress range.
+  polls.before("BRepPrimAPI_MakePrism");
+  BRepPrimAPI_MakePrism prism(profile, along, Standard_True, Standard_True);
+  if (!prism.IsDone()) {
+    raise_not_done("BRepPrimAPI_MakePrism could not sweep the profile");
+  }
+  Built built;
+  built.shape = prism.Shape();
+  built.history = history_of(profile, prism);
+  built.start.Append(prism.FirstShape());
+  built.end.Append(prism.LastShape());
+  for (const TopAbs_ShapeEnum type : {TopAbs_EDGE, TopAbs_VERTEX}) {
+    TopTools_IndexedMapOfShape elements;
+    TopExp::MapShapes(profile, type, elements);
+    for (int index = 1; index <= elements.Extent(); ++index) {
+      built.caps.push_back(Cap{prism.FirstShape(elements(index)), elements(index), false});
+      built.caps.push_back(Cap{prism.LastShape(elements(index)), elements(index), true});
+    }
+  }
+  return built;
+}
+
+// A prism of `profile` along `direction` over `length` whose lateral faces BRepOffsetAPI_DraftAngle
+// turns by `taper` about their edges in the profile's plane, outward for a positive taper.
+Built make_drafted(const TopoDS_Face &profile, const gp_Dir &direction, double length,
+                   double taper, Polls &polls) {
+  Built built = make_prism(profile, gp_Vec(direction) * length, polls);
+  polls.before("BRepOffsetAPI_DraftAngle::Add");
+  BRepOffsetAPI_DraftAngle draft(built.shape);
+  const gp_Pln neutral(profile_plane(profile).Location(), direction);
+  TopTools_IndexedMapOfShape edges;
+  TopExp::MapShapes(profile, TopAbs_EDGE, edges);
+  for (int index = 1; index <= edges.Extent(); ++index) {
+    for (const TopoDS_Shape &lateral : built.history->Generated(edges(index))) {
+      if (lateral.ShapeType() != TopAbs_FACE) {
+        continue;
+      }
+      // A positive angle turns the face toward the inside of the prism.
+      draft.Add(TopoDS::Face(lateral), direction, -taper, neutral);
+      if (!draft.AddDone()) {
+        raise_not_done("BRepOffsetAPI_DraftAngle could not add the face of profile edge " +
+                       std::to_string(index) + ": " + status_name(draft.Status()));
+      }
+    }
+  }
+  polls.run("BRepOffsetAPI_DraftAngle",
+            [&](const Message_ProgressRange &range) { draft.Build(range); });
+  if (!draft.IsDone()) {
+    raise_not_done(std::string("BRepOffsetAPI_DraftAngle failed: ") +
+                   status_name(draft.Status()));
+  }
+  // The draft's Modified and Generated name faces only. Its ModifiedShape names the edges and
+  // vertices too, which the history then records as modified.
+  polls.before("BRepOffsetAPI_DraftAngle::ModifiedShape");
+  const Handle(BRepTools_History) drafted = history_of(built.shape, draft);
+  for (const TopAbs_ShapeEnum type : {TopAbs_EDGE, TopAbs_VERTEX}) {
+    TopTools_IndexedMapOfShape elements;
+    TopExp::MapShapes(built.shape, type, elements);
+    for (int index = 1; index <= elements.Extent(); ++index) {
+      const TopoDS_Shape image = draft.ModifiedShape(elements(index));
+      if (!image.IsNull() && !image.IsSame(elements(index))) {
+        drafted->AddModified(elements(index), image);
+      }
+    }
+  }
+  polls.before("BRepTools_History::Merge");
+  merge_history(built.history, drafted);
+  built.shape = draft.Shape();
+  return built;
+}
+
+// The edges of `offset` that BRepOffsetAPI_MakeOffset made from the edges of `wire`, as one wire
+// in the wire's own order, so a ruled loft pairs each edge with its offset. Records each edge of
+// the wire moved by `far` as the end of its profile edge in `caps`.
+TopoDS_Wire offset_wire(const TopoDS_Wire &wire, const TopoDS_Face &face,
+                        BRepOffsetAPI_MakeOffset &offset, const TopLoc_Location &far,
+                        std::vector<Cap> &caps) {
+  BRepBuilderAPI_MakeWire images;
+  int position = 0;
+  for (BRepTools_WireExplorer edges(wire, face); edges.More(); edges.Next()) {
+    ++position;
+    const TopTools_ListOfShape &generated = offset.Generated(edges.Current());
+    if (generated.Extent() != 1) {
+      raise_not_done("BRepOffsetAPI_MakeOffset gave edge " + std::to_string(position) +
+                     " of a profile wire " + std::to_string(generated.Extent()) + " images");
+    }
+    images.Add(TopoDS::Edge(generated.First()));
+    if (!images.IsDone()) {
+      raise_not_done("BRepBuilderAPI_MakeWire could not chain the offset of edge " +
+                     std::to_string(position) + " of a profile wire");
+    }
+    caps.push_back(Cap{images.Edge().Moved(far), edges.Current(), true});
+  }
+  return images.Wire();
+}
+
+// A ruled loft (BRepOffsetAPI_ThruSections) from each wire of `profile` to its offset by
+// `length` times the tangent of `taper` (BRepOffsetAPI_MakeOffset of the profile's face, joined
+// by intersection, so lines and arcs stay lines and arcs), moved along `direction` by `length`.
+// The holes' lofts are cut from the outer loft.
+Built make_lofted(const TopoDS_Face &profile, const gp_Dir &direction, double length,
+                  double taper, Polls &polls) {
+  polls.before("BRepOffsetAPI_MakeOffset");
+  BRepOffsetAPI_MakeOffset offset(profile, GeomAbs_Intersection);
+  offset.Perform(length * std::tan(taper));
+  if (!offset.IsDone()) {
+    raise_not_done("BRepOffsetAPI_MakeOffset could not offset the profile's wires");
+  }
+  gp_Trsf shift;
+  shift.SetTranslation(gp_Vec(direction) * length);
+  const TopLoc_Location far(shift);
+
+  Built built;
+  const TopoDS_Wire outer = BRepTools::OuterWire(profile);
+  std::vector<TopoDS_Wire> wires{outer};
+  for (TopoDS_Iterator iterator(profile); iterator.More(); iterator.Next()) {
+    if (!iterator.Value().IsSame(outer)) {
+      wires.push_back(TopoDS::Wire(iterator.Value()));
+    }
+  }
+  TopTools_ListOfShape holes;
+  for (const TopoDS_Wire &wire : wires) {
+    polls.before("BRepBuilderAPI_MakeWire");
+    const TopoDS_Wire end =
+        TopoDS::Wire(offset_wire(wire, profile, offset, far, built.caps).Moved(far));
+    BRepOffsetAPI_ThruSections loft(Standard_True, Standard_True);
+    loft.AddWire(wire);
+    loft.AddWire(end);
+    polls.run("BRepOffsetAPI_ThruSections",
+              [&](const Message_ProgressRange &range) { loft.Build(range); });
+    if (!loft.IsDone()) {
+      raise_not_done("BRepOffsetAPI_ThruSections could not loft a profile wire to its offset");
+    }
+    polls.before("BRepTools_History::Merge");
+    TopTools_ListOfShape arguments;
+    arguments.Append(wire);
+    merge_history(built.history, new BRepTools_History(arguments, loft));
+    if (wire.IsSame(outer)) {
+      built.shape = loft.Shape();
+      built.start.Append(loft.FirstShape());
+      built.end.Append(loft.LastShape());
+    } else {
+      holes.Append(loft.Shape());
+    }
+  }
+  if (!holes.IsEmpty()) {
+    built.shape = run_boolean(BOPAlgo_CUT, built.shape, holes, false, built.history, polls);
+  }
+  return built;
+}
+
+// Appends the faces of `shape` to `faces`.
+void add_faces(TopTools_ListOfShape &faces, const TopoDS_Shape &shape) {
+  for (TopExp_Explorer explorer(shape, TopAbs_FACE); explorer.More(); explorer.Next()) {
+    faces.Append(explorer.Current());
+  }
+}
+
+// The prism up to `until` (a face of the body, or the body) by BRepFeat_MakePrism, or by
+// BRepFeat_MakeDPrism with a taper. With the body as its basis, the builder keeps the feature
+// alone (mode 2); without one, it fuses the feature with an empty compound (mode 1). Its end is
+// what the builder names LastShape and what it names Modified of the faces of `until`.
+Built make_feature(const TopoDS_Face &profile, const TopoDS_Shape &body, bool on_body,
+                   const gp_Dir &direction, const TopoDS_Shape &until, double length,
+                   double taper, Polls &polls) {
+  TopoDS_Compound nothing;
+  BRep_Builder().MakeCompound(nothing);
+  const TopoDS_Shape basis = on_body ? body : TopoDS_Shape(nothing);
+  const int mode = on_body ? 2 : 1;
+  Built built;
+  TopTools_ListOfShape arguments;
+  arguments.Append(profile);
+  arguments.Append(body);
+  if (taper == 0.0) {
+    BRepFeat_MakePrism feature;
+    feature.Init(basis, profile, TopoDS_Face(), direction, mode, Standard_False);
+    // The builder takes no progress range.
+    polls.before("BRepFeat_MakePrism");
+    feature.Perform(until);
+    if (!feature.IsDone()) {
+      raise_not_done(std::string("BRepFeat_MakePrism failed: ") +
+                     status_name(feature.CurrentStatusError()));
+    }
+    built.shape = feature.Shape();
+    built.history = new BRepTools_History(arguments, feature);
+    built.start = feature.FirstShape();
+    built.end = feature.LastShape();
+    add_faces(built.end, until);
+    return built;
+  }
+  // The draft runs along the face's normal, which the facade checked is `direction`. A positive
+  // angle turns the faces toward the inside of the prism.
+  BRepFeat_MakeDPrism feature(basis, profile, TopoDS_Face(), -taper, mode, Standard_False);
+  // The builder takes no progress range.
+  polls.before("BRepFeat_MakeDPrism");
+  if (until.IsNull()) {
+    feature.Perform(length);
+  } else {
+    feature.Perform(until);
+  }
+  if (!feature.IsDone()) {
+    raise_not_done(std::string("BRepFeat_MakeDPrism failed: ") +
+                   status_name(feature.CurrentStatusError()));
+  }
+  built.shape = feature.Shape();
+  built.history = new BRepTools_History(arguments, feature);
+  built.start = feature.FirstShape();
+  built.end = feature.LastShape();
+  add_faces(built.end, until);
+  return built;
+}
+
+// Splits `built` at `tool` with BRepAlgoAPI_Splitter and keeps the solids that hold an image of
+// its start faces, the side of the profile. The images of the tool's faces in them are the end.
+void split_at(Built &built, const TopoDS_Shape &tool, Polls &polls) {
+  BRepAlgoAPI_Splitter splitter;
+  TopTools_ListOfShape arguments;
+  arguments.Append(built.shape);
+  TopTools_ListOfShape tools;
+  tools.Append(tool);
+  splitter.SetArguments(arguments);
+  splitter.SetTools(tools);
+  set_boolean_options(splitter);
+  polls.run("BRepAlgoAPI_Splitter",
+            [&](const Message_ProgressRange &range) { splitter.Build(range); });
+  require_no_errors(splitter, "BRepAlgoAPI_Splitter");
+  polls.before("BRepTools_History::Merge");
+  merge_history(built.history, splitter.History());
+
+  TopTools_MapOfShape starts;
+  for (const TopoDS_Shape &start : built.start) {
+    for (const TopoDS_Shape &image : images_of(start, built.history)) {
+      starts.Add(image);
+    }
+  }
+  std::vector<TopoDS_Shape> kept;
+  for (TopExp_Explorer solids(splitter.Shape(), TopAbs_SOLID); solids.More(); solids.Next()) {
+    for (TopExp_Explorer faces(solids.Current(), TopAbs_FACE); faces.More(); faces.Next()) {
+      if (starts.Contains(faces.Current())) {
+        kept.push_back(solids.Current());
+        break;
+      }
+    }
+  }
+  if (kept.empty()) {
+    raise_not_done("BRepAlgoAPI_Splitter left no piece on the side of the profile");
+  }
+  built.shape = single_or_compound(kept);
+  built.end.Clear();
+  add_faces(built.end, tool);
+}
+
+// The extent up to the body (section 8.5, and the rib's extent of section 8.6): `prism` passes
+// through the body, which splits it; the pieces on the side of the profile stay, so the prism
+// ends on the first faces of the body it meets.
+void up_to_body(Built &prism, const TopoDS_Shape &body, Polls &polls) {
+  split_at(prism, body, polls);
+}
+
+// Points of a face: its vertices, kEdgeSamples points inside each edge's range, and the centers
+// of a kGridSamples by kGridSamples grid over its parameters that lie inside it.
+std::vector<gp_Pnt> sample_points(const TopoDS_Face &face) {
+  std::vector<gp_Pnt> points;
+  TopTools_IndexedMapOfShape vertices;
+  TopExp::MapShapes(face, TopAbs_VERTEX, vertices);
+  for (int index = 1; index <= vertices.Extent(); ++index) {
+    points.push_back(BRep_Tool::Pnt(TopoDS::Vertex(vertices(index))));
+  }
+  TopTools_IndexedMapOfShape edges;
+  TopExp::MapShapes(face, TopAbs_EDGE, edges);
+  for (int index = 1; index <= edges.Extent(); ++index) {
+    const TopoDS_Edge &edge = TopoDS::Edge(edges(index));
+    if (BRep_Tool::Degenerated(edge)) {
+      continue;
+    }
+    const BRepAdaptor_Curve curve(edge);
+    const double first = curve.FirstParameter();
+    const double step = (curve.LastParameter() - first) / kEdgeSamples;
+    for (int sample = 0; sample < kEdgeSamples; ++sample) {
+      points.push_back(curve.Value(first + (sample + 0.5) * step));
+    }
+  }
+  const BRepAdaptor_Surface surface(face);
+  const double u_step = (surface.LastUParameter() - surface.FirstUParameter()) / kGridSamples;
+  const double v_step = (surface.LastVParameter() - surface.FirstVParameter()) / kGridSamples;
+  for (int column = 0; column < kGridSamples; ++column) {
+    for (int row = 0; row < kGridSamples; ++row) {
+      const gp_Pnt2d parameters(surface.FirstUParameter() + (column + 0.5) * u_step,
+                                surface.FirstVParameter() + (row + 0.5) * v_step);
+      const BRepClass_FaceClassifier inside(face, parameters, kLinear);
+      if (inside.State() == TopAbs_IN) {
+        points.push_back(surface.Value(parameters.X(), parameters.Y()));
+      }
+    }
+  }
+  return points;
+}
+
+// Raises Partsmith_InvalidInput when a point of an end face lies outside `target`, face `index`
+// of the body: the profile reaches the face only in part (gate 7's newcomer mistake).
+void require_within(const TopTools_ListOfShape &end, const TopoDS_Face &target,
+                    std::uint32_t index, Polls &polls) {
+  polls.before("BRepClass_FaceClassifier");
+  for (const TopoDS_Shape &face : end) {
+    for (const gp_Pnt &point : sample_points(TopoDS::Face(face))) {
+      const BRepClass_FaceClassifier classifier(target, point, kLinear);
+      if (classifier.State() == TopAbs_OUT) {
+        raise_invalid_input("Only part of the profile reaches face " + std::to_string(index) +
+                            ", so the extrude cannot end on it.");
+      }
+    }
+  }
+}
+
+// Checks a whole shape and repairs it when it is not valid, as section 3.5 does, recording which.
+ValidityType check_and_repair(TopoDS_Shape &shape, const Handle(BRepTools_History) &history,
+                              Polls &polls) {
+  polls.before("BRepCheck_Analyzer");
+  if (BRepCheck_Analyzer(shape).IsValid()) {
+    return ValidityType::AsBuilt;
+  }
+  return repair(shape, history, polls) ? ValidityType::AfterRepair : ValidityType::Invalid;
+}
+
+// What `spec` reaches on the copy of the body: its face, or the whole body.
+TopoDS_Shape until_of(const Shape &body, const ExtentSpecData &spec) {
+  return spec.end == ExtentEndType::UpToFace ? element_at(body, ElementKind::Face, spec.face)
+                                             : body.get();
+}
+
+// The length of a prism of `profile` that `spec` asks: its length, or through the body.
+double length_of(const TopoDS_Face &profile, const Shape *body, const ExtentSpecData &spec) {
+  return body == nullptr ? spec.length
+                         : through_length(profile, body->get(), to_direction(spec.direction));
+}
+
+// Ends a prism that passes through the body as `spec` asks: on the face's surface (split at a
+// face on it that cuts the whole prism), or on the first faces of the body it meets.
+void end_at(Built &built, const Shape &body, const ExtentSpecData &spec, Polls &polls) {
+  if (spec.end == ExtentEndType::UpToFace) {
+    polls.before("BRepBuilderAPI_MakeFace");
+    split_at(built, cutting_face(TopoDS::Face(until_of(body, spec)), built.shape), polls);
+  } else {
+    up_to_body(built, body.get(), polls);
+  }
+}
+
+// The element kind of an edge or a vertex.
+ElementKind cap_kind(const TopoDS_Shape &element) {
+  return element.ShapeType() == TopAbs_EDGE ? ElementKind::Edge : ElementKind::Vertex;
+}
+
+// The caps of `built` whose images are elements of `result`, with the index of their input in
+// `profile`, sorted.
+rust::Vec<CapData> cap_data(const Built &built, const Shape &profile, const Shape &result) {
+  std::vector<std::tuple<bool, std::uint8_t, std::uint32_t, std::uint32_t>> found;
+  for (const Cap &cap : built.caps) {
+    if (cap.element.IsNull()) {
+      continue;
+    }
+    const ElementKind kind = cap_kind(cap.input);
+    const int input = profile.map(kind).FindIndex(cap.input);
+    for (const TopoDS_Shape &image : images_of(cap.element, built.history)) {
+      const int index = result.map(kind).FindIndex(image);
+      if (index > 0 && input > 0) {
+        found.emplace_back(cap.end, static_cast<std::uint8_t>(kind),
+                           static_cast<std::uint32_t>(index),
+                           static_cast<std::uint32_t>(input));
+      }
+    }
+  }
+  std::sort(found.begin(), found.end());
+  found.erase(std::unique(found.begin(), found.end()), found.end());
+  rust::Vec<CapData> caps;
+  for (const auto &[end, kind, index, input] : found) {
+    const auto element_kind = static_cast<ElementKind>(kind);
+    caps.push_back(CapData{SubShapeData{element_kind, index}, SubShapeData{element_kind, input},
+                           end});
+  }
+  return caps;
+}
+
+// The end faces of `built` that are faces of its shape.
+TopTools_ListOfShape end_faces(const Built &built) {
+  TopTools_IndexedMapOfShape faces;
+  TopExp::MapShapes(built.shape, TopAbs_FACE, faces);
+  TopTools_ListOfShape end;
+  for (const TopoDS_Shape &named : built.end) {
+    for (const TopoDS_Shape &image : images_of(named, built.history)) {
+      if (faces.Contains(image)) {
+        end.Append(image);
+      }
+    }
+  }
+  return end;
+}
+
+// Builds the extent `construct` makes from the copies of the profile's face and of the body
+// (null for a prism of a length), checks that its end lies within the face it reaches, checks and
+// repairs it, and returns it with its history, its named faces and caps, and its polls.
+template <class Construct>
+ExtentData extent(const Shape &profile, const Shape &body, const ExtentSpecData &spec,
+                  const Interrupt &interrupt, Construct &&construct) {
+  const Handle(PollRecorder) recorder = new PollRecorder(interrupt);
+  Polls polls{Handle(Interruption)(recorder)};
+  // The builders run on copies, so they never write to the inputs (kernel spec section 3.1). A
+  // copy has its input's indices, so the history of a copy is the input's.
+  polls.before("BRepBuilderAPI_Copy");
+  const Shape profile_copy = copy_elements(profile);
+  std::vector<TopoDS_Shape> inputs{profile_copy.get()};
+  std::optional<Shape> body_copy;
+  if (spec.end != ExtentEndType::Length) {
+    polls.before("BRepBuilderAPI_Copy");
+    body_copy.emplace(copy_elements(body));
+    inputs.push_back(body_copy->get());
+  }
+  Built built = construct(profile_face(profile_copy.get()), body_copy ? &*body_copy : nullptr,
+                          polls);
+  if (spec.end == ExtentEndType::UpToFace) {
+    const TopoDS_Face target = TopoDS::Face(until_of(*body_copy, spec));
+    require_within(end_faces(built), target, spec.face, polls);
+  }
+  const ValidityType validity = check_and_repair(built.shape, built.history, polls);
+  polls.before("BRepTools_History");
+  const std::shared_ptr<Shape> result = make_shape(built.shape);
+  rust::Vec<InputHistoryData> history = history_data(built.history, inputs, *result);
+  rust::Vec<std::uint32_t> start = face_indices(built.start, built.history, result->faces());
+  rust::Vec<std::uint32_t> end = face_indices(built.end, built.history, result->faces());
+  rust::Vec<CapData> caps = cap_data(built, profile_copy, *result);
+  return ExtentData{result,   std::move(history), std::move(start), std::move(end),
+                    std::move(caps), validity,     recorder->data()};
+}
+
+}  // namespace
+
+ExtentData extrude_feature(const Shape &profile, const Shape &body, const ExtentSpecData &spec,
+                           const Interrupt &interrupt) {
+  return extent(profile, body, spec, interrupt,
+                [&](const TopoDS_Face &face, const Shape *reached, Polls &polls) {
+                  const TopoDS_Shape basis = reached == nullptr ? TopoDS_Shape() : reached->get();
+                  const TopoDS_Shape until =
+                      reached == nullptr ? TopoDS_Shape() : until_of(*reached, spec);
+                  return make_feature(face, basis, spec.basis == FeatureBasisType::Body,
+                                      to_direction(spec.direction), until, spec.length,
+                                      spec.taper, polls);
+                });
+}
+
+ExtentData extrude_split(const Shape &profile, const Shape &body, const ExtentSpecData &spec,
+                         const Interrupt &interrupt) {
+  return extent(profile, body, spec, interrupt,
+                [&](const TopoDS_Face &face, const Shape *reached, Polls &polls) {
+                  if (reached == nullptr) {
+                    raise_invalid_input("The split prism needs a face or a body to reach.");
+                  }
+                  const gp_Vec along =
+                      gp_Vec(to_direction(spec.direction)) * length_of(face, reached, spec);
+                  Built built = make_prism(face, along, polls);
+                  end_at(built, *reached, spec, polls);
+                  return built;
+                });
+}
+
+ExtentData extrude_drafted(const Shape &profile, const Shape &body, const ExtentSpecData &spec,
+                           const Interrupt &interrupt) {
+  return extent(profile, body, spec, interrupt,
+                [&](const TopoDS_Face &face, const Shape *reached, Polls &polls) {
+                  Built built = make_drafted(face, to_direction(spec.direction),
+                                             length_of(face, reached, spec), spec.taper, polls);
+                  if (reached != nullptr) {
+                    end_at(built, *reached, spec, polls);
+                  }
+                  return built;
+                });
+}
+
+ExtentData extrude_lofted(const Shape &profile, const Shape &body, const ExtentSpecData &spec,
+                          const Interrupt &interrupt) {
+  return extent(profile, body, spec, interrupt,
+                [&](const TopoDS_Face &face, const Shape *reached, Polls &polls) {
+                  Built built = make_lofted(face, to_direction(spec.direction),
+                                            length_of(face, reached, spec), spec.taper, polls);
+                  if (reached != nullptr) {
+                    end_at(built, *reached, spec, polls);
+                  }
+                  return built;
+                });
+}
+
+double surface_distance(const Shape &shape, std::uint32_t face, const Shape &target,
+                        std::uint32_t target_face) {
+  const TopoDS_Face &sampled = TopoDS::Face(element_at(shape, ElementKind::Face, face));
+  const TopoDS_Face &reference =
+      TopoDS::Face(element_at(target, ElementKind::Face, target_face));
+  Handle(Geom_Surface) surface = BRep_Tool::Surface(reference);
+  const Handle(Geom_RectangularTrimmedSurface) trimmed =
+      Handle(Geom_RectangularTrimmedSurface)::DownCast(surface);
+  if (!trimmed.IsNull()) {
+    surface = trimmed->BasisSurface();
+  }
+  double largest = 0.0;
+  for (const gp_Pnt &point : sample_points(sampled)) {
+    const GeomAPI_ProjectPointOnSurf projection(point, surface);
+    if (projection.NbPoints() == 0) {
+      raise_not_done("GeomAPI_ProjectPointOnSurf found no point of face " +
+                     std::to_string(target_face) + " near a point of face " +
+                     std::to_string(face));
+    }
+    largest = std::max(largest, projection.LowerDistance());
+  }
+  return largest;
+}
+
