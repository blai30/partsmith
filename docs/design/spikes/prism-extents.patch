+//! The prism-extents spike (kernel spec section 8.5): each construction on each input, measured
+//! by the parts of section 8.1 item 4 that run as tests. Validity, the closed mesh, the end faces
+//! on their target surface, the taper of the lateral faces and their generators are pinned as the
+//! spike recorded them, with one check of the spike's own: the faces the builders name as the
+//! start lie on the profile's plane, since two BRepFeat constructions return solids that do not
+//! start at the profile. The history of every element and a summary for the native and
+//! WebAssembly comparison are printed for the record.
+
+use std::collections::BTreeSet;
+use std::fmt::Write as _;
+
+use partsmith_mesh::{TessellationTolerance, WELD_TOLERANCE};
+use partsmith_occt_sys::{
+    ExtentResult, Interrupt, KernelError, LINEAR_TOLERANCE, Shape, SubShape, SubShapeKind,
+    Validity, extrude_to, surface_distance,
+};
+
+use crate::prism_inputs::{Run, UP, runs};
+
+/// The tolerance of the closed-mesh check: 0.05 mm and 5 degrees (test 138).
+const FINE: TessellationTolerance = TessellationTolerance {
+    chord_deviation: 0.05,
+    angular_deviation: 5.0_f64.to_radians(),
+};
+
+/// How far an end face may lie from its target surface (section 8.5's Checks).
+const END_TOLERANCE: f64 = LINEAR_TOLERANCE;
+
+/// How far a lateral face's taper may be from the one asked, in radians (section 8.5's Checks).
+const TAPER_TOLERANCE: f64 = 1e-9;
+
+/// What the tests measure of one run that builds.
+struct Measurement {
+    /// The check of the whole prism, and `Shape::is_valid` of the shape returned.
+    validity: Validity,
+    is_valid: bool,
+    /// The undirected edges of the welded mesh not used by exactly two triangles.
+    open_edges: usize,
+    /// The faces the builders name as the start, and the largest distance of their points from
+    /// the profile's plane: the prism starts at the profile.
+    start_faces: usize,
+    start_distance: f64,
+    /// The faces the builders name as the end, and the largest distance of their points from the
+    /// target's surface.
+    end_faces: usize,
+    end_distance: f64,
+    /// For the record: every face that lies on the target's surface, named or not.
+    faces_on_target: usize,
+    /// The faces named neither start nor end, and how many of them are in the `Generated` list
+    /// of exactly one profile edge.
+    lateral_faces: usize,
+    generated_once: usize,
+    /// For a taper, the largest difference between a lateral face's taper and the one asked,
+    /// measured with `Shape::edge_normals` on its edge in the start cap; infinite for a lateral
+    /// face with no such edge.
+    taper_error: Option<f64>,
+}
+
+impl Measurement {
+    /// Every measurement, for the record.
+    fn describe(&self) -> String {
+        let taper = self.taper_error.map_or_else(
+            || "no taper".to_owned(),
+            |error| format!("taper error {error:?} rad"),
+        );
+        format!(
+            "{:?}, is_valid {}, {} open mesh edges, {} start faces at most {:?} mm from the profile's plane, {} end faces at most {:?} mm from the target's surface, {} faces on that surface, {} lateral faces of which {} are in the Generated list of exactly one profile edge, {taper}",
+            self.validity,
+            self.is_valid,
+            self.open_edges,
+            self.start_faces,
+            self.start_distance,
+            self.end_faces,
+            self.end_distance,
+            self.faces_on_target,
+            self.lateral_faces,
+            self.generated_once,
+        )
+    }
+
+    /// The criteria the run passes and fails, as the pinned outcomes write them.
+    fn outcome(&self) -> String {
+        let mut criteria = vec![
+            ("valid", self.validity == Validity::AsBuilt && self.is_valid),
+            (
+                "start",
+                self.start_faces > 0 && self.start_distance <= END_TOLERANCE,
+            ),
+            ("closed", self.open_edges == 0),
+            (
+                "end",
+                self.end_faces > 0 && self.end_distance <= END_TOLERANCE,
+            ),
+            (
+                "generated",
+                self.lateral_faces > 0 && self.generated_once == self.lateral_faces,
+            ),
+        ];
+        if let Some(error) = self.taper_error {
+            criteria.push(("taper", error <= TAPER_TOLERANCE));
+        }
+        criteria
+            .iter()
+            .map(|(name, passes)| {
+                if *passes {
+                    (*name).to_owned()
+                } else {
+                    format!("no-{name}")
+                }
+            })
+            .collect::<Vec<_>>()
+            .join(" ")
+    }
+}
+
+/// The undirected edges of the shape's mesh at `FINE`, welded with `WELD_TOLERANCE`, that are
+/// not used by exactly two triangles (test 138's check).
+fn open_edges(shape: &Shape) -> usize {
+    let welded = shape
+        .tessellate(&FINE, &Interrupt::new())
+        .expect("the prism tessellates")
+        .weld(WELD_TOLERANCE)
+        .expect("WELD_TOLERANCE is a valid weld tolerance")
+        .mesh;
+    let mut uses = std::collections::BTreeMap::new();
+    for corners in welded.triangles() {
+        for side in 0..3 {
+            let (start, end) = (corners[side], corners[(side + 1) % 3]);
+            *uses
+                .entry((start.min(end), start.max(end)))
+                .or_insert(0_u32) += 1;
+        }
+    }
+    uses.values().filter(|count| **count != 2).count()
+}
+
+/// The faces named neither start nor end.
+fn lateral_faces(result: &ExtentResult) -> Vec<u32> {
+    (1..=result.shape.count(SubShapeKind::Face))
+        .filter(|face| !result.start.contains(face) && !result.end.contains(face))
+        .collect()
+}
+
+/// The profile edges whose `Generated` list holds face `face`.
+fn generators(result: &ExtentResult, face: u32) -> Vec<u32> {
+    result
+        .history
+        .generated_from(SubShapeKind::Face, face)
+        .into_iter()
+        .filter(|origin| origin.input == 0 && origin.element.kind == SubShapeKind::Edge)
+        .map(|origin| origin.element.index)
+        .collect()
+}
+
+/// The taper of `face` measured on its edge in the start cap: the angle of its outward normal
+/// past the plane normal to `UP`, positive when the prism widens away from the profile.
+fn taper_of(result: &ExtentResult, face: u32) -> Option<f64> {
+    let topology = result.shape.topology().expect("the topology can be read");
+    let start_edges: BTreeSet<u32> = result
+        .start
+        .iter()
+        .flat_map(|start| topology.faces[position_of(*start)].edges.clone())
+        .collect();
+    let edge = topology.faces[position_of(face)]
+        .edges
+        .iter()
+        .find(|edge| start_edges.contains(edge))?;
+    let normals = result
+        .shape
+        .edge_normals(*edge)
+        .expect("the edge normals can be read");
+    let normal = normals
+        .faces
+        .iter()
+        .find(|normal| normal.face == face)?
+        .normal;
+    Some((-normal.dot(UP)).asin())
+}
+
+/// The list position of a 1-based index.
+fn position_of(index: u32) -> usize {
+    usize::try_from(index - 1).expect("indices fit usize")
+}
+
+/// The largest distance of the points of `faces` of the prism from the surface of `target`'s face
+/// `target_face`.
+fn largest_distance(result: &ExtentResult, faces: &[u32], target: &Shape, target_face: u32) -> f64 {
+    faces
+        .iter()
+        .map(|face| {
+            surface_distance(&result.shape, *face, target, target_face)
+                .expect("the face's distance can be measured")
+        })
+        .fold(0.0, f64::max)
+}
+
+/// Measures a run that builds.
+fn measure(run: &Run, result: &ExtentResult) -> Measurement {
+    let start_distance = largest_distance(result, &result.start, &run.profile.shape, 1);
+    let end_distance = largest_distance(result, &result.end, &run.target.shape, run.target.face);
+    let faces_on_target = (1..=result.shape.count(SubShapeKind::Face))
+        .filter(|face| {
+            surface_distance(&result.shape, *face, &run.target.shape, run.target.face)
+                .is_ok_and(|distance| distance <= END_TOLERANCE)
+        })
+        .count();
+    let lateral = lateral_faces(result);
+    let generated_once = lateral
+        .iter()
+        .filter(|face| generators(result, **face).len() == 1)
+        .count();
+    let taper_error = (run.spec.taper != 0.0).then(|| {
+        lateral
+            .iter()
+            .map(|face| {
+                taper_of(result, *face)
+                    .map_or(f64::INFINITY, |taper| (taper - run.spec.taper).abs())
+            })
+            .fold(0.0, f64::max)
+    });
+    Measurement {
+        validity: result.validity,
+        is_valid: result.shape.is_valid().expect("the check runs"),
+        open_edges: open_edges(&result.shape),
+        start_faces: result.start.len(),
+        start_distance,
+        end_faces: result.end.len(),
+        end_distance,
+        faces_on_target,
+        lateral_faces: lateral.len(),
+        generated_once,
+        taper_error,
+    }
+}
+
+/// The message of the shim's own check when the profile reaches the face only in part.
+const IN_PART_MESSAGE: &str =
+    "Only part of the profile reaches face 5, so the extrude cannot end on it.";
+
+/// The outcome of a run as the pinned table writes it: the criteria it passes and fails, or the
+/// exception it fails with. The input that the profile reaches only in part passes when it fails
+/// with the shim's own message, and fails otherwise (section 8.5's Pass).
+fn outcome(run: &Run, result: &Result<ExtentResult, KernelError>) -> String {
+    match result {
+        Err(error) if run.in_part && error.message == IN_PART_MESSAGE => "own-status".to_owned(),
+        Err(error) if run.in_part => format!("no-own-status {}", error.exception),
+        Err(error) => format!("fails {}", error.exception),
+        Ok(_) if run.in_part => "no-own-status builds".to_owned(),
+        Ok(result) => measure(run, result).outcome(),
+    }
+}
+
