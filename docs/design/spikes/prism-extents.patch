+++ b/crates/partsmith-occt-sys/tests/prism_inputs.rs
@@ -0,0 +1,365 @@
+//! The inputs and constructions of the prism-extents spike (kernel spec section 8.5), shared by
+//! its tests and the bench's rows.
+
+use std::f64::consts::TAU;
+use std::time::Duration;
+
+use partsmith_occt_sys::{
+    ExtentConstruction, ExtentEnd, ExtentSpec, FeatureBasis, PlanarCurve, PlanarLoop,
+    PlanarProfile, PlanarRegion, Plane, Point, Point2, Primitive, PrimitiveFace, Shape,
+    TaggedCurve, Vector, make_box, make_cylinder, make_profile,
+};
+
+/// The direction every prism of the spike runs in, the normal of `Plane::XY`.
+pub const UP: Vector = Vector::new(0.0, 0.0, 1.0);
+
+/// The taper of section 8.5's tapered inputs: 5 degrees.
+pub const TAPER_DEGREES: f64 = 5.0;
+
+/// The length of the tapered prisms that reach no face, in millimeters.
+pub const TAPER_LENGTH: f64 = 10.0;
+
+/// The time section 8.5 gives `RECT` up to a face, natively.
+pub const UP_TO_FACE_BUDGET: Duration = Duration::from_millis(30);
+
+/// The time section 8.5 gives the tapered 100-edge profile, natively.
+pub const TAPERED_BUDGET: Duration = Duration::from_millis(60);
+
+/// The face a prism's end must lie on: face `face` of `shape`, whose surface the check measures.
+#[derive(Debug, Clone)]
+pub struct Target {
+    /// The shape that holds the face.
+    pub shape: Shape,
+    /// The face's 1-based index.
+    pub face: u32,
+}
+
+/// One construction tried on one input.
+#[derive(Debug, Clone)]
+pub struct Run {
+    /// The input's name.
+    pub input: &'static str,
+    /// The construction's name.
+    pub construction: &'static str,
+    /// The profile.
+    pub profile: PlanarProfile,
+    /// The extent to build.
+    pub spec: ExtentSpec,
+    /// The face the end must lie on.
+    pub target: Target,
+    /// The time section 8.5 gives the run natively, if any.
+    pub budget: Option<Duration>,
+    /// Whether the profile reaches the face only in part, the input that must fail with a status
+    /// of its own.
+    pub in_part: bool,
+}
+
+/// A line of a profile with its tag.
+fn line(tag: u32, start: (f64, f64), end: (f64, f64)) -> TaggedCurve {
+    TaggedCurve {
+        tag,
+        curve: PlanarCurve::Line {
+            start: Point2 {
+                x: start.0,
+                y: start.1,
+            },
+            end: Point2 { x: end.0, y: end.1 },
+        },
+    }
+}
+
+/// The closed polygon through `corners`, one line per side, tagged from `first_tag`.
+fn polygon(corners: &[(f64, f64)], first_tag: u32) -> PlanarLoop {
+    let curves = (0..corners.len())
+        .map(|position| {
+            let tag = first_tag + u32::try_from(position).expect("few corners");
+            line(
+                tag,
+                corners[position],
+                corners[(position + 1) % corners.len()],
+            )
+        })
+        .collect();
+    PlanarLoop { curves }
+}
+
+/// The corners of the 80 x 50 rectangle at the origin, counterclockwise from it.
+const RECT_CORNERS: [(f64, f64); 4] = [(0.0, 0.0), (80.0, 0.0), (80.0, 50.0), (0.0, 50.0)];
+
+/// A profile of one region on `Plane::XY`.
+fn profile(outer: PlanarLoop, holes: Vec<PlanarLoop>) -> PlanarProfile {
+    make_profile(&Plane::XY, &[PlanarRegion { outer, holes }]).expect("the profile builds")
+}
+
+/// `RECT`: lines tagged 1 to 4 around the 80 x 50 rectangle at the origin (test 15).
+pub fn rect() -> PlanarProfile {
+    profile(polygon(&RECT_CORNERS, 1), Vec::new())
+}
+
+/// The profile of test 18: `RECT` with a hole, the circle tagged 5 of radius 5 about (40, 25).
+pub fn rect_with_hole() -> PlanarProfile {
+    let circle = TaggedCurve {
+        tag: 5,
+        curve: PlanarCurve::Circle {
+            center: Point2 { x: 40.0, y: 25.0 },
+            radius: 5.0,
+        },
+    };
+    profile(
+        polygon(&RECT_CORNERS, 1),
+        vec![PlanarLoop {
+            curves: vec![circle],
+        }],
+    )
+}
+
+/// The 100-edge profile of section 5: the regular polygon of 100 sides inscribed in a circle of
+/// radius 40 mm about the origin, tagged 1 to 100.
+pub fn hundred_gon() -> PlanarProfile {
+    let corners: Vec<(f64, f64)> = (0..100)
+        .map(|corner| {
+            let angle = TAU * f64::from(corner) / 100.0;
+            (40.0 * angle.cos(), 40.0 * angle.sin())
+        })
+        .collect();
+    profile(polygon(&corners, 1), Vec::new())
+}
+
+/// The 1-based index of the face of `primitive` with `role`.
+fn face_of(primitive: &Primitive, role: PrimitiveFace) -> u32 {
+    let position = primitive
+        .faces
+        .iter()
+        .position(|face| *face == role)
+        .expect("the primitive has the face");
+    u32::try_from(position + 1).expect("few faces")
+}
+
+/// A box on a plane parallel to `Plane::XY` through `origin`.
+fn box_at(origin: Point, length: f64, width: f64, height: f64) -> Primitive {
+    let plane = Plane {
+        origin,
+        ..Plane::XY
+    };
+    make_box(&plane, length, width, height).expect("the box builds")
+}
+
+/// The block above `RECT`: 120 x 90 x 10 from (-20, -20, 30), its bottom face the plane z = 30
+/// over the whole profile.
+pub fn block() -> Target {
+    let block = box_at(Point::new(-20.0, -20.0, 30.0), 120.0, 90.0, 10.0);
+    Target {
+        face: face_of(&block, PrimitiveFace::Bottom),
+        shape: block.shape,
+    }
+}
+
+/// A block above `RECT` whose bottom face is tilted 20 degrees about the X axis: 120 x 110 x 10
+/// on the plane through (-20, -30, 25) with normal (0, -sin 20, cos 20). Its bottom face rises
+/// from z = 35.9 to z = 54.1 over the profile.
+pub fn tilted_block() -> Target {
+    let angle = 20.0_f64.to_radians();
+    let plane = Plane {
+        origin: Point::new(-20.0, -30.0, 25.0),
+        normal: Vector::new(0.0, -angle.sin(), angle.cos()),
+        x_axis: Vector::new(1.0, 0.0, 0.0),
+    };
+    let block = make_box(&plane, 120.0, 110.0, 10.0).expect("the tilted block builds");
+    Target {
+        face: face_of(&block, PrimitiveFace::Bottom),
+        shape: block.shape,
+    }
+}
+
+/// A cylinder of radius 60 lying along X above `RECT`: its axis through (-20, 25, 100), 120 long,
+/// its seam on top. Its side reaches down to z = 40 over the profile's middle and z = 45.5 over
+/// its long edges.
+pub fn cylinder() -> Target {
+    let plane = Plane {
+        origin: Point::new(-20.0, 25.0, 100.0),
+        normal: Vector::new(1.0, 0.0, 0.0),
+        x_axis: Vector::new(0.0, 0.0, 1.0),
+    };
+    let cylinder = make_cylinder(&plane, 60.0, 120.0).expect("the cylinder builds");
+    Target {
+        face: face_of(&cylinder, PrimitiveFace::Side),
+        shape: cylinder.shape,
+    }
+}
+
+/// A block above half of `RECT`: 100 x 90 x 10 from (40, -20, 30), so its bottom face covers
+/// the profile only for x of 40 and more.
+pub fn half_block() -> Target {
+    let block = box_at(Point::new(40.0, -20.0, 30.0), 100.0, 90.0, 10.0);
+    Target {
+        face: face_of(&block, PrimitiveFace::Bottom),
+        shape: block.shape,
+    }
+}
+
+/// The plane z = `TAPER_LENGTH` as the face of a large square, the target of the tapered prisms
+/// that reach no face.
+pub fn end_plane() -> Target {
+    let plane = Plane {
+        origin: Point::new(0.0, 0.0, TAPER_LENGTH),
+        ..Plane::XY
+    };
+    let corners = [
+        (-100.0, -100.0),
+        (100.0, -100.0),
+        (100.0, 100.0),
+        (-100.0, 100.0),
+    ];
+    let square = make_profile(
+        &plane,
+        &[PlanarRegion {
+            outer: polygon(&corners, 1),
+            holes: Vec::new(),
+        }],
+    )
+    .expect("the end plane builds");
+    Target {
+        shape: square.shape,
+        face: 1,
+    }
+}
+
+/// The constructions of an extent up to a face or the body, with their names.
+const UP_TO_CONSTRUCTIONS: [(&str, ExtentConstruction); 3] = [
+    (
+        "feature-body",
+        ExtentConstruction::FeaturePrism(FeatureBasis::Body),
+    ),
+    (
+        "feature-nothing",
+        ExtentConstruction::FeaturePrism(FeatureBasis::Nothing),
+    ),
+    ("split", ExtentConstruction::SplitPrism),
+];
+
+/// The constructions of a taper of a length, with their names. A BRepFeat construction without
+/// a body to reach has an empty compound as its basis whichever basis it is given.
+const TAPER_CONSTRUCTIONS: [(&str, ExtentConstruction); 3] = [
+    (
+        "feature",
+        ExtentConstruction::FeaturePrism(FeatureBasis::Nothing),
+    ),
+    ("draft-angle", ExtentConstruction::DraftAngle),
+    ("thru-sections", ExtentConstruction::ThruSections),
+];
+
+/// The constructions of a taper up to a face, with their names.
+const TAPER_UP_TO_CONSTRUCTIONS: [(&str, ExtentConstruction); 4] = [
+    (
+        "feature-body",
+        ExtentConstruction::FeaturePrism(FeatureBasis::Body),
+    ),
+    (
+        "feature-nothing",
+        ExtentConstruction::FeaturePrism(FeatureBasis::Nothing),
+    ),
+    ("draft-angle", ExtentConstruction::DraftAngle),
+    ("thru-sections", ExtentConstruction::ThruSections),
+];
+
+/// Every construction tried on every input of section 8.5, in the order of its Inputs.
+pub fn runs() -> Vec<Run> {
+    let mut runs = Vec::new();
+    let up_to_face = [
+        ("rect-parallel", block(), Some(UP_TO_FACE_BUDGET), false),
+        (
+            "rect-tilted",
+            tilted_block(),
+            Some(UP_TO_FACE_BUDGET),
+            false,
+        ),
+        ("rect-cylinder", cylinder(), Some(UP_TO_FACE_BUDGET), false),
+        ("rect-in-part", half_block(), None, true),
+    ];
+    for (input, target, budget, in_part) in up_to_face {
+        for (construction_name, construction) in UP_TO_CONSTRUCTIONS {
+            runs.push(Run {
+                input,
+                construction: construction_name,
+                profile: rect(),
+                spec: ExtentSpec {
+                    direction: UP,
+                    end: ExtentEnd::UpToFace {
+                        body: target.shape.clone(),
+                        face: target.face,
+                    },
+                    taper: 0.0,
+                    construction,
+                },
+                target: target.clone(),
+                budget,
+                in_part,
+            });
+        }
+    }
+    let body = block();
+    for (construction_name, construction) in UP_TO_CONSTRUCTIONS {
+        runs.push(Run {
+            input: "rect-body",
+            construction: construction_name,
+            profile: rect(),
+            spec: ExtentSpec {
+                direction: UP,
+                end: ExtentEnd::UpToBody(body.shape.clone()),
+                taper: 0.0,
+                construction,
+            },
+            target: body.clone(),
+            budget: None,
+            in_part: false,
+        });
+    }
+    let taper = TAPER_DEGREES.to_radians();
+    let tapered = [
+        ("rect-taper-out", rect(), taper, None),
+        ("rect-taper-in", rect(), -taper, None),
+        ("hole-taper-out", rect_with_hole(), taper, None),
+        ("hole-taper-in", rect_with_hole(), -taper, None),
+        ("gon-taper-out", hundred_gon(), taper, Some(TAPERED_BUDGET)),
+        ("gon-taper-in", hundred_gon(), -taper, Some(TAPERED_BUDGET)),
+    ];
+    for (input, profile, angle, budget) in tapered {
+        for (construction_name, construction) in TAPER_CONSTRUCTIONS {
+            runs.push(Run {
+                input,
+                construction: construction_name,
+                profile: profile.clone(),
+                spec: ExtentSpec {
+                    direction: UP,
+                    end: ExtentEnd::Length(TAPER_LENGTH),
+                    taper: angle,
+                    construction,
+                },
+                target: end_plane(),
+                budget,
+                in_part: false,
+            });
+        }
+    }
+    let tilted = tilted_block();
+    for (construction_name, construction) in TAPER_UP_TO_CONSTRUCTIONS {
+        runs.push(Run {
+            input: "rect-taper-tilted",
+            construction: construction_name,
+            profile: rect(),
+            spec: ExtentSpec {
+                direction: UP,
+                end: ExtentEnd::UpToFace {
+                    body: tilted.shape.clone(),
+                    face: tilted.face,
+                },
+                taper,
+                construction,
+            },
+            target: tilted.clone(),
+            budget: None,
+            in_part: false,
+        });
+    }
+    runs
+}
