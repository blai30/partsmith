diff --git a/crates/partsmith-occt-sys/src/prism_extents.rs b/crates/partsmith-occt-sys/src/prism_extents.rs
new file mode 100644
index 0000000..eb329a2
--- /dev/null
+++ b/crates/partsmith-occt-sys/src/prism_extents.rs
@@ -0,0 +1,509 @@
+//! The extents of the prism-extents spike (kernel spec section 8.5): a prism of a profile up to a
+//! face of a body or up to the body, and a tapered prism, by each construction the spike
+//! compares. The result reports OCCT's history of the profile and the body, the faces the
+//! builders name as its start and its end, the check of the whole shape and the call's polls.
+
+use std::f64::consts::FRAC_PI_2;
+use std::time::Duration;
+
+use crate::ANGULAR_TOLERANCE;
+use crate::error::{KernelError, Operation, call};
+use crate::ffi::bridge as sys;
+use crate::history::{History, history_from_ffi};
+use crate::interrupt::Interrupt;
+use crate::profiles::PlanarProfile;
+use crate::shape::{Shape, SubShape, SubShapeKind};
+use crate::values::{Vector, check_finite, is_positive_length};
+
+/// The basis shape a BRepFeat construction builds its feature on.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
+pub enum FeatureBasis {
+    /// The body the prism reaches, with the builder keeping the feature alone (mode 2).
+    Body,
+    /// An empty compound, with the builder fusing the feature with it (mode 1).
+    Nothing,
+}
+
+/// The construction of a prism's extent (section 8.5's Constructions).
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
+pub enum ExtentConstruction {
+    /// `BRepFeat_MakePrism` up to a face or the body with `Perform(Until)`, or
+    /// `BRepFeat_MakeDPrism` with a taper.
+    FeaturePrism(FeatureBasis),
+    /// `BRepPrimAPI_MakePrism` through the body, split by `BRepAlgoAPI_Splitter` at the face's
+    /// surface or at the body, and kept on the profile's side.
+    SplitPrism,
+    /// `BRepOffsetAPI_DraftAngle` on the lateral faces of a prism, split as `SplitPrism` is when
+    /// it reaches a face or the body.
+    DraftAngle,
+    /// `BRepOffsetAPI_ThruSections` between the profile and its offset at the far end
+    /// (`BRepOffsetAPI_MakeOffset` of the profile's wires), split as `SplitPrism` is when it
+    /// reaches a face or the body.
+    ThruSections,
+}
+
+/// Where a prism ends.
+#[derive(Debug, Clone)]
+pub enum ExtentEnd {
+    /// At this distance from the profile, in millimeters.
+    Length(f64),
+    /// On face `face` of `body`.
+    UpToFace {
+        /// The body that holds the face.
+        body: Shape,
+        /// The face, a 1-based index of `body`'s faces.
+        face: u32,
+    },
+    /// On the first faces of the body it meets.
+    UpToBody(Shape),
+}
+
+/// A prism's extent.
+#[derive(Debug, Clone)]
+pub struct ExtentSpec {
+    /// The direction the prism runs in, out of the profile's plane.
+    pub direction: Vector,
+    /// Where it ends.
+    pub end: ExtentEnd,
+    /// The angle of its lateral faces to the direction in radians, positive outward; 0 for a
+    /// prism without a taper.
+    pub taper: f64,
+    /// Its construction.
+    pub construction: ExtentConstruction,
+}
+
+/// How a shape passed the checks of `BRepCheck_Analyzer` (section 8.1 item 4).
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
+pub enum Validity {
+    /// Valid as built.
+    AsBuilt,
+    /// Valid after `ShapeFix_Shape`.
+    AfterRepair,
+    /// Invalid after `ShapeFix_Shape`.
+    Invalid,
+}
+
+/// The polls of one call with an interrupt that is never requested (section 8.1 item 4).
+#[derive(Debug, Clone, Copy, PartialEq)]
+pub struct PollRecord {
+    /// The number of `UserBreak` calls.
+    pub count: u64,
+    /// From the call's start to its first poll.
+    pub first: Duration,
+    /// The longest gap between two polls.
+    pub longest: Duration,
+    /// How many polls came before the longest gap: it ends at poll `longest_after + 1`.
+    pub longest_after: u64,
+    /// From the last poll to the call's end.
+    pub last: Duration,
+    /// The whole call in the shim.
+    pub total: Duration,
+}
+
+/// An edge or a vertex of a prism that a builder names as the start or the end of a profile edge
+/// or vertex: `BRepPrimAPI_MakePrism`'s `FirstShape` and `LastShape`, or the offset of a profile
+/// edge that a loft ends on.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
+pub struct CapName {
+    /// The prism's edge or vertex.
+    pub element: SubShape,
+    /// The profile's edge or vertex.
+    pub input: SubShape,
+    /// Whether it is the end of the input rather than its start.
+    pub end: bool,
+}
+
+/// A prism's extent with what the spike measures of it.
+#[derive(Debug, Clone)]
+pub struct ExtentResult {
+    /// The prism, repaired when it was not valid as built.
+    pub shape: Shape,
+    /// OCCT's history of the profile, then of the body when the extent reaches one.
+    pub history: History,
+    /// The faces the builders name as the prism's start, ascending.
+    pub start: Vec<u32>,
+    /// The faces the builders name as the prism's end, ascending: the far cap, or the pieces of
+    /// the face or the body it reaches.
+    pub end: Vec<u32>,
+    /// The edges and vertices the builders name as the start or the end of a profile element.
+    pub caps: Vec<CapName>,
+    /// The check of the whole prism.
+    pub validity: Validity,
+    /// The polls of the call.
+    pub polls: PollRecord,
+}
+
+const ZERO_DIRECTION_MESSAGE: &str = "The extrude direction needs to be nonzero.";
+const DIRECTION_IN_PLANE_MESSAGE: &str =
+    "The extrude direction lies in the sketch plane, so the profile cannot be extruded.";
+const TAPER_DIRECTION_MESSAGE: &str =
+    "A tapered extrude runs along the normal of its sketch plane.";
+const LENGTH_MESSAGE: &str = "The extrude length must be greater than 0 mm.";
+const TAPER_MESSAGE: &str = "The taper angle must be less than 90 degrees either way.";
+const NEEDS_TAPER_MESSAGE: &str = "This construction tapers the extrude, so it needs a taper.";
+const NO_TAPER_MESSAGE: &str = "The split prism does not taper.";
+const NEEDS_BODY_MESSAGE: &str = "The split prism needs a face or a body to reach.";
+const PLAIN_LENGTH_MESSAGE: &str = "An extrude of a length without a taper is a plain extrude.";
+const EMPTY_BODY_MESSAGE: &str = "The extrude needs a body with faces to reach.";
+
+/// The milliseconds the shim reports, as a duration.
+fn duration(milliseconds: f64) -> Duration {
+    Duration::from_secs_f64(milliseconds.max(0.0) / 1000.0)
+}
+
+impl PollRecord {
+    fn from_ffi(data: sys::PollData) -> PollRecord {
+        PollRecord {
+            count: data.count,
+            first: duration(data.first),
+            longest: duration(data.longest),
+            longest_after: data.longest_after,
+            last: duration(data.last),
+            total: duration(data.total),
+        }
+    }
+}
+
+impl CapName {
+    fn from_ffi(operation: Operation, data: sys::CapData) -> Result<CapName, KernelError> {
+        let sub_shape = |data: sys::SubShapeData| {
+            Ok(SubShape {
+                kind: SubShapeKind::from_ffi(operation, data.kind)?,
+                index: data.index,
+            })
+        };
+        Ok(CapName {
+            element: sub_shape(data.element)?,
+            input: sub_shape(data.input)?,
+            end: data.end,
+        })
+    }
+}
+
+impl Validity {
+    fn from_ffi(operation: Operation, data: sys::ValidityType) -> Result<Validity, KernelError> {
+        match data {
+            sys::ValidityType::AsBuilt => Ok(Validity::AsBuilt),
+            sys::ValidityType::AfterRepair => Ok(Validity::AfterRepair),
+            sys::ValidityType::Invalid => Ok(Validity::Invalid),
+            _ => Err(KernelError::internal(operation, "unknown validity")),
+        }
+    }
+}
+
+/// Checks a body the prism reaches: it has faces, and `face`, when given, is one of them.
+fn check_body(operation: Operation, body: &Shape, face: Option<u32>) -> Result<(), KernelError> {
+    if body.count(SubShapeKind::Face) == 0 {
+        return Err(KernelError::invalid_input(operation, EMPTY_BODY_MESSAGE));
+    }
+    match face {
+        Some(face) => body.check_index(operation, SubShapeKind::Face, face),
+        None => Ok(()),
+    }
+}
+
+impl ExtentSpec {
+    /// Checks the spec against the profile's plane normal (section 3.1 items 4 to 6) and returns
+    /// its bridge form with the body it reaches, or an empty shape.
+    fn to_ffi(
+        &self,
+        operation: Operation,
+        normal: Vector,
+    ) -> Result<(sys::ExtentSpecData, Shape), KernelError> {
+        let direction = self.direction;
+        check_finite(
+            operation,
+            &[direction.x, direction.y, direction.z, self.taper],
+        )?;
+        let unit = direction
+            .normalized()
+            .ok_or_else(|| KernelError::invalid_input(operation, ZERO_DIRECTION_MESSAGE))?;
+        if unit.dot(normal).abs() <= ANGULAR_TOLERANCE {
+            return Err(KernelError::invalid_input(
+                operation,
+                DIRECTION_IN_PLANE_MESSAGE,
+            ));
+        }
+        if self.taper.abs() >= FRAC_PI_2 - ANGULAR_TOLERANCE {
+            return Err(KernelError::invalid_input(operation, TAPER_MESSAGE));
+        }
+        let tapered = self.taper.abs() > ANGULAR_TOLERANCE;
+        if tapered && unit.dot(normal) < 1.0 - ANGULAR_TOLERANCE {
+            return Err(KernelError::invalid_input(
+                operation,
+                TAPER_DIRECTION_MESSAGE,
+            ));
+        }
+        let basis = match self.construction {
+            ExtentConstruction::FeaturePrism(FeatureBasis::Body) => sys::FeatureBasisType::Body,
+            _ => sys::FeatureBasisType::Nothing,
+        };
+        match self.construction {
+            ExtentConstruction::SplitPrism if tapered => {
+                return Err(KernelError::invalid_input(operation, NO_TAPER_MESSAGE));
+            }
+            ExtentConstruction::DraftAngle | ExtentConstruction::ThruSections if !tapered => {
+                return Err(KernelError::invalid_input(operation, NEEDS_TAPER_MESSAGE));
+            }
+            _ => {}
+        }
+        let mut data = sys::ExtentSpecData {
+            basis,
+            end: sys::ExtentEndType::Length,
+            direction: unit.to_ffi(),
+            length: 0.0,
+            face: 0,
+            taper: if tapered { self.taper } else { 0.0 },
+        };
+        let body = match &self.end {
+            ExtentEnd::Length(length) => {
+                check_finite(operation, &[*length])?;
+                if !is_positive_length(*length) {
+                    return Err(KernelError::invalid_input(operation, LENGTH_MESSAGE));
+                }
+                match self.construction {
+                    ExtentConstruction::SplitPrism => {
+                        return Err(KernelError::invalid_input(operation, NEEDS_BODY_MESSAGE));
+                    }
+                    ExtentConstruction::FeaturePrism(_) if !tapered => {
+                        return Err(KernelError::invalid_input(operation, PLAIN_LENGTH_MESSAGE));
+                    }
+                    _ => {}
+                }
+                data.length = *length;
+                Shape::empty()
+            }
+            ExtentEnd::UpToFace { body, face } => {
+                check_body(operation, body, Some(*face))?;
+                data.end = sys::ExtentEndType::UpToFace;
+                data.face = *face;
+                body.clone()
+            }
+            ExtentEnd::UpToBody(body) => {
+                check_body(operation, body, None)?;
+                data.end = sys::ExtentEndType::UpToBody;
+                body.clone()
+            }
+        };
+        Ok((data, body))
+    }
+}
+
+/// A construction of the shim.
+type Construction = fn(
+    &sys::Shape,
+    &sys::Shape,
+    &sys::ExtentSpecData,
+    &Interrupt,
+) -> Result<sys::ExtentData, cxx::Exception>;
+
+/// Extrudes a one-region profile as `spec` asks, by its construction (section 8.5).
+pub fn extrude_to(
+    profile: &PlanarProfile,
+    spec: &ExtentSpec,
+    interrupt: &Interrupt,
+) -> Result<ExtentResult, KernelError> {
+    let construction: Construction = match spec.construction {
+        ExtentConstruction::FeaturePrism(_) => sys::extrude_feature,
+        ExtentConstruction::SplitPrism => sys::extrude_split,
+        ExtentConstruction::DraftAngle => sys::extrude_drafted,
+        ExtentConstruction::ThruSections => sys::extrude_lofted,
+    };
+    extent(profile, spec, construction, interrupt)
+}
+
+/// Extrudes a one-region profile with `BRepFeat_MakePrism` up to a face or the body
+/// (`Perform(Until)`), or with `BRepFeat_MakeDPrism` when `taper` is not 0 (section 8.5's
+/// construction (i)).
+pub fn extrude_feature(
+    profile: &PlanarProfile,
+    direction: Vector,
+    end: &ExtentEnd,
+    taper: f64,
+    basis: FeatureBasis,
+    interrupt: &Interrupt,
+) -> Result<ExtentResult, KernelError> {
+    let construction = ExtentConstruction::FeaturePrism(basis);
+    let spec = spec(direction, end, taper, construction);
+    extent(profile, &spec, sys::extrude_feature, interrupt)
+}
+
+/// Extrudes a one-region profile up to a face or the body with `BRepPrimAPI_MakePrism` through
+/// the body, split by `BRepAlgoAPI_Splitter` at the face's surface or at the body and kept on the
+/// profile's side (section 8.5's construction (ii) up to a face or the body).
+pub fn extrude_split(
+    profile: &PlanarProfile,
+    direction: Vector,
+    end: &ExtentEnd,
+    interrupt: &Interrupt,
+) -> Result<ExtentResult, KernelError> {
+    let spec = spec(direction, end, 0.0, ExtentConstruction::SplitPrism);
+    extent(profile, &spec, sys::extrude_split, interrupt)
+}
+
+/// Extrudes a one-region profile tapered by `BRepOffsetAPI_DraftAngle` on the lateral faces of a
+/// prism, split as `extrude_split` splits when it reaches a face or the body (section 8.5's
+/// taper (ii)).
+pub fn extrude_drafted(
+    profile: &PlanarProfile,
+    direction: Vector,
+    end: &ExtentEnd,
+    taper: f64,
+    interrupt: &Interrupt,
+) -> Result<ExtentResult, KernelError> {
+    let spec = spec(direction, end, taper, ExtentConstruction::DraftAngle);
+    extent(profile, &spec, sys::extrude_drafted, interrupt)
+}
+
+/// Extrudes a one-region profile tapered by `BRepOffsetAPI_ThruSections` between the profile and
+/// its offset at the far end, split as `extrude_split` splits when it reaches a face or the body
+/// (section 8.5's taper (iii)).
+pub fn extrude_lofted(
+    profile: &PlanarProfile,
+    direction: Vector,
+    end: &ExtentEnd,
+    taper: f64,
+    interrupt: &Interrupt,
+) -> Result<ExtentResult, KernelError> {
+    let spec = spec(direction, end, taper, ExtentConstruction::ThruSections);
+    extent(profile, &spec, sys::extrude_lofted, interrupt)
+}
+
+/// The spec of one construction's call.
+fn spec(
+    direction: Vector,
+    end: &ExtentEnd,
+    taper: f64,
+    construction: ExtentConstruction,
+) -> ExtentSpec {
+    ExtentSpec {
+        direction,
+        end: end.clone(),
+        taper,
+        construction,
+    }
+}
+
+/// Checks `spec` and runs `construction` on it. Each construction's function names only its own
+/// shim function, so a build that calls one construction links no other.
+fn extent(
+    profile: &PlanarProfile,
+    spec: &ExtentSpec,
+    construction: Construction,
+    interrupt: &Interrupt,
+) -> Result<ExtentResult, KernelError> {
+    let operation = Operation::ExtrudeTo;
+    let frame = profile.plane.frame(operation)?;
+    let (data, body) = spec.to_ffi(operation, frame.normal)?;
+    let result = call(operation, || {
+        construction(profile.shape.inner(), body.inner(), &data, interrupt)
+    })?;
+    Ok(ExtentResult {
+        shape: Shape::from_ffi(operation, result.shape)?,
+        history: history_from_ffi(operation, result.inputs)?,
+        start: result.start,
+        end: result.end,
+        caps: result
+            .caps
+            .into_iter()
+            .map(|cap| CapName::from_ffi(operation, cap))
+            .collect::<Result<_, _>>()?,
+        validity: Validity::from_ffi(operation, result.validity)?,
+        polls: PollRecord::from_ffi(result.polls),
+    })
+}
+
+/// The largest distance from points of face `face` of `shape` (its vertices, points along its
+/// edges and a grid of points inside it) to the surface of face `target_face` of `target`, which
+/// reaches beyond that face's bounds: how far the face lies from the surface.
+pub fn surface_distance(
+    shape: &Shape,
+    face: u32,
+    target: &Shape,
+    target_face: u32,
+) -> Result<f64, KernelError> {
+    let operation = Operation::Query;
+    shape.check_index(operation, SubShapeKind::Face, face)?;
+    target.check_index(operation, SubShapeKind::Face, target_face)?;
+    call(operation, || {
+        sys::surface_distance(shape.inner(), face, target.inner(), target_face)
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::test_support::square_region;
+    use crate::{Plane, make_profile};
+
+    fn spec(construction: ExtentConstruction, end: ExtentEnd, taper: f64) -> ExtentSpec {
+        ExtentSpec {
+            direction: Vector::new(0.0, 0.0, 1.0),
+            end,
+            taper,
+            construction,
+        }
+    }
+
+    fn message(spec: &ExtentSpec) -> String {
+        let square = make_profile(&Plane::XY, &[square_region(0.0)]).expect("the square builds");
+        extrude_to(&square, spec, &Interrupt::new())
+            .expect_err("the spec is refused")
+            .message
+    }
+
+    #[test]
+    fn a_split_prism_needs_something_to_reach() {
+        let split = spec(ExtentConstruction::SplitPrism, ExtentEnd::Length(10.0), 0.0);
+        assert_eq!(message(&split), NEEDS_BODY_MESSAGE);
+    }
+
+    #[test]
+    fn a_split_prism_does_not_taper() {
+        let body = Shape::empty();
+        let split = spec(
+            ExtentConstruction::SplitPrism,
+            ExtentEnd::UpToBody(body),
+            0.1,
+        );
+        assert_eq!(message(&split), NO_TAPER_MESSAGE);
+    }
+
+    #[test]
+    fn taper_constructions_need_a_taper() {
+        for construction in [
+            ExtentConstruction::DraftAngle,
+            ExtentConstruction::ThruSections,
+        ] {
+            let untapered = spec(construction, ExtentEnd::Length(10.0), 0.0);
+            assert_eq!(message(&untapered), NEEDS_TAPER_MESSAGE);
+        }
+    }
+
+    #[test]
+    fn a_taper_runs_along_the_normal() {
+        let mut oblique = spec(ExtentConstruction::DraftAngle, ExtentEnd::Length(10.0), 0.1);
+        oblique.direction = Vector::new(0.0, 1.0, 1.0);
+        assert_eq!(message(&oblique), TAPER_DIRECTION_MESSAGE);
+    }
+
+    #[test]
+    fn a_body_without_faces_cannot_be_reached() {
+        let empty = spec(
+            ExtentConstruction::SplitPrism,
+            ExtentEnd::UpToBody(Shape::empty()),
+            0.0,
+        );
+        assert_eq!(message(&empty), EMPTY_BODY_MESSAGE);
+    }
+
+    #[test]
+    fn a_plain_feature_prism_of_a_length_is_refused() {
+        let plain = spec(
+            ExtentConstruction::FeaturePrism(FeatureBasis::Nothing),
+            ExtentEnd::Length(10.0),
+            0.0,
+        );
+        assert_eq!(message(&plain), PLAIN_LENGTH_MESSAGE);
+    }
+}
