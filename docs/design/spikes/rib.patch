index 0000000..cfdc439
--- /dev/null
+++ b/crates/partsmith-occt-sys/src/rib.rs
@@ -0,0 +1,240 @@
+//! The ribs of the rib spike (kernel spec section 8.6): an open profile in a plane, thickened by
+//! half the rib's thickness to each side of the plane and reaching the body, by each construction
+//! the spike compares. The result reports the body with the rib, OCCT's history of the profile
+//! and the body, the faces the construction names as the rib's two sides, the checks of the
+//! result and of the construction, and the call's polls.
+
+use crate::error::{KernelError, Operation, call};
+use crate::ffi::bridge as sys;
+use crate::history::{History, history_from_ffi};
+use crate::interrupt::Interrupt;
+use crate::prism_extents::{PollRecord, Validity};
+use crate::shape::{Shape, SubShapeKind};
+use crate::values::{Plane, Point2, check_finite, is_positive_length};
+
+/// A rib: an open profile in a plane, thickened by half the thickness to each side of the plane.
+/// The rib reaches the body on the side of the profile that the plane's normal crossed with the
+/// profile's direction points to, the side `BRepFeat_MakeLinearForm` fills: on the left of the
+/// profile in the plane's coordinates.
+#[derive(Debug, Clone, PartialEq)]
+pub struct RibSpec {
+    /// The profile's plane, the middle of the rib.
+    pub plane: Plane,
+    /// The profile: lines through these points in order, in the plane's coordinates.
+    pub profile: Vec<Point2>,
+    /// The rib's thickness across the plane, in millimeters.
+    pub thickness: f64,
+}
+
+/// The construction of a rib (section 8.6's Constructions).
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
+pub enum RibConstruction {
+    /// (a) `BRepFeat_MakeLinearForm` with the open wire, its plane and the two thickness
+    /// directions. `sliding` is its `Modify` option: the builder tries to slide the rib along the
+    /// faces it meets.
+    LinearForm {
+        /// Whether the builder tries to slide the rib along the faces it meets.
+        sliding: bool,
+    },
+    /// (b) The open profile thickened into a planar face (`BRepOffsetAPI_MakeOffset` with
+    /// `IsOpenResult` true, by half the thickness to each side, join `GeomAbs_Intersection`),
+    /// extruded up to the body with the split prism of section 8.5 and fused to it. A straight
+    /// profile thickens across the rib's plane and reaches the body as `RibSpec` says. A profile
+    /// that is not straight lies in one plane only, the rib's: it thickens there and reaches
+    /// along the plane's normal.
+    ThickenedPrism,
+}
+
+/// A rib with what the spike measures of it.
+#[derive(Debug, Clone)]
+pub struct RibResult {
+    /// The body with the rib, repaired when it was not valid as built.
+    pub shape: Shape,
+    /// The rib before the fuse, repaired when it was not valid as built; the result itself for
+    /// `BRepFeat_MakeLinearForm`, which fuses the rib itself.
+    pub construction: Shape,
+    /// The profile as the shim built it: an open wire with one edge per line, in order.
+    pub profile: Shape,
+    /// OCCT's history of the profile (input 0) and the body (input 1).
+    pub history: History,
+    /// The faces the construction names as the rib's two sides, ascending.
+    pub sides: Vec<u32>,
+    /// The check of the result.
+    pub validity: Validity,
+    /// The check of the construction before the fuse.
+    pub construction_validity: Validity,
+    /// The polls of the call.
+    pub polls: PollRecord,
+}
+
+const FEW_POINTS_MESSAGE: &str = "A rib profile needs at least two points.";
+const SAME_POINTS_MESSAGE: &str = "Two points in a row of the rib profile are the same point.";
+const THICKNESS_MESSAGE: &str = "The rib thickness must be greater than 0 mm.";
+const NO_SOLID_MESSAGE: &str = "The rib needs a body with a solid to reach.";
+
+/// The shim's function of one construction.
+type Construction =
+    fn(&sys::Shape, &sys::RibSpecData, &Interrupt) -> Result<sys::RibData, cxx::Exception>;
+
+/// Builds the rib `spec` asks on `body` by `construction` (section 8.6).
+pub fn rib(
+    body: &Shape,
+    spec: &RibSpec,
+    construction: RibConstruction,
+    interrupt: &Interrupt,
+) -> Result<RibResult, KernelError> {
+    match construction {
+        RibConstruction::LinearForm { sliding } => rib_linear_form(body, spec, sliding, interrupt),
+        RibConstruction::ThickenedPrism => rib_thickened(body, spec, interrupt),
+    }
+}
+
+/// Builds the rib with `BRepFeat_MakeLinearForm`, fused to the body (section 8.6's construction
+/// (a)).
+pub fn rib_linear_form(
+    body: &Shape,
+    spec: &RibSpec,
+    sliding: bool,
+    interrupt: &Interrupt,
+) -> Result<RibResult, KernelError> {
+    build(body, spec, sliding, sys::rib_linear_form, interrupt)
+}
+
+/// Builds the rib from the profile thickened into a planar face, extruded up to the body with the
+/// split prism of section 8.5 and fused to it (section 8.6's construction (b)).
+pub fn rib_thickened(
+    body: &Shape,
+    spec: &RibSpec,
+    interrupt: &Interrupt,
+) -> Result<RibResult, KernelError> {
+    build(body, spec, false, sys::rib_thickened, interrupt)
+}
+
+/// Checks the rib's values (section 3.1 items 4 to 6) and returns their bridge form, with the
+/// profile's points in model space.
+fn spec_data(
+    operation: Operation,
+    body: &Shape,
+    spec: &RibSpec,
+    sliding: bool,
+) -> Result<sys::RibSpecData, KernelError> {
+    let frame = spec.plane.frame(operation)?;
+    let coordinates: Vec<f64> = spec
+        .profile
+        .iter()
+        .flat_map(|point| [point.x, point.y])
+        .chain([spec.thickness])
+        .collect();
+    check_finite(operation, &coordinates)?;
+    if spec.profile.len() < 2 {
+        return Err(KernelError::invalid_input(operation, FEW_POINTS_MESSAGE));
+    }
+    if spec
+        .profile
+        .windows(2)
+        .any(|pair| !is_positive_length(pair[0].distance(pair[1])))
+    {
+        return Err(KernelError::invalid_input(operation, SAME_POINTS_MESSAGE));
+    }
+    if !is_positive_length(spec.thickness) {
+        return Err(KernelError::invalid_input(operation, THICKNESS_MESSAGE));
+    }
+    if body.count(SubShapeKind::Solid) == 0 {
+        return Err(KernelError::invalid_input(operation, NO_SOLID_MESSAGE));
+    }
+    Ok(sys::RibSpecData {
+        plane: frame.to_ffi(),
+        points: spec
+            .profile
+            .iter()
+            .map(|point| spec.plane.to_world(*point).to_ffi())
+            .collect(),
+        thickness: spec.thickness,
+        sliding,
+    })
+}
+
+/// Checks the rib's values and runs `construction` on them. Each construction's function names
+/// only its own shim function, so a build that calls one construction links no other.
+fn build(
+    body: &Shape,
+    spec: &RibSpec,
+    sliding: bool,
+    construction: Construction,
+    interrupt: &Interrupt,
+) -> Result<RibResult, KernelError> {
+    let operation = Operation::Rib;
+    let data = spec_data(operation, body, spec, sliding)?;
+    let result = call(operation, || construction(body.inner(), &data, interrupt))?;
+    Ok(RibResult {
+        shape: Shape::from_ffi(operation, result.shape)?,
+        construction: Shape::from_ffi(operation, result.construction)?,
+        profile: Shape::from_ffi(operation, result.profile)?,
+        history: history_from_ffi(operation, result.inputs)?,
+        sides: result.sides,
+        validity: Validity::from_ffi(operation, result.validity)?,
+        construction_validity: Validity::from_ffi(operation, result.construction_validity)?,
+        polls: PollRecord::from_ffi(result.polls),
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::make_box;
+
+    fn spec(profile: &[(f64, f64)], thickness: f64) -> RibSpec {
+        RibSpec {
+            plane: Plane::XZ,
+            profile: profile.iter().map(|&(x, y)| Point2 { x, y }).collect(),
+            thickness,
+        }
+    }
+
+    fn message(body: &Shape, spec: &RibSpec) -> String {
+        rib_thickened(body, spec, &Interrupt::new())
+            .expect_err("the rib is refused")
+            .message
+    }
+
+    fn block() -> Shape {
+        make_box(&Plane::XY, 10.0, 10.0, 10.0)
+            .expect("the block builds")
+            .shape
+    }
+
+    #[test]
+    fn a_profile_needs_two_points() {
+        assert_eq!(
+            message(&block(), &spec(&[(1.0, 1.0)], 1.0)),
+            FEW_POINTS_MESSAGE
+        );
+    }
+
+    #[test]
+    fn points_in_a_row_differ() {
+        let repeated = spec(&[(1.0, 1.0), (1.0, 1.0), (5.0, 5.0)], 1.0);
+        assert_eq!(message(&block(), &repeated), SAME_POINTS_MESSAGE);
+    }
+
+    #[test]
+    fn a_rib_has_a_thickness() {
+        let flat = spec(&[(1.0, 1.0), (5.0, 5.0)], 0.0);
+        assert_eq!(message(&block(), &flat), THICKNESS_MESSAGE);
+    }
+
+    #[test]
+    fn a_rib_reaches_a_solid() {
+        let diagonal = spec(&[(1.0, 1.0), (5.0, 5.0)], 1.0);
+        assert_eq!(message(&Shape::empty(), &diagonal), NO_SOLID_MESSAGE);
+    }
+
+    #[test]
+    fn values_are_finite() {
+        let infinite = spec(&[(1.0, 1.0), (f64::INFINITY, 5.0)], 1.0);
+        assert_eq!(
+            message(&block(), &infinite),
+            "A value is not a finite number."
+        );
+    }
+}
