+namespace {
+
+// Points of a face: its vertices, kEdgeSamples points inside each edge's range, and the centers
+// of a kGridSamples by kGridSamples grid over its parameters that lie inside it.
+std::vector<gp_Pnt> sample_points(const TopoDS_Face &face) {
+  std::vector<gp_Pnt> points;
+  TopTools_IndexedMapOfShape vertices;
+  TopExp::MapShapes(face, TopAbs_VERTEX, vertices);
+  for (int index = 1; index <= vertices.Extent(); ++index) {
+    points.push_back(BRep_Tool::Pnt(TopoDS::Vertex(vertices(index))));
+  }
+  TopTools_IndexedMapOfShape edges;
+  TopExp::MapShapes(face, TopAbs_EDGE, edges);
+  for (int index = 1; index <= edges.Extent(); ++index) {
+    const TopoDS_Edge &edge = TopoDS::Edge(edges(index));
+    if (BRep_Tool::Degenerated(edge)) {
+      continue;
+    }
+    const BRepAdaptor_Curve curve(edge);
+    const double first = curve.FirstParameter();
+    const double step = (curve.LastParameter() - first) / kEdgeSamples;
+    for (int sample = 0; sample < kEdgeSamples; ++sample) {
+      points.push_back(curve.Value(first + (sample + 0.5) * step));
+    }
+  }
+  const BRepAdaptor_Surface surface(face);
+  const double u_step = (surface.LastUParameter() - surface.FirstUParameter()) / kGridSamples;
+  const double v_step = (surface.LastVParameter() - surface.FirstVParameter()) / kGridSamples;
+  for (int column = 0; column < kGridSamples; ++column) {
+    for (int row = 0; row < kGridSamples; ++row) {
+      const gp_Pnt2d parameters(surface.FirstUParameter() + (column + 0.5) * u_step,
+                                surface.FirstVParameter() + (row + 0.5) * v_step);
+      const BRepClass_FaceClassifier inside(face, parameters, kLinear);
+      if (inside.State() == TopAbs_IN) {
+        points.push_back(surface.Value(parameters.X(), parameters.Y()));
+      }
+    }
+  }
+  return points;
+}
+
+// Raises Partsmith_InvalidInput when a point of an end face lies outside `target`, face `index`
+// of the body: the profile reaches the face only in part (gate 7's newcomer mistake).
+void require_within(const TopTools_ListOfShape &end, const TopoDS_Face &target,
+                    std::uint32_t index, Polls &polls) {
+  polls.before("BRepClass_FaceClassifier");
+  for (const TopoDS_Shape &face : end) {
+    for (const gp_Pnt &point : sample_points(TopoDS::Face(face))) {
+      const BRepClass_FaceClassifier classifier(target, point, kLinear);
+      if (classifier.State() == TopAbs_OUT) {
+        raise_invalid_input("Only part of the profile reaches face " + std::to_string(index) +
+                            ", so the extrude cannot end on it.");
+      }
+    }
+  }
+}
+
+}  // namespace
+
+// Checks a whole shape and repairs it when it is not valid, as section 3.5 does, recording which.
+ValidityType detail::check_and_repair(TopoDS_Shape &shape,
+                                      const Handle(BRepTools_History) &history, Polls &polls) {
+  polls.before("BRepCheck_Analyzer");
+  if (BRepCheck_Analyzer(shape).IsValid()) {
+    return ValidityType::AsBuilt;
+  }
+  return repair(shape, history, polls) ? ValidityType::AfterRepair : ValidityType::Invalid;
+}
+
+namespace {
+
+// What `spec` reaches on the copy of the body: its face, or the whole body.
+TopoDS_Shape until_of(const Shape &body, const ExtentSpecData &spec) {
+  return spec.end == ExtentEndType::UpToFace ? element_at(body, ElementKind::Face, spec.face)
+                                             : body.get();
+}
+
+// The length of a prism of `profile` that `spec` asks: its length, or through the body.
+double length_of(const TopoDS_Face &profile, const Shape *body, const ExtentSpecData &spec) {
+  return body == nullptr ? spec.length
+                         : through_length(profile, body->get(), to_direction(spec.direction));
+}
+
+// Ends a prism that passes through the body as `spec` asks: on the face's surface (split at a
+// face on it that cuts the whole prism), or on the first faces of the body it meets.
+void end_at(Built &built, const Shape &body, const ExtentSpecData &spec, Polls &polls) {
+  if (spec.end == ExtentEndType::UpToFace) {
+    polls.before("BRepBuilderAPI_MakeFace");
+    split_at(built, cutting_face(TopoDS::Face(until_of(body, spec)), built.shape), polls);
+  } else {
+    up_to_body(built, body.get(), polls);
+  }
+}
+
+// The element kind of an edge or a vertex.
+ElementKind cap_kind(const TopoDS_Shape &element) {
+  return element.ShapeType() == TopAbs_EDGE ? ElementKind::Edge : ElementKind::Vertex;
+}
+
+// The caps of `built` whose images are elements of `result`, with the index of their input in
+// `profile`, sorted.
+rust::Vec<CapData> cap_data(const Built &built, const Shape &profile, const Shape &result) {
+  std::vector<std::tuple<bool, std::uint8_t, std::uint32_t, std::uint32_t>> found;
+  for (const Cap &cap : built.caps) {
+    if (cap.element.IsNull()) {
+      continue;
+    }
+    const ElementKind kind = cap_kind(cap.input);
+    const int input = profile.map(kind).FindIndex(cap.input);
+    for (const TopoDS_Shape &image : images_of(cap.element, built.history)) {
+      const int index = result.map(kind).FindIndex(image);
+      if (index > 0 && input > 0) {
+        found.emplace_back(cap.end, static_cast<std::uint8_t>(kind),
+                           static_cast<std::uint32_t>(index),
+                           static_cast<std::uint32_t>(input));
+      }
+    }
+  }
+  std::sort(found.begin(), found.end());
+  found.erase(std::unique(found.begin(), found.end()), found.end());
+  rust::Vec<CapData> caps;
+  for (const auto &[end, kind, index, input] : found) {
+    const auto element_kind = static_cast<ElementKind>(kind);
+    caps.push_back(CapData{SubShapeData{element_kind, index}, SubShapeData{element_kind, input},
+                           end});
+  }
+  return caps;
+}
+
+// The end faces of `built` that are faces of its shape.
+TopTools_ListOfShape end_faces(const Built &built) {
+  TopTools_IndexedMapOfShape faces;
+  TopExp::MapShapes(built.shape, TopAbs_FACE, faces);
+  TopTools_ListOfShape end;
+  for (const TopoDS_Shape &named : built.end) {
+    for (const TopoDS_Shape &image : images_of(named, built.history)) {
+      if (faces.Contains(image)) {
+        end.Append(image);
+      }
+    }
+  }
+  return end;
+}
+
+// Builds the extent `construct` makes from the copies of the profile's face and of the body
+// (null for a prism of a length), checks that its end lies within the face it reaches, checks and
+// repairs it, and returns it with its history, its named faces and caps, and its polls.
+template <class Construct>
+ExtentData extent(const Shape &profile, const Shape &body, const ExtentSpecData &spec,
+                  const Interrupt &interrupt, Construct &&construct) {
+  const Handle(PollRecorder) recorder = new PollRecorder(interrupt);
+  Polls polls{Handle(Interruption)(recorder)};
+  // The builders run on copies, so they never write to the inputs (kernel spec section 3.1). A
+  // copy has its input's indices, so the history of a copy is the input's.
+  polls.before("BRepBuilderAPI_Copy");
+  const Shape profile_copy = copy_elements(profile);
+  std::vector<TopoDS_Shape> inputs{profile_copy.get()};
+  std::optional<Shape> body_copy;
+  if (spec.end != ExtentEndType::Length) {
+    polls.before("BRepBuilderAPI_Copy");
+    body_copy.emplace(copy_elements(body));
+    inputs.push_back(body_copy->get());
+  }
+  Built built = construct(profile_face(profile_copy.get()), body_copy ? &*body_copy : nullptr,
+                          polls);
+  if (spec.end == ExtentEndType::UpToFace) {
+    const TopoDS_Face target = TopoDS::Face(until_of(*body_copy, spec));
+    require_within(end_faces(built), target, spec.face, polls);
+  }
+  const ValidityType validity = check_and_repair(built.shape, built.history, polls);
+  polls.before("BRepTools_History");
+  const std::shared_ptr<Shape> result = make_shape(built.shape);
+  rust::Vec<InputHistoryData> history = history_data(built.history, inputs, *result);
+  rust::Vec<std::uint32_t> start = face_indices(built.start, built.history, result->faces());
+  rust::Vec<std::uint32_t> end = face_indices(built.end, built.history, result->faces());
+  rust::Vec<CapData> caps = cap_data(built, profile_copy, *result);
+  return ExtentData{result,   std::move(history), std::move(start), std::move(end),
+                    std::move(caps), validity,     recorder->data()};
+}
+
+}  // namespace
+
+ExtentData extrude_feature(const Shape &profile, const Shape &body, const ExtentSpecData &spec,
+                           const Interrupt &interrupt) {
+  return extent(profile, body, spec, interrupt,
+                [&](const TopoDS_Face &face, const Shape *reached, Polls &polls) {
+                  const TopoDS_Shape basis = reached == nullptr ? TopoDS_Shape() : reached->get();
+                  const TopoDS_Shape until =
+                      reached == nullptr ? TopoDS_Shape() : until_of(*reached, spec);
+                  return make_feature(face, basis, spec.basis == FeatureBasisType::Body,
+                                      to_direction(spec.direction), until, spec.length,
+                                      spec.taper, polls);
+                });
+}
+
+ExtentData extrude_split(const Shape &profile, const Shape &body, const ExtentSpecData &spec,
+                         const Interrupt &interrupt) {
+  return extent(profile, body, spec, interrupt,
+                [&](const TopoDS_Face &face, const Shape *reached, Polls &polls) {
+                  if (reached == nullptr) {
+                    raise_invalid_input("The split prism needs a face or a body to reach.");
+                  }
+                  const gp_Vec along =
+                      gp_Vec(to_direction(spec.direction)) * length_of(face, reached, spec);
+                  Built built = make_prism(face, along, polls);
+                  end_at(built, *reached, spec, polls);
+                  return built;
+                });
+}
+
+ExtentData extrude_drafted(const Shape &profile, const Shape &body, const ExtentSpecData &spec,
+                           const Interrupt &interrupt) {
+  return extent(profile, body, spec, interrupt,
+                [&](const TopoDS_Face &face, const Shape *reached, Polls &polls) {
+                  Built built = make_drafted(face, to_direction(spec.direction),
+                                             length_of(face, reached, spec), spec.taper, polls);
+                  if (reached != nullptr) {
+                    end_at(built, *reached, spec, polls);
+                  }
+                  return built;
+                });
+}
+
+ExtentData extrude_lofted(const Shape &profile, const Shape &body, const ExtentSpecData &spec,
+                          const Interrupt &interrupt) {
+  return extent(profile, body, spec, interrupt,
+                [&](const TopoDS_Face &face, const Shape *reached, Polls &polls) {
+                  Built built = make_lofted(face, to_direction(spec.direction),
+                                            length_of(face, reached, spec), spec.taper, polls);
+                  if (reached != nullptr) {
+                    end_at(built, *reached, spec, polls);
+                  }
+                  return built;
+                });
+}
+
+double surface_distance(const Shape &shape, std::uint32_t face, const Shape &target,
+                        std::uint32_t target_face) {
+  const TopoDS_Face &sampled = TopoDS::Face(element_at(shape, ElementKind::Face, face));
+  const TopoDS_Face &reference =
+      TopoDS::Face(element_at(target, ElementKind::Face, target_face));
+  Handle(Geom_Surface) surface = BRep_Tool::Surface(reference);
+  const Handle(Geom_RectangularTrimmedSurface) trimmed =
+      Handle(Geom_RectangularTrimmedSurface)::DownCast(surface);
+  if (!trimmed.IsNull()) {
+    surface = trimmed->BasisSurface();
+  }
+  double largest = 0.0;
+  for (const gp_Pnt &point : sample_points(sampled)) {
+    const GeomAPI_ProjectPointOnSurf projection(point, surface);
+    if (projection.NbPoints() == 0) {
+      raise_not_done("GeomAPI_ProjectPointOnSurf found no point of face " +
+                     std::to_string(target_face) + " near a point of face " +
+                     std::to_string(face));
+    }
+    largest = std::max(largest, projection.LowerDistance());
+  }
+  return largest;
+}
+
+}  // namespace occt
+}  // namespace partsmith
diff --git a/crates/partsmith-occt-sys/cpp/rib.cpp b/crates/partsmith-occt-sys/cpp/rib.cpp
new file mode 100644
index 0000000..7a34ee6
--- /dev/null
+++ b/crates/partsmith-occt-sys/cpp/rib.cpp
@@ -0,0 +1,394 @@
+// The ribs of the rib spike (kernel spec section 8.6): an open profile in a plane, thickened by
+// half the rib's thickness to each side of the plane and reaching the body, by each construction
+// the spike compares. (a) BRepFeat_MakeLinearForm with the open wire, its plane and the two
+// thickness directions. (b) The profile thickened into a planar face (BRepOffsetAPI_MakeOffset of
+// the open wire with IsOpenResult true, by half the thickness to each side, join
+// GeomAbs_Intersection), extruded up to the body with the split prism of the prism-extents spike
+// (`up_to_body`, section 8.5) and fused to it with the settings of section 3.4.5. Both put the
+// rib's material on BRepFeat_MakeLinearForm's side of the profile: the plane's normal crossed
+// with the profile's direction. The spikes' indicator records when each call is polled (section
+// 8.1 item 4).
+#include <algorithm>
+#include <mutex>
+#include <string>
+#include <vector>
+
+#include <BRepBuilderAPI_MakeEdge.hxx>
+#include <BRepBuilderAPI_MakeFace.hxx>
+#include <BRepBuilderAPI_MakePolygon.hxx>
+#include <BRepBuilderAPI_MakeWire.hxx>
+#include <BRepFeat_MakeLinearForm.hxx>
+#include <BRepOffsetAPI_MakeOffset.hxx>
+#include <BRep_Tool.hxx>
+#include <Geom_Plane.hxx>
+#include <TopExp.hxx>
+#include <TopExp_Explorer.hxx>
+#include <TopTools_IndexedMapOfShape.hxx>
+#include <TopoDS.hxx>
+#include <TopoDS_Vertex.hxx>
+#include <TopoDS_Wire.hxx>
+#include <gp_Lin.hxx>
+#include <gp_Pln.hxx>
+
+#include "partsmith-occt-sys/cpp/internal.h"
+
+namespace partsmith {
+namespace occt {
+
+using namespace detail;
+
+namespace {
+
+// The profile as an open wire of lines, one between each two points in a row.
+TopoDS_Wire profile_wire(const RibSpecData &spec) {
+  BRepBuilderAPI_MakePolygon polygon;
+  for (const Vec3 &point : spec.points) {
+    polygon.Add(to_point(point));
+  }
+  if (!polygon.IsDone()) {
+    raise_not_done("BRepBuilderAPI_MakePolygon could not join the points of the rib's profile");
+  }
+  return polygon.Wire();
+}
+
+// True when every point of the profile lies on the line through its first and last points.
+bool is_straight(const RibSpecData &spec) {
+  const gp_Pnt first = to_point(spec.points.front());
+  const gp_Lin line(first, gp_Vec(first, to_point(spec.points.back())));
+  return std::all_of(spec.points.begin(), spec.points.end(), [&](const Vec3 &point) {
+    return line.Distance(to_point(point)) <= kLinear;
+  });
+}
+
+// The faces of `shape` among `named`, as 1-based indices, ascending and once each.
+rust::Vec<std::uint32_t> faces_among(const TopoDS_Shape &shape,
+                                     const TopTools_ListOfShape &named) {
+  TopTools_IndexedMapOfShape faces;
+  TopExp::MapShapes(shape, TopAbs_FACE, faces);
+  std::vector<std::uint32_t> indices;
+  for (const TopoDS_Shape &face : named) {
+    const int index = faces.FindIndex(face);
+    if (index > 0) {
+      indices.push_back(static_cast<std::uint32_t>(index));
+    }
+  }
+  std::sort(indices.begin(), indices.end());
+  indices.erase(std::unique(indices.begin(), indices.end()), indices.end());
+  rust::Vec<std::uint32_t> result;
+  for (const std::uint32_t index : indices) {
+    result.push_back(index);
+  }
+  return result;
+}
+
+// The profile thickened into a planar face: the face, the history that names its parts from the
+// profile's edges and vertices, and its edges along the profile on each side, from which the
+// prism sweeps the rib's sides.
+struct Thickened {
+  TopoDS_Face face;
+  Handle(BRepTools_History) history = new BRepTools_History;
+  TopTools_ListOfShape sides;
+};
+
+// The offset to one side by `distance` of the open profile that `spine` holds
+// (BRepOffsetAPI_MakeOffset with IsOpenResult true and join GeomAbs_Intersection), in the plane of
+// `spine`. Records the edges and vertices each profile element generated in `thickened`.
+TopoDS_Wire offset_side(const TopoDS_Face &spine, double distance, Thickened &thickened,
+                        Polls &polls) {
+  BRepOffsetAPI_MakeOffset offset(spine, GeomAbs_Intersection, Standard_True);
+  // Perform takes no progress range.
+  polls.before("BRepOffsetAPI_MakeOffset");
+  offset.Perform(distance);
+  if (!offset.IsDone()) {
+    raise_not_done("BRepOffsetAPI_MakeOffset could not offset the rib's profile by " +
+                   std::to_string(distance) + " mm");
+  }
+  TopExp_Explorer wires(offset.Shape(), TopAbs_WIRE);
+  if (!wires.More()) {
+    raise_not_done("BRepOffsetAPI_MakeOffset gave the rib's profile no offset wire");
+  }
+  const TopoDS_Wire side = TopoDS::Wire(wires.Current());
+  wires.Next();
+  if (wires.More()) {
+    raise_not_done("BRepOffsetAPI_MakeOffset gave the rib's profile several offset wires");
+  }
+  for (const TopAbs_ShapeEnum type : {TopAbs_EDGE, TopAbs_VERTEX}) {
+    TopTools_IndexedMapOfShape elements;
+    TopExp::MapShapes(spine, type, elements);
+    for (int index = 1; index <= elements.Extent(); ++index) {
+      for (const TopoDS_Shape &image : offset.Generated(elements(index))) {
+        thickened.history->AddGenerated(elements(index), image);
+      }
+    }
+  }
+  for (TopExp_Explorer edges(side, TopAbs_EDGE); edges.More(); edges.Next()) {
+    thickened.sides.Append(edges.Current());
+  }
+  return side;
+}
+
+// The end of the open wire `side` nearest to `point`.
+TopoDS_Vertex end_near(const TopoDS_Wire &side, const gp_Pnt &point) {
+  TopoDS_Vertex first;
+  TopoDS_Vertex last;
+  TopExp::Vertices(side, first, last);
+  return BRep_Tool::Pnt(first).Distance(point) <= BRep_Tool::Pnt(last).Distance(point) ? first
+                                                                                       : last;
+}
+
+// The profile thickened by `half` to each side into a planar face on `plane`: the two offsets of
+// the profile in `plane`, joined at each end of the profile by a line through that end. Each
+// profile edge generates the face, each end vertex the line and the corners at its end.
+Thickened thicken(const TopoDS_Wire &wire, const gp_Pln &plane, double half, Polls &polls) {
+  Thickened thickened;
+  // BRepOffsetAPI_MakeOffset reads the side of an offset from the sign of its distance relative
+  // to the wire of its face, so the face on `plane` holds the profile, as the face it makes
+  // through a wire alone does.
+  polls.before("BRepBuilderAPI_MakeFace");
+  const TopoDS_Face spine = BRepBuilderAPI_MakeFace(plane, wire, Standard_False).Face();
+  const TopoDS_Wire first_side = offset_side(spine, half, thickened, polls);
+  const TopoDS_Wire second_side = offset_side(spine, -half, thickened, polls);
+  polls.before("BRepBuilderAPI_MakeWire");
+  TopoDS_Vertex ends[2];
+  TopExp::Vertices(wire, ends[0], ends[1]);
+  BRepBuilderAPI_MakeWire outline;
+  outline.Add(first_side);
+  for (const TopoDS_Vertex &end : ends) {
+    const gp_Pnt point = BRep_Tool::Pnt(end);
+    const TopoDS_Vertex first_corner = end_near(first_side, point);
+    const TopoDS_Vertex second_corner = end_near(second_side, point);
+    BRepBuilderAPI_MakeEdge line(first_corner, second_corner);
+    if (!line.IsDone()) {
+      raise_not_done("BRepBuilderAPI_MakeEdge could not join the offsets at an end of the profile");
+    }
+    const TopoDS_Edge closing = line.Edge();
+    for (const TopoDS_Shape &part :
+         {TopoDS_Shape(closing), TopoDS_Shape(first_corner), TopoDS_Shape(second_corner)}) {
+      thickened.history->AddGenerated(end, part);
+    }
+    outline.Add(closing);
+    if (end.IsSame(ends[0])) {
+      outline.Add(second_side);
+    }
+  }
+  if (!outline.IsDone()) {
+    raise_not_done("BRepBuilderAPI_MakeWire could not close the thickened profile");
+  }
+  polls.before("BRepBuilderAPI_MakeFace");
+  BRepBuilderAPI_MakeFace face(plane, outline.Wire(), Standard_True);
+  if (!face.IsDone()) {
+    raise_not_done("BRepBuilderAPI_MakeFace could not bound the thickened profile");
+  }
+  thickened.face = face.Face();
+  for (TopExp_Explorer edges(wire, TopAbs_EDGE); edges.More(); edges.Next()) {
+    thickened.history->AddGenerated(edges.Current(), thickened.face);
+  }
+  return thickened;
+}
+
+// The images of `element` in `history`: its Modified images, or itself when the history keeps
+// it.
+TopTools_ListOfShape images_in(const Handle(BRepTools_History) &history,
+                               const TopoDS_Shape &element) {
+  TopTools_ListOfShape images = history->Modified(element);
+  if (images.IsEmpty() && !history->IsRemoved(element)) {
+    images.Append(element);
+  }
+  return images;
+}
+
+// Records the images of the prism's start cap, BRepPrimAPI_MakePrism's copy of `profile`, as
+// modified from the profile's face, edges and vertices, so the history names the cap from the
+// profile. It runs after the split, whose history keeps the cap's own images only while nothing
+// names the cap.
+void name_start(Built &prism, const TopoDS_Face &profile) {
+  for (const TopoDS_Shape &start : prism.start) {
+    for (const TopoDS_Shape &image : images_in(prism.history, start)) {
+      prism.history->AddModified(profile, image);
+    }
+  }
+  for (const Cap &cap : prism.caps) {
+    if (!cap.end && !cap.element.IsNull()) {
+      for (const TopoDS_Shape &image : images_in(prism.history, cap.element)) {
+        prism.history->AddModified(cap.input, image);
+      }
+    }
+  }
+}
+
+// The history of BRepFeat_MakeLinearForm for the elements of `arguments`, from its Modified and
+// Generated. Its IsDeleted reads a map that holds only some elements and throws for the others,
+// so it is not asked: an element with no image that is not in the result is deleted (kernel
+// spec section 3.3).
+Handle(BRepTools_History) form_history(const std::vector<TopoDS_Shape> &arguments,
+                                       BRepFeat_MakeLinearForm &form) {
+  Handle(BRepTools_History) history = new BRepTools_History;
+  for (const TopoDS_Shape &argument : arguments) {
+    for (const TopAbs_ShapeEnum type : {TopAbs_FACE, TopAbs_EDGE, TopAbs_VERTEX}) {
+      TopTools_IndexedMapOfShape elements;
+      TopExp::MapShapes(argument, type, elements);
+      for (int index = 1; index <= elements.Extent(); ++index) {
+        for (const TopoDS_Shape &image : form.Modified(elements(index))) {
+          history->AddModified(elements(index), image);
+        }
+        for (const TopoDS_Shape &image : form.Generated(elements(index))) {
+          history->AddGenerated(elements(index), image);
+        }
+      }
+    }
+  }
+  return history;
+}
+
+// Raises StdFail_NotDone with the status of BRepFeat_MakeLinearForm when `step` failed.
+void require_form_done(const BRepFeat_MakeLinearForm &form, const char *step) {
+  if (!form.IsDone()) {
+    raise_not_done(std::string(step) + " failed: " + status_name(form.CurrentStatusError()));
+  }
+}
+
+// Serializes BRepFeat_MakeLinearForm builds, as the blends are (kernel spec section 3.10 item 5).
+// BRepFeat_RibSlot::Modified and Generated clear, fill and return one function-static list
+// (`static TopTools_ListOfShape list;` in BRepFeat_RibSlot.cxx), so ribs built on several threads
+// at once freed each other's list nodes and corrupted the heap.
+std::mutex &linear_form_mutex() {
+  static std::mutex mutex;
+  return mutex;
+}
+
+// A rib as BRepFeat_MakeLinearForm built it: the body with the rib, the history of the profile
+// and the body, and the rib's two sides.
+struct BuiltForm {
+  TopoDS_Shape shape;
+  Handle(BRepTools_History) history;
+  TopTools_ListOfShape sides;
+};
+
+// Builds the rib `spec` asks on `body` from the profile `wire` with BRepFeat_MakeLinearForm.
+// Everything that touches the builder, from creating it to reading its history and sides, holds
+// `linear_form_mutex`. The poll before Init comes right after the call takes the mutex.
+BuiltForm build_form(const TopoDS_Shape &body, const TopoDS_Wire &wire, const RibSpecData &spec,
+                     Polls &polls) {
+  const std::lock_guard<std::mutex> lock(linear_form_mutex());
+  // Neither Init nor Perform takes a progress range.
+  polls.before("BRepFeat_MakeLinearForm::Init");
+  const gp_Ax3 frame = to_ax3(spec.plane);
+  const gp_Vec across = gp_Vec(frame.Direction()) * (spec.thickness / 2.0);
+  BRepFeat_MakeLinearForm form;
+  form.Init(body, wire, new Geom_Plane(frame), across, across.Reversed(), 1, spec.sliding);
+  require_form_done(form, "BRepFeat_MakeLinearForm::Init");
+  polls.before("BRepFeat_MakeLinearForm::Perform");
+  form.Perform();
+  require_form_done(form, "BRepFeat_MakeLinearForm::Perform");
+  polls.before("BRepFeat_MakeLinearForm::Modified");
+  BuiltForm built{form.Shape(), form_history({wire, body}, form), {}};
+  // The rib's two sides are the builder's first and last shapes. Each is recorded as its own
+  // image, so a repair carries it to its repaired face.
+  for (const TopTools_ListOfShape *named : {&form.FirstShape(), &form.LastShape()}) {
+    for (const TopoDS_Shape &side : *named) {
+      built.history->AddModified(side, side);
+      built.sides.Append(side);
+    }
+  }
+  return built;
+}
+
+// The data of a rib: the result and the construction, the profile, the history of the profile
+// and the body relative to the result, the result's faces among `sides`, both checks and the
+// polls.
+RibData rib_data(const TopoDS_Shape &shape, const TopoDS_Shape &construction,
+                 const TopoDS_Wire &wire, const Handle(BRepTools_History) &history,
+                 const std::vector<TopoDS_Shape> &inputs, const TopTools_ListOfShape &sides,
+                 ValidityType validity, ValidityType construction_validity,
+                 const PollRecorder &recorder, Polls &polls) {
+  polls.before("BRepTools_History");
+  const std::shared_ptr<Shape> result = make_shape(shape);
+  rust::Vec<InputHistoryData> history_lists = history_data(history, inputs, *result);
+  return RibData{result,
+                 make_shape(construction),
+                 make_shape(wire),
+                 std::move(history_lists),
+                 faces_among(shape, sides),
+                 validity,
+                 construction_validity,
+                 recorder.data()};
+}
+
+}  // namespace
+
+RibData rib_linear_form(const Shape &body, const RibSpecData &spec, const Interrupt &interrupt) {
+  const Handle(PollRecorder) recorder = new PollRecorder(interrupt);
+  Polls polls{Handle(Interruption)(recorder)};
+  // The builder runs on a copy of the body, so it never writes to the input (kernel spec section
+  // 3.1). A copy has its input's indices, so the history of the copy is the input's.
+  polls.before("BRepBuilderAPI_Copy");
+  const Shape body_copy = copy_elements(body);
+  polls.before("BRepBuilderAPI_MakePolygon");
+  const TopoDS_Wire wire = profile_wire(spec);
+  BuiltForm built = build_form(body_copy.get(), wire, spec, polls);
+  const ValidityType validity = check_and_repair(built.shape, built.history, polls);
+  TopTools_ListOfShape side_images;
+  for (const TopoDS_Shape &side : built.sides) {
+    for (const TopoDS_Shape &image : built.history->Modified(side)) {
+      side_images.Append(image);
+    }
+  }
+  const std::vector<TopoDS_Shape> inputs{wire, body_copy.get()};
+  return rib_data(built.shape, built.shape, wire, built.history, inputs, side_images, validity,
+                  validity, *recorder, polls);
+}
+
+RibData rib_thickened(const Shape &body, const RibSpecData &spec, const Interrupt &interrupt) {
+  const Handle(PollRecorder) recorder = new PollRecorder(interrupt);
+  Polls polls{Handle(Interruption)(recorder)};
+  // The prism, its split and the fuse run on a copy of the body (kernel spec section 3.1).
+  polls.before("BRepBuilderAPI_Copy");
+  const Shape body_copy = copy_elements(body);
+  polls.before("BRepBuilderAPI_MakePolygon");
+  const TopoDS_Wire wire = profile_wire(spec);
+  const gp_Ax3 frame = to_ax3(spec.plane);
+  // A straight profile thickens in the plane through it that holds the profile plane's normal,
+  // so the rib's sides lie at half the thickness from the profile's plane, and the rib reaches
+  // the body along that plane's normal, on the side of BRepFeat_MakeLinearForm's material. A
+  // profile that is not straight lies in one plane only, its own: BRepOffsetAPI_MakeOffset
+  // thickens it there, and the rib reaches along the normal of the profile's plane.
+  gp_Dir direction = frame.Direction();
+  gp_Pln strip_plane(frame);
+  if (is_straight(spec)) {
+    const gp_Pnt first = to_point(spec.points.front());
+    const gp_Dir along(gp_Vec(first, to_point(spec.points.back())));
+    direction = frame.Direction().Crossed(along);
+    strip_plane = gp_Pln(first, direction);
+  }
+  const Thickened thickened = thicken(wire, strip_plane, spec.thickness / 2.0, polls);
+  const double length = through_length(thickened.face, body_copy.get(), direction);
+  Built prism = make_prism(thickened.face, gp_Vec(direction) * length, polls);
+  up_to_body(prism, body_copy.get(), polls);
+  polls.before("BRepTools_History::AddModified");
+  name_start(prism, thickened.face);
+  TopoDS_Shape construction = prism.shape;
+  const ValidityType construction_validity =
+      check_and_repair(construction, prism.history, polls);
+  TopTools_ListOfShape tools;
+  tools.Append(construction);
+  TopoDS_Shape shape = solids_only(
+      run_boolean(BOPAlgo_FUSE, body_copy.get(), tools, true, prism.history, polls));
+  const ValidityType validity = check_and_repair(shape, prism.history, polls);
+  // The sides are what the prism swept from the offsets, through the split and the fuse.
+  polls.before("BRepTools_History::Merge");
+  TopTools_ListOfShape sides;
+  for (const TopoDS_Shape &edge : thickened.sides) {
+    for (const TopoDS_Shape &image : prism.history->Generated(edge)) {
+      sides.Append(image);
+    }
+  }
+  Handle(BRepTools_History) history = new BRepTools_History;
+  merge_history(history, thickened.history);
+  merge_history(history, prism.history);
+  const std::vector<TopoDS_Shape> inputs{wire, body_copy.get()};
+  return rib_data(shape, construction, wire, history, inputs, sides, validity,
+                  construction_validity, *recorder, polls);
+}
+
+}  // namespace occt
+}  // namespace partsmith
