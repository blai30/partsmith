 //! The web core module `partsmith_core`: an Emscripten executable whose runtime stays alive after `main` returns, so JavaScript can call `ps_alloc`, `ps_free` and `ps_call` (protocol.md section 2.10, ADR 0009).
 
+use std::hint::black_box;
+
+use partsmith_occt_sys::{
+    Interrupt, Plane, Point, Point2, RibSpec, fuse, make_box, rib_linear_form, rib_thickened,
+};
+
 fn main() {
     // Creating the session here pays its setup cost while the module is instantiated. Calling into the library also keeps it, and with it the three exports, in the link.
     partsmith_wasm::initialize_session();
+    keep_rib_spike();
+}
+
+/// Calls the rib spike's functions on a small input so the linker keeps their code for the size measurement (kernel spec section 8.1 items 2 and 4): each construction once, on an L of two plates 6 x 4 x 1 mm with a rib 0.4 mm thick across their corner.
+fn keep_rib_spike() {
+    let (Ok(horizontal), Ok(vertical)) = (
+        make_box(&Plane::XY, 6.0, 4.0, 1.0),
+        make_box(&Plane::XY, 1.0, 4.0, 6.0),
+    ) else {
+        return;
+    };
+    let interrupt = Interrupt::new();
+    let Ok(bracket) = fuse(&horizontal.shape, &[vertical.shape], &interrupt) else {
+        return;
+    };
+    let spec = RibSpec {
+        plane: Plane {
+            origin: Point::new(0.0, 2.0, 0.0),
+            ..Plane::XZ
+        },
+        profile: vec![Point2 { x: 5.0, y: 1.0 }, Point2 { x: 1.0, y: 5.0 }],
+        thickness: 0.4,
+    };
+    let _ = black_box(rib_linear_form(&bracket.shape, &spec, true, &interrupt));
+    let _ = black_box(rib_thickened(&bracket.shape, &spec, &interrupt));
 }
