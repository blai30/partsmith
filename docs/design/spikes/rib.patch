index 0000000..aa6473f
--- /dev/null
+++ b/crates/partsmith-occt-sys/tests/rib.rs
@@ -0,0 +1,483 @@
+//! The rib spike (kernel spec section 8.6): each construction on each input, measured by the parts
+//! of section 8.1 item 4 that run as tests. The criterion of section 8.6's Pass that runs here,
+//! construction (b) valid wherever (a) is, is pinned as the spike recorded it, with the validity of
+//! each run's construction and result. Parity, time and size are judged from the two targets'
+//! output, the bench and the web core. The closed mesh, the rib's side faces at half the thickness
+//! from the profile's plane and the generators of its faces are measured, not criteria of the
+//! Pass, and printed for the record with the volume of each result next to the one the input
+//! describes, the history of every element and a summary for the native and WebAssembly
+//! comparison. Natively every run is also built on several threads at once and compared with a
+//! run on one thread (section 3.10 item 2).
+
+use std::collections::BTreeMap;
+use std::fmt::Write as _;
+use std::thread;
+
+use partsmith_mesh::{TessellationTolerance, WELD_TOLERANCE};
+use partsmith_occt_sys::{
+    Interrupt, LINEAR_TOLERANCE, PlanarCurve, PlanarLoop, PlanarRegion, Plane, Point2,
+    RibConstruction, RibResult, RibSpec, Shape, SubShape, SubShapeKind, TaggedCurve, Validity,
+    make_profile, rib, surface_distance,
+};
+
+use crate::rib_inputs::{Run, runs};
+
+/// The tolerance of the closed-mesh check: 0.05 mm and 5 degrees (test 138).
+const FINE: TessellationTolerance = TessellationTolerance {
+    chord_deviation: 0.05,
+    angular_deviation: 5.0_f64.to_radians(),
+};
+
+/// How far a side face may lie from the plane at half the thickness from the profile's plane
+/// (section 8.6's Checks, measured and not a criterion of its Pass).
+const SIDE_TOLERANCE: f64 = LINEAR_TOLERANCE;
+
+/// What the tests measure of one run that builds.
+struct Measurement {
+    /// The checks of the result and of the construction, and `Shape::is_valid` of each.
+    validity: Validity,
+    is_valid: bool,
+    construction_validity: Validity,
+    construction_is_valid: bool,
+    /// The undirected edges of the welded mesh of the result not used by exactly two triangles.
+    open_edges: usize,
+    /// The faces the construction names as the rib's sides, and for each the largest distance of
+    /// its points from the nearer of the two planes at half the thickness from the profile's
+    /// plane, with the side of that plane (1 or -1).
+    sides: Vec<(u32, f64, i8)>,
+    /// The rib's faces: the faces of the result that no face of the body lists in `modified`.
+    rib_faces: Vec<u32>,
+    /// The rib's faces neither in a profile edge's `generated` list nor named a side.
+    unexplained: Vec<u32>,
+    /// The result's volume, and the one the input describes.
+    volume: f64,
+    expected_volume: f64,
+}
+
+impl Measurement {
+    /// Every measurement, for the record.
+    fn describe(&self) -> String {
+        format!(
+            "{:?} (is_valid {}), construction {:?} (is_valid {}), {} open mesh edges, sides (face, largest distance from its plane in mm, side) {:?}, rib faces {:?}, of which neither generated by a profile edge nor a side {:?}, volume {:?} against {:?} described (relative difference {:?})",
+            self.validity,
+            self.is_valid,
+            self.construction_validity,
+            self.construction_is_valid,
+            self.open_edges,
+            self.sides,
+            self.rib_faces,
+            self.unexplained,
+            self.volume,
+            self.expected_volume,
+            (self.volume - self.expected_volume) / self.expected_volume,
+        )
+    }
+
+    /// Whether the construction and the result are valid as built, by the shim's check and by
+    /// `Shape::is_valid`: what section 8.6's Pass asks of (b) wherever (a) has it.
+    fn valid_as_built(&self) -> bool {
+        self.validity == Validity::AsBuilt
+            && self.is_valid
+            && self.construction_validity == Validity::AsBuilt
+            && self.construction_is_valid
+    }
+
+    /// The checks the run fails: the closed mesh of section 8.1 item 4, and section 8.6's Checks
+    /// of the sides and of the generators of the rib's faces. Measured, not criteria of section
+    /// 8.6's Pass.
+    fn failed_checks(&self) -> Vec<&'static str> {
+        let both_sides = [1, -1]
+            .iter()
+            .all(|side| self.sides.iter().any(|(_, _, named)| named == side));
+        [
+            ("closed", self.open_edges == 0),
+            (
+                "sides",
+                both_sides
+                    && self
+                        .sides
+                        .iter()
+                        .all(|(_, distance, _)| *distance <= SIDE_TOLERANCE),
+            ),
+            (
+                "generated",
+                !self.rib_faces.is_empty() && self.unexplained.is_empty(),
+            ),
+        ]
+        .into_iter()
+        .filter(|(_, passes)| !passes)
+        .map(|(check, _)| check)
+        .collect()
+    }
+}
+
+/// The undirected edges of the shape's mesh at `FINE`, welded with `WELD_TOLERANCE`, that are
+/// not used by exactly two triangles (test 138's check).
+fn open_edges(shape: &Shape) -> usize {
+    let welded = shape
+        .tessellate(&FINE, &Interrupt::new())
+        .expect("the rib tessellates")
+        .weld(WELD_TOLERANCE)
+        .expect("WELD_TOLERANCE is a valid weld tolerance")
+        .mesh;
+    let mut uses = BTreeMap::new();
+    for corners in welded.triangles() {
+        for side in 0..3 {
+            let (start, end) = (corners[side], corners[(side + 1) % 3]);
+            *uses
+                .entry((start.min(end), start.max(end)))
+                .or_insert(0_u32) += 1;
+        }
+    }
+    uses.values().filter(|count| **count != 2).count()
+}
+
+/// Whether face `face` of the result is in the `modified` list of a face of the body (input 1).
+fn from_body(result: &RibResult, face: u32) -> bool {
+    result
+        .history
+        .modified_from(SubShapeKind::Face, face)
+        .iter()
+        .any(|origin| origin.input == 1)
+}
+
+/// Whether face `face` of the result is in the `generated` list of a profile edge (input 0).
+fn generated_by_profile_edge(result: &RibResult, face: u32) -> bool {
+    result
+        .history
+        .generated_from(SubShapeKind::Face, face)
+        .iter()
+        .any(|origin| origin.input == 0 && origin.element.kind == SubShapeKind::Edge)
+}
+
+/// The largest distance of the points of `face` from the plane at half the thickness on the
+/// nearer side of the profile's plane, with that side.
+fn side_distance(run: &Run, result: &RibResult, face: u32) -> (f64, i8) {
+    let half = run.spec.thickness / 2.0;
+    let distance = |offset: f64| {
+        surface_distance(&result.shape, face, &offset_plane(&run.spec, offset), 1)
+            .expect("the side's distance can be measured")
+    };
+    let (positive, negative) = (distance(half), distance(-half));
+    if positive <= negative {
+        (positive, 1)
+    } else {
+        (negative, -1)
+    }
+}
+
+/// The plane at `offset` from the rib's plane along its normal, as the face of a square profile
+/// on it: face 1 of the shape, whose untrimmed surface `surface_distance` measures.
+fn offset_plane(spec: &RibSpec, offset: f64) -> Shape {
+    let normal = spec
+        .plane
+        .normal
+        .normalized()
+        .expect("the rib's plane has a normal");
+    let plane = Plane {
+        origin: spec.plane.origin.offset(normal.scaled(offset)),
+        ..spec.plane
+    };
+    let corners = [(0.0, 0.0), (1.0, 0.0), (1.0, 1.0), (0.0, 1.0)];
+    let point = |corner: usize| {
+        let (x, y) = corners[corner % corners.len()];
+        Point2 { x, y }
+    };
+    let curves = (0..corners.len())
+        .map(|corner| TaggedCurve {
+            tag: u32::try_from(corner + 1).expect("four sides"),
+            curve: PlanarCurve::Line {
+                start: point(corner),
+                end: point(corner + 1),
+            },
+        })
+        .collect();
+    let region = PlanarRegion {
+        outer: PlanarLoop { curves },
+        holes: Vec::new(),
+    };
+    make_profile(&plane, &[region])
+        .expect("the square builds")
+        .shape
+}
+
+/// Measures a run that builds.
+fn measure(run: &Run, result: &RibResult) -> Measurement {
+    let rib_faces: Vec<u32> = (1..=result.shape.count(SubShapeKind::Face))
+        .filter(|face| !from_body(result, *face))
+        .collect();
+    let unexplained = rib_faces
+        .iter()
+        .copied()
+        .filter(|face| !generated_by_profile_edge(result, *face) && !result.sides.contains(face))
+        .collect();
+    let sides = result
+        .sides
+        .iter()
+        .map(|face| {
+            let (distance, side) = side_distance(run, result, *face);
+            (*face, distance, side)
+        })
+        .collect();
+    Measurement {
+        validity: result.validity,
+        is_valid: result.shape.is_valid().expect("the check runs"),
+        construction_validity: result.construction_validity,
+        construction_is_valid: result.construction.is_valid().expect("the check runs"),
+        open_edges: open_edges(&result.shape),
+        sides,
+        rib_faces,
+        unexplained,
+        volume: result.shape.volume().expect("the result has a volume"),
+        expected_volume: run.volume,
+    }
+}
+
+/// Measures a run, adds its line to `report`, and returns its outcome as the pinned table writes
+/// it: `valid` when its construction and result are valid as built, `not valid` when either is
+/// not, or the exception it fails with.
+fn measure_into(report: &mut String, run: &Run) -> String {
+    match rib(&run.body, &run.spec, run.kind, &Interrupt::new()) {
+        Ok(built) => {
+            let measurement = measure(run, &built);
+            writeln!(
+                report,
+                "{} {}: {}; sides {:?}; checks failed, measured and not criteria of the Pass {:?}; native time limit {:?}",
+                run.input,
+                run.construction,
+                measurement.describe(),
+                built.sides,
+                measurement.failed_checks(),
+                run.budget
+            )
+            .expect("a string takes text");
+            if measurement.valid_as_built() {
+                "valid".to_owned()
+            } else {
+                "not valid".to_owned()
+            }
+        }
+        Err(error) => {
+            writeln!(
+                report,
+                "{} {}: {}",
+                run.input,
+                run.construction,
+                error.detail()
+            )
+            .expect("a string takes text");
+            format!("fails {}", error.exception)
+        }
+    }
+}
+
+/// The inputs on which construction (b) is not valid where an option of (a) is, from each run's
+/// input, construction and whether it is valid: the inputs that fail the criterion of section
+/// 8.6's Pass that runs here.
+fn invalid_where_linear_form_is_valid<'input>(
+    runs: &[(&'input str, RibConstruction, bool)],
+) -> Vec<&'input str> {
+    let valid = |input: &str, thickened: bool| {
+        runs.iter().any(|(name, kind, valid)| {
+            *name == input && *valid && (*kind == RibConstruction::ThickenedPrism) == thickened
+        })
+    };
+    let mut inputs: Vec<&str> = runs.iter().map(|(input, _, _)| *input).collect();
+    inputs.dedup();
+    inputs
+        .into_iter()
+        .filter(|input| valid(input, false) && !valid(input, true))
+        .collect()
+}
+
+/// Every run's outcome, as the spike recorded it on 2026-11-15: each construction and result is
+/// valid as built.
+const RECORDED: &[(&str, &str, &str)] = &[
+    ("bracket", "linear-form", "valid"),
+    ("bracket", "linear-form-fixed", "valid"),
+    ("bracket", "thickened", "valid"),
+    ("cylinder", "linear-form", "valid"),
+    ("cylinder", "linear-form-fixed", "valid"),
+    ("cylinder", "thickened", "valid"),
+    ("v", "linear-form", "valid"),
+    ("v", "linear-form-fixed", "valid"),
+    ("v", "thickened", "valid"),
+    ("inside", "linear-form", "valid"),
+    ("inside", "linear-form-fixed", "valid"),
+    ("inside", "thickened", "valid"),
+    ("hole", "linear-form", "valid"),
+    ("hole", "linear-form-fixed", "valid"),
+    ("hole", "thickened", "valid"),
+];
+
+/// The inputs on which (b) is not valid where (a) is, as the spike recorded them: none.
+const RECORDED_INVALID: &[&str] = &[];
+
+#[test]
+fn ribs_meet_the_recorded_outcomes() {
+    let mut report = String::new();
+    let mut outcomes = Vec::new();
+    let mut validity = Vec::new();
+    for run in runs() {
+        let outcome = measure_into(&mut report, &run);
+        validity.push((run.input, run.kind, outcome == "valid"));
+        outcomes.push((run.input, run.construction, outcome));
+    }
+    let invalid = invalid_where_linear_form_is_valid(&validity);
+    println!("{report}");
+    println!("inputs on which (b) is not valid where (a) is: {invalid:?}");
+    let recorded: Vec<(&str, &str, String)> = RECORDED
+        .iter()
+        .map(|(input, construction, outcome)| (*input, *construction, (*outcome).to_owned()))
+        .collect();
+    assert_eq!(outcomes, recorded);
+    assert_eq!(invalid, RECORDED_INVALID);
+}
+
+/// The names OCCT's history gives each face, edge and vertex of a rib, one line per element.
+fn names(result: &RibResult) -> String {
+    let mut text = String::new();
+    for kind in [SubShapeKind::Face, SubShapeKind::Edge, SubShapeKind::Vertex] {
+        for index in 1..=result.shape.count(kind) {
+            let mut parts = Vec::new();
+            if kind == SubShapeKind::Face && result.sides.contains(&index) {
+                parts.push("side".to_owned());
+            }
+            let input_name = |input: usize| if input == 0 { "profile" } else { "body" };
+            for origin in result.history.modified_from(kind, index) {
+                parts.push(format!(
+                    "modified {} {:?} {}",
+                    input_name(origin.input),
+                    origin.element.kind,
+                    origin.element.index
+                ));
+            }
+            for origin in result.history.generated_from(kind, index) {
+                parts.push(format!(
+                    "generated {} {:?} {}",
+                    input_name(origin.input),
+                    origin.element.kind,
+                    origin.element.index
+                ));
+            }
+            let element = SubShape { kind, index };
+            writeln!(
+                text,
+                "  {:?} {}: {}",
+                element.kind,
+                element.index,
+                parts.join(", ")
+            )
+            .expect("a string takes text");
+        }
+    }
+    text
+}
+
+#[test]
+fn rib_history_names_for_the_record() {
+    for run in runs() {
+        if let Ok(result) = rib(&run.body, &run.spec, run.kind, &Interrupt::new()) {
+            println!(
+                "history {} {}:\n{}",
+                run.input,
+                run.construction,
+                names(&result)
+            );
+        }
+    }
+}
+
+/// A summary of `shape` as ADR 0042 compares examples: counts, volume, area and bounding box.
+fn summary(shape: &Shape) -> String {
+    let bounds = shape.bounding_box().expect("the shape has bounds");
+    format!(
+        "faces {} edges {} vertices {} volume {:?} area {:?} min {:?} max {:?}",
+        shape.count(SubShapeKind::Face),
+        shape.count(SubShapeKind::Edge),
+        shape.count(SubShapeKind::Vertex),
+        shape.volume().expect("the shape has a volume"),
+        shape.area().expect("the shape has an area"),
+        bounds.min,
+        bounds.max
+    )
+}
+
+#[test]
+fn rib_summaries_for_parity() {
+    for run in runs() {
+        match rib(&run.body, &run.spec, run.kind, &Interrupt::new()) {
+            Ok(result) => println!(
+                "parity {} {}: result {}; construction {}",
+                run.input,
+                run.construction,
+                summary(&result.shape),
+                summary(&result.construction)
+            ),
+            Err(error) => println!(
+                "parity {} {}: fails {}",
+                run.input,
+                run.construction,
+                error.detail()
+            ),
+        }
+    }
+}
+
+/// The threads of the concurrency test, and how many times each builds every run.
+const THREADS: usize = 4;
+const ROUNDS_PER_THREAD: usize = 5;
+
+/// What a run gives, as the concurrency test compares it: the summaries of its result and its
+/// construction, its sides and the names of every element, or its failure.
+fn outcome(run: &Run) -> String {
+    match rib(&run.body, &run.spec, run.kind, &Interrupt::new()) {
+        Ok(result) => format!(
+            "result {}; construction {}; sides {:?}\n{}",
+            summary(&result.shape),
+            summary(&result.construction),
+            result.sides,
+            names(&result)
+        ),
+        Err(error) => format!("fails {}", error.detail()),
+    }
+}
+
+#[test]
+#[cfg_attr(
+    target_os = "emscripten",
+    ignore = "the WebAssembly build has no threads"
+)]
+fn ribs_built_on_every_thread_match_single_threaded_ones() {
+    let runs = runs();
+    let reference: Vec<String> = runs.iter().map(outcome).collect();
+
+    let results: Vec<Vec<String>> = thread::scope(|scope| {
+        let handles: Vec<_> = (0..THREADS)
+            .map(|_| {
+                scope.spawn(|| {
+                    (0..ROUNDS_PER_THREAD)
+                        .flat_map(|_| runs.iter().map(outcome))
+                        .collect()
+                })
+            })
+            .collect();
+        handles
+            .into_iter()
+            .map(|handle| handle.join().expect("the thread finishes"))
+            .collect()
+    });
+
+    for (thread_number, outcomes) in results.iter().enumerate() {
+        for (position, outcome) in outcomes.iter().enumerate() {
+            let run = position % runs.len();
+            assert!(
+                *outcome == reference[run],
+                "{} {} on thread {thread_number}, round {}, differs from the single-threaded run",
+                runs[run].input,
+                runs[run].construction,
+                position / runs.len()
+            );
+        }
+    }
+}
diff --git a/crates/partsmith-occt-sys/tests/rib_inputs.rs b/crates/partsmith-occt-sys/tests/rib_inputs.rs
new file mode 100644
index 0000000..9b32a74
--- /dev/null
+++ b/crates/partsmith-occt-sys/tests/rib_inputs.rs
@@ -0,0 +1,201 @@
+//! The inputs and constructions of the rib spike (kernel spec section 8.6), shared by its tests
+//! and the bench's rows.
+
+use std::f64::consts::PI;
+use std::time::Duration;
+
+use partsmith_occt_sys::{
+    Interrupt, Plane, Point, Point2, RibConstruction, RibSpec, Shape, cut, fuse, make_box,
+    make_cylinder,
+};
+
+/// The thickness of every rib of the spike, as gate 1's bracket has it, in millimeters.
+pub const THICKNESS: f64 = 4.0;
+
+/// The time section 8.6 gives the bracket's rib, natively.
+pub const BRACKET_BUDGET: Duration = Duration::from_millis(50);
+
+/// One construction tried on one input.
+#[derive(Debug, Clone)]
+pub struct Run {
+    /// The input's name.
+    pub input: &'static str,
+    /// The construction's name.
+    pub construction: &'static str,
+    /// The body the rib reaches.
+    pub body: Shape,
+    /// The rib.
+    pub spec: RibSpec,
+    /// The construction.
+    pub kind: RibConstruction,
+    /// The volume of the body with the rib that section 8.6's input describes, in cubic
+    /// millimeters: the body's, plus the region of the profile's plane between the profile and
+    /// the body times the thickness.
+    pub volume: f64,
+    /// The time section 8.6 gives the run natively, if any: its Pass times construction (b) on
+    /// the bracket.
+    pub budget: Option<Duration>,
+}
+
+/// The middle plane of the bracket's plates, y = 20, with its local x along +X and local y along
+/// +Z, so plane coordinates are (x, z).
+fn bracket_middle() -> Plane {
+    Plane {
+        origin: Point::new(0.0, 20.0, 0.0),
+        ..Plane::XZ
+    }
+}
+
+/// The plane of the tube's rib, z = 15, with its local axes along +X and +Y.
+fn tube_middle() -> Plane {
+    Plane {
+        origin: Point::new(0.0, 0.0, 15.0),
+        ..Plane::XY
+    }
+}
+
+/// Gate 1's L-bracket: two plates of 60 x 40 x 5 mm at a right angle, a horizontal one on
+/// `Plane::XY` (x from 0 to 60, z from 0 to 5) and a vertical one (x from 0 to 5, z from 0 to
+/// 60), fused. Its volume is 23,000 mm^3.
+pub fn bracket() -> Shape {
+    let horizontal = make_box(&Plane::XY, 60.0, 40.0, 5.0).expect("the plate builds");
+    let vertical = make_box(&Plane::XY, 5.0, 40.0, 60.0).expect("the plate builds");
+    fuse(&horizontal.shape, &[vertical.shape], &Interrupt::new())
+        .expect("the plates fuse")
+        .shape
+}
+
+/// The bracket with a hole of radius 4 mm through its horizontal plate at (25, 20), under the
+/// middle of the rib.
+pub fn bracket_with_hole() -> Shape {
+    let placement = Plane {
+        origin: Point::new(25.0, 20.0, -1.0),
+        ..Plane::XY
+    };
+    let drill = make_cylinder(&placement, 4.0, 7.0).expect("the drill builds");
+    cut(&bracket(), &[drill.shape], &Interrupt::new())
+        .expect("the hole cuts")
+        .shape
+}
+
+/// A tube of outer radius 20 mm and inner radius 15 mm along Z, 30 mm long.
+pub fn tube() -> Shape {
+    let outer = make_cylinder(&Plane::XY, 20.0, 30.0).expect("the cylinder builds");
+    let inner = make_cylinder(&Plane::XY, 15.0, 30.0).expect("the cylinder builds");
+    cut(&outer.shape, &[inner.shape], &Interrupt::new())
+        .expect("the bore cuts")
+        .shape
+}
+
+/// A point in plane coordinates.
+fn point(x: f64, y: f64) -> Point2 {
+    Point2 { x, y }
+}
+
+/// A rib of the spike's thickness through `profile` on `plane`.
+fn spec(plane: Plane, profile: Vec<Point2>) -> RibSpec {
+    RibSpec {
+        plane,
+        profile,
+        thickness: THICKNESS,
+    }
+}
+
+/// One input: its name, body, rib and the volume section 8.6 describes.
+struct Input {
+    name: &'static str,
+    body: Shape,
+    spec: RibSpec,
+    volume: f64,
+    budget: Option<Duration>,
+}
+
+/// The inputs of section 8.6. Every profile runs so that the body lies on its left in plane
+/// coordinates, the side `BRepFeat_MakeLinearForm` fills.
+fn inputs() -> Vec<Input> {
+    // The chord of the tube's bore at y = 5 meets the bore at x = +-sqrt(15^2 - 5^2).
+    let chord = 200.0_f64.sqrt();
+    // The circular segment between the chord and the bore.
+    let segment = 15.0 * 15.0 * (5.0_f64 / 15.0).acos() - 5.0 * chord;
+    let bracket_volume = 23_000.0;
+    vec![
+        Input {
+            // Gate 1's rib: the diagonal from (45, 5) on the horizontal plate's top to (5, 45)
+            // on the vertical plate's inner face, filling the triangle in the corner.
+            name: "bracket",
+            body: bracket(),
+            spec: spec(bracket_middle(), vec![point(45.0, 5.0), point(5.0, 45.0)]),
+            volume: bracket_volume + 0.5 * 40.0 * 40.0 * THICKNESS,
+            budget: Some(BRACKET_BUDGET),
+        },
+        Input {
+            // Both ends meet a cylinder: the chord of the tube's bore at y = 5, filling the
+            // circular segment between it and the bore.
+            name: "cylinder",
+            body: tube(),
+            spec: spec(tube_middle(), vec![point(-chord, 5.0), point(chord, 5.0)]),
+            volume: PI * (20.0 * 20.0 - 15.0 * 15.0) * 30.0 + segment * THICKNESS,
+            budget: None,
+        },
+        Input {
+            // Two segments in a V whose tip (20, 20) points into the corner, filling the
+            // quadrilateral between them and the plates (600 mm^2).
+            name: "v",
+            body: bracket(),
+            spec: spec(
+                bracket_middle(),
+                vec![point(45.0, 5.0), point(20.0, 20.0), point(5.0, 45.0)],
+            ),
+            volume: bracket_volume + 600.0 * THICKNESS,
+            budget: None,
+        },
+        Input {
+            // The bracket's diagonal extended 3 mm into each plate: its ends lie inside the
+            // body, and the rib is the bracket's.
+            name: "inside",
+            body: bracket(),
+            spec: spec(bracket_middle(), vec![point(48.0, 2.0), point(2.0, 48.0)]),
+            volume: bracket_volume + 0.5 * 40.0 * 40.0 * THICKNESS,
+            budget: None,
+        },
+        Input {
+            // The bracket's rib over the hole in its horizontal plate: the rib ends at the
+            // plate's top and spans the hole.
+            name: "hole",
+            body: bracket_with_hole(),
+            spec: spec(bracket_middle(), vec![point(45.0, 5.0), point(5.0, 45.0)]),
+            volume: bracket_volume - PI * 4.0 * 4.0 * 5.0 + 0.5 * 40.0 * 40.0 * THICKNESS,
+            budget: None,
+        },
+    ]
+}
+
+/// The constructions tried on every input: (a) with and without its sliding option, and (b).
+const CONSTRUCTIONS: [(&str, RibConstruction); 3] = [
+    ("linear-form", RibConstruction::LinearForm { sliding: true }),
+    (
+        "linear-form-fixed",
+        RibConstruction::LinearForm { sliding: false },
+    ),
+    ("thickened", RibConstruction::ThickenedPrism),
+];
+
+/// Every construction on every input, in the order of the inputs.
+pub fn runs() -> Vec<Run> {
+    inputs()
+        .into_iter()
+        .flat_map(|input| {
+            CONSTRUCTIONS.map(|(construction, kind)| Run {
+                input: input.name,
+                construction,
+                body: input.body.clone(),
+                spec: input.spec.clone(),
+                kind,
+                volume: input.volume,
+                budget: input
+                    .budget
+                    .filter(|_| kind == RibConstruction::ThickenedPrism),
+            })
+        })
+        .collect()
+}
