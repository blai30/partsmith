+// The wrap emboss of the wrap-emboss spike (kernel spec section 8.3): outlines of the developed
+// plane mapped onto a cylinder or a cone by the parameter-plane map, one face per region on the
+// surface, each thickened along the surface's normals by BRepOffset_MakeSimpleOffset or by
+// BRepOffsetAPI_MakeThickSolid::MakeThickSolidBySimple, then fused to the body (raised) or cut
+// from it (recessed). The spike's indicator records when it is polled (section 8.1 item 4).
+#include <algorithm>
+#include <chrono>
+#include <cmath>
+#include <limits>
+#include <optional>
+#include <utility>
+#include <vector>
+
+#include <BRepAdaptor_Curve.hxx>
+#include <BRepBuilderAPI_MakeFace.hxx>
+#include <BRepCheck_Analyzer.hxx>
+#include <BRepGProp.hxx>
+#include <BRepClass_FaceClassifier.hxx>
+#include <BRepOffsetAPI_MakeThickSolid.hxx>
+#include <BRepOffset_MakeSimpleOffset.hxx>
+#include <BRepTools.hxx>
+#include <BRep_Builder.hxx>
+#include <BRep_Tool.hxx>
+#include <GCPnts_AbscissaPoint.hxx>
+#include <GProp_GProps.hxx>
+#include <TopExp.hxx>
+#include <TopTools_IndexedDataMapOfShapeListOfShape.hxx>
+#include <TopTools_IndexedMapOfShape.hxx>
+#include <TopoDS.hxx>
+#include <TopoDS_Wire.hxx>
+
+#include "partsmith-occt-sys/cpp/internal.h"
+
+namespace partsmith {
+namespace occt {
+
+using namespace detail;
+
+namespace {
+
+using Clock = std::chrono::steady_clock;
+
+// The milliseconds of a duration.
+double milliseconds(Clock::duration duration) {
+  return std::chrono::duration<double, std::milli>(duration).count();
+}
+
+// The spike's indicator: answers as the shim's indicator does, and records the time of each
+// poll, so the spike can report the polls of a call and the longest gap between them.
+class PollRecorder : public Interruption {
+ public:
+  explicit PollRecorder(const Interrupt &interrupt)
+      : Interruption(interrupt), start_(Clock::now()), last_(start_) {}
+
+  Standard_Boolean UserBreak() override {
+    const Clock::time_point now = Clock::now();
+    if (count_ == 0) {
+      first_ = now - start_;
+    } else if (now - last_ > longest_) {
+      longest_ = now - last_;
+      longest_after_ = count_;
+    }
+    last_ = now;
+    ++count_;
+    return Interruption::UserBreak();
+  }
+
+  // The polls so far, with the time from the last one to now as the end of the call.
+  PollData data() const {
+    const Clock::time_point now = Clock::now();
+    return PollData{count_,         milliseconds(first_),      milliseconds(longest_),
+                    longest_after_, milliseconds(now - last_), milliseconds(now - start_)};
+  }
+
+ private:
+  Clock::time_point start_;
+  Clock::time_point last_;
+  Clock::duration first_{};
+  Clock::duration longest_{};
+  std::uint64_t longest_after_ = 0;
+  std::uint64_t count_ = 0;
+};
+
+// The curve of a role that has none: the base and top faces.
+constexpr std::uint32_t kNoCurve = std::numeric_limits<std::uint32_t>::max();
+
+// The points sampled along each curve of a loop to find which way it runs.
+constexpr int kOrientationSamples = 32;
+
+// The relative tolerance of the lengths edge_length measures.
+constexpr double kLengthTolerance = 1e-12;
+
+// The relative tolerance of the volumes adaptive_volume measures.
+constexpr double kVolumeTolerance = 1e-10;
+
+// An element of the construction with its role.
+struct Role {
+  TopoDS_Shape element;
+  EmbossPart part;
+  std::uint32_t region;
+  std::uint32_t curve;
+  EmbossSource source;
+};
+
+// One region's face on the surface, with the edge each curve gave it and the vertex at each
+// curve's start.
+struct WrappedRegion {
+  TopoDS_Face face;
+  std::vector<std::pair<TopoDS_Edge, std::uint32_t>> edges;
+  std::vector<std::pair<TopoDS_Vertex, std::uint32_t>> vertices;
+};
+
+// Twice the signed area of a loop of the developed plane, from points sampled along its curves:
+// positive when it runs counterclockwise.
+double twice_signed_area(const std::vector<ParameterCurve> &loop) {
+  std::vector<gp_Pnt2d> points;
+  for (const ParameterCurve &curve : loop) {
+    for (int sample = 0; sample < kOrientationSamples; ++sample) {
+      points.push_back(curve.curve->Value(curve.first + (curve.last - curve.first) * sample /
+                                                            kOrientationSamples));
+    }
+  }
+  double area = 0.0;
+  for (std::size_t point = 0; point < points.size(); ++point) {
+    const gp_Pnt2d &next = points[(point + 1) % points.size()];
+    area += points[point].X() * next.Y() - next.X() * points[point].Y();
+  }
+  return area;
+}
+
+// Maps the loop of `count` curves from `first` onto the surface: one edge per curve along its
+// image, consecutive edges sharing the vertex where they meet. Raises Partsmith_InvalidInput when
+// the curves do not meet end to end, or when the loop does not run counterclockwise (`outer`) or
+// clockwise (a hole). Records each edge and vertex in `region` and the map's deviation.
+TopoDS_Wire wrap_loop(const WrapSurfaceData &surface, const Handle(Geom_Surface) &geometry,
+                      rust::Slice<const WrapCurveData> curves, std::size_t first,
+                      std::size_t count, bool outer, WrappedRegion &region, double &deviation) {
+  std::vector<ParameterCurve> developed;
+  for (std::size_t position = 0; position < count; ++position) {
+    developed.push_back(developed_curve(curves[first + position]));
+  }
+  for (std::size_t position = 0; position < count; ++position) {
+    if (developed[position].end().Distance(developed[(position + 1) % count].start()) > kLinear) {
+      raise_invalid_input("The curves of an emboss loop must meet end to end.");
+    }
+  }
+  if ((twice_signed_area(developed) > 0.0) != outer) {
+    raise_invalid_input(outer ? "An emboss region's outer loop must run counterclockwise."
+                              : "An emboss region's holes must run clockwise.");
+  }
+  std::vector<TopoDS_Vertex> vertices;
+  for (const ParameterCurve &curve : developed) {
+    const gp_Pnt2d start = curve.start();
+    vertices.push_back(
+        vertex_on_surface(geometry, developed_to_parameter(surface, start.X(), start.Y())));
+  }
+  BRep_Builder builder;
+  TopoDS_Wire wire;
+  builder.MakeWire(wire);
+  for (std::size_t position = 0; position < count; ++position) {
+    const MappedCurve mapped = map_curve(surface, developed[position]);
+    deviation = std::max(deviation, mapped.deviation);
+    const TopoDS_Edge edge = edge_on_surface(geometry, mapped.image.curve, vertices[position],
+                                             vertices[(position + 1) % count], mapped.image.first,
+                                             mapped.image.last, 0.0);
+    builder.Add(wire, edge);
+    const auto curve = static_cast<std::uint32_t>(first + position);
+    region.edges.emplace_back(edge, curve);
+    region.vertices.emplace_back(vertices[position], curve);
+  }
+  wire.Closed(Standard_True);
+  return wire;
+}
+
+// The wrapped faces of the outlines, one per region: `loops` gives the curves of each loop in
+// order and `regions` the loops of each region, its outer loop first.
+std::vector<WrappedRegion> wrap_regions(const WrapSurfaceData &surface,
+                                        rust::Slice<const WrapCurveData> curves,
+                                        rust::Slice<const std::uint32_t> loops,
+                                        rust::Slice<const std::uint32_t> regions,
+                                        double &deviation, Polls &polls) {
+  const Handle(Geom_Surface) geometry = wrap_surface(surface);
+  std::vector<WrappedRegion> wrapped;
+  std::size_t loop = 0;
+  std::size_t curve = 0;
+  for (const std::uint32_t loop_count : regions) {
+    polls.before("BRepBuilderAPI_MakeFace");
+    WrappedRegion region;
+    std::optional<BRepBuilderAPI_MakeFace> face;
+    for (std::uint32_t position = 0; position < loop_count; ++position, ++loop) {
+      const std::size_t count = loops[loop];
+      const TopoDS_Wire wire =
+          wrap_loop(surface, geometry, curves, curve, count, position == 0, region, deviation);
+      curve += count;
+      if (position == 0) {
+        // The loops already run the way the face's normal asks, so the face maker is not asked
+        // to orient them.
+        face.emplace(geometry, wire, Standard_False);
+      } else {
+        face->Add(wire);
+      }
+    }
+    if (!face->IsDone()) {
+      raise_not_done("BRepBuilderAPI_MakeFace failed with status " +
+                     std::to_string(static_cast<int>(face->Error())));
+    }
+    region.face = face->Face();
+    wrapped.push_back(std::move(region));
+  }
+  return wrapped;
+}
+
+// The element of `solid` that `element` of the wrapped face became: itself when the solid holds
+// it, else its image in the thickening's `modified` history.
+template <class Modified>
+std::optional<std::pair<TopoDS_Shape, EmbossSource>> base_image(
+    const TopoDS_Shape &element, const TopTools_IndexedMapOfShape &elements,
+    Modified &&modified) {
+  if (elements.Contains(element)) {
+    return std::make_pair(element, EmbossSource::Section);
+  }
+  const TopoDS_Shape image = modified(element);
+  if (!image.IsNull() && elements.Contains(image)) {
+    return std::make_pair(image, EmbossSource::Modified);
+  }
+  return std::nullopt;
+}
+
+// The one ancestor in `ancestors` (a map from elements to the elements holding them) that holds
+// both `first` and `second`, or nothing.
+std::optional<TopoDS_Shape> shared_ancestor(
+    const TopTools_IndexedDataMapOfShapeListOfShape &ancestors, const TopoDS_Shape &first,
+    const TopoDS_Shape &second) {
+  if (!ancestors.Contains(first) || !ancestors.Contains(second)) {
+    return std::nullopt;
+  }
+  for (const TopoDS_Shape &candidate : ancestors.FindFromKey(first)) {
+    for (const TopoDS_Shape &other : ancestors.FindFromKey(second)) {
+      if (candidate.IsSame(other)) {
+        return candidate;
+      }
+    }
+  }
+  return std::nullopt;
+}
+
+// The roles of one region's solid: the base face, edges and vertices from the wrapped face
+// (themselves, or their images in the thickening's `modified`), the top face, edges and vertices
+// from its `generated`, and the walls and the edges between base and top vertices by adjacency,
+// since no OCCT history of the thickening names them.
+template <class Generated, class Modified>
+void add_roles(const TopoDS_Shape &solid, const WrappedRegion &region, std::uint32_t index,
+               Generated &&generated, Modified &&modified, std::vector<Role> &roles) {
+  TopTools_IndexedMapOfShape elements;
+  TopExp::MapShapes(solid, elements);
+  TopTools_IndexedDataMapOfShapeListOfShape edge_faces;
+  TopExp::MapShapesAndAncestors(solid, TopAbs_EDGE, TopAbs_FACE, edge_faces);
+  TopTools_IndexedDataMapOfShapeListOfShape vertex_edges;
+  TopExp::MapShapesAndAncestors(solid, TopAbs_VERTEX, TopAbs_EDGE, vertex_edges);
+  auto top_of = [&](const TopoDS_Shape &element) -> std::optional<TopoDS_Shape> {
+    const TopoDS_Shape image = generated(element);
+    if (image.IsNull() || !elements.Contains(image)) {
+      return std::nullopt;
+    }
+    return image;
+  };
+  if (const auto base = base_image(region.face, elements, modified)) {
+    roles.push_back({base->first, EmbossPart::BaseFace, index, kNoCurve, base->second});
+  }
+  if (const auto top = top_of(region.face)) {
+    roles.push_back({*top, EmbossPart::TopFace, index, kNoCurve, EmbossSource::Generated});
+  }
+  for (const auto &[edge, curve] : region.edges) {
+    const auto base = base_image(edge, elements, modified);
+    const auto top = top_of(edge);
+    if (base) {
+      roles.push_back({base->first, EmbossPart::BaseEdge, index, curve, base->second});
+    }
+    if (top) {
+      roles.push_back({*top, EmbossPart::TopEdge, index, curve, EmbossSource::Generated});
+    }
+    if (base && top) {
+      if (const auto wall = shared_ancestor(edge_faces, base->first, *top)) {
+        roles.push_back({*wall, EmbossPart::WallFace, index, curve, EmbossSource::Adjacent});
+      }
+    }
+  }
+  for (const auto &[vertex, curve] : region.vertices) {
+    const auto base = base_image(vertex, elements, modified);
+    const auto top = top_of(vertex);
+    if (base) {
+      roles.push_back({base->first, EmbossPart::BaseVertex, index, curve, base->second});
+    }
+    if (top) {
+      roles.push_back({*top, EmbossPart::TopVertex, index, curve, EmbossSource::Generated});
+    }
+    if (base && top) {
+      if (const auto wall = shared_ancestor(vertex_edges, base->first, *top)) {
+        roles.push_back({*wall, EmbossPart::WallEdge, index, curve, EmbossSource::Adjacent});
+      }
+    }
+  }
+}
+
+// The first shape of a history list, or a null shape.
+TopoDS_Shape first_of(const TopTools_ListOfShape &shapes) {
+  return shapes.IsEmpty() ? TopoDS_Shape() : shapes.First();
+}
+
+// Thickens one region's face by `depth` with `thickening`, outward when `raised` and inward
+// otherwise, and adds the roles of the solid's elements. Both thickenings make the solid's shell
+// with the face as given and offset it along its normal as given, so the face is given as the
+// solid's boundary, reversed for a raised solid, whose base faces the axis, and is offset by
+// minus the depth, into the solid. Given forward and offset outward, a raised solid came out
+// inside out (negative volume), which BRepCheck_Analyzer passes and the fuse empties.
+TopoDS_Shape thicken(const WrappedRegion &region, std::uint32_t index, double depth, bool raised,
+                     ThickeningType thickening, std::vector<Role> &roles, Polls &polls) {
+  const TopoDS_Shape face = raised ? region.face.Reversed() : TopoDS_Shape(region.face);
+  const double offset = -depth;
+  if (thickening == ThickeningType::SimpleOffset) {
+    BRepOffset_MakeSimpleOffset maker(face, offset);
+    maker.SetBuildSolidFlag(Standard_True);
+    polls.before("BRepOffset_MakeSimpleOffset");
+    maker.Perform();
+    if (!maker.IsDone()) {
+      raise_not_done(std::string("BRepOffset_MakeSimpleOffset failed: ") +
+                     maker.GetErrorMessage().ToCString());
+    }
+    const TopoDS_Shape solid = maker.GetResultShape();
+    add_roles(
+        solid, region, index, [&](const TopoDS_Shape &shape) { return maker.Generated(shape); },
+        [&](const TopoDS_Shape &shape) { return maker.Modified(shape); }, roles);
+    return solid;
+  }
+  BRepOffsetAPI_MakeThickSolid maker;
+  polls.before("BRepOffsetAPI_MakeThickSolid");
+  maker.MakeThickSolidBySimple(face, offset);
+  if (!maker.IsDone()) {
+    raise_not_done("BRepOffsetAPI_MakeThickSolid::MakeThickSolidBySimple failed");
+  }
+  const TopoDS_Shape solid = maker.Shape();
+  add_roles(
+      solid, region, index,
+      [&](const TopoDS_Shape &shape) { return first_of(maker.Generated(shape)); },
+      [&](const TopoDS_Shape &shape) { return first_of(maker.Modified(shape)); }, roles);
+  return solid;
+}
+
+// Replaces each role's element by its images in `history`, dropping removed elements.
+void follow(std::vector<Role> &roles, const Handle(BRepTools_History) &history) {
+  std::vector<Role> followed;
+  for (const Role &role : roles) {
+    if (history->IsRemoved(role.element)) {
+      continue;
+    }
+    const TopTools_ListOfShape &images = history->Modified(role.element);
+    if (images.IsEmpty()) {
+      followed.push_back(role);
+    }
+    for (const TopoDS_Shape &image : images) {
+      followed.push_back({image, role.part, role.region, role.curve, role.source});
+    }
+  }
+  roles = std::move(followed);
+}
+
+// The kind of a face, edge or vertex; nothing for other types.
+std::optional<ElementKind> element_kind(TopAbs_ShapeEnum type) {
+  switch (type) {
+    case TopAbs_FACE:
+      return ElementKind::Face;
+    case TopAbs_EDGE:
+      return ElementKind::Edge;
+    case TopAbs_VERTEX:
+      return ElementKind::Vertex;
+    default:
+      return std::nullopt;
+  }
+}
+
+// Checks a whole shape and repairs it when it is not valid, as section 3.5 does, recording which.
+ValidityType check_and_repair(TopoDS_Shape &shape, const Handle(BRepTools_History) &history,
+                              Polls &polls) {
+  polls.before("BRepCheck_Analyzer");
+  if (BRepCheck_Analyzer(shape).IsValid()) {
+    return ValidityType::AsBuilt;
+  }
+  return repair(shape, history, polls) ? ValidityType::AfterRepair : ValidityType::Invalid;
+}
+
+}  // namespace
+
+EmbossData wrap_emboss(const Shape &body, const EmbossSpecData &spec,
+                       rust::Slice<const WrapCurveData> curves,
+                       rust::Slice<const std::uint32_t> loops,
+                       rust::Slice<const std::uint32_t> regions, const Interrupt &interrupt) {
+  const Handle(PollRecorder) recorder = new PollRecorder(interrupt);
+  Polls polls{Handle(Interruption)(recorder)};
+  double deviation = 0.0;
+  const std::vector<WrappedRegion> wrapped =
+      wrap_regions(spec.surface, curves, loops, regions, deviation, polls);
+
+  std::vector<TopoDS_Shape> solids;
+  std::vector<Role> roles;
+  for (std::size_t region = 0; region < wrapped.size(); ++region) {
+    solids.push_back(thicken(wrapped[region], static_cast<std::uint32_t>(region), spec.depth,
+                             spec.raised, spec.thickening, roles, polls));
+  }
+  TopoDS_Shape construction = compound_of(solids);
+  Handle(BRepTools_History) repair_history = new BRepTools_History;
+  const ValidityType construction_validity =
+      check_and_repair(construction, repair_history, polls);
+  if (construction_validity == ValidityType::Invalid) {
+    raise_invalid_result("the emboss construction stays invalid after ShapeFix_Shape");
+  }
+  follow(roles, repair_history);
+  const std::shared_ptr<Shape> construction_shape = make_shape(construction);
+
+  // The boolean of section 3.4.5 on copies of the body and the construction, its whole result
+  // checked and repaired. History inputs: [body, construction].
+  polls.before("BRepBuilderAPI_Copy");
+  const Shape body_copy = copy_elements(body);
+  polls.before("BRepBuilderAPI_Copy");
+  const Shape construction_copy = copy_elements(*construction_shape);
+  TopTools_ListOfShape tools;
+  tools.Append(construction_copy.get());
+  Handle(BRepTools_History) history = new BRepTools_History;
+  TopoDS_Shape result =
+      solids_only(run_boolean(spec.raised ? BOPAlgo_FUSE : BOPAlgo_CUT, body_copy.get(), tools,
+                              true, history, polls));
+  const ValidityType result_validity = check_and_repair(result, history, polls);
+  OpResultData result_data =
+      op_result(result, history, {body_copy.get(), construction_copy.get()});
+
+  rust::Vec<EmbossRoleData> role_data;
+  for (const Role &role : roles) {
+    const std::optional<ElementKind> kind = element_kind(role.element.ShapeType());
+    const int index = kind ? construction_shape->map(*kind).FindIndex(role.element) : 0;
+    if (index > 0) {
+      role_data.push_back(EmbossRoleData{*kind, static_cast<std::uint32_t>(index), role.part,
+                                         role.region, role.curve, role.source});
+    }
+  }
+  return EmbossData{std::move(result_data), construction_shape, std::move(role_data),
+                    construction_validity, result_validity, recorder->data(), deviation};
+}
+
+rust::Vec<Vec3> edge_points(const Shape &shape, std::uint32_t edge, std::uint32_t count) {
+  const BRepAdaptor_Curve curve(TopoDS::Edge(element_at(shape, ElementKind::Edge, edge)));
+  const double first = curve.FirstParameter();
+  const double last = curve.LastParameter();
+  rust::Vec<Vec3> points;
+  for (std::uint32_t point = 0; point < count; ++point) {
+    const double parameter = count == 1 ? first : first + (last - first) * point / (count - 1);
+    points.push_back(to_vec3(curve.Value(parameter).XYZ()));
+  }
+  return points;
+}
+
+rust::Vec<Vec3> face_points(const Shape &shape, std::uint32_t face, std::uint32_t count) {
+  const TopoDS_Face &element = TopoDS::Face(element_at(shape, ElementKind::Face, face));
+  const Handle(Geom_Surface) surface = BRep_Tool::Surface(element);
+  double u_first = 0.0;
+  double u_last = 0.0;
+  double v_first = 0.0;
+  double v_last = 0.0;
+  BRepTools::UVBounds(element, u_first, u_last, v_first, v_last);
+  // The cell centers of ever finer square grids until enough of them lie inside the face.
+  std::vector<gp_Pnt2d> inside;
+  for (std::uint32_t cells = 4; inside.size() < count && cells <= 1024; cells *= 2) {
+    inside.clear();
+    for (std::uint32_t row = 0; row < cells; ++row) {
+      for (std::uint32_t column = 0; column < cells; ++column) {
+        const gp_Pnt2d point(u_first + (u_last - u_first) * (column + 0.5) / cells,
+                             v_first + (v_last - v_first) * (row + 0.5) / cells);
+        if (BRepClass_FaceClassifier(element, point, kLinear).State() == TopAbs_IN) {
+          inside.push_back(point);
+        }
+      }
+    }
+  }
+  if (inside.size() < count) {
+    raise_not_done("the face holds fewer points inside it than asked for");
+  }
+  rust::Vec<Vec3> points;
+  for (std::uint32_t point = 0; point < count; ++point) {
+    const gp_Pnt2d &parameter = inside[point * inside.size() / count];
+    points.push_back(to_vec3(surface->Value(parameter.X(), parameter.Y()).XYZ()));
+  }
+  return points;
+}
+
+double edge_length(const Shape &shape, std::uint32_t edge) {
+  const BRepAdaptor_Curve curve(TopoDS::Edge(element_at(shape, ElementKind::Edge, edge)));
+  return GCPnts_AbscissaPoint::Length(curve, kLengthTolerance);
+}
+
+double adaptive_volume(const Shape &shape) {
+  GProp_GProps properties;
+  BRepGProp::VolumePropertiesGK(shape.get(), properties, kVolumeTolerance, Standard_True,
+                                Standard_True);
+  return properties.Mass();
+}
+
+}  // namespace occt
+}  // namespace partsmith
