+        'T' => (
+            vec![region(
+                polygon(&[
+                    (1.2, 0.0),
+                    (2.0, 0.0),
+                    (2.0, 4.2),
+                    (3.2, 4.2),
+                    (3.2, 5.0),
+                    (0.0, 5.0),
+                    (0.0, 4.2),
+                    (1.2, 4.2),
