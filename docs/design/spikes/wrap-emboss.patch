index 0000000..ad8280f
--- /dev/null
+++ b/crates/partsmith-occt-sys/src/parameter_plane.rs
@@ -0,0 +1,376 @@
+//! The parameter-plane map of a cylinder or a cone (kernel spec sections 8.2 and 8.3): curves of
+//! the developed plane and helices become curves of the surface's parameter plane, and edges on
+//! the surface with those curves on it, exact on a cylinder and within 1e-6 mm on a cone. The
+//! helix-thread spike's thread and the wrap-emboss spike's emboss share this code path.
+
+use std::f64::consts::{FRAC_PI_2, TAU};
+
+use crate::error::{KernelError, Operation, call};
+use crate::ffi::bridge as sys;
+use crate::shape::Shape;
+use crate::values::{Plane, Point2, check_finite, is_positive_length};
+
+/// A cylinder or a cone about the normal of its frame. Angles on it start at the frame's x axis
+/// and heights at its origin.
+#[derive(Debug, Clone, Copy, PartialEq)]
+pub enum WrapSurface {
+    /// A cylinder.
+    Cylinder {
+        /// The axis frame.
+        frame: Plane,
+        /// The radius.
+        radius: f64,
+    },
+    /// A cone whose radius grows by the tangent of `half_angle` per millimeter along the normal;
+    /// a negative angle narrows it.
+    Cone {
+        /// The axis frame.
+        frame: Plane,
+        /// The radius at the frame's origin.
+        radius: f64,
+        /// The angle between the cone's lines and its axis, in radians.
+        half_angle: f64,
+    },
+}
+
+/// A helix on a cylinder or a cone: from angle `phase` at `height` along the axis, it rises
+/// `pitch` along the axis per turn for `turns` turns. A positive pitch is right-handed.
+#[derive(Debug, Clone, Copy, PartialEq)]
+pub struct Helix {
+    /// The angle of its start from the frame's x axis, in radians.
+    pub phase: f64,
+    /// The height of its start along the axis.
+    pub height: f64,
+    /// Its rise along the axis per turn.
+    pub pitch: f64,
+    /// Its number of turns.
+    pub turns: f64,
+}
+
+/// A B-spline of the developed plane, as `Geom2d_BSplineCurve` takes it.
+#[derive(Debug, Clone, PartialEq)]
+pub struct WrapBspline {
+    /// Its degree, from 1 to 25.
+    pub degree: u32,
+    /// Its poles.
+    pub poles: Vec<Point2>,
+    /// Its distinct knots, increasing.
+    pub knots: Vec<f64>,
+    /// The multiplicity of each knot.
+    pub multiplicities: Vec<u32>,
+    /// Whether it is periodic, and so closed.
+    pub periodic: bool,
+}
+
+/// A curve of the parameter-plane map. The developed plane is the plane tangent to the surface
+/// along its line at angle 0, with x along the circle at height 0 and y along the line. On a
+/// cylinder of radius r its point (x, y) maps to u = x / r and v = y, so each curve's image is
+/// exact; on a cone it maps through the polar coordinates of the developed sector, and each
+/// image is approximated within 1e-6 mm (section 8.3).
+#[derive(Debug, Clone, PartialEq)]
+pub enum WrapCurve {
+    /// A straight segment of the developed plane.
+    Segment {
+        /// Its start in the developed plane.
+        start: Point2,
+        /// Its end in the developed plane.
+        end: Point2,
+    },
+    /// An arc of a circle of the developed plane: from `start_angle` (from the x axis) through
+    /// `sweep`, counterclockwise when positive and clockwise when negative.
+    Arc {
+        /// Its center in the developed plane.
+        center: Point2,
+        /// Its radius.
+        radius: f64,
+        /// The angle of its start, in radians.
+        start_angle: f64,
+        /// The angle it turns through, in radians, at most a full turn either way.
+        sweep: f64,
+    },
+    /// A B-spline of the developed plane.
+    Bspline(WrapBspline),
+    /// A helix, a line of the parameter plane on both surfaces.
+    Helix(Helix),
+}
+
+const RADIUS_MESSAGE: &str = "A wrap surface needs a radius greater than 0 mm.";
+const HALF_ANGLE_MESSAGE: &str =
+    "A cone needs a half-angle between 0 and 90 degrees, other than 0, on either side.";
+const SHORT_SEGMENT_MESSAGE: &str = "A segment needs a length greater than 0 mm.";
+const ARC_MESSAGE: &str =
+    "An arc needs a radius greater than 0 mm and a sweep other than 0 of at most a full turn.";
+const BSPLINE_MESSAGE: &str = "A B-spline needs a degree from 1 to 25, increasing knots with positive multiplicities, and as many poles as they call for.";
+const TURNS_MESSAGE: &str = "A helix needs more than 0 turns.";
+const APEX_MESSAGE: &str = "A helix on a cone must stay on one side of the cone's apex.";
+
+impl WrapSurface {
+    /// Checks the surface (section 3.1 items 4 to 6) and returns its bridge form.
+    pub(crate) fn to_ffi(self, operation: Operation) -> Result<sys::WrapSurfaceData, KernelError> {
+        let (frame, radius, half_angle) = match self {
+            WrapSurface::Cylinder { frame, radius } => (frame, radius, 0.0),
+            WrapSurface::Cone {
+                frame,
+                radius,
+                half_angle,
+            } => (frame, radius, half_angle),
+        };
+        check_finite(operation, &[radius, half_angle])?;
+        let frame = frame.frame(operation)?;
+        if !is_positive_length(radius) {
+            return Err(KernelError::invalid_input(operation, RADIUS_MESSAGE));
+        }
+        let is_cone = matches!(self, WrapSurface::Cone { .. });
+        if is_cone && !(half_angle != 0.0 && half_angle.abs() < FRAC_PI_2) {
+            return Err(KernelError::invalid_input(operation, HALF_ANGLE_MESSAGE));
+        }
+        Ok(sys::WrapSurfaceData {
+            frame: frame.to_ffi(),
+            radius,
+            half_angle,
+        })
+    }
+
+    /// The radius at `height` along the axis.
+    fn radius_at(surface: &sys::WrapSurfaceData, height: f64) -> f64 {
+        surface.radius + height * surface.half_angle.tan()
+    }
+}
+
+impl WrapBspline {
+    /// Checks the B-spline's values and counts (section 3.1 items 4 to 6): `Geom2d_BSplineCurve`
+    /// raises on counts that do not agree.
+    fn check(&self, operation: Operation) -> Result<(), KernelError> {
+        let coordinates: Vec<f64> = self
+            .poles
+            .iter()
+            .flat_map(|pole| [pole.x, pole.y])
+            .collect();
+        check_finite(operation, &coordinates)?;
+        check_finite(operation, &self.knots)?;
+        let increasing = self.knots.windows(2).all(|pair| pair[0] < pair[1]);
+        let multiplicities: Option<usize> = self
+            .multiplicities
+            .iter()
+            .try_fold(0usize, |sum, multiplicity| {
+                (*multiplicity >= 1).then(|| sum + *multiplicity as usize)
+            });
+        let poles_needed = multiplicities.and_then(|sum| {
+            let last = *self.multiplicities.last()? as usize;
+            if self.periodic {
+                Some(sum - last)
+            } else {
+                sum.checked_sub(self.degree as usize + 1)
+            }
+        });
+        let valid = (1..=25).contains(&self.degree)
+            && self.knots.len() >= 2
+            && self.knots.len() == self.multiplicities.len()
+            && increasing
+            && poles_needed == Some(self.poles.len())
+            && self.poles.len() >= 2;
+        if !valid {
+            return Err(KernelError::invalid_input(operation, BSPLINE_MESSAGE));
+        }
+        Ok(())
+    }
+}
+
+impl WrapCurve {
+    /// Checks the curve on `surface` and returns its bridge form.
+    pub(crate) fn to_ffi(
+        &self,
+        operation: Operation,
+        surface: &sys::WrapSurfaceData,
+    ) -> Result<sys::WrapCurveData, KernelError> {
+        let mut data = sys::WrapCurveData {
+            kind: sys::WrapCurveType::Segment,
+            start_x: 0.0,
+            start_y: 0.0,
+            end_x: 0.0,
+            end_y: 0.0,
+            phase: 0.0,
+            height: 0.0,
+            pitch: 0.0,
+            turns: 0.0,
+            center_x: 0.0,
+            center_y: 0.0,
+            radius: 0.0,
+            start_angle: 0.0,
+            sweep: 0.0,
+            degree: 0,
+            periodic: false,
+            poles: Vec::new(),
+            knots: Vec::new(),
+            multiplicities: Vec::new(),
+        };
+        match self {
+            WrapCurve::Segment { start, end } => {
+                check_finite(operation, &[start.x, start.y, end.x, end.y])?;
+                if !is_positive_length(start.distance(*end)) {
+                    return Err(KernelError::invalid_input(operation, SHORT_SEGMENT_MESSAGE));
+                }
+                (data.start_x, data.start_y, data.end_x, data.end_y) =
+                    (start.x, start.y, end.x, end.y);
+            }
+            WrapCurve::Arc {
+                center,
+                radius,
+                start_angle,
+                sweep,
+            } => {
+                check_finite(
+                    operation,
+                    &[center.x, center.y, *radius, *start_angle, *sweep],
+                )?;
+                if !is_positive_length(*radius) || *sweep == 0.0 || sweep.abs() > TAU {
+                    return Err(KernelError::invalid_input(operation, ARC_MESSAGE));
+                }
+                data.kind = sys::WrapCurveType::Arc;
+                (data.center_x, data.center_y, data.radius) = (center.x, center.y, *radius);
+                (data.start_angle, data.sweep) = (*start_angle, *sweep);
+            }
+            WrapCurve::Bspline(bspline) => {
+                bspline.check(operation)?;
+                data.kind = sys::WrapCurveType::Bspline;
+                data.degree = bspline.degree;
+                data.periodic = bspline.periodic;
+                data.poles = bspline
+                    .poles
+                    .iter()
+                    .flat_map(|pole| [pole.x, pole.y])
+                    .collect();
+                data.knots.clone_from(&bspline.knots);
+                data.multiplicities.clone_from(&bspline.multiplicities);
+            }
+            WrapCurve::Helix(helix) => {
+                check_helix(operation, surface, helix)?;
+                data.kind = sys::WrapCurveType::Helix;
+                (data.phase, data.height, data.pitch, data.turns) =
+                    (helix.phase, helix.height, helix.pitch, helix.turns);
+            }
+        }
+        Ok(data)
+    }
+}
+
+/// Checks a helix on `surface`: finite, more than 0 turns, and on a cone where the radius stays
+/// above 0 from its start to its end.
+pub(crate) fn check_helix(
+    operation: Operation,
+    surface: &sys::WrapSurfaceData,
+    helix: &Helix,
+) -> Result<(), KernelError> {
+    check_finite(
+        operation,
+        &[helix.phase, helix.height, helix.pitch, helix.turns],
+    )?;
+    if helix.turns <= 0.0 {
+        return Err(KernelError::invalid_input(operation, TURNS_MESSAGE));
+    }
+    let end = helix.height + helix.pitch * helix.turns;
+    if [helix.height, end]
+        .iter()
+        .any(|height| !is_positive_length(WrapSurface::radius_at(surface, *height)))
+    {
+        return Err(KernelError::invalid_input(operation, APEX_MESSAGE));
+    }
+    Ok(())
+}
+
+/// Maps each curve onto the parameter plane of `surface` and returns a compound of one edge per
+/// curve, in order. Each edge has the curve's image on the parameter plane as its curve on the
+/// surface, and a 3D curve that `BRepLib::BuildCurves3d` approximates within 1e-7 mm.
+pub fn wrap_curves(surface: &WrapSurface, curves: &[WrapCurve]) -> Result<Shape, KernelError> {
+    let operation = Operation::WrapCurves;
+    let surface = surface.to_ffi(operation)?;
+    let curves = curves
+        .iter()
+        .map(|curve| curve.to_ffi(operation, &surface))
+        .collect::<Result<Vec<_>, KernelError>>()?;
+    let shape = call(operation, || sys::wrap_curves(&surface, &curves))?;
+    Shape::from_ffi(operation, shape)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::KernelErrorKind;
+
+    fn cone(half_angle: f64) -> WrapSurface {
+        WrapSurface::Cone {
+            frame: Plane::XY,
+            radius: 10.0,
+            half_angle,
+        }
+    }
+
+    #[test]
+    fn a_cone_without_a_half_angle_is_refused() {
+        let error = wrap_curves(&cone(0.0), &[]).expect_err("no half-angle");
+
+        assert_eq!(error.message, HALF_ANGLE_MESSAGE);
+        assert_eq!(error.kind, KernelErrorKind::InvalidInput);
+    }
+
+    #[test]
+    fn an_arc_without_a_sweep_is_refused() {
+        let arc = WrapCurve::Arc {
+            center: Point2 { x: 0.0, y: 0.0 },
+            radius: 1.0,
+            start_angle: 0.0,
+            sweep: 0.0,
+        };
+
+        let error = wrap_curves(&cone(0.1), &[arc]).expect_err("no sweep");
+
+        assert_eq!(error.message, ARC_MESSAGE);
+    }
+
+    #[test]
+    fn a_bspline_with_too_few_poles_is_refused() {
+        let bspline = WrapCurve::Bspline(WrapBspline {
+            degree: 3,
+            poles: vec![Point2 { x: 0.0, y: 0.0 }, Point2 { x: 1.0, y: 0.0 }],
+            knots: vec![0.0, 1.0],
+            multiplicities: vec![4, 4],
+            periodic: false,
+        });
+
+        let error = wrap_curves(&cone(0.1), &[bspline]).expect_err("too few poles");
+
+        assert_eq!(error.message, BSPLINE_MESSAGE);
+    }
+
+    #[test]
+    fn a_helix_through_the_apex_is_refused() {
+        let helix = WrapCurve::Helix(Helix {
+            phase: 0.0,
+            height: 0.0,
+            pitch: -20.0,
+            turns: 10.0,
+        });
+
+        let error = wrap_curves(&cone(0.1), &[helix]).expect_err("through the apex");
+
+        assert_eq!(error.message, APEX_MESSAGE);
+    }
+
+    #[test]
+    fn a_helix_without_turns_is_refused() {
+        let helix = WrapCurve::Helix(Helix {
+            phase: 0.0,
+            height: 0.0,
+            pitch: 1.0,
+            turns: 0.0,
+        });
+        let cylinder = WrapSurface::Cylinder {
+            frame: Plane::XY,
+            radius: 5.0,
+        };
+
+        let error = wrap_curves(&cylinder, &[helix]).expect_err("no turns");
+
+        assert_eq!(error.message, TURNS_MESSAGE);
+    }
+}
