+/// The runs of each row of the wrap-emboss spike (kernel spec section 8.1 item 4).
+const SPIKE_RUNS: usize = 5;
+
+/// The time section 8.3 gives the 20-character label with its boolean, natively.
+const LABEL_BUDGET: Duration = Duration::from_secs(1);
+
+/// The median of a value over a row's runs, and its largest value.
+fn median_and_most(values: impl IntoIterator<Item = Duration>) -> (Duration, Duration) {
+    let mut values: Vec<Duration> = values.into_iter().collect();
+    values.sort();
+    (values[values.len() / 2], values[values.len() - 1])
+}
+
+/// The rows of the wrap-emboss spike: for each input and construction, the median of 5 runs of
+/// the emboss with its boolean, and the polls of those runs with an interrupt that is never
+/// requested, with the time each run spends in the facade outside the shim, whose polls cover
+/// only the call inside it. Natively the rows of the 20-character label (on the cylinder and
+/// across its seam) have section 8.3's 1 s; the other rows, and every row under Node, print
+/// their medians.
+fn measure_wrap_emboss(report: &mut Report) {
+    for input in inputs() {
+        for (name, thickening) in CONSTRUCTIONS {
+            let row = format!("wrap-emboss {} {name}", input.name);
+            if !report.includes(&row) {
+                continue;
+            }
+            let spec = EmbossSpec {
+                thickening,
+                ..input.spec.clone()
+            };
+            let mut polls: Vec<PollRecord> = Vec::with_capacity(SPIKE_RUNS);
+            let mut outside = Vec::with_capacity(SPIKE_RUNS);
+            let time = median(SPIKE_RUNS, |_| {
+                let start = Instant::now();
+                let result = wrap_emboss(&input.body, &spec, &Interrupt::new());
+                let elapsed = start.elapsed();
+                match result {
+                    Ok(result) => {
+                        outside.push(elapsed.saturating_sub(result.polls.total));
+                        polls.push(result.polls);
+                    }
+                    Err(error) => println!("{row}: {}", error.detail()),
+                }
+                elapsed
+            });
+            if !polls.is_empty() {
+                let (longest, most) = median_and_most(polls.iter().map(|record| record.longest));
+                let (first, _) = median_and_most(polls.iter().map(|record| record.first));
+                let (last, _) = median_and_most(polls.iter().map(|record| record.last));
+                let (outside, outside_most) = median_and_most(outside);
+                let after: Vec<u64> = polls.iter().map(|record| record.longest_after).collect();
+                println!(
+                    "{row}: polls {} first {first:.3?} longest {longest:.3?} (most {most:.3?}, after polls {after:?}) last {last:.3?} outside the shim {outside:.3?} (most {outside_most:.3?})",
+                    polls[0].count
+                );
+            }
+            if cfg!(not(target_os = "emscripten")) && input.is_label {
+                report.record_time(&row, time, LABEL_BUDGET);
+            } else {
+                println!("{row}: median {time:.3?} (no budget)");
+            }
+        }
+    }
+}
