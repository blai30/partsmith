+                Vec::new(),
+            )],
+            3.2,
+        ),
+        'L' => (
+            vec![region(
+                polygon(&[
+                    (0.0, 0.0),
+                    (2.8, 0.0),
+                    (2.8, 0.8),
+                    (0.8, 0.8),
