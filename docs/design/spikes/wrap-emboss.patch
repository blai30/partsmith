+//! The inputs of the wrap-emboss spike (kernel spec section 8.3), shared by its tests and its bench
+//! rows: an outline alphabet of lines and arcs for the characters of `PARTSMITH LABEL 2026`, 5 mm
+//! tall with strokes 0.8 mm wide, with `S` a closed B-spline (no font reader yet, m2-plan.md item
+//! 27), and the labels on a cylinder of radius 15 mm and on a frustum of radii 20 and 15 mm, 30 mm
+//! tall.
+
+use std::f64::consts::{FRAC_PI_2, PI};
+
+use partsmith_occt_sys::{
+    EmbossKind, EmbossSpec, Plane, Point, Point2, Shape, Thickening, Vector, WrapBspline,
+    WrapCurve, WrapLoop, WrapRegion, WrapSurface, make_cone, make_cylinder,
+};
+
+/// The height of the characters.
+pub const CAP_HEIGHT: f64 = 5.0;
+
+/// The gap after each character.
+pub const GAP: f64 = 0.6;
+
+/// How far a space advances.
+pub const SPACE: f64 = 2.0;
+
+/// How far the outlines are raised or recessed.
+pub const DEPTH: f64 = 0.6;
+
+/// The radius of the cylinder, the cap's side.
+pub const CYLINDER_RADIUS: f64 = 15.0;
+
+/// The height of the cylinder.
+pub const CYLINDER_HEIGHT: f64 = 14.0;
+
+/// The baseline of the labels on the cylinder, along its axis.
+pub const CYLINDER_BASELINE: f64 = 4.5;
+
+/// The frustum's radii at its bottom and its top, and its height.
+pub const FRUSTUM_BOTTOM: f64 = 20.0;
+pub const FRUSTUM_TOP: f64 = 15.0;
+pub const FRUSTUM_HEIGHT: f64 = 30.0;
+
+/// The label of the spike.
+pub const LABEL: &str = "PARTSMITH LABEL 2026";
+
+/// The label on the frustum.
+pub const SHORT_LABEL: &str = "PARTS";
+
+/// The character the label across the seam is centered on: the seam runs through its middle.
+pub const SEAM_CHARACTER: usize = 12;
+
+/// The underline of the long label: its thickness, and its gap below the baseline.
+pub const UNDERLINE: f64 = 0.8;
+pub const UNDERLINE_GAP: f64 = 0.8;
+
+/// How far the underline runs past the label's ends.
+pub const UNDERLINE_OVERHANG: f64 = 0.5;
+
+/// A pen that draws one closed loop of the developed plane from its start, in chain order.
+struct Pen {
+    start: Point2,
+    at: Point2,
+    curves: Vec<WrapCurve>,
+}
+
+/// A point of the developed plane.
+fn point(x: f64, y: f64) -> Point2 {
+    Point2 { x, y }
+}
+
+impl Pen {
+    /// A loop that starts at (x, y).
+    fn at(x: f64, y: f64) -> Pen {
+        Pen {
+            start: point(x, y),
+            at: point(x, y),
+            curves: Vec::new(),
+        }
+    }
+
+    /// A segment to (x, y).
+    fn line(mut self, x: f64, y: f64) -> Pen {
+        let end = point(x, y);
+        self.curves.push(WrapCurve::Segment {
+            start: self.at,
+            end,
+        });
+        self.at = end;
+        self
+    }
+
+    /// An arc about (x, y) from where the pen is, through `sweep` degrees (counterclockwise when
+    /// positive).
+    fn arc(mut self, x: f64, y: f64, sweep: f64) -> Pen {
+        let center = point(x, y);
+        let radius = (self.at.x - x).hypot(self.at.y - y);
+        let start_angle = (self.at.y - y).atan2(self.at.x - x);
+        let sweep = sweep.to_radians();
+        let end_angle = start_angle + sweep;
+        self.curves.push(WrapCurve::Arc {
+            center,
+            radius,
+            start_angle,
+            sweep,
+        });
+        self.at = point(x + radius * end_angle.cos(), y + radius * end_angle.sin());
+        self
+    }
+
+    /// Closes the loop with a segment back to its start, unless the pen is there already.
+    fn close(self) -> WrapLoop {
+        let pen = if (self.at.x - self.start.x).hypot(self.at.y - self.start.y) > 1e-9 {
+            let start = self.start;
+            self.line(start.x, start.y)
+        } else {
+            self
+        };
+        WrapLoop { curves: pen.curves }
+    }
+}
+
+/// A region with its outer loop and holes.
+fn region(outer: WrapLoop, holes: Vec<WrapLoop>) -> WrapRegion {
+    WrapRegion { outer, holes }
+}
+
+/// The closed polygon through `corners`.
+fn polygon(corners: &[(f64, f64)]) -> WrapLoop {
+    let (x, y) = corners[0];
+    corners[1..]
+        .iter()
+        .fold(Pen::at(x, y), |pen, &(x, y)| pen.line(x, y))
+        .close()
+}
+
+/// The counter of `P` and `R`: a half disk of radius 0.7 on a 0.7 mm stem, clockwise.
+fn bowl_counter() -> WrapLoop {
+    Pen::at(0.8, 2.8)
+        .line(0.8, 4.2)
+        .line(1.5, 4.2)
+        .arc(1.5, 3.5, -180.0)
+        .close()
+}
+
+/// The angle on the bowl of `R` where its leg's right side meets it.
+const R_LEG_ANGLE: f64 = -1.19;
+
+/// The poles of the closed B-spline of `S`: a blocky S, counterclockwise, that the cubic B-spline
+/// rounds.
+const S_POLES: [(f64, f64); 12] = [
+    (0.0, 0.0),
+    (3.0, 0.0),
+    (3.0, 2.9),
+    (0.8, 2.9),
+    (0.8, 4.2),
+    (3.0, 4.2),
+    (3.0, 5.0),
+    (0.0, 5.0),
+    (0.0, 2.1),
+    (2.2, 2.1),
+    (2.2, 0.8),
+    (0.0, 0.8),
+];
+
+/// The outline of `S`: one periodic cubic B-spline with uniform knots.
+fn s_outline() -> WrapLoop {
+    let poles: Vec<Point2> = S_POLES.iter().map(|&(x, y)| point(x, y)).collect();
+    let knots: Vec<f64> = (0..=poles.len()).map(|knot| knot as f64).collect();
+    let multiplicities = vec![1; knots.len()];
+    WrapLoop {
+        curves: vec![WrapCurve::Bspline(WrapBspline {
+            degree: 3,
+            poles,
+            knots,
+            multiplicities,
+            periodic: true,
+        })],
+    }
+}
+
+/// The regions of a character in its own box, from (0, 0) to its width and the cap height, and
+/// its width; nothing for a space.
+pub fn glyph(character: char) -> (Vec<WrapRegion>, f64) {
+    let slope = 0.28;
+    match character {
+        'P' => (
+            vec![region(
+                Pen::at(0.0, 0.0)
+                    .line(0.8, 0.0)
+                    .line(0.8, 2.0)
+                    .line(1.5, 2.0)
+                    .arc(1.5, 3.5, 180.0)
+                    .line(0.0, 5.0)
+                    .close(),
+                vec![bowl_counter()],
+            )],
+            3.0,
+        ),
+        'A' => {
+            let apex = 1.9 / (2.0 * slope);
+            (
+                vec![region(
+                    polygon(&[
+                        (0.0, 0.0),
+                        (0.85, 0.0),
+                        (0.85 + slope * 1.1, 1.1),
+                        (2.75 - slope * 1.1, 1.1),
+                        (2.75, 0.0),
+                        (3.6, 0.0),
+                        (2.2, 5.0),
+                        (1.4, 5.0),
