+                        Pen::at(2.2, 1.5)
+                            .arc(1.5, 1.5, -180.0)
+                            .arc(1.5, 1.5, -180.0)
+                            .close(),
+                    ],
+                )],
+                3.0,
+            )
+        }
+        ' ' => (Vec::new(), SPACE - GAP),
+        other => panic!("the spike's alphabet has no {other:?}"),
+    }
+}
+
+/// Moves a curve by `along_x` along x and `along_y` along y.
+fn moved(curve: &WrapCurve, along_x: f64, along_y: f64) -> WrapCurve {
+    let shift = |at: Point2| point(at.x + along_x, at.y + along_y);
+    match curve {
+        WrapCurve::Segment { start, end } => WrapCurve::Segment {
+            start: shift(*start),
+            end: shift(*end),
+        },
+        WrapCurve::Arc {
+            center,
+            radius,
+            start_angle,
+            sweep,
+        } => WrapCurve::Arc {
+            center: shift(*center),
+            radius: *radius,
+            start_angle: *start_angle,
+            sweep: *sweep,
+        },
+        WrapCurve::Bspline(bspline) => WrapCurve::Bspline(WrapBspline {
+            poles: bspline.poles.iter().map(|pole| shift(*pole)).collect(),
+            ..bspline.clone()
+        }),
+        WrapCurve::Helix(helix) => WrapCurve::Helix(*helix),
+    }
+}
+
+/// Moves a region by `along_x` along x and `along_y` along y.
+fn moved_region(region: &WrapRegion, along_x: f64, along_y: f64) -> WrapRegion {
+    let move_loop = |outline: &WrapLoop| WrapLoop {
+        curves: outline
+            .curves
+            .iter()
+            .map(|curve| moved(curve, along_x, along_y))
+            .collect(),
+    };
+    WrapRegion {
+        outer: move_loop(&region.outer),
+        holes: region.holes.iter().map(move_loop).collect(),
+    }
+}
+
+/// The length of `text` from the start of its first character to the end of its last.
+pub fn text_length(text: &str) -> f64 {
+    text.chars()
+        .map(|character| glyph(character).1 + GAP)
+        .sum::<f64>()
+        - GAP
+}
+
+/// Where each character of `text` starts, from 0.
+pub fn character_starts(text: &str) -> Vec<f64> {
+    let mut starts = Vec::new();
+    let mut at = 0.0;
+    for character in text.chars() {
+        starts.push(at);
+        at += glyph(character).1 + GAP;
+    }
+    starts
+}
+
+/// The regions of `text` with its baseline at `baseline` and its first character at `start`.
+pub fn text_regions(text: &str, start: f64, baseline: f64) -> Vec<WrapRegion> {
+    text.chars()
+        .zip(character_starts(text))
+        .flat_map(|(character, offset)| {
+            glyph(character)
+                .0
+                .iter()
+                .map(|region| moved_region(region, start + offset, baseline))
+                .collect::<Vec<_>>()
+        })
+        .collect()
+}
+
+/// The surface the cylinder's labels wrap onto.
+pub fn cylinder_surface() -> WrapSurface {
+    WrapSurface::Cylinder {
+        frame: Plane::XY,
+        radius: CYLINDER_RADIUS,
+    }
+}
+
+/// The frustum's half-angle: it narrows upward.
+pub fn frustum_half_angle() -> f64 {
+    -((FRUSTUM_BOTTOM - FRUSTUM_TOP) / FRUSTUM_HEIGHT).atan()
+}
+
+/// The surface the frustum's label wraps onto: its frame turned half a turn, so the label's middle
+/// faces away from the frustum's seam.
+pub fn frustum_surface() -> WrapSurface {
+    WrapSurface::Cone {
+        frame: Plane {
+            origin: Point::new(0.0, 0.0, 0.0),
+            normal: Vector::new(0.0, 0.0, 1.0),
+            x_axis: Vector::new(-1.0, 0.0, 0.0),
+        },
+        radius: FRUSTUM_BOTTOM,
+        half_angle: frustum_half_angle(),
+    }
+}
+
+/// One input of the spike.
+#[derive(Debug, Clone)]
+pub struct Input {
+    /// Its name in test and row names.
+    pub name: &'static str,
+    /// The body the outlines go onto.
+    pub body: Shape,
+    /// The surface, regions and depth, raised or recessed (the thickening is set per
+    /// construction).
+    pub spec: EmbossSpec,
+    /// Whether it is the 20-character label, whose time and poll gap section 8.3 bounds.
+    pub is_label: bool,
+}
+
+/// The cylinder of radius 15 mm, 14 mm tall.
+pub fn cylinder() -> Shape {
+    make_cylinder(&Plane::XY, CYLINDER_RADIUS, CYLINDER_HEIGHT)
+        .expect("the cylinder builds")
+        .shape
+}
+
+/// The frustum of radii 20 and 15 mm, 30 mm tall.
+pub fn frustum() -> Shape {
+    make_cone(&Plane::XY, FRUSTUM_BOTTOM, FRUSTUM_TOP, FRUSTUM_HEIGHT)
+        .expect("the frustum builds")
+        .shape
+}
+
+/// The spec of one input, with the first construction; each test and row sets its own.
+fn spec(surface: WrapSurface, regions: Vec<WrapRegion>, kind: EmbossKind) -> EmbossSpec {
+    EmbossSpec {
+        surface,
+        regions,
+        depth: DEPTH,
+        kind,
+        thickening: Thickening::SimpleOffset,
+    }
+}
+
+/// Where the 20-character label starts so that its middle faces away from the cylinder's seam.
+pub fn label_start() -> f64 {
+    PI * CYLINDER_RADIUS - text_length(LABEL) / 2.0
+}
+
+/// Where the 20-character label starts so that the cylinder's seam runs through the middle of
+/// its `SEAM_CHARACTER`.
+pub fn seam_label_start() -> f64 {
+    let character = LABEL
+        .chars()
+        .nth(SEAM_CHARACTER)
+        .expect("the label is long enough");
+    -(character_starts(LABEL)[SEAM_CHARACTER] + glyph(character).1 / 2.0)
+}
+
+/// The underline of the long label: a rectangle under the 20 characters starting at `start`.
+pub fn underline(start: f64) -> WrapRegion {
+    let (left, right) = (
+        start - UNDERLINE_OVERHANG,
+        start + text_length(LABEL) + UNDERLINE_OVERHANG,
+    );
+    let (bottom, top) = (
+        CYLINDER_BASELINE - UNDERLINE_GAP - UNDERLINE,
+        CYLINDER_BASELINE - UNDERLINE_GAP,
+    );
+    region(
+        polygon(&[(left, bottom), (right, bottom), (right, top), (left, top)]),
+        Vec::new(),
+    )
+}
+
+/// The frustum's label: centered on the developed plane's y axis at the middle of the slant.
+pub fn frustum_regions() -> Vec<WrapRegion> {
+    let slant = (FRUSTUM_HEIGHT * FRUSTUM_HEIGHT
+        + (FRUSTUM_BOTTOM - FRUSTUM_TOP) * (FRUSTUM_BOTTOM - FRUSTUM_TOP))
+        .sqrt();
+    text_regions(
+        SHORT_LABEL,
+        -text_length(SHORT_LABEL) / 2.0,
+        (slant - CAP_HEIGHT) / 2.0,
+    )
+}
+
+/// Every input of the spike (section 8.3), raised and recessed.
+pub fn inputs() -> Vec<Input> {
+    let mut inputs = Vec::new();
+    for kind in [EmbossKind::Raised, EmbossKind::Recessed] {
+        let label = text_regions(LABEL, label_start(), CYLINDER_BASELINE);
+        let seam = text_regions(LABEL, seam_label_start(), CYLINDER_BASELINE);
+        let mut long = label.clone();
+        long.push(underline(label_start()));
+        let names = match kind {
+            EmbossKind::Raised => ["label raised", "seam raised", "long raised", "cone raised"],
+            EmbossKind::Recessed => [
+                "label recessed",
+                "seam recessed",
+                "long recessed",
+                "cone recessed",
+            ],
+        };
+        inputs.push(Input {
+            name: names[0],
+            body: cylinder(),
+            spec: spec(cylinder_surface(), label, kind),
+            is_label: true,
+        });
+        inputs.push(Input {
+            name: names[1],
+            body: cylinder(),
+            spec: spec(cylinder_surface(), seam, kind),
+            is_label: true,
+        });
+        inputs.push(Input {
+            name: names[2],
+            body: cylinder(),
+            spec: spec(cylinder_surface(), long, kind),
+            is_label: false,
+        });
+        inputs.push(Input {
+            name: names[3],
+            body: frustum(),
+            spec: spec(frustum_surface(), frustum_regions(), kind),
+            is_label: false,
+        });
+    }
+    inputs
+}
+
+/// The two constructions of section 8.3, by name.
+pub const CONSTRUCTIONS: [(&str, Thickening); 2] = [
+    ("simple-offset", Thickening::SimpleOffset),
+    ("thick-solid", Thickening::ThickSolidBySimple),
+];
