+//! The wrap-emboss spike (kernel spec section 8.3): both thickenings on every input, measured as
+//! section 8.1 item 4 asks. Each test prints its measurements, with one canonical `parity` line
+//! per shape that the native and WebAssembly runs compare (ADR 0042), and pins the criteria of
+//! section 8.3's Pass but time and parity that the input fails, as the spike recorded them.
+
+use std::collections::BTreeMap;
+use std::f64::consts::TAU;
+
+use partsmith_mesh::{TessellationTolerance, WELD_TOLERANCE};
+use partsmith_occt_sys::{
+    EmbossKind, EmbossPart, EmbossResult, EmbossSource, EmbossSpec, Interrupt, Plane, Point,
+    Point2, Shape, SubShapeKind, Thickening, Validity, Vector, WrapBspline, WrapCurve, WrapLoop,
+    WrapSurface, adaptive_volume, edge_length, edge_points, face_points, wrap_curves, wrap_emboss,
+};
+
+use crate::common::assert_closed;
+use crate::emboss_inputs::{CONSTRUCTIONS, DEPTH, Input, inputs};
+
+/// The tolerance of tests 137 and 138: 0.05 mm and 5 degrees.
+const FINE: TessellationTolerance = TessellationTolerance {
+    chord_deviation: 0.05,
+    angular_deviation: 0.087_266_462_599_716_48,
+};
+
+/// The points sampled on each raised top face, and along each of its edges (measured only).
+const SAMPLES: u32 = 20;
+
+/// How far a top face's points may lie from the offset surface (section 8.3's Checks).
+const SURFACE_TOLERANCE: f64 = 1e-6;
+
+/// How far a wrapped outline's length may differ from its planar length, relative.
+const LENGTH_TOLERANCE: f64 = 1e-6;
+
+/// The canonical summary of a shape that the native and WebAssembly runs compare.
+fn parity_line(key: &str, stage: &str, shape: &Shape) -> String {
+    let volume = shape.volume().expect("the shape is measured");
+    let area = shape.area().expect("the shape is measured");
+    let Ok(bounds) = shape.bounding_box() else {
+        return format!("parity {key} {stage}: empty");
+    };
+    format!(
+        "parity {key} {stage}: faces={} edges={} vertices={} volume={volume:?} area={area:?} min={:?} max={:?}",
+        shape.count(SubShapeKind::Face),
+        shape.count(SubShapeKind::Edge),
+        shape.count(SubShapeKind::Vertex),
+        bounds.min,
+        bounds.max
+    )
+}
+
+/// The undirected edges of the welded mesh that are not used by exactly two triangles, or the
+/// tessellation's error (test 138's check).
+fn open_mesh_edges(shape: &Shape) -> Result<usize, String> {
+    let mesh = shape
+        .tessellate(&FINE, &Interrupt::new())
+        .map_err(|error| error.detail())?;
+    let welded = mesh
+        .weld(WELD_TOLERANCE)
+        .expect("WELD_TOLERANCE is a valid weld tolerance")
+        .mesh;
+    let triangles: Vec<[usize; 3]> = welded
+        .triangles()
+        .iter()
+        .map(|corners| corners.map(|vertex| vertex as usize))
+        .collect();
+    let mut uses: BTreeMap<(usize, usize), usize> = BTreeMap::new();
+    for [first, second, third] in &triangles {
+        for (start, end) in [(*first, *second), (*second, *third), (*third, *first)] {
+            *uses.entry((start.min(end), start.max(end))).or_insert(0) += 1;
+        }
+    }
+    let open = uses.values().filter(|count| **count != 2).count();
+    if open == 0 {
+        assert_closed(&triangles);
+    }
+    Ok(open)
+}
+
+/// The vector from `from` to `to`.
+fn between(from: Point, to: Point) -> Vector {
+    Vector::new(to.x - from.x, to.y - from.y, to.z - from.z)
+}
+
+/// The signed distance of `point` from `surface` along its normal that points away from the
+/// axis: on a cylinder its distance from the axis less the radius, on a cone its distance from
+/// the cone's line in the point's axial half-plane.
+fn surface_distance(surface: &WrapSurface, point: Point) -> f64 {
+    let (frame, radius, half_angle) = match *surface {
+        WrapSurface::Cylinder { frame, radius } => (frame, radius, 0.0),
+        WrapSurface::Cone {
+            frame,
+            radius,
+            half_angle,
+        } => (frame, radius, half_angle),
+    };
+    let normal = frame.normal.normalized().expect("the frame has a normal");
+    let offset = between(frame.origin, point);
+    let height = offset.dot(normal);
+    let along = normal.scaled(height);
+    let radial = Vector::new(offset.x - along.x, offset.y - along.y, offset.z - along.z).length();
+    (radial - (radius + height * half_angle.tan())) * half_angle.cos()
+}
+
+/// The planar length of a periodic uniform cubic B-spline, by 10-point Gauss-Legendre
+/// quadrature on 16 pieces of each span: the only B-spline of the spike's alphabet.
+fn uniform_cubic_length(bspline: &WrapBspline) -> f64 {
+    const NODES: [f64; 5] = [
+        0.148_874_338_981_631_2,
+        0.433_395_394_129_247_2,
+        0.679_409_568_299_024_4,
+        0.865_063_366_688_984_5,
+        0.973_906_528_517_171_7,
+    ];
+    const WEIGHTS: [f64; 5] = [
+        0.295_524_224_714_752_9,
+        0.269_266_719_309_996_4,
+        0.219_086_362_515_982,
+        0.149_451_349_150_580_6,
+        0.066_671_344_308_688_1,
+    ];
+    const PIECES: usize = 16;
+    assert!(bspline.periodic && bspline.degree == 3);
+    let poles = &bspline.poles;
+    let count = poles.len();
+    let speed = |span: usize, parameter: f64| {
+        let weights = [
+            -(1.0 - parameter) * (1.0 - parameter) / 2.0,
+            (3.0 * parameter * parameter - 4.0 * parameter) / 2.0,
+            (-3.0 * parameter * parameter + 2.0 * parameter + 1.0) / 2.0,
+            parameter * parameter / 2.0,
+        ];
+        let (mut x, mut y) = (0.0, 0.0);
+        for (offset, weight) in weights.iter().enumerate() {
+            let pole = poles[(span + offset) % count];
+            x += weight * pole.x;
+            y += weight * pole.y;
+        }
+        x.hypot(y)
+    };
+    let mut length = 0.0;
+    for span in 0..count {
+        for piece in 0..PIECES {
+            let (low, high) = (
+                piece as f64 / PIECES as f64,
+                (piece + 1) as f64 / PIECES as f64,
+            );
+            let (middle, half) = ((low + high) / 2.0, (high - low) / 2.0);
+            for (node, weight) in NODES.iter().zip(WEIGHTS) {
+                length += weight
+                    * half
+                    * (speed(span, middle - half * node) + speed(span, middle + half * node));
+            }
+        }
+    }
+    length
+}
+
+/// The length of a curve of the developed plane.
+fn planar_length(curve: &WrapCurve) -> f64 {
+    match curve {
+        WrapCurve::Segment { start, end } => (end.x - start.x).hypot(end.y - start.y),
+        WrapCurve::Arc { radius, sweep, .. } => radius * sweep.abs(),
+        WrapCurve::Bspline(bspline) => uniform_cubic_length(bspline),
+        WrapCurve::Helix(_) => unreachable!("an emboss has no helix"),
+    }
+}
+
+/// Every loop of a spec in order, each with the number of its first curve.
+fn loops(spec: &EmbossSpec) -> Vec<(u32, &WrapLoop)> {
+    let mut first = 0u32;
+    let mut loops = Vec::new();
+    for region in &spec.regions {
+        for outline in std::iter::once(&region.outer).chain(&region.holes) {
+            loops.push((first, outline));
+            first += outline.curves.len() as u32;
+        }
+    }
+    loops
+}
+
+/// The smallest and largest x of the spec's curves in the developed plane, from their ends,
+/// arc centers less their radii and B-spline poles.
+fn developed_extent(spec: &EmbossSpec) -> (f64, f64) {
+    let mut extent = (f64::INFINITY, f64::NEG_INFINITY);
+    let mut add = |x: f64| extent = (extent.0.min(x), extent.1.max(x));
+    for (_, outline) in loops(spec) {
+        for curve in &outline.curves {
+            match curve {
+                WrapCurve::Segment { start, end } => {
+                    add(start.x);
+                    add(end.x);
+                }
+                WrapCurve::Arc { center, radius, .. } => {
+                    add(center.x - radius);
+                    add(center.x + radius);
+                }
+                WrapCurve::Bspline(bspline) => bspline.poles.iter().for_each(|pole| add(pole.x)),
+                WrapCurve::Helix(_) => {}
+            }
+        }
+    }
+    extent
+}
+
+/// The largest relative difference between a wrapped outline's length (its base edges in the
+/// construction, along their 3D curves) and its planar length.
+fn length_error(result: &EmbossResult, spec: &EmbossSpec) -> f64 {
+    let mut wrapped: BTreeMap<u32, f64> = BTreeMap::new();
+    for role in &result.roles {
+        if role.part == EmbossPart::BaseEdge {
+            let curve = role.curve.expect("a base edge comes from a curve");
+            *wrapped.entry(curve).or_insert(0.0) +=
+                edge_length(&result.construction, role.element.index).expect("the edge measures");
+        }
+    }
+    loops(spec)
+        .into_iter()
+        .map(|(first, outline)| {
+            let planar: f64 = outline.curves.iter().map(planar_length).sum();
+            let length: f64 = (first..first + outline.curves.len() as u32)
+                .map(|curve| wrapped.get(&curve).copied().unwrap_or(f64::NAN))
+                .sum();
+            ((length - planar) / planar).abs()
+        })
+        .fold(0.0, f64::max)
+}
+
+/// The faces of `shape` that are raised top faces: in the construction, the faces of the role
+/// `TopFace`; in the result, the faces whose origins in the construction (input 1) are.
+fn top_faces(result: &EmbossResult, in_result: bool) -> Vec<u32> {
+    let tops: Vec<u32> = result
+        .roles
+        .iter()
+        .filter(|role| role.part == EmbossPart::TopFace)
+        .map(|role| role.element.index)
+        .collect();
+    if !in_result {
+        return tops;
+    }
+    (1..=result.shape.count(SubShapeKind::Face))
+        .filter(|face| {
+            result
+                .history
+                .modified_from(SubShapeKind::Face, *face)
+                .iter()
+                .any(|origin| origin.input == 1 && tops.contains(&origin.element.index))
+        })
+        .collect()
+}
+
+/// How far the top faces of `shape` lie from the offset surface at their vertices and at
+/// `SAMPLES` points of each, and (measured only) at `SAMPLES` points of each of their edges.
+fn top_deviation(shape: &Shape, faces: &[u32], surface: &WrapSurface, offset: f64) -> (f64, f64) {
+    let topology = shape.topology().expect("the shape has a topology");
+    let deviation = |point: Point| (surface_distance(surface, point) - offset).abs();
+    let mut on_face: f64 = 0.0;
+    let mut on_edges: f64 = 0.0;
+    for &face in faces {
+        let entry = &topology.faces[face as usize - 1];
+        for &vertex in &entry.vertices {
+            let position = shape
+                .element(SubShapeKind::Vertex, vertex)
+                .expect("the vertex is measured")
+                .centroid;
+            on_face = on_face.max(deviation(position));
+        }
+        for point in face_points(shape, face, SAMPLES).expect("the face is sampled") {
+            on_face = on_face.max(deviation(point));
+        }
+        for &edge in &entry.edges {
+            for point in edge_points(shape, edge, SAMPLES).expect("the edge is sampled") {
+                on_edges = on_edges.max(deviation(point));
+            }
+        }
+    }
+    (on_face, on_edges)
+}
+
+/// What a result element descends from.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, PartialOrd, Ord)]
+enum Descent {
+    /// An element of the body.
+    Body,
+    /// An element of the construction with its part and what named it, and whether the boolean
+    /// kept it whole (`true`) or made it one of several images.
+    Construction(EmbossPart, EmbossSource, bool),
+    /// An element of the construction that no role names.
+    Unnamed,
+    /// Only generated by the boolean, or nothing at all.
+    New,
+}
+
+/// For each kind, how many result elements descend from each combination of origins.
+fn history_counts(result: &EmbossResult) -> BTreeMap<(SubShapeKind, Vec<Descent>), usize> {
+    let roles: BTreeMap<(SubShapeKind, u32), (EmbossPart, EmbossSource)> = result
+        .roles
+        .iter()
+        .map(|role| {
+            (
+                (role.element.kind, role.element.index),
+                (role.part, role.source),
+            )
+        })
+        .collect();
+    let mut counts = BTreeMap::new();
+    for kind in [SubShapeKind::Face, SubShapeKind::Edge, SubShapeKind::Vertex] {
+        for index in 1..=result.shape.count(kind) {
+            let mut descents: Vec<Descent> = result
+                .history
+                .modified_from(kind, index)
+                .into_iter()
+                .map(|origin| {
+                    if origin.input == 0 {
+                        return Descent::Body;
+                    }
+                    let fates = &result.history.inputs[1];
+                    let fate = match kind {
+                        SubShapeKind::Face => &fates.faces,
+                        SubShapeKind::Edge => &fates.edges,
+                        _ => &fates.vertices,
+                    }[origin.element.index as usize - 1]
+                        .clone();
+                    match roles.get(&(origin.element.kind, origin.element.index)) {
+                        Some((part, source)) => {
+                            Descent::Construction(*part, *source, fate.modified.len() == 1)
+                        }
+                        None => Descent::Unnamed,
+                    }
+                })
+                .collect();
+            if descents.is_empty() {
+                descents.push(Descent::New);
+            }
+            descents.sort();
+            descents.dedup();
+            *counts.entry((kind, descents)).or_insert(0) += 1;
+        }
+    }
+    counts
+}
+
+/// The elements of the construction that no role names, by kind.
+fn unnamed_construction(result: &EmbossResult) -> BTreeMap<SubShapeKind, usize> {
+    let mut unnamed = BTreeMap::new();
+    for kind in [SubShapeKind::Face, SubShapeKind::Edge, SubShapeKind::Vertex] {
+        let count = (1..=result.construction.count(kind))
+            .filter(|index| {
+                !result
+                    .roles
+                    .iter()
+                    .any(|role| role.element.kind == kind && role.element.index == *index)
+            })
+            .count();
+        unnamed.insert(kind, count);
+    }
+    unnamed
+}
+
+/// The construction's roles counted by part and source.
+fn role_counts(result: &EmbossResult) -> BTreeMap<(EmbossPart, EmbossSource), usize> {
+    let mut counts = BTreeMap::new();
+    for role in &result.roles {
+        *counts.entry((role.part, role.source)).or_insert(0) += 1;
+    }
+    counts
+}
+
+/// The construction's top faces that have no image in the result.
+fn lost_top_faces(result: &EmbossResult) -> usize {
+    result
+        .roles
+        .iter()
+        .filter(|role| role.part == EmbossPart::TopFace)
+        .filter(|role| {
+            result.history.inputs[1].faces[role.element.index as usize - 1]
+                .modified
+                .is_empty()
+        })
+        .count()
+}
+
+/// The volume checks (measured, not a criterion of section 8.3): `Shape::volume` and the adaptive
+/// volume of the construction and the result, and how far the result's adaptive volume is from
+/// the body's with the construction's added (raised) or taken away (recessed), relative.
+fn volume_line(key: &str, input: &Input, result: &EmbossResult) -> String {
+    let measure = |shape: &Shape| {
+        (
+            shape.volume().expect("the shape is measured"),
+            adaptive_volume(shape).expect("the shape is measured"),
+        )
+    };
+    let body = measure(&input.body);
+    let construction = measure(&result.construction);
+    let joined = measure(&result.shape);
+    let expected = match input.spec.kind {
+        EmbossKind::Raised => body.1 + construction.1,
+        EmbossKind::Recessed => body.1 - construction.1,
+    };
+    format!(
+        "{key}: volumes (Shape::volume, adaptive): body {body:?}, construction {construction:?}, result {joined:?}; result off the body {} the construction by {:.3e} relative",
+        match input.spec.kind {
+            EmbossKind::Raised => "with",
+            EmbossKind::Recessed => "without",
+        },
+        (joined.1 - expected).abs() / expected
+    )
+}
+
+/// True when `value` is at most `limit`; false for NaN.
+fn within(value: f64, limit: f64) -> bool {
+    value <= limit
+}
+
+/// The criteria of section 8.3's Pass but time and parity that an input fails.
+fn failures(
+    result: &EmbossResult,
+    top: (f64, f64),
+    length: Option<f64>,
+    construction_valid: bool,
+    result_valid: bool,
+) -> Vec<&'static str> {
+    let mut failures = Vec::new();
+    if result.construction_validity != Validity::AsBuilt || !construction_valid {
+        failures.push("the construction is not valid as built");
+    }
+    if result.result_validity != Validity::AsBuilt || !result_valid {
+        failures.push("the emboss with its boolean is not valid as built");
+    }
+    if !within(top.0, SURFACE_TOLERANCE) {
+        failures.push("a raised top face is off the offset surface");
+    }
+    if lost_top_faces(result) > 0 {
+        failures.push("the result lost raised top faces");
+    }
+    if length.is_some_and(|error| !within(error, LENGTH_TOLERANCE)) {
+        failures.push("a wrapped outline's length is not its planar length");
+    }
+    failures
+}
+
+/// Runs one construction on one input, prints its measurements and returns the criteria it fails
+/// (or the failure of the call).
+fn measure(input: &Input, name: &str, thickening: Thickening) -> Vec<String> {
+    let key = format!("{} {name}", input.name);
+    let spec = EmbossSpec {
+        thickening,
+        ..input.spec.clone()
+    };
+    let result = match wrap_emboss(&input.body, &spec, &Interrupt::new()) {
+        Ok(result) => result,
+        Err(error) => {
+            println!("{key}: failed: {}", error.detail());
+            println!("parity {key} failure: {}", error.detail());
+            return vec![format!("failed: {}", error.detail())];
+        }
+    };
+    let offset = match input.spec.kind {
+        EmbossKind::Raised => DEPTH,
+        EmbossKind::Recessed => -DEPTH,
+    };
+    let construction_valid = result.construction.is_valid().expect("the check runs");
+    let result_valid = result.shape.is_valid().expect("the check runs");
+    let construction_top = top_deviation(
+        &result.construction,
+        &top_faces(&result, false),
+        &spec.surface,
+        offset,
+    );
+    let result_faces = top_faces(&result, true);
+    let result_top = top_deviation(&result.shape, &result_faces, &spec.surface, offset);
+    let worst_top = (
+        construction_top.0.max(result_top.0),
+        construction_top.1.max(result_top.1),
+    );
+    let length = length_error(&result, &spec);
+    let on_cylinder = matches!(spec.surface, WrapSurface::Cylinder { .. });
+    let (left, right) = developed_extent(&spec);
+    println!(
+        "{key}: {} regions, {} curves, from x = {left:.4} to {right:.4} mm of the developed plane ({:.4} mm{}); the 20-character label: {}",
+        spec.regions.len(),
+        loops(&spec)
+            .iter()
+            .map(|(_, outline)| outline.curves.len())
+            .sum::<usize>(),
+        right - left,
+        match spec.surface {
+            WrapSurface::Cylinder { radius, .. } => format!(
+                ", {:.4} rad, {:.1} percent of the circumference",
+                (right - left) / radius,
+                100.0 * (right - left) / (TAU * radius)
+            ),
+            WrapSurface::Cone { .. } => String::new(),
+        },
+        input.is_label
+    );
+    println!(
+        "{key}: construction {:?} (is_valid {construction_valid}), result {:?} (is_valid {result_valid}); open mesh edges: construction {:?}, result {:?}",
+        result.construction_validity,
+        result.result_validity,
+        open_mesh_edges(&result.construction),
+        open_mesh_edges(&result.shape),
+    );
+    println!(
+        "{key}: top faces {} in the construction, {} in the result; off the offset surface: construction {:.3e} mm (edges {:.3e}), result {:.3e} mm (edges {:.3e})",
+        top_faces(&result, false).len(),
+        result_faces.len(),
+        construction_top.0,
+        construction_top.1,
+        result_top.0,
+        result_top.1,
+    );
+    println!(
+        "{key}: wrapped outline length error {length:.3e} relative ({}); map deviation {:.3e} mm",
+        if on_cylinder { "checked" } else { "measured" },
+        result.map_deviation
+    );
+    println!(
+        "{key}: polls {} first {:.3?} longest {:.3?} after poll {} last {:.3?} total {:.3?} (debug build)",
+        result.polls.count,
+        result.polls.first,
+        result.polls.longest,
+        result.polls.longest_after,
+        result.polls.last,
+        result.polls.total
+    );
+    println!("{key}: roles {:?}", role_counts(&result));
+    println!(
+        "{key}: construction elements no role names {:?}",
+        unnamed_construction(&result)
+    );
+    for ((kind, descents), count) in history_counts(&result) {
+        println!("{key}: history {kind:?} x{count} from {descents:?}");
+    }
+    println!("{}", volume_line(&key, input, &result));
+    println!(
+        "{}",
+        parity_line(&key, "construction", &result.construction)
+    );
+    println!("{}", parity_line(&key, "result", &result.shape));
+    failures(
+        &result,
+        worst_top,
+        on_cylinder.then_some(length),
+        construction_valid,
+        result_valid,
+    )
+    .into_iter()
+    .map(String::from)
+    .collect()
+}
+
+/// Runs one input with one construction and checks the failures the spike recorded for it.
+fn check(input_name: &str, construction: &str, expected: &[&str]) {
+    let input = inputs()
+        .into_iter()
+        .find(|input| input.name == input_name)
+        .expect("the input exists");
+    let (name, thickening) = CONSTRUCTIONS
+        .into_iter()
+        .find(|(name, _)| *name == construction)
+        .expect("the construction exists");
+    let failures = measure(&input, name, thickening);
+    println!("{input_name} {construction}: fails {failures:?}");
+    assert_eq!(failures, expected, "{input_name} {construction}");
+}
+
+macro_rules! spike_tests {
+    ($($test:ident: $input:literal, $construction:literal, [$($failure:literal),*];)*) => {
+        $(
+            #[test]
+            fn $test() {
+                check($input, $construction, &[$($failure),*]);
+            }
+        )*
+    };
+}
+
+spike_tests! {
+    label_raised_simple_offset: "label raised", "simple-offset", [];
+    label_raised_thick_solid: "label raised", "thick-solid", [];
+    label_recessed_simple_offset: "label recessed", "simple-offset", [];
+    label_recessed_thick_solid: "label recessed", "thick-solid", [];
+    seam_raised_simple_offset: "seam raised", "simple-offset", [];
+    seam_raised_thick_solid: "seam raised", "thick-solid", [];
+    seam_recessed_simple_offset: "seam recessed", "simple-offset", [];
+    seam_recessed_thick_solid: "seam recessed", "thick-solid", [];
+    long_raised_simple_offset: "long raised", "simple-offset", [];
+    long_raised_thick_solid: "long raised", "thick-solid", [];
+    long_recessed_simple_offset: "long recessed", "simple-offset", [];
+    long_recessed_thick_solid: "long recessed", "thick-solid", [];
+    cone_raised_simple_offset: "cone raised", "simple-offset", [];
+    cone_raised_thick_solid: "cone raised", "thick-solid", [];
+    cone_recessed_simple_offset: "cone recessed", "simple-offset", [];
+    cone_recessed_thick_solid: "cone recessed", "thick-solid", [];
+}
+
+/// The inverse of the cone's parameter-plane map at a point of its surface: the point of the
+/// developed plane it comes from.
+fn developed_point(surface: &WrapSurface, point: Point) -> Point2 {
+    let WrapSurface::Cone {
+        frame,
+        radius,
+        half_angle,
+    } = *surface
+    else {
+        unreachable!("the check is for a cone")
+    };
+    let normal = frame.normal.normalized().expect("a unit normal");
+    let x_axis = frame.x_axis.normalized().expect("a unit x axis");
+    let y_axis = normal.cross(x_axis);
+    let offset = between(frame.origin, point);
+    let angle = offset.dot(y_axis).atan2(offset.dot(x_axis));
+    let slant = offset.dot(normal) / half_angle.cos();
+    let sine = half_angle.sin();
+    let apex = radius / sine;
+    let distance = (slant + apex) * sine.signum();
+    let sector = angle * sine.abs();
+    Point2 {
+        x: distance * sector.sin(),
+        y: sine.signum() * distance * sector.cos() - apex,
+    }
+}
+
+#[test]
+fn a_segment_and_an_arc_on_a_cone_lie_on_their_exact_images() {
+    let surface = WrapSurface::Cone {
+        frame: Plane::XY,
+        radius: 20.0,
+        half_angle: -(5.0_f64 / 30.0).atan(),
+    };
+    let start = Point2 { x: -3.0, y: 10.0 };
+    let end = Point2 { x: 4.0, y: 16.0 };
+    let center = Point2 { x: 1.0, y: 12.0 };
+    let curves = [
+        WrapCurve::Segment { start, end },
+        WrapCurve::Arc {
+            center,
+            radius: 2.5,
+            start_angle: -0.5,
+            sweep: -4.0,
+        },
+    ];
+    let edges = wrap_curves(&surface, &curves).expect("the curves map");
+
+    let mut worst: f64 = 0.0;
+    for point in edge_points(&edges, 1, SAMPLES).expect("the segment is sampled") {
+        worst = worst.max(surface_distance(&surface, point).abs());
+        let developed = developed_point(&surface, point);
+        let along = (end.x - start.x, end.y - start.y);
+        let length = along.0.hypot(along.1);
+        let across =
+            ((developed.x - start.x) * along.1 - (developed.y - start.y) * along.0) / length;
+        worst = worst.max(across.abs());
+    }
+    for point in edge_points(&edges, 2, SAMPLES).expect("the arc is sampled") {
+        worst = worst.max(surface_distance(&surface, point).abs());
+        let developed = developed_point(&surface, point);
+        let off = ((developed.x - center.x).hypot(developed.y - center.y) - 2.5).abs();
+        worst = worst.max(off);
+    }
+    println!(
+        "cone map: the sampled points lie {worst:.3e} mm off the cone or their developed curves"
+    );
+    assert!(worst < 1e-6, "{worst}");
+}
+
+#[test]
+fn an_arc_on_a_cylinder_is_an_exact_ellipse_of_the_parameter_plane() {
+    let surface = WrapSurface::Cylinder {
+        frame: Plane::XY,
+        radius: 15.0,
+    };
+    let center = Point2 { x: 40.0, y: 6.0 };
+    let arc = WrapCurve::Arc {
+        center,
+        radius: 1.5,
+        start_angle: 2.0,
+        sweep: -5.0,
+    };
+    let edges = wrap_curves(&surface, &[arc]).expect("the arc maps");
+
+    let mut worst: f64 = 0.0;
+    for point in edge_points(&edges, 1, SAMPLES).expect("the arc is sampled") {
+        let angle = point.y.atan2(point.x).rem_euclid(TAU);
+        let developed = Point2 {
+            x: 15.0 * angle,
+            y: point.z,
+        };
+        let off = ((developed.x - center.x).hypot(developed.y - center.y) - 1.5).abs();
+        worst = worst.max(off).max((point.x.hypot(point.y) - 15.0).abs());
+    }
+    println!("cylinder map: the arc's samples lie {worst:.3e} mm off the developed circle");
+    assert!(worst < 1e-6, "{worst}");
+}
