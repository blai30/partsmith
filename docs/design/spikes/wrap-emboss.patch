 //! The web core module `partsmith_core`: an Emscripten executable whose runtime stays alive after `main` returns, so JavaScript can call `ps_alloc`, `ps_free` and `ps_call` (protocol.md section 2.10, ADR 0009).
 
+use std::hint::black_box;
+
+use partsmith_occt_sys::{
+    EmbossKind, EmbossSpec, Interrupt, Plane, Point2, Thickening, WrapCurve, WrapLoop, WrapRegion,
+    WrapSurface, adaptive_volume, edge_length, edge_points, face_points, make_cone, make_cylinder,
+    wrap_curves, wrap_emboss,
+};
+
 fn main() {
     // Creating the session here pays its setup cost while the module is instantiated. Calling into the library also keeps it, and with it the three exports, in the link.
     partsmith_wasm::initialize_session();
+    keep_wrap_emboss_spike();
+}
+
+/// A square of the developed plane, 1 mm across, with its lower left corner at (x, y), counterclockwise.
+fn square(x: f64, y: f64) -> WrapRegion {
+    let corners = [(x, y), (x + 1.0, y), (x + 1.0, y + 1.0), (x, y + 1.0)];
+    let curves = (0..corners.len())
+        .map(|corner| {
+            let (start_x, start_y) = corners[corner];
+            let (end_x, end_y) = corners[(corner + 1) % corners.len()];
+            WrapCurve::Segment {
+                start: Point2 {
+                    x: start_x,
+                    y: start_y,
+                },
+                end: Point2 { x: end_x, y: end_y },
+            }
+        })
+        .collect();
+    WrapRegion {
+        outer: WrapLoop { curves },
+        holes: Vec::new(),
+    }
+}
+
+/// Calls each function of the wrap-emboss spike once on a small input, both thickenings and both surfaces among them, so the linker keeps their code for the size measurement (kernel spec section 8.1 items 2 and 4).
+fn keep_wrap_emboss_spike() {
+    let cylinder = WrapSurface::Cylinder {
+        frame: Plane::XY,
+        radius: 5.0,
+    };
+    let cone = WrapSurface::Cone {
+        frame: Plane::XY,
+        radius: 5.0,
+        half_angle: -0.1,
+    };
+    let arc = WrapCurve::Arc {
+        center: Point2 { x: 0.0, y: 1.0 },
+        radius: 0.5,
+        start_angle: 0.0,
+        sweep: 1.0,
+    };
+    if let Ok(edges) = wrap_curves(&cylinder, &[arc]) {
+        black_box(edge_points(&edges, 1, 2).ok());
+        black_box(edge_length(&edges, 1).ok());
+    }
+    let interrupt = Interrupt::new();
+    let bodies = [
+        make_cylinder(&Plane::XY, 5.0, 3.0),
+        make_cone(&Plane::XY, 5.0, 4.7, 3.0),
+    ];
+    let embosses = [
+        (cylinder, EmbossKind::Raised, Thickening::SimpleOffset),
+        (cone, EmbossKind::Recessed, Thickening::ThickSolidBySimple),
+    ];
+    for (body, (surface, kind, thickening)) in bodies.into_iter().zip(embosses) {
+        let Ok(body) = body else {
+            continue;
+        };
+        let spec = EmbossSpec {
+            surface,
+            regions: vec![square(0.0, 1.0)],
+            depth: 0.3,
+            kind,
+            thickening,
+        };
+        if let Ok(emboss) = wrap_emboss(&body.shape, &spec, &interrupt) {
+            black_box(face_points(&emboss.construction, 1, 2).ok());
+            black_box(adaptive_volume(&emboss.shape).ok());
+        }
+    }
 }
