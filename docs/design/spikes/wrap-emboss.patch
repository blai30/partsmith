+                Vec::new(),
+            )],
+            0.8,
+        ),
+        'H' => (
+            vec![region(
+                polygon(&[
+                    (0.0, 0.0),
+                    (0.8, 0.0),
+                    (0.8, 2.1),
+                    (2.4, 2.1),
+                    (2.4, 0.0),
+                    (3.2, 0.0),
+                    (3.2, 5.0),
+                    (2.4, 5.0),
+                    (2.4, 2.9),
+                    (0.8, 2.9),
+                    (0.8, 5.0),
+                    (0.0, 5.0),
