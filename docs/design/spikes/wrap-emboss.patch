index 0000000..fa86aa9
--- /dev/null
+++ b/crates/partsmith-occt-sys/src/emboss.rs
@@ -0,0 +1,472 @@
+//! The wrap emboss of the wrap-emboss spike (kernel spec section 8.3): planar outlines mapped onto
+//! a cylinder or a cone by the parameter-plane map, made faces on it, thickened along its normals
+//! by one of two OCCT constructions, then fused to the body (raised) or cut from it (recessed).
+//! The result reports the construction's roles from OCCT's history, both validity checks, the
+//! call's polls and how far the cone's images lie from their exact images.
+
+use std::time::Duration;
+
+use crate::error::{KernelError, Operation, call};
+use crate::ffi::bridge as sys;
+use crate::history::{History, op_result_from_ffi};
+use crate::interrupt::Interrupt;
+use crate::parameter_plane::{WrapCurve, WrapSurface};
+use crate::shape::{Shape, SubShape, SubShapeKind};
+use crate::values::{Point, check_finite, is_positive_length};
+
+/// A closed loop of the developed plane: its curves in chain order, each running from its start
+/// to the next one's start.
+#[derive(Debug, Clone, PartialEq)]
+pub struct WrapLoop {
+    /// The curves in chain order.
+    pub curves: Vec<WrapCurve>,
+}
+
+/// An outer loop, counterclockwise in the developed plane, with hole loops, clockwise.
+#[derive(Debug, Clone, PartialEq)]
+pub struct WrapRegion {
+    /// The outer boundary.
+    pub outer: WrapLoop,
+    /// The holes inside the outer boundary.
+    pub holes: Vec<WrapLoop>,
+}
+
+/// How each wrapped face becomes a solid (section 8.3's two constructions).
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
+pub enum Thickening {
+    /// `BRepOffset_MakeSimpleOffset` with `SetBuildSolidFlag(true)`.
+    SimpleOffset,
+    /// `BRepOffsetAPI_MakeThickSolid::MakeThickSolidBySimple`.
+    ThickSolidBySimple,
+}
+
+/// Which way the outlines go from the surface, and so which boolean joins them to the body.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
+pub enum EmbossKind {
+    /// Thickened outward and fused to the body.
+    Raised,
+    /// Thickened inward and cut from the body.
+    Recessed,
+}
+
+/// A wrap emboss: outlines of the developed plane of `surface`, raised or recessed by `depth`.
+#[derive(Debug, Clone, PartialEq)]
+pub struct EmbossSpec {
+    /// The cylinder or cone the outlines are mapped onto.
+    pub surface: WrapSurface,
+    /// The regions of the outlines.
+    pub regions: Vec<WrapRegion>,
+    /// How far the outlines are raised or recessed along the surface's normals.
+    pub depth: f64,
+    /// Raised or recessed.
+    pub kind: EmbossKind,
+    /// How each face is thickened.
+    pub thickening: Thickening,
+}
+
+/// What an element of a wrap emboss's construction is.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, PartialOrd, Ord, Hash)]
+pub enum EmbossPart {
+    /// The wrapped face on the surface.
+    BaseFace,
+    /// The face the thickening offset from it.
+    TopFace,
+    /// A face between a base edge and its top edge.
+    WallFace,
+    /// An edge of the wrapped face, from one curve.
+    BaseEdge,
+    /// The edge the thickening offset from a base edge.
+    TopEdge,
+    /// An edge from a base vertex to its top vertex.
+    WallEdge,
+    /// A vertex of the wrapped face, at the start of one curve.
+    BaseVertex,
+    /// The vertex the thickening offset from a base vertex.
+    TopVertex,
+}
+
+/// What named an element of a wrap emboss's construction.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, PartialOrd, Ord, Hash)]
+pub enum EmbossSource {
+    /// The element of the wrapped face itself, in the solid unchanged.
+    Section,
+    /// The thickening's `Modified` of an element of the wrapped face.
+    Modified,
+    /// The thickening's `Generated` of an element of the wrapped face.
+    Generated,
+    /// No history: the face holding a base edge and its top edge, or the edge joining a base
+    /// vertex and its top vertex.
+    Adjacent,
+}
+
+/// The role of one element of a wrap emboss's construction.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
+pub struct EmbossRole {
+    /// The element of the construction.
+    pub element: SubShape,
+    /// What it is.
+    pub part: EmbossPart,
+    /// The region it belongs to, in `EmbossSpec::regions` order.
+    pub region: u32,
+    /// The curve it comes from, numbered over every loop of every region in order (outer loop
+    /// first, then the holes); none for the base and top faces.
+    pub curve: Option<u32>,
+    /// What named it.
+    pub source: EmbossSource,
+}
+
+/// How a shape passed the checks of `BRepCheck_Analyzer` (section 8.1 item 4).
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
+pub enum Validity {
+    /// Valid as built.
+    AsBuilt,
+    /// Valid after `ShapeFix_Shape`.
+    AfterRepair,
+    /// Invalid after `ShapeFix_Shape`.
+    Invalid,
+}
+
+/// The polls of one call with an interrupt that is never requested (section 8.1 item 4).
+#[derive(Debug, Clone, Copy, PartialEq)]
+pub struct PollRecord {
+    /// The number of `UserBreak` calls.
+    pub count: u64,
+    /// From the call's start to its first poll.
+    pub first: Duration,
+    /// The longest gap between two polls.
+    pub longest: Duration,
+    /// How many polls came before the longest gap: it ends at poll `longest_after + 1`.
+    pub longest_after: u64,
+    /// From the last poll to the call's end.
+    pub last: Duration,
+    /// The whole call in the shim.
+    pub total: Duration,
+}
+
+/// A wrap emboss joined to its body.
+#[derive(Debug, Clone)]
+pub struct EmbossResult {
+    /// The body with the emboss.
+    pub shape: Shape,
+    /// The history of the boolean. Inputs: [body, construction].
+    pub history: History,
+    /// The construction alone: a compound of one solid per region, in region order.
+    pub construction: Shape,
+    /// The roles of the construction's elements.
+    pub roles: Vec<EmbossRole>,
+    /// The check of the construction.
+    pub construction_validity: Validity,
+    /// The check of the whole result of the boolean.
+    pub result_validity: Validity,
+    /// The polls of the call.
+    pub polls: PollRecord,
+    /// The largest distance on the surface between a curve's image and its exact image, at 51
+    /// samples of each curve: rounding on a cylinder, the approximation on a cone.
+    pub map_deviation: f64,
+}
+
+const DEPTH_MESSAGE: &str = "An emboss needs a depth greater than 0 mm.";
+const EMPTY_MESSAGE: &str = "An emboss needs at least one region, and every loop a curve.";
+const HELIX_MESSAGE: &str = "An emboss outline is made of segments, arcs and B-splines.";
+const NO_SOLID_MESSAGE: &str = "An emboss needs a body with a solid.";
+
+impl Validity {
+    fn from_ffi(
+        operation: Operation,
+        validity: sys::ValidityType,
+    ) -> Result<Validity, KernelError> {
+        match validity {
+            sys::ValidityType::AsBuilt => Ok(Validity::AsBuilt),
+            sys::ValidityType::AfterRepair => Ok(Validity::AfterRepair),
+            sys::ValidityType::Invalid => Ok(Validity::Invalid),
+            _ => Err(KernelError::unknown_from_shim(
+                operation,
+                "validity",
+                validity.repr,
+            )),
+        }
+    }
+}
+
+impl EmbossRole {
+    fn from_ffi(
+        operation: Operation,
+        role: sys::EmbossRoleData,
+    ) -> Result<EmbossRole, KernelError> {
+        let part = match role.part {
+            sys::EmbossPart::BaseFace => EmbossPart::BaseFace,
+            sys::EmbossPart::TopFace => EmbossPart::TopFace,
+            sys::EmbossPart::WallFace => EmbossPart::WallFace,
+            sys::EmbossPart::BaseEdge => EmbossPart::BaseEdge,
+            sys::EmbossPart::TopEdge => EmbossPart::TopEdge,
+            sys::EmbossPart::WallEdge => EmbossPart::WallEdge,
+            sys::EmbossPart::BaseVertex => EmbossPart::BaseVertex,
+            sys::EmbossPart::TopVertex => EmbossPart::TopVertex,
+            _ => {
+                return Err(KernelError::unknown_from_shim(
+                    operation,
+                    "emboss part",
+                    role.part.repr,
+                ));
+            }
+        };
+        let source = match role.source {
+            sys::EmbossSource::Section => EmbossSource::Section,
+            sys::EmbossSource::Modified => EmbossSource::Modified,
+            sys::EmbossSource::Generated => EmbossSource::Generated,
+            sys::EmbossSource::Adjacent => EmbossSource::Adjacent,
+            _ => {
+                return Err(KernelError::unknown_from_shim(
+                    operation,
+                    "emboss source",
+                    role.source.repr,
+                ));
+            }
+        };
+        Ok(EmbossRole {
+            element: SubShape {
+                kind: SubShapeKind::from_ffi(operation, role.kind)?,
+                index: role.index,
+            },
+            part,
+            region: role.region,
+            curve: (role.curve != u32::MAX).then_some(role.curve),
+            source,
+        })
+    }
+}
+
+impl PollRecord {
+    fn from_ffi(polls: sys::PollData) -> PollRecord {
+        let duration = |milliseconds: f64| Duration::from_secs_f64(milliseconds.max(0.0) / 1000.0);
+        PollRecord {
+            count: polls.count,
+            first: duration(polls.first),
+            longest: duration(polls.longest),
+            longest_after: polls.longest_after,
+            last: duration(polls.last),
+            total: duration(polls.total),
+        }
+    }
+}
+
+/// The bridge form of a spec's outlines: every curve in order, the number of curves of each
+/// loop, and the number of loops of each region.
+struct Outlines {
+    curves: Vec<sys::WrapCurveData>,
+    loops: Vec<u32>,
+    regions: Vec<u32>,
+}
+
+/// A count of curves or loops as the bridge takes it.
+fn count(length: usize) -> u32 {
+    u32::try_from(length).expect("an emboss has fewer than 2^32 curves and loops")
+}
+
+impl EmbossSpec {
+    /// Checks the spec (section 3.1 items 4 to 6) and returns its bridge form. The shim checks
+    /// what needs geometry: that each loop's curves meet end to end and that it runs the way its
+    /// place asks.
+    fn to_ffi(&self, operation: Operation) -> Result<(sys::EmbossSpecData, Outlines), KernelError> {
+        check_finite(operation, &[self.depth])?;
+        if !is_positive_length(self.depth) {
+            return Err(KernelError::invalid_input(operation, DEPTH_MESSAGE));
+        }
+        let surface = self.surface.to_ffi(operation)?;
+        let mut outlines = Outlines {
+            curves: Vec::new(),
+            loops: Vec::new(),
+            regions: Vec::new(),
+        };
+        for region in &self.regions {
+            for outline in std::iter::once(&region.outer).chain(&region.holes) {
+                if outline.curves.is_empty() {
+                    return Err(KernelError::invalid_input(operation, EMPTY_MESSAGE));
+                }
+                for curve in &outline.curves {
+                    if matches!(curve, WrapCurve::Helix(_)) {
+                        return Err(KernelError::invalid_input(operation, HELIX_MESSAGE));
+                    }
+                    outlines.curves.push(curve.to_ffi(operation, &surface)?);
+                }
+                outlines.loops.push(count(outline.curves.len()));
+            }
+            outlines.regions.push(count(region.holes.len() + 1));
+        }
+        if outlines.regions.is_empty() {
+            return Err(KernelError::invalid_input(operation, EMPTY_MESSAGE));
+        }
+        let thickening = match self.thickening {
+            Thickening::SimpleOffset => sys::ThickeningType::SimpleOffset,
+            Thickening::ThickSolidBySimple => sys::ThickeningType::ThickSolidBySimple,
+        };
+        let spec = sys::EmbossSpecData {
+            surface,
+            depth: self.depth,
+            raised: self.kind == EmbossKind::Raised,
+            thickening,
+        };
+        Ok((spec, outlines))
+    }
+}
+
+/// Maps the outlines of `spec` onto its surface, makes one face per region, thickens each by
+/// `spec.depth` along the surface's normals (outward when raised, inward when recessed) with
+/// `spec.thickening`, checks the compound of solids and repairs it when invalid, then fuses it to
+/// `body` (raised) or cuts it from it (recessed) with the settings of section 3.4.5 and checks
+/// the whole result. A construction that stays invalid after repair fails with `InvalidResult`; a
+/// result that does reports `Validity::Invalid`.
+pub fn wrap_emboss(
+    body: &Shape,
+    spec: &EmbossSpec,
+    interrupt: &Interrupt,
+) -> Result<EmbossResult, KernelError> {
+    let operation = Operation::Emboss;
+    let (data, outlines) = spec.to_ffi(operation)?;
+    if body.count(SubShapeKind::Solid) == 0 {
+        return Err(KernelError::invalid_input(operation, NO_SOLID_MESSAGE));
+    }
+    let data = call(operation, || {
+        sys::wrap_emboss(
+            body.inner(),
+            &data,
+            &outlines.curves,
+            &outlines.loops,
+            &outlines.regions,
+            interrupt,
+        )
+    })?;
+    let result = op_result_from_ffi(operation, data.result)?;
+    Ok(EmbossResult {
+        shape: result.shape,
+        history: result.history,
+        construction: Shape::from_ffi(operation, data.construction)?,
+        roles: data
+            .roles
+            .into_iter()
+            .map(|role| EmbossRole::from_ffi(operation, role))
+            .collect::<Result<_, KernelError>>()?,
+        construction_validity: Validity::from_ffi(operation, data.construction_validity)?,
+        result_validity: Validity::from_ffi(operation, data.result_validity)?,
+        polls: PollRecord::from_ffi(data.polls),
+        map_deviation: data.map_deviation,
+    })
+}
+
+/// `count` points of edge `edge` of `shape` (1-based), equally spaced in its 3D curve's
+/// parameter from its start to its end.
+pub fn edge_points(shape: &Shape, edge: u32, count: u32) -> Result<Vec<Point>, KernelError> {
+    let operation = Operation::Query;
+    shape.check_index(operation, SubShapeKind::Edge, edge)?;
+    let points = call(operation, || sys::edge_points(shape.inner(), edge, count))?;
+    Ok(points.into_iter().map(Point::from_ffi).collect())
+}
+
+/// `count` points of face `face` of `shape` (1-based): points of its surface at the cell centers
+/// inside it of the coarsest square grid over its parameter bounds, from 4 by 4 cells doubling up
+/// to 1024 by 1024, that puts at least `count` inside, spread evenly over that grid's inside ones.
+pub fn face_points(shape: &Shape, face: u32, count: u32) -> Result<Vec<Point>, KernelError> {
+    let operation = Operation::Query;
+    shape.check_index(operation, SubShapeKind::Face, face)?;
+    let points = call(operation, || sys::face_points(shape.inner(), face, count))?;
+    Ok(points.into_iter().map(Point::from_ffi).collect())
+}
+
+/// The length of edge `edge` of `shape` (1-based) along its 3D curve, by
+/// `GCPnts_AbscissaPoint::Length` within 1e-12 relative.
+pub fn edge_length(shape: &Shape, edge: u32) -> Result<f64, KernelError> {
+    let operation = Operation::Query;
+    shape.check_index(operation, SubShapeKind::Edge, edge)?;
+    call(operation, || sys::edge_length(shape.inner(), edge))
+}
+
+/// The volume of the solids of `shape` by `BRepGProp::VolumePropertiesGK`, adaptive Gauss-Kronrod
+/// integration over the spans of each face within 1e-10 relative: a second measure for the
+/// spike's volume checks, apart from `Shape::volume`.
+pub fn adaptive_volume(shape: &Shape) -> Result<f64, KernelError> {
+    let operation = Operation::Measure;
+    call(operation, || sys::adaptive_volume(shape.inner()))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::KernelErrorKind;
+    use crate::parameter_plane::Helix;
+    use crate::values::{Plane, Point2};
+
+    fn spec(regions: Vec<WrapRegion>, depth: f64) -> EmbossSpec {
+        EmbossSpec {
+            surface: WrapSurface::Cylinder {
+                frame: Plane::XY,
+                radius: 15.0,
+            },
+            regions,
+            depth,
+            kind: EmbossKind::Raised,
+            thickening: Thickening::SimpleOffset,
+        }
+    }
+
+    fn square() -> WrapRegion {
+        let corners = [(0.0, 0.0), (1.0, 0.0), (1.0, 1.0), (0.0, 1.0)];
+        let curves = (0..4)
+            .map(|corner| {
+                let (x, y) = corners[corner];
+                let (next_x, next_y) = corners[(corner + 1) % 4];
+                WrapCurve::Segment {
+                    start: Point2 { x, y },
+                    end: Point2 {
+                        x: next_x,
+                        y: next_y,
+                    },
+                }
+            })
+            .collect();
+        WrapRegion {
+            outer: WrapLoop { curves },
+            holes: Vec::new(),
+        }
+    }
+
+    fn refusal(spec: &EmbossSpec) -> KernelError {
+        wrap_emboss(&Shape::empty(), spec, &Interrupt::new()).expect_err("the spec is refused")
+    }
+
+    #[test]
+    fn an_emboss_without_depth_is_refused() {
+        let error = refusal(&spec(vec![square()], 0.0));
+
+        assert_eq!(error.message, DEPTH_MESSAGE);
+        assert_eq!(error.kind, KernelErrorKind::InvalidInput);
+    }
+
+    #[test]
+    fn an_emboss_without_regions_is_refused() {
+        let error = refusal(&spec(Vec::new(), 0.6));
+
+        assert_eq!(error.message, EMPTY_MESSAGE);
+    }
+
+    #[test]
+    fn an_outline_with_a_helix_is_refused() {
+        let mut region = square();
+        region.outer.curves.push(WrapCurve::Helix(Helix {
+            phase: 0.0,
+            height: 0.0,
+            pitch: 1.0,
+            turns: 1.0,
+        }));
+
+        let error = refusal(&spec(vec![region], 0.6));
+
+        assert_eq!(error.message, HELIX_MESSAGE);
+    }
+
+    #[test]
+    fn a_body_without_a_solid_is_refused() {
+        let error = refusal(&spec(vec![square()], 0.6));
+
+        assert_eq!(error.message, NO_SOLID_MESSAGE);
+    }
+}
