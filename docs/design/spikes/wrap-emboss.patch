+                vec![
+                    Pen::at(0.8, 1.5)
+                        .line(0.8, 3.5)
+                        .arc(1.5, 3.5, -180.0)
+                        .line(2.2, 1.5)
+                        .arc(1.5, 1.5, -180.0)
+                        .close(),
+                ],
+            )],
+            3.0,
+        ),
+        '6' => {
