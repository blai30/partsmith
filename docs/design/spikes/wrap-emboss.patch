+// The parameter-plane map of a cylinder or a cone (kernel spec sections 8.2 and 8.3): points and
+// curves of the developed plane and helices become points and curves of the surface's parameter
+// plane, and edges on the surface with their 3D curves built by BRepLib. The thread construction
+// of the helix-thread spike and the wrap emboss of the wrap-emboss spike share this code path.
+#include <algorithm>
+#include <cmath>
+
+#include <Adaptor2d_Curve2d.hxx>
+#include <BRepBuilderAPI_MakeEdge.hxx>
+#include <BRepLib.hxx>
+#include <BRep_Builder.hxx>
+#include <Geom2dAdaptor_Curve.hxx>
+#include <Geom2dConvert_ApproxCurve.hxx>
+#include <Geom2d_BSplineCurve.hxx>
+#include <Geom2d_Circle.hxx>
+#include <Geom2d_Ellipse.hxx>
+#include <Geom2d_Line.hxx>
+#include <Geom_ConicalSurface.hxx>
+#include <Geom_CylindricalSurface.hxx>
+#include <ShapeAnalysis_Edge.hxx>
+#include <TColStd_Array1OfInteger.hxx>
+#include <TColStd_Array1OfReal.hxx>
+#include <TColgp_Array1OfPnt2d.hxx>
+#include <TopoDS_Compound.hxx>
+
+#include "partsmith-occt-sys/cpp/internal.h"
+
+namespace partsmith {
+namespace occt {
+
+using namespace detail;
+
+namespace {
+
+// The most segments BRepLib may give the 3D curve of one turn of a helix, and of any curve.
+constexpr int kSegmentsPerTurn = 8;
+constexpr int kLeastSegments = 30;
+// The highest degree of a 3D curve, BRepLib's default.
+constexpr int kCurveDegree = 14;
+// The samples ShapeAnalysis_Edge compares the 3D curve with the curve on the surface at.
+constexpr int kCurveSamples = 23;
+
+// The samples at which the image of a developed curve is compared with its exact image.
+constexpr int kDeviationSamples = 50;
+
+// The most segments and the highest degree of the approximation of an image on a cone.
+constexpr int kImageSegments = 200;
+constexpr int kImageDegree = 14;
+
+// The second derivatives of a function of the developed plane with respect to x and y.
+struct Hessian {
+  double xx;
+  double xy;
+  double yy;
+};
+
+// The polar coordinates of the developed sector of a cone at a point of the developed plane, with
+// their first and second derivatives: `u` and `v` of the parameter plane, their gradients (the
+// Jacobian's rows) and their Hessians.
+struct PolarMap {
+  gp_Pnt2d value;
+  gp_Vec2d u_gradient;
+  gp_Vec2d v_gradient;
+  Hessian u_hessian;
+  Hessian v_hessian;
+};
+
+// The second derivative of one polar coordinate along a developed curve, from the curve's first
+// and second derivatives `tangent` and `curvature`, by the chain rule.
+double second_derivative(const gp_Vec2d &gradient, const Hessian &hessian, const gp_Vec2d &tangent,
+                         const gp_Vec2d &curvature) {
+  const double x = tangent.X();
+  const double y = tangent.Y();
+  return gradient.Dot(curvature) + hessian.xx * x * x + 2.0 * hessian.xy * x * y +
+         hessian.yy * y * y;
+}
+
+// The map of the developed plane of a cone onto its parameter plane at (x, y), as
+// developed_to_parameter computes it, with its derivatives.
+PolarMap polar_map(const WrapSurfaceData &surface, double x, double y) {
+  const double sine = std::sin(surface.half_angle);
+  const double side = sine > 0.0 ? 1.0 : -1.0;
+  const double magnitude = std::fabs(sine);
+  const double apex = surface.radius / sine;
+  const double along = side * (y + apex);
+  const double squared = x * x + along * along;
+  const double distance = std::sqrt(squared);
+  const double fourth = squared * squared;
+  const double cubed = squared * distance;
+  PolarMap map{};
+  map.value = gp_Pnt2d(std::atan2(x, along) / magnitude, side * distance - apex);
+  map.u_gradient = gp_Vec2d(along / (squared * magnitude), -side * x / (squared * magnitude));
+  map.v_gradient = gp_Vec2d(side * x / distance, along / distance);
+  map.u_hessian.xx = -2.0 * along * x / (fourth * magnitude);
+  map.u_hessian.xy = side * (x * x - along * along) / (fourth * magnitude);
+  map.u_hessian.yy = 2.0 * x * along / (fourth * magnitude);
+  map.v_hessian.xx = side * along * along / cubed;
+  map.v_hessian.xy = -x * along / cubed;
+  map.v_hessian.yy = side * x * x / cubed;
+  return map;
+}
+
+// The exact image of a curve of the developed plane on the parameter plane of a cone, as a curve
+// adaptor that Geom2dConvert_ApproxCurve approximates: each value is the developed curve's mapped
+// through the developed sector's polar coordinates, and each derivative follows by the chain rule.
+class ConeImage : public Adaptor2d_Curve2d {
+ public:
+  ConeImage(const WrapSurfaceData &surface, const Handle(Geom2d_Curve) &developed, double first,
+            double last)
+      : surface_(surface), developed_(developed, first, last) {}
+
+  Standard_Real FirstParameter() const override { return developed_.FirstParameter(); }
+  Standard_Real LastParameter() const override { return developed_.LastParameter(); }
+  GeomAbs_Shape Continuity() const override { return developed_.Continuity(); }
+  Standard_Integer NbIntervals(const GeomAbs_Shape shape) const override {
+    return developed_.NbIntervals(shape);
+  }
+  void Intervals(TColStd_Array1OfReal &parameters, const GeomAbs_Shape shape) const override {
+    developed_.Intervals(parameters, shape);
+  }
+  Handle(Adaptor2d_Curve2d) Trim(const Standard_Real first, const Standard_Real last,
+                                 const Standard_Real) const override {
+    return new ConeImage(surface_, developed_.Curve(), first, last);
+  }
+  gp_Pnt2d Value(const Standard_Real parameter) const override {
+    const gp_Pnt2d point = developed_.Value(parameter);
+    return developed_to_parameter(surface_, point.X(), point.Y());
+  }
+  void D0(const Standard_Real parameter, gp_Pnt2d &point) const override {
+    point = Value(parameter);
+  }
+  void D1(const Standard_Real parameter, gp_Pnt2d &point, gp_Vec2d &first) const override {
+    gp_Pnt2d developed;
+    gp_Vec2d tangent;
+    developed_.D1(parameter, developed, tangent);
+    const PolarMap map = polar_map(surface_, developed.X(), developed.Y());
+    point = map.value;
+    first = gp_Vec2d(map.u_gradient.Dot(tangent), map.v_gradient.Dot(tangent));
+  }
+  void D2(const Standard_Real parameter, gp_Pnt2d &point, gp_Vec2d &first,
+          gp_Vec2d &second) const override {
+    gp_Pnt2d developed;
+    gp_Vec2d tangent;
+    gp_Vec2d curvature;
+    developed_.D2(parameter, developed, tangent, curvature);
+    const PolarMap map = polar_map(surface_, developed.X(), developed.Y());
+    point = map.value;
+    first = gp_Vec2d(map.u_gradient.Dot(tangent), map.v_gradient.Dot(tangent));
+    second = gp_Vec2d(second_derivative(map.u_gradient, map.u_hessian, tangent, curvature),
+                      second_derivative(map.v_gradient, map.v_hessian, tangent, curvature));
+  }
+
+ private:
+  WrapSurfaceData surface_;
+  Geom2dAdaptor_Curve developed_;
+};
+
+// The B-spline of the developed plane that `curve` describes.
+Handle(Geom2d_BSplineCurve) developed_bspline(const WrapCurveData &curve) {
+  const int pole_count = static_cast<int>(curve.poles.size() / 2);
+  TColgp_Array1OfPnt2d poles(1, pole_count);
+  for (int pole = 0; pole < pole_count; ++pole) {
+    poles.SetValue(pole + 1, gp_Pnt2d(curve.poles[2 * pole], curve.poles[2 * pole + 1]));
+  }
+  const int knot_count = static_cast<int>(curve.knots.size());
+  TColStd_Array1OfReal knots(1, knot_count);
+  TColStd_Array1OfInteger multiplicities(1, knot_count);
+  for (int knot = 0; knot < knot_count; ++knot) {
+    knots.SetValue(knot + 1, curve.knots[knot]);
+    multiplicities.SetValue(knot + 1, static_cast<int>(curve.multiplicities[knot]));
+  }
+  return new Geom2d_BSplineCurve(poles, knots, multiplicities, static_cast<int>(curve.degree),
+                                 curve.periodic);
+}
+
+// The exact image of `developed` on the parameter plane of a cylinder of radius r, where the map
+// (x, y) -> (x / r, y) is affine.
+ParameterCurve cylinder_image(const WrapSurfaceData &surface, const ParameterCurve &developed) {
+  const double radius = surface.radius;
+  auto map = [&](const gp_Pnt2d &point) { return gp_Pnt2d(point.X() / radius, point.Y()); };
+  const Handle(Standard_Type) type = developed.curve->DynamicType();
+  if (type == STANDARD_TYPE(Geom2d_Line)) {
+    const gp_Pnt2d start = map(developed.start());
+    const gp_Vec2d along(start, map(developed.end()));
+    return ParameterCurve{new Geom2d_Line(start, gp_Dir2d(along)), 0.0, along.Magnitude()};
+  }
+  if (type == STANDARD_TYPE(Geom2d_Circle)) {
+    // The circle c + R (cos t, s sin t), s = 1 counterclockwise and -1 clockwise, maps to the
+    // ellipse A(c) + (R / r cos t, s R sin t). Geom2d_Ellipse puts its major axis along its x
+    // direction; when that is v (r >= 1) the ellipse's parameter is t - pi / 2.
+    const gp_Circ2d circle = Handle(Geom2d_Circle)::DownCast(developed.curve)->Circ2d();
+    const double sense = circle.Position().YDirection().Y() > 0.0 ? 1.0 : -1.0;
+    const double along_u = circle.Radius() / radius;
+    const double along_v = circle.Radius();
+    const gp_Pnt2d center = map(circle.Location());
+    if (along_v >= along_u) {
+      const gp_Ax22d axes(center, gp_Dir2d(0.0, sense), gp_Dir2d(-1.0, 0.0));
+      return ParameterCurve{new Geom2d_Ellipse(gp_Elips2d(axes, along_v, along_u)),
+                            developed.first - M_PI / 2.0, developed.last - M_PI / 2.0};
+    }
+    const gp_Ax22d axes(center, gp_Dir2d(1.0, 0.0), gp_Dir2d(0.0, sense));
+    return ParameterCurve{new Geom2d_Ellipse(gp_Elips2d(axes, along_u, along_v)), developed.first,
+                          developed.last};
+  }
+  // A B-spline keeps its knots and weights; its poles map.
+  Handle(Geom2d_BSplineCurve) image =
+      Handle(Geom2d_BSplineCurve)::DownCast(developed.curve->Copy());
+  for (int pole = 1; pole <= image->NbPoles(); ++pole) {
+    image->SetPole(pole, map(image->Pole(pole)));
+  }
+  return ParameterCurve{image, developed.first, developed.last};
+}
+
+// The image of `developed` on the parameter plane of a cone, approximated within a 2D tolerance
+// that keeps the image within kCurveTolerance on the surface, where a step in u covers the radius
+// times as far as a step in v.
+ParameterCurve cone_image(const WrapSurfaceData &surface, const ParameterCurve &developed) {
+  double widest = 1.0;
+  for (int sample = 0; sample <= kDeviationSamples; ++sample) {
+    const gp_Pnt2d point = developed.curve->Value(
+        developed.first + (developed.last - developed.first) * sample / kDeviationSamples);
+    const double height =
+        developed_to_parameter(surface, point.X(), point.Y()).Y() * std::cos(surface.half_angle);
+    widest = std::max(widest, surface.radius + height * std::tan(surface.half_angle));
+  }
+  const Handle(ConeImage) exact =
+      new ConeImage(surface, developed.curve, developed.first, developed.last);
+  Geom2dConvert_ApproxCurve approximation(exact, kCurveTolerance / widest, GeomAbs_C2,
+                                          kImageSegments, kImageDegree);
+  if (!approximation.HasResult()) {
+    raise_not_done("Geom2dConvert_ApproxCurve found no image of a developed curve on the cone");
+  }
+  const Handle(Geom2d_Curve) image = approximation.Curve();
+  return ParameterCurve{image, image->FirstParameter(), image->LastParameter()};
+}
+
+}  // namespace
+
+namespace detail {
+
+Handle(Geom_ElementarySurface) wrap_surface(const WrapSurfaceData &surface) {
+  const gp_Ax3 frame = to_ax3(surface.frame);
+  if (surface.half_angle == 0.0) {
+    return new Geom_CylindricalSurface(frame, surface.radius);
+  }
+  return new Geom_ConicalSurface(frame, surface.half_angle, surface.radius);
+}
+
+double parameter_height(const WrapSurfaceData &surface, double height) {
+  return height / std::cos(surface.half_angle);
+}
+
+gp_Pnt2d developed_to_parameter(const WrapSurfaceData &surface, double x, double y) {
+  if (surface.half_angle == 0.0) {
+    // A cylinder of radius r develops onto the plane by u = x / r and v = y.
+    return gp_Pnt2d(x / surface.radius, y);
+  }
+  // A cone develops onto a sector about its apex: polar coordinates about the apex give the
+  // slant distance (v) and the angle, which is u times the sine of the half-angle.
+  const double sine = std::sin(surface.half_angle);
+  const double side = sine > 0.0 ? 1.0 : -1.0;
+  const double apex = surface.radius / sine;
+  const double along = side * (y + apex);
+  const double distance = std::hypot(x, along);
+  return gp_Pnt2d(std::atan2(x, along) / std::fabs(sine), side * distance - apex);
+}
+
+HelixLine helix_line(const WrapSurfaceData &surface, double phase, double height, double pitch) {
+  const gp_Vec2d turn(2.0 * M_PI, parameter_height(surface, pitch));
+  const gp_Pnt2d start(phase, parameter_height(surface, height));
+  return HelixLine{new Geom2d_Line(start, gp_Dir2d(turn)), turn.Magnitude()};
+}
+
+TopoDS_Edge edge_on_surface(const Handle(Geom_Surface) &surface, const Handle(Geom2d_Curve) &curve,
+                            const TopoDS_Vertex &first, const TopoDS_Vertex &last,
+                            double first_parameter, double last_parameter, double turns) {
+  BRepBuilderAPI_MakeEdge make(curve, surface, first, last, first_parameter, last_parameter);
+  if (!make.IsDone()) {
+    raise_not_done("BRepBuilderAPI_MakeEdge failed with status " +
+                   std::to_string(static_cast<int>(make.Error())));
+  }
+  TopoDS_Edge edge = make.Edge();
+  const int segments =
+      std::max(kLeastSegments, kSegmentsPerTurn * static_cast<int>(std::ceil(turns)));
+  if (!BRepLib::BuildCurve3d(edge, kCurveTolerance, GeomAbs_C1, kCurveDegree, segments)) {
+    raise_not_done("BRepLib::BuildCurves3d gave the edge no 3D curve");
+  }
+  // BRepLib sets the edge's tolerance to the one asked for whatever the approximation reached,
+  // so the edge is checked against the curve on its surface.
+  double deviation = 0.0;
+  ShapeAnalysis_Edge().CheckSameParameter(edge, deviation, kCurveSamples);
+  if (deviation > kCurveTolerance) {
+    raise_not_done("BRepLib::BuildCurves3d approximated an edge within " +
+                   std::to_string(deviation) + " mm, more than its tolerance");
+  }
+  return edge;
+}
+
+TopoDS_Vertex vertex_on_surface(const Handle(Geom_Surface) &surface, const gp_Pnt2d &point) {
+  TopoDS_Vertex vertex;
+  BRep_Builder().MakeVertex(vertex, surface->Value(point.X(), point.Y()), kCurveTolerance);
+  return vertex;
+}
+
+ParameterCurve developed_curve(const WrapCurveData &curve) {
+  if (curve.kind == WrapCurveType::Segment) {
+    const gp_Pnt2d start(curve.start_x, curve.start_y);
+    const gp_Vec2d along(start, gp_Pnt2d(curve.end_x, curve.end_y));
+    return ParameterCurve{new Geom2d_Line(start, gp_Dir2d(along)), 0.0, along.Magnitude()};
+  }
+  if (curve.kind == WrapCurveType::Arc) {
+    // In an indirect frame the circle's parameter runs clockwise, so a negative sweep starts at
+    // minus the start angle.
+    const double sense = curve.sweep > 0.0 ? 1.0 : -1.0;
+    const gp_Ax22d axes(gp_Pnt2d(curve.center_x, curve.center_y), gp_Dir2d(1.0, 0.0),
+                        gp_Dir2d(0.0, sense));
+    const double first = sense * curve.start_angle;
+    return ParameterCurve{new Geom2d_Circle(axes, curve.radius), first,
+                          first + std::fabs(curve.sweep)};
+  }
+  const Handle(Geom2d_Curve) bspline = developed_bspline(curve);
+  return ParameterCurve{bspline, bspline->FirstParameter(), bspline->LastParameter()};
+}
+
+MappedCurve map_curve(const WrapSurfaceData &surface, const ParameterCurve &developed) {
+  const ParameterCurve image = surface.half_angle == 0.0 ? cylinder_image(surface, developed)
+                                                         : cone_image(surface, developed);
+  // The image and the exact image at the same fraction of their ranges: both maps keep the
+  // developed curve's parameter, up to the shift of the ellipse's.
+  const Handle(Geom_Surface) geometry = wrap_surface(surface);
+  double deviation = 0.0;
+  for (int sample = 0; sample <= kDeviationSamples; ++sample) {
+    const double fraction = static_cast<double>(sample) / kDeviationSamples;
+    const gp_Pnt2d point =
+        developed.curve->Value(developed.first + (developed.last - developed.first) * fraction);
+    const gp_Pnt2d exact = developed_to_parameter(surface, point.X(), point.Y());
+    const gp_Pnt2d mapped = image.curve->Value(image.first + (image.last - image.first) * fraction);
+    deviation = std::max(deviation, geometry->Value(exact.X(), exact.Y())
+                                        .Distance(geometry->Value(mapped.X(), mapped.Y())));
+  }
+  if (deviation > kMapTolerance) {
+    raise_not_done("the image of a developed curve lies " + std::to_string(deviation) +
+                   " mm from its exact image, more than its tolerance");
+  }
+  return MappedCurve{image, deviation};
+}
+
+}  // namespace detail
+
+std::shared_ptr<Shape> wrap_curves(const WrapSurfaceData &surface,
+                                   rust::Slice<const WrapCurveData> curves) {
+  const Handle(Geom_Surface) geometry = wrap_surface(surface);
+  std::vector<TopoDS_Shape> edges;
+  for (const WrapCurveData &curve : curves) {
+    if (curve.kind == WrapCurveType::Helix) {
+      const HelixLine helix = helix_line(surface, curve.phase, curve.height, curve.pitch);
+      const double length = helix.turn_length * curve.turns;
+      const TopoDS_Vertex first = vertex_on_surface(geometry, helix.line->Value(0.0));
+      const TopoDS_Vertex last = vertex_on_surface(geometry, helix.line->Value(length));
+      edges.push_back(
+          edge_on_surface(geometry, helix.line, first, last, 0.0, length, curve.turns));
+      continue;
+    }
+    // A segment, an arc or a B-spline of the developed plane, by its image.
+    const ParameterCurve developed = developed_curve(curve);
+    const ParameterCurve image = map_curve(surface, developed).image;
+    const gp_Pnt2d start = image.start();
+    const gp_Pnt2d end = image.end();
+    const TopoDS_Vertex first = vertex_on_surface(geometry, start);
+    const TopoDS_Vertex last =
+        developed.start().Distance(developed.end()) <= kLinear ? first
+                                                               : vertex_on_surface(geometry, end);
+    edges.push_back(edge_on_surface(geometry, image.curve, first, last, image.first, image.last,
+                                    std::fabs(end.X() - start.X()) / (2.0 * M_PI)));
+  }
+  return make_shape(compound_of(edges));
+}
+
+}  // namespace occt
+}  // namespace partsmith
