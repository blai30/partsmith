+/// An input of edge projections.
+fn projection(name: &'static str, shape: Shape, edges: Vec<u32>, plane: Plane) -> Input {
+    Input {
+        name,
+        shape,
+        edges,
+        plane,
+        constructions: PROJECTIONS,
+        outline: None,
+        budget: None,
+    }
+}
+
+/// An input of silhouettes.
+fn silhouette(name: &'static str, shape: Shape, plane: Plane, outline: Outline) -> Input {
+    Input {
+        name,
+        shape,
+        edges: Vec::new(),
+        plane,
+        constructions: SILHOUETTES,
+        outline: Some(outline),
+        budget: None,
+    }
+}
+
+/// A cylinder outline around the Z axis through the origin.
+fn z_cylinder(radius: f64) -> Outline {
+    Outline::Cylinder {
+        origin: common::ORIGIN,
+        axis: Vector::new(0.0, 0.0, 1.0),
+        radius,
+    }
+}
+
+/// The input of section 8.7 named `name`, one of `INPUT_NAMES`.
+pub fn input(name: &'static str) -> Input {
+    match name {
+        "box-xy" | "box-011" => {
+            let block = common::box_primitive().shape;
+            let edges = every_edge(&block);
+            let plane = if name == "box-xy" {
+                Plane::XY
+            } else {
+                plane_with_normal(OBLIQUE)
+            };
+            projection(name, block, edges, plane)
+        }
+        "circle-30" => {
+            let cylinder = common::cylinder_primitive().shape;
+            let circle = top_circle(&cylinder);
+            let thirty = 30f64.to_radians();
+            let plane = plane_with_normal(Vector::new(0.0, thirty.sin(), thirty.cos()));
+            projection(name, cylinder, vec![circle], plane)
+        }
+        "rounded-xy" => {
+            let rounded = common::fully_rounded_box();
+            let edges = every_edge(&rounded);
+            Input {
+                budget: Some(Duration::from_millis(20)),
+                ..projection(name, rounded, edges, Plane::XY)
+            }
+        }
+        "part-section" => Input {
+            name,
+            shape: section_five_part(),
+            edges: Vec::new(),
+            plane: Plane::XY,
+            constructions: SECTIONS,
+            outline: None,
+            budget: None,
+        },
+        "cylinder-oblique" => silhouette(
+            name,
+            common::cylinder_primitive().shape,
+            plane_with_normal(OBLIQUE),
+            z_cylinder(5.0),
+        ),
+        "cylinder-perpendicular" => silhouette(
+            name,
+            common::cylinder_primitive().shape,
+            plane_with_normal(Vector::new(0.0, 1.0, 0.0)),
+            z_cylinder(5.0),
+        ),
+        "sphere-oblique" => silhouette(
+            name,
+            common::sphere_primitive().shape,
+            plane_with_normal(OBLIQUE),
+            Outline::Sphere {
+                center: common::ORIGIN,
+                radius: 10.0,
+            },
+        ),
+        "torus-oblique" => silhouette(
+            name,
+            make_torus(&Plane::XY, 10.0, 3.0)
+                .expect("the torus builds")
+                .shape,
+            plane_with_normal(OBLIQUE),
+            Outline::Torus {
+                center: common::ORIGIN,
+                axis: Vector::new(0.0, 0.0, 1.0),
+                major_radius: 10.0,
+                minor_radius: 3.0,
+            },
+        ),
+        "cone-oblique" => silhouette(
+            name,
+            make_cone(&Plane::XY, 10.0, 5.0, 20.0)
+                .expect("the frustum builds")
+                .shape,
+            plane_with_normal(OBLIQUE),
+            Outline::Cone {
+                apex: Point::new(0.0, 0.0, 40.0),
+                axis: Vector::new(0.0, 0.0, -1.0),
+                half_angle: (10.0f64 / 40.0).atan(),
+            },
+        ),
+        "rounded-z" => silhouette(
+            name,
+            common::fully_rounded_box(),
+            Plane::XY,
+            Outline::RoundedRectangle {
+                min: (0.0, 0.0),
+                max: (10.0, 20.0),
+                radius: 1.0,
+            },
+        ),
+        _ => panic!("no input named {name}"),
+    }
+}
