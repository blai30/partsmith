index 0000000..985c4b6
--- /dev/null
+++ b/crates/partsmith-occt-sys/tests/projection.rs
@@ -0,0 +1,636 @@
+//! The projection spike (kernel spec section 8.7): for each input and construction, the checks of
+//! section 8.1 item 4 that run in a test, printed as measurements. Lines starting `PARITY` are the
+//! canonical summary that the native and the WebAssembly runs compare (ADR 0042). Each test also
+//! holds the construction to the outcome the spike recorded for it.
+
+use std::collections::BTreeMap;
+
+use partsmith_mesh::{TessellationTolerance, WELD_TOLERANCE};
+use partsmith_occt_sys::{
+    CurveOrigin, CurveRelation, CurveSet, EdgeFailure, GeometryKind, Interrupt, Plane, Point,
+    ProjectedPoint, Shape, SubShape, SubShapeKind, Vector, edge_samples, element_distances,
+};
+
+use super::projection_inputs::{Construction, INPUT_NAMES, Input, Outline, input};
+
+/// The points sampled on each edge (section 8.7).
+const SAMPLES: u32 = 20;
+
+/// The point check's tolerance (section 8.7).
+const POINT_TOLERANCE: f64 = 1e-6;
+
+/// A direction is along another within this cosine.
+const PARALLEL: f64 = 1e-9;
+
+/// The closed-mesh check's tolerance, 0.05 mm and 5 degrees (section 8.1 item 4).
+const FINE: TessellationTolerance = TessellationTolerance {
+    chord_deviation: 0.05,
+    angular_deviation: 5.0_f64.to_radians(),
+};
+
+/// What a source edge projects to, from its geometry.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+enum Expected {
+    /// A line along the direction.
+    Point,
+    /// A line across it.
+    Line,
+    /// A circle in a plane across the direction.
+    Circle,
+    /// A circle in a plane oblique to the direction.
+    Ellipse,
+    /// A circle in a plane along the direction: a segment.
+    Segment,
+}
+
+/// What one construction gave for one input, with the section 8.7 checks.
+struct Outcome {
+    /// Every failure of a check, empty when the input passes.
+    failures: Vec<String>,
+    /// The checks as the spike reads them for degenerate projections, where they differ.
+    geometric_failures: Vec<String>,
+}
+
+impl Outcome {
+    /// Adds a failure that both readings share.
+    fn fail(&mut self, failure: String) {
+        self.geometric_failures.push(failure.clone());
+        self.failures.push(failure);
+    }
+}
+
+/// The source edges of a projection, with what the projection made of each.
+struct Sources<'a> {
+    /// The shape the source edges belong to.
+    shape: &'a Shape,
+    /// The source edges.
+    edges: &'a [u32],
+    /// The origins that name each projected edge by its source edge.
+    origins: &'a [CurveOrigin],
+    /// The source edges that project to a point.
+    points: &'a [ProjectedPoint],
+    /// The source edges the projection could not project.
+    failures: &'a [EdgeFailure],
+}
+
+/// The unit normal of a plane.
+fn unit_normal(plane: &Plane) -> Vector {
+    plane.normal.normalized().expect("the plane is valid")
+}
+
+/// `point` less `origin`, as a vector.
+fn difference(point: Point, origin: Point) -> Vector {
+    Vector::new(point.x - origin.x, point.y - origin.y, point.z - origin.z)
+}
+
+/// The part of `vector` across the unit vector `axis`.
+fn across(vector: Vector, axis: Vector) -> Vector {
+    let along = axis.scaled(vector.dot(axis));
+    Vector::new(vector.x - along.x, vector.y - along.y, vector.z - along.z)
+}
+
+/// `point` projected onto `plane` along its normal.
+fn projected(point: Point, plane: &Plane) -> Point {
+    let normal = unit_normal(plane);
+    let height = difference(point, plane.origin).dot(normal);
+    point.offset(normal.scaled(-height))
+}
+
+/// The kind a source edge projects to along `normal`, or `None` for a kind section 8.7 does not
+/// name.
+fn expected_kind(shape: &Shape, edge: u32, normal: Vector) -> Option<Expected> {
+    let geometry = shape
+        .element(SubShapeKind::Edge, edge)
+        .expect("edges can be read");
+    let along = geometry
+        .direction
+        .map(|direction| direction.dot(normal).abs());
+    match (geometry.kind, along) {
+        (GeometryKind::Line, Some(along)) if along > 1.0 - PARALLEL => Some(Expected::Point),
+        (GeometryKind::Line, Some(_)) => Some(Expected::Line),
+        (GeometryKind::Circle, Some(along)) if along > 1.0 - PARALLEL => Some(Expected::Circle),
+        (GeometryKind::Circle, Some(along)) if along < PARALLEL => Some(Expected::Segment),
+        (GeometryKind::Circle, Some(_)) => Some(Expected::Ellipse),
+        _ => None,
+    }
+}
+
+/// The edges that `origins` name as coming from `input`, ascending.
+fn edges_from(origins: &[CurveOrigin], input: SubShape) -> Vec<u32> {
+    origins
+        .iter()
+        .filter(|origin| origin.input == input && origin.element.kind == SubShapeKind::Edge)
+        .map(|origin| origin.element.index)
+        .collect()
+}
+
+/// The kind of each edge of a shape.
+fn kinds(shape: &Shape) -> Vec<GeometryKind> {
+    shape
+        .elements(SubShapeKind::Edge)
+        .expect("edges can be read")
+        .iter()
+        .map(|edge| edge.kind)
+        .collect()
+}
+
+/// The largest distance from each of `points` to the nearest of `edges` of `shape`.
+fn largest_distance(shape: &Shape, edges: &[u32], points: &[Point]) -> f64 {
+    let mut nearest = vec![f64::INFINITY; points.len()];
+    for edge in edges {
+        let distances = element_distances(shape, SubShapeKind::Edge, *edge, points)
+            .expect("distances can be measured");
+        for (best, distance) in nearest.iter_mut().zip(distances) {
+            *best = best.min(distance);
+        }
+    }
+    nearest.into_iter().fold(0.0, f64::max)
+}
+
+/// Section 8.7's checks of one projection onto `plane` along its normal: the kind of each source
+/// edge's projection, as written (lines to lines, circles to circles or ellipses) and with the
+/// degenerate projections read geometrically (a line along the direction to a point, a circle
+/// seen edge on to a segment), and the 20 sampled points of each source edge within 1e-6 mm of its
+/// projection.
+fn check_projection(
+    sources: &Sources,
+    plane: &Plane,
+    curves: &CurveSet,
+    kinds_of: &[GeometryKind],
+) -> Outcome {
+    let normal = unit_normal(plane);
+    let mut outcome = Outcome {
+        failures: Vec::new(),
+        geometric_failures: Vec::new(),
+    };
+    for edge in sources.edges {
+        let source = SubShape {
+            kind: SubShapeKind::Edge,
+            index: *edge,
+        };
+        let made = edges_from(sources.origins, source);
+        let point = sources.points.iter().find(|point| point.edge == *edge);
+        let failure = sources
+            .failures
+            .iter()
+            .find(|failure| failure.edge == *edge);
+        let expected = expected_kind(sources.shape, *edge, normal);
+        let made_kinds: Vec<GeometryKind> = made
+            .iter()
+            .map(|index| kinds_of[*index as usize - 1])
+            .collect();
+        let all = |wanted: &[GeometryKind]| {
+            !made_kinds.is_empty() && made_kinds.iter().all(|kind| wanted.contains(kind))
+        };
+        let source = sources
+            .shape
+            .element(SubShapeKind::Edge, *edge)
+            .expect("edges can be read");
+        let gave = format!(
+            "edge {edge} ({expected:?}, {:?} along {:?}) gave {made_kinds:?}, point {}, failure {:?}",
+            source.kind,
+            source.direction,
+            point.is_some(),
+            failure.map(|failure| failure.message.as_str())
+        );
+        let as_written = match expected {
+            Some(Expected::Point | Expected::Line) => all(&[GeometryKind::Line]),
+            Some(Expected::Circle | Expected::Ellipse | Expected::Segment) => {
+                all(&[GeometryKind::Circle, GeometryKind::Ellipse])
+            }
+            None => true,
+        };
+        if !as_written {
+            outcome.failures.push(format!("kind as written: {gave}"));
+        }
+        let geometric = match expected {
+            Some(Expected::Point) => made.is_empty() && point.is_some(),
+            Some(Expected::Line | Expected::Segment) => all(&[GeometryKind::Line]),
+            Some(Expected::Circle) => all(&[GeometryKind::Circle]),
+            Some(Expected::Ellipse) => all(&[GeometryKind::Ellipse]),
+            None => true,
+        };
+        if !geometric {
+            outcome
+                .geometric_failures
+                .push(format!("kind read geometrically: {gave}"));
+        }
+        let samples: Vec<Point> = edge_samples(sources.shape, *edge, SAMPLES)
+            .expect("the source edge can be sampled")
+            .into_iter()
+            .map(|sample| projected(sample, plane))
+            .collect();
+        let deviation = match (made.is_empty(), point) {
+            (false, _) => largest_distance(&curves.shape, &made, &samples),
+            (true, Some(point)) => samples
+                .iter()
+                .map(|sample| sample.distance(point.point))
+                .fold(0.0, f64::max),
+            (true, None) => f64::INFINITY,
+        };
+        println!("  edge {edge}: {gave}, points within {deviation:?}");
+        if deviation > POINT_TOLERANCE {
+            outcome.fail(format!("points: edge {edge} within {deviation:?}"));
+        }
+    }
+    outcome
+}
+
+/// Section 8.7's checks of the section by the sketch plane, read for a section: each edge is a
+/// line, a circle or an ellipse, and its 20 sampled points lie on the plane and on a face of the
+/// body within 1e-6 mm.
+fn check_section(input: &Input, curves: &CurveSet, kinds_of: &[GeometryKind]) -> Outcome {
+    let normal = unit_normal(&input.plane);
+    let mut failures = Vec::new();
+    let faces: Vec<u32> = (1..=input.shape.count(SubShapeKind::Face)).collect();
+    for (position, kind) in kinds_of.iter().enumerate() {
+        let edge = u32::try_from(position + 1).expect("few edges");
+        if !matches!(
+            kind,
+            GeometryKind::Line | GeometryKind::Circle | GeometryKind::Ellipse
+        ) {
+            failures.push(format!("kind: edge {edge} is {kind:?}"));
+        }
+        let samples = edge_samples(&curves.shape, edge, SAMPLES).expect("the edge can be sampled");
+        let off_plane = samples
+            .iter()
+            .map(|sample| difference(*sample, input.plane.origin).dot(normal).abs())
+            .fold(0.0, f64::max);
+        let mut nearest = vec![f64::INFINITY; samples.len()];
+        for face in &faces {
+            let distances = element_distances(&input.shape, SubShapeKind::Face, *face, &samples)
+                .expect("distances can be measured");
+            for (best, distance) in nearest.iter_mut().zip(distances) {
+                *best = best.min(distance);
+            }
+        }
+        let off_body = nearest.into_iter().fold(0.0, f64::max);
+        println!("  edge {edge}: {kind:?}, off the plane {off_plane:?}, off the body {off_body:?}");
+        if off_plane > POINT_TOLERANCE || off_body > POINT_TOLERANCE {
+            failures.push(format!(
+                "points: edge {edge} off the plane {off_plane:?} and the body {off_body:?}"
+            ));
+        }
+    }
+    Outcome {
+        geometric_failures: failures.clone(),
+        failures,
+    }
+}
+
+/// The value of `outline`'s signed distance function at `point`: 0 on the surface.
+fn surface_distance(outline: &Outline, point: Point) -> f64 {
+    match *outline {
+        Outline::Cylinder {
+            origin,
+            axis,
+            radius,
+        } => across(difference(point, origin), axis).length() - radius,
+        Outline::Sphere { center, radius } => point.distance(center) - radius,
+        Outline::Torus {
+            center,
+            axis,
+            major_radius,
+            minor_radius,
+        } => {
+            let offset = difference(point, center);
+            let height = offset.dot(axis);
+            let radial = across(offset, axis).length();
+            (radial - major_radius).hypot(height) - minor_radius
+        }
+        Outline::Cone {
+            apex,
+            axis,
+            half_angle,
+        } => {
+            let offset = difference(point, apex);
+            let height = offset.dot(axis);
+            let radial = across(offset, axis).length();
+            radial * half_angle.cos() - height * half_angle.sin()
+        }
+        Outline::RoundedRectangle { min, max, radius } => {
+            let half = ((max.0 - min.0) / 2.0, (max.1 - min.1) / 2.0);
+            let center = ((max.0 + min.0) / 2.0, (max.1 + min.1) / 2.0);
+            let corner = (
+                (point.x - center.0).abs() - (half.0 - radius),
+                (point.y - center.1).abs() - (half.1 - radius),
+            );
+            corner.0.max(0.0).hypot(corner.1.max(0.0)) + corner.0.max(corner.1).min(0.0) - radius
+        }
+    }
+}
+
+/// How far `point`, a point of a silhouette on the plane, is from the exact silhouette: the
+/// line through it along the view touches the surface where the surface's distance function
+/// along it has an extremum of 0, so this is the extremum closest to 0, in absolute value.
+fn silhouette_deviation(outline: &Outline, point: Point, normal: Vector) -> f64 {
+    if let Outline::RoundedRectangle { .. } = outline {
+        return surface_distance(outline, point).abs();
+    }
+    let along = |parameter: f64| surface_distance(outline, point.offset(normal.scaled(parameter)));
+    let step = 0.05;
+    let reach = 100.0;
+    let count = (2.0 * reach / step) as usize;
+    let values: Vec<f64> = (0..=count)
+        .map(|sample| along(-reach + step * sample as f64))
+        .collect();
+    let mut closest = f64::INFINITY;
+    for sample in 1..count {
+        let (before, here, after) = (values[sample - 1], values[sample], values[sample + 1]);
+        let minimum = here <= before && here <= after;
+        let maximum = here >= before && here >= after;
+        if !minimum && !maximum {
+            continue;
+        }
+        // Golden section search for the extremum between the neighbors.
+        let sign = if minimum { 1.0 } else { -1.0 };
+        let golden = (5f64.sqrt() - 1.0) / 2.0;
+        let (mut low, mut high) = (
+            -reach + step * (sample - 1) as f64,
+            -reach + step * (sample + 1) as f64,
+        );
+        while high - low > 1e-12 {
+            let first = high - golden * (high - low);
+            let second = low + golden * (high - low);
+            if sign * along(first) < sign * along(second) {
+                high = second;
+            } else {
+                low = first;
+            }
+        }
+        closest = closest.min(along((low + high) / 2.0).abs());
+    }
+    closest
+}
+
+/// Section 8.7's silhouette checks: a cylinder seen across its axis gives two lines. A silhouette
+/// that projects edges HLR drew in 3D onto the plane (the exact silhouette with edges on the
+/// outline) also gets the checks of a projection, with the drawn edges as its source edges. The
+/// largest deviation from the exact silhouette is printed as a measurement.
+fn check_silhouette(input: &Input, curves: &CurveSet, kinds_of: &[GeometryKind]) -> Outcome {
+    let outline = input.outline.expect("a silhouette input has an outline");
+    let normal = unit_normal(&input.plane);
+    let mut deviation: f64 = 0.0;
+    let geometry = curves
+        .shape
+        .elements(SubShapeKind::Edge)
+        .expect("edges can be read");
+    for (position, element) in geometry.iter().enumerate() {
+        let edge = u32::try_from(position + 1).expect("few edges");
+        let samples = edge_samples(&curves.shape, edge, SAMPLES).expect("the edge can be sampled");
+        let largest = samples
+            .into_iter()
+            .map(|sample| silhouette_deviation(&outline, sample, normal))
+            .fold(0.0, f64::max);
+        if position < 12 {
+            println!(
+                "  edge {edge}: {:?} centroid {:?} length {:?} deviation {largest:?}",
+                element.kind, element.centroid, element.measure
+            );
+        }
+        deviation = deviation.max(largest);
+    }
+    println!("  deviation from the exact silhouette {deviation:?}");
+    let drawn_edges: Vec<u32> = (1..=curves.drawn.count(SubShapeKind::Edge)).collect();
+    let drawn = Sources {
+        shape: &curves.drawn,
+        edges: &drawn_edges,
+        origins: &curves.drawn_origins,
+        points: &[],
+        failures: &[],
+    };
+    let mut outcome = check_projection(&drawn, &input.plane, curves, kinds_of);
+    if input.name == "cylinder-perpendicular" && kinds_of != [GeometryKind::Line; 2] {
+        outcome.fail(format!("two lines: the silhouette is {kinds_of:?}"));
+    }
+    outcome
+}
+
+/// Test 138's check: `shape` tessellated at 0.05 mm and 5 degrees and welded with
+/// `WELD_TOLERANCE`, as the number of triangles and of undirected edges not used by exactly two
+/// of them.
+fn closed_mesh(shape: &Shape) -> Result<(usize, usize), String> {
+    let welded = shape
+        .tessellate(&FINE, &Interrupt::new())
+        .map_err(|error| error.detail())?
+        .weld(WELD_TOLERANCE)
+        .map_err(|error| error.to_string())?
+        .mesh;
+    let mut uses: BTreeMap<(u32, u32), usize> = BTreeMap::new();
+    for [first, second, third] in welded.triangles() {
+        for (start, end) in [(*first, *second), (*second, *third), (*third, *first)] {
+            *uses.entry((start.min(end), start.max(end))).or_default() += 1;
+        }
+    }
+    let open = uses.values().filter(|count| **count != 2).count();
+    Ok((welded.triangle_count(), open))
+}
+
+/// The relations that name each edge and vertex of `curves`, with the count of elements each
+/// set of relations names, and the elements no origin names.
+fn history_summary(curves: &CurveSet) -> String {
+    let mut relations: BTreeMap<SubShape, Vec<(SubShapeKind, CurveRelation)>> = BTreeMap::new();
+    for origin in &curves.origins {
+        relations
+            .entry(origin.element)
+            .or_default()
+            .push((origin.input.kind, origin.relation));
+    }
+    let mut counts: BTreeMap<String, u32> = BTreeMap::new();
+    for kind in [SubShapeKind::Edge, SubShapeKind::Vertex] {
+        for index in 1..=curves.shape.count(kind) {
+            let mut named = relations
+                .get(&SubShape { kind, index })
+                .cloned()
+                .unwrap_or_default();
+            named.sort();
+            named.dedup();
+            *counts.entry(format!("{kind:?} by {named:?}")).or_default() += 1;
+        }
+    }
+    format!("{counts:?}")
+}
+
+/// The failures the spike recorded for `construction` on input `name`: of the checks as written,
+/// and with the degenerate projections read geometrically. Each counts one source edge and check
+/// (kinds or points; for a silhouette's projection step, one drawn edge), or the silhouette's
+/// two-line check.
+fn recorded(name: &str, construction: Construction) -> (usize, usize) {
+    match (name, construction) {
+        ("box-xy", _) => (4, 0),
+        ("box-011", Construction::CurveOnPlaneKeepingParameters) => (8, 8),
+        ("circle-30", Construction::Prism) => (1, 1),
+        ("rounded-xy", Construction::CurveOnPlane) => (28, 20),
+        ("rounded-xy", Construction::CurveOnPlaneKeepingParameters) => (24, 16),
+        ("rounded-xy", Construction::Prism) => (24, 0),
+        (
+            "cylinder-perpendicular",
+            Construction::SilhouetteExact
+            | Construction::SilhouetteMesh
+            | Construction::SilhouetteMeshWithEdges,
+        ) => (1, 1),
+        ("rounded-z", Construction::SilhouetteExactWithEdges) => (2, 2),
+        _ => (0, 0),
+    }
+}
+
+/// Runs every construction of input `name`, prints its measurements and asserts the failures the
+/// spike recorded for each.
+fn measure(name: &'static str) {
+    let input = input(name);
+    println!(
+        "{name}: input {:?}, {} source edges",
+        input.shape,
+        input.edges.len()
+    );
+    for construction in input.constructions {
+        let label = format!("{name} {}", construction.name());
+        let curves = match construction.run(&input, &Interrupt::new()) {
+            Ok(curves) => curves,
+            Err(error) => panic!("{label} failed: {}", error.detail()),
+        };
+        let shape = &curves.shape;
+        let kinds_of = kinds(shape);
+        let validity = shape.is_valid().map_err(|error| error.detail());
+        let mesh = closed_mesh(shape);
+        println!(
+            "{label}: {shape:?}, valid {validity:?}, closed mesh (triangles, open edges) {mesh:?}, \
+             tolerance {:?}, whole edges {}, drawn edges {}, points {}, failures {:?}",
+            curves.tolerance,
+            curves.whole_edges,
+            curves.drawn.count(SubShapeKind::Edge),
+            curves.points.len(),
+            curves.failures
+        );
+        println!("{label}: kinds {kinds_of:?}");
+        println!("{label}: history {}", history_summary(&curves));
+        println!(
+            "{label}: polls {} (debug build) longest {:?}",
+            curves.polls.count, curves.polls.longest
+        );
+        let mut outcome = if !input.edges.is_empty() {
+            let sources = Sources {
+                shape: &input.shape,
+                edges: &input.edges,
+                origins: &curves.origins,
+                points: &curves.points,
+                failures: &curves.failures,
+            };
+            check_projection(&sources, &input.plane, &curves, &kinds_of)
+        } else if input.outline.is_some() {
+            check_silhouette(&input, &curves, &kinds_of)
+        } else {
+            check_section(&input, &curves, &kinds_of)
+        };
+        if validity != Ok(true) {
+            outcome.fail(format!("validity: {validity:?}"));
+        }
+        if !mesh.as_ref().is_ok_and(|(_, open)| *open == 0) {
+            outcome.fail(format!("closed mesh: {mesh:?}"));
+        }
+        println!("{label}: failures as written {:?}", outcome.failures);
+        println!(
+            "{label}: failures read geometrically {:?}",
+            outcome.geometric_failures
+        );
+        print_parity(&label, &curves, &kinds_of);
+        assert_eq!(
+            (outcome.failures.len(), outcome.geometric_failures.len()),
+            recorded(name, *construction),
+            "{label}: the failures the spike recorded"
+        );
+    }
+}
+
+/// Prints the canonical summary of `curves` that the native and WebAssembly runs compare.
+fn print_parity(label: &str, curves: &CurveSet, kinds_of: &[GeometryKind]) {
+    let shape = &curves.shape;
+    let length: f64 = shape
+        .elements(SubShapeKind::Edge)
+        .expect("edges can be read")
+        .iter()
+        .map(|edge| edge.measure)
+        .sum();
+    let bounds = shape
+        .bounding_box()
+        .map(|bounds| format!("{:?} {:?}", bounds.min, bounds.max))
+        .unwrap_or_else(|error| error.detail());
+    println!(
+        "PARITY {label} faces {} edges {} vertices {} volume {:?} area {:?} length {length:?} \
+         bounds {bounds} kinds {kinds_of:?} points {:?} failures {}",
+        shape.count(SubShapeKind::Face),
+        shape.count(SubShapeKind::Edge),
+        shape.count(SubShapeKind::Vertex),
+        shape.volume().map_err(|error| error.detail()),
+        shape.area().map_err(|error| error.detail()),
+        curves
+            .points
+            .iter()
+            .map(|point| (point.edge, point.point))
+            .collect::<Vec<_>>(),
+        curves.failures.len()
+    );
+}
+
