+#include <gp_XY.hxx>
+
+#include "partsmith-occt-sys/cpp/internal.h"
+
+namespace partsmith {
+namespace occt {
+
+using namespace detail;
+
+namespace {
+
+// The mesh HLRBRep_PolyAlgo works from: the tolerance of the closed-mesh check of kernel spec
+// section 8.1 item 4, 0.05 mm and 5 degrees.
+constexpr double kMeshDeviation = 0.05;
+constexpr double kMeshAngle = 5.0 * M_PI / 180.0;
+
+// The spike's indicator: answers as the shim's indicator does, and records the time of each poll,
+// so the spike can report the polls of a call and the longest gap between two of them.
+class PollRecorder : public Interruption {
+ public:
+  explicit PollRecorder(const Interrupt &interrupt)
+      : Interruption(interrupt), start_(Clock::now()), last_(start_) {}
+
+  Standard_Boolean UserBreak() override {
+    const Clock::time_point now = Clock::now();
+    if (count_ == 0) {
+      first_ = now - start_;
+    } else if (now - last_ > longest_) {
+      longest_ = now - last_;
+      longest_after_ = count_;
+    }
+    last_ = now;
+    ++count_;
+    return Interruption::UserBreak();
+  }
+
+  // The polls so far, with the time from the last one to now as the end of the call.
+  PollData data() const {
+    const Clock::time_point now = Clock::now();
+    return PollData{count_,         milliseconds(first_),      milliseconds(longest_),
+                    longest_after_, milliseconds(now - last_), milliseconds(now - start_)};
+  }
+
+ private:
+  using Clock = std::chrono::steady_clock;
+
+  static double milliseconds(Clock::duration duration) {
+    return std::chrono::duration<double, std::milli>(duration).count();
+  }
+
+  Clock::time_point start_;
+  Clock::time_point last_;
+  Clock::duration first_{};
+  Clock::duration longest_{};
+  std::uint64_t longest_after_ = 0;
+  std::uint64_t count_ = 0;
+};
+
+// An edge or a vertex a call made and an input element it came from.
+struct Origin {
+  TopoDS_Shape element;
+  SubShapeData input;
+  RelationType relation;
+};
+
+// A made edge and the edge HLR drew in 3D that it was projected from.
+struct DrawnSource {
+  TopoDS_Shape edge;
+  TopoDS_Shape drawn;
+};
+
+// What one call made: its edges with the input elements they came from, the edges HLR drew in 3D
+// that it projected with the source of each made edge, the source edges that project to a point,
+// and those it could not project.
+struct Curves {
+  std::vector<TopoDS_Shape> edges;
+  std::vector<Origin> origins;
+  std::vector<TopoDS_Shape> drawn;
+  std::vector<DrawnSource> drawn_sources;
+  rust::Vec<ProjectedPointData> points;
+  rust::Vec<EdgeFailureData> failures;
+  std::uint32_t whole_edges = 0;
+
+  // Adds `edge`, which no history names.
+  void add(const TopoDS_Shape &edge) { edges.push_back(edge); }
+
+  // Adds `edge`, which came from `input` by `relation`, as did its vertices.
+  void add(const TopoDS_Shape &edge, SubShapeData input, RelationType relation) {
+    add(edge);
+    origins.push_back(Origin{edge, input, relation});
+    for (TopoDS_Iterator vertex(edge); vertex.More(); vertex.Next()) {
+      origins.push_back(Origin{vertex.Value(), input, relation});
+    }
+  }
+};
+
+// The text of an OCCT exception, as trycatch writes it.
+std::string describe(const Standard_Failure &failure) {
+  return std::string(failure.DynamicType()->Name()) + ": " + failure.GetMessageString();
+}
+
+// The largest tolerance of an edge or a vertex of `shape`.
+double largest_tolerance(const Shape &shape) {
+  double largest = 0.0;
+  for (int edge = 1; edge <= shape.edges().Extent(); ++edge) {
+    largest = std::max(largest, BRep_Tool::Tolerance(TopoDS::Edge(shape.edges()(edge))));
+  }
+  for (int vertex = 1; vertex <= shape.vertices().Extent(); ++vertex) {
+    largest = std::max(largest, BRep_Tool::Tolerance(TopoDS::Vertex(shape.vertices()(vertex))));
+  }
+  return largest;
+}
+
+// The result element an origin names, by its kind and index in `result`.
+SubShapeData element_of(const Shape &result, const TopoDS_Shape &element) {
+  const ElementKind kind =
+      element.ShapeType() == TopAbs_VERTEX ? ElementKind::Vertex : ElementKind::Edge;
+  return SubShapeData{kind, static_cast<std::uint32_t>(result.map(kind).FindIndex(element))};
+}
+
+// The order of origins: by element, then by input, then by relation.
+std::tuple<ElementKind, std::uint32_t, ElementKind, std::uint32_t, RelationType> origin_order(
+    const OriginData &origin) {
+  return {origin.element.kind, origin.element.index, origin.input.kind, origin.input.index,
+          origin.relation};
+}
+
+// The compound of the made edges, with each input element its edges and vertices came from, each
+// pair once, in origin order, and the compound of the drawn edges, with the drawn edge each made
+// edge was projected from, in drawing order.
+CurveSetData curve_set(Curves curves, const PollRecorder &recorder) {
+  const std::shared_ptr<Shape> result = make_shape(compound_of(curves.edges));
+  const std::shared_ptr<Shape> drawn = make_shape(compound_of(curves.drawn));
+  rust::Vec<OriginData> drawn_origins;
+  for (const DrawnSource &source : curves.drawn_sources) {
+    drawn_origins.push_back(OriginData{element_of(*result, source.edge),
+                                       element_of(*drawn, source.drawn), RelationType::Projected});
+  }
+  std::vector<OriginData> found;
+  for (const Origin &origin : curves.origins) {
+    found.push_back(OriginData{element_of(*result, origin.element), origin.input, origin.relation});
+  }
+  const auto before = [](const OriginData &left, const OriginData &right) {
+    return origin_order(left) < origin_order(right);
+  };
+  const auto same = [](const OriginData &left, const OriginData &right) {
+    return origin_order(left) == origin_order(right);
+  };
+  std::sort(found.begin(), found.end(), before);
+  found.erase(std::unique(found.begin(), found.end(), same), found.end());
+  rust::Vec<OriginData> origins;
+  for (const OriginData &origin : found) {
+    origins.push_back(origin);
+  }
+  const double tolerance = largest_tolerance(*result);
+  return CurveSetData{result,
+                      std::move(origins),
+                      drawn,
+                      std::move(drawn_origins),
+                      std::move(curves.points),
+                      std::move(curves.failures),
+                      tolerance,
+                      curves.whole_edges,
+                      recorder.data()};
+}
+
+// The edges of `edges` of `shape`, checking each index.
+std::vector<std::pair<std::uint32_t, TopoDS_Edge>> source_edges(
+    const Shape &shape, rust::Slice<const std::uint32_t> edges) {
+  std::vector<std::pair<std::uint32_t, TopoDS_Edge>> sources;
+  for (std::uint32_t index : edges) {
+    sources.emplace_back(index, TopoDS::Edge(element_at(shape, ElementKind::Edge, index)));
+  }
+  return sources;
+}
+
+// The edge of `edge`'s curve projected onto `plane` along its normal with
+// GeomProjLib::ProjectOnPlane, keeping the curve's parametrization or not. Raises StdFail_NotDone
+// when it gives no curve or no edge.
+TopoDS_Edge projected_curve(const TopoDS_Edge &edge, const Handle(Geom_Plane) &plane,
+                            bool keep_parametrization, Polls &polls) {
+  double first = 0.0;
+  double last = 0.0;
+  const Handle(Geom_Curve) curve = BRep_Tool::Curve(edge, first, last);
+  polls.before("GeomProjLib::ProjectOnPlane");
+  const Handle(Geom_Curve) projected =
+      GeomProjLib::ProjectOnPlane(new Geom_TrimmedCurve(curve, first, last), plane,
+                                  plane->Position().Direction(), keep_parametrization);
+  if (projected.IsNull()) {
+    raise_not_done("GeomProjLib::ProjectOnPlane returned no curve");
+  }
+  polls.before("BRepBuilderAPI_MakeEdge");
+  BRepBuilderAPI_MakeEdge maker(projected);
+  if (!maker.IsDone()) {
+    raise_not_done("BRepBuilderAPI_MakeEdge failed with status " + std::to_string(maker.Error()));
+  }
+  return maker.Edge();
+}
+
+// Projects one edge with BRepProj_Projection onto `target` along `direction` and adds the edges of
+// its wires.
+void project_edge(std::uint32_t index, const TopoDS_Edge &edge, const TopoDS_Face &target,
+                  const gp_Dir &direction, Curves &curves, Polls &polls) {
+  polls.before("BRepProj_Projection");
+  BRepProj_Projection projection(edge, target, direction);
+  if (!projection.IsDone()) {
+    curves.failures.push_back(EdgeFailureData{index, "BRepProj_Projection is not done"});
+    return;
+  }
+  for (TopExp_Explorer piece(projection.Shape(), TopAbs_EDGE); piece.More(); piece.Next()) {
+    curves.add(piece.Current(), SubShapeData{ElementKind::Edge, index}, RelationType::Projected);
+  }
+}
+
+// The point a source edge projects to when its projection has no length: a degenerated edge, or
+// a line along the plane's normal. No projection algorithm makes a curve of it.
+std::optional<gp_Pnt> projects_to_point(const TopoDS_Edge &edge, const gp_Pln &plane) {
+  std::optional<gp_Pnt> point;
+  if (BRep_Tool::Degenerated(edge)) {
+    point = BRep_Tool::Pnt(TopExp::FirstVertex(edge));
+  } else if (const BRepAdaptor_Curve curve(edge);
+             curve.GetType() == GeomAbs_Line &&
+             curve.Line().Direction().IsParallel(plane.Axis().Direction(), Precision::Angular())) {
+    point = curve.Value(curve.FirstParameter());
+  }
+  if (point) {
+    double u_parameter = 0.0;
+    double v_parameter = 0.0;
+    ElSLib::Parameters(plane, *point, u_parameter, v_parameter);
+    point = ElSLib::Value(u_parameter, v_parameter, plane);
+  }
+  return point;
+}
+
+// Records the point of each source edge that projects to one, runs `project` on each other source
+// edge and records an OCCT exception as that edge's failure.
+template <class Project>
+void project_each(const Shape &shape, rust::Slice<const std::uint32_t> edges, const gp_Pln &plane,
+                  Curves &curves, Project &&project) {
+  for (const auto &[index, edge] : source_edges(shape, edges)) {
+    if (const std::optional<gp_Pnt> point = projects_to_point(edge, plane)) {
+      curves.points.push_back(ProjectedPointData{index, to_vec3(point->XYZ())});
+      continue;
+    }
+    try {
+      project(index, edge);
+    } catch (const Partsmith_Canceled &) {
+      throw;
+    } catch (const Standard_Failure &failure) {
+      curves.failures.push_back(EdgeFailureData{index, describe(failure)});
+    }
+  }
+}
+
+// The displacement from the projector's frame, where HLR draws its edges, onto the plane.
+gp_Trsf onto_plane(const Frame &plane) {
+  gp_Trsf displacement;
+  displacement.SetDisplacement(gp_Ax3(), to_ax3(plane));
+  return displacement;
+}
+
+// Gives the edges HLR drew in its projector's frame their 3D curves and moves them onto the plane.
+void place_on_plane(Curves &curves, const Frame &plane, Polls &polls) {
+  const TopoDS_Compound drawn = compound_of(curves.edges);
+  polls.before("BRepLib::BuildCurves3d");
+  BRepLib::BuildCurves3d(drawn);
+  polls.before("BRepBuilderAPI_Transform");
+  BRepBuilderAPI_Transform mover(drawn, onto_plane(plane), Standard_True);
+  for (TopoDS_Shape &edge : curves.edges) {
+    edge = mover.ModifiedShape(edge);
+  }
+  for (Origin &origin : curves.origins) {
+    origin.element = mover.ModifiedShape(origin.element);
+  }
+}
+
+// The number of edges of a shape that may be null.
+std::uint32_t edge_count(const TopoDS_Shape &shape) {
+  if (shape.IsNull()) {
+    return 0;
+  }
+  TopTools_IndexedMapOfShape edges;
+  TopExp::MapShapes(shape, TopAbs_EDGE, edges);
+  return static_cast<std::uint32_t>(edges.Extent());
+}
+
+// Adds each edge of `outlines`, a compound HLR drew for input face `face`, or nothing when null.
+void add_outlines(const TopoDS_Shape &outlines, std::uint32_t face, Curves &curves) {
+  if (outlines.IsNull()) {
+    return;
+  }
+  for (TopExp_Explorer edge(outlines, TopAbs_EDGE); edge.More(); edge.Next()) {
+    curves.add(edge.Current(), SubShapeData{ElementKind::Face, face}, RelationType::Outlined);
+  }
+}
+
+}  // namespace
+
+CurveSetData project_on_plane(const Shape &shape, rust::Slice<const std::uint32_t> edges,
+                              const Frame &plane, bool keep_parametrization,
+                              const Interrupt &interrupt) {
+  const Handle(PollRecorder) recorder = new PollRecorder(interrupt);
+  Polls polls(recorder);
+  const gp_Pln target_plane(to_ax3(plane));
+  const Handle(Geom_Plane) target = new Geom_Plane(target_plane);
+  Curves curves;
+  project_each(shape, edges, target_plane, curves,
+               [&](std::uint32_t index, const TopoDS_Edge &edge) {
+                 curves.add(projected_curve(edge, target, keep_parametrization, polls),
+                            SubShapeData{ElementKind::Edge, index}, RelationType::Projected);
+               });
+  return curve_set(std::move(curves), *recorder);
+}
+
+CurveSetData project_by_prism(const Shape &shape, rust::Slice<const std::uint32_t> edges,
+                              const Frame &plane, const Interrupt &interrupt) {
+  const Handle(PollRecorder) recorder = new PollRecorder(interrupt);
+  Polls polls(recorder);
+  const gp_Pln target_plane(to_ax3(plane));
+  polls.before("BRepBuilderAPI_MakeFace");
+  const TopoDS_Face target = covering_face(shape.get(), target_plane);
+  Curves curves;
+  project_each(shape, edges, target_plane, curves,
+               [&](std::uint32_t index, const TopoDS_Edge &edge) {
+                 project_edge(index, edge, target, target_plane.Axis().Direction(), curves, polls);
+               });
+  return curve_set(std::move(curves), *recorder);
+}
+
+CurveSetData section_by_plane(const Shape &shape, const Frame &plane, bool approximation,
+                              const Interrupt &interrupt) {
+  const Handle(PollRecorder) recorder = new PollRecorder(interrupt);
+  Polls polls(recorder);
+  BRepAlgoAPI_Section section(shape.get(), gp_Pln(to_ax3(plane)), Standard_False);
+  section.Approximation(approximation);
+  set_boolean_options(section);
+  polls.run("BRepAlgoAPI_Section",
+            [&](const Message_ProgressRange &range) { section.Build(range); });
+  require_no_errors(section, "BRepAlgoAPI_Section");
+  // The section's edges, and each input element whose history names one of them or one of their
+  // vertices: the element itself, or an image in its Modified or Generated list.
+  Curves curves;
+  TopTools_IndexedMapOfShape made;
+  TopExp::MapShapes(section.Shape(), TopAbs_EDGE, made);
+  curves.edges.assign(made.cbegin(), made.cend());
+  TopExp::MapShapes(section.Shape(), TopAbs_VERTEX, made);
+  for (ElementKind kind : {ElementKind::Face, ElementKind::Edge, ElementKind::Vertex}) {
+    const TopTools_IndexedMapOfShape &inputs = shape.map(kind);
+    for (int index = 1; index <= inputs.Extent(); ++index) {
+      const TopoDS_Shape &input = inputs(index);
+      const SubShapeData source{kind, static_cast<std::uint32_t>(index)};
+      if (made.Contains(input)) {
+        curves.origins.push_back(Origin{input, source, RelationType::Kept});
+      }
+      for (const TopoDS_Shape &image : section.Modified(input)) {
+        if (made.Contains(image)) {
+          curves.origins.push_back(Origin{image, source, RelationType::Modified});
+        }
+      }
+      for (const TopoDS_Shape &image : section.Generated(input)) {
+        if (made.Contains(image)) {
+          curves.origins.push_back(Origin{image, source, RelationType::Generated});
+        }
+      }
+    }
+  }
+  curves.whole_edges = static_cast<std::uint32_t>(curves.edges.size());
+  return curve_set(std::move(curves), *recorder);
+}
+
+CurveSetData silhouette_exact(const Shape &shape, const Frame &plane, bool edges_on_outline,
+                              const Interrupt &interrupt) {
+  const Handle(PollRecorder) recorder = new PollRecorder(interrupt);
+  Polls polls(recorder);
+  polls.before("BRepBuilderAPI_Copy");
+  const Shape copy = copy_shape(shape);
+  const Handle(HLRBRep_Algo) algorithm = new HLRBRep_Algo;
+  algorithm->Add(copy.get());
+  algorithm->Projector(HLRAlgo_Projector(to_ax2(plane)));
+  polls.before("HLRBRep_Algo::Update");
+  algorithm->Update();
+  polls.before("HLRBRep_Algo::Hide");
+  algorithm->Hide();
+  polls.before("HLRBRep_HLRToShape");
+  HLRBRep_HLRToShape extractor(algorithm);
+  Curves curves;
+  if (edges_on_outline) {
+    // The visible outlines inside faces and the visible parts of edges on the outline, in 3D
+    // (OutLineVCompound3d), each projected onto the plane. No history names them; each made edge
+    // is recorded with the drawn edge it was projected from, for the checks of a projection.
+    const TopoDS_Shape drawn = extractor.OutLineVCompound3d();
+    curves.whole_edges = edge_count(drawn);
+    const Handle(Geom_Plane) target = new Geom_Plane(gp_Pln(to_ax3(plane)));
+    if (!drawn.IsNull()) {
+      for (TopExp_Explorer edge(drawn, TopAbs_EDGE); edge.More(); edge.Next()) {
+        const TopoDS_Edge made =
+            projected_curve(TopoDS::Edge(edge.Current()), target, false, polls);
+        curves.add(made);
+        curves.drawn.push_back(edge.Current());
+        curves.drawn_sources.push_back(DrawnSource{made, edge.Current()});
+      }
+    }
+    return curve_set(std::move(curves), *recorder);
+  }
+  // The outlines of each face of the outlined shape, the copy with its outlines as internal edges,
+  // with the face of the copy it was built from.
+  const Handle(HLRTopoBRep_OutLiner) &outliner = algorithm->ShapeBounds(1).Shape();
+  TopTools_IndexedMapOfShape outlined;
+  TopExp::MapShapes(outliner->OutLinedShape(), TopAbs_FACE, outlined);
+  for (int face = 1; face <= outlined.Extent(); ++face) {
+    const TopoDS_Shape &outlined_face = outlined(face);
+    const TopoDS_Shape original = outliner->DataStructure().NewSOldS(outlined_face);
+    const auto index = static_cast<std::uint32_t>(copy.faces().FindIndex(original));
+    add_outlines(extractor.OutLineVCompound(outlined_face), index, curves);
+  }
+  curves.whole_edges = edge_count(extractor.OutLineVCompound());
+  place_on_plane(curves, plane, polls);
+  return curve_set(std::move(curves), *recorder);
+}
+
+CurveSetData silhouette_from_mesh(const Shape &shape, const Frame &plane, bool edges_on_outline,
+                                  const Interrupt &interrupt) {
+  const Handle(PollRecorder) recorder = new PollRecorder(interrupt);
+  Polls polls(recorder);
+  polls.before("BRepBuilderAPI_Copy");
+  const Shape copy = copy_shape(shape);
+  mesh(copy.get(), kMeshDeviation, kMeshAngle, polls);
+  const Handle(HLRBRep_PolyAlgo) algorithm = new HLRBRep_PolyAlgo(copy.get());
+  algorithm->Projector(HLRAlgo_Projector(to_ax2(plane)));
+  polls.before("HLRBRep_PolyAlgo::Update");
+  algorithm->Update();
+  Curves curves;
+  if (edges_on_outline) {
+    // The visible parts of the segments the algorithm marks as outlines inside faces or as edges on
+    // the outline, read as HLRBRep_PolyHLRToShape::Update reads them, each with its face or edge.
+    polls.before("HLRBRep_PolyAlgo::Hide");
+    const gp_Trsf &projector = algorithm->Projector().Transformation();
+    HLRAlgo_EdgeStatus status;
+    TopoDS_Shape source;
+    Standard_Boolean smooth = Standard_False;
+    Standard_Boolean sewn = Standard_False;
+    Standard_Boolean on_outline = Standard_False;
+    Standard_Boolean inside = Standard_False;
+    for (algorithm->InitHide(); algorithm->MoreHide(); algorithm->NextHide()) {
+      const HLRAlgo_BiPoint::PointsT &points =
+          algorithm->Hide(status, source, smooth, sewn, on_outline, inside);
+      if (!on_outline && !inside) {
+        continue;
+      }
+      gp_XYZ start = points.Pnt1;
+      gp_XYZ end = points.Pnt2;
+      projector.Transforms(start);
+      projector.Transforms(end);
+      const gp_XY origin(start.X(), start.Y());
+      const gp_XY along = gp_XY(end.X(), end.Y()) - origin;
+      if (along.Modulus() <= 1e-10) {
+        continue;
+      }
+      const ElementKind kind = inside ? ElementKind::Face : ElementKind::Edge;
+      const auto index = static_cast<std::uint32_t>(copy.map(kind).FindIndex(source));
+      HLRAlgo_EdgeIterator part;
+      for (part.InitVisible(status); part.MoreVisible(); part.NextVisible()) {
+        double from = 0.0;
+        double to = 0.0;
+        Standard_ShortReal from_tolerance = 0.0F;
+        Standard_ShortReal to_tolerance = 0.0F;
+        part.Visible(from, from_tolerance, to, to_tolerance);
+        const gp_Pnt2d first(origin + from * along);
+        const gp_Pnt2d last(origin + to * along);
+        if (first.SquareDistance(last) > 1e-20) {
+          curves.add(BRepLib_MakeEdge2d(first, last).Edge(), SubShapeData{kind, index},
+                     RelationType::Outlined);
+        }
+      }
+    }
+    curves.whole_edges = static_cast<std::uint32_t>(curves.edges.size());
+  } else {
+    polls.before("HLRBRep_PolyHLRToShape");
+    HLRBRep_PolyHLRToShape extractor;
+    extractor.Update(algorithm);
+    // The outline segments of each face of the copy, whose indices are the input's.
+    for (int face = 1; face <= copy.faces().Extent(); ++face) {
+      add_outlines(extractor.OutLineVCompound(copy.faces()(face)), static_cast<std::uint32_t>(face),
+                   curves);
+    }
+    curves.whole_edges = edge_count(extractor.OutLineVCompound());
+  }
+  place_on_plane(curves, plane, polls);
+  return curve_set(std::move(curves), *recorder);
+}
+
+rust::Vec<Vec3> edge_samples(const Shape &shape, std::uint32_t edge, std::uint32_t count) {
+  const TopoDS_Edge &sampled = TopoDS::Edge(element_at(shape, ElementKind::Edge, edge));
+  rust::Vec<Vec3> samples;
+  if (BRep_Tool::Degenerated(sampled)) {
+    // A degenerated edge has no curve: each of its points is its vertex.
+    const Vec3 vertex = to_vec3(BRep_Tool::Pnt(TopExp::FirstVertex(sampled)).XYZ());
+    for (std::uint32_t sample = 0; sample < count; ++sample) {
+      samples.push_back(vertex);
+    }
+    return samples;
+  }
+  double first = 0.0;
+  double last = 0.0;
+  const Handle(Geom_Curve) curve = BRep_Tool::Curve(sampled, first, last);
+  for (std::uint32_t sample = 0; sample < count; ++sample) {
+    const double parameter =
+        count == 1 ? first : first + (last - first) * sample / static_cast<double>(count - 1);
+    samples.push_back(to_vec3(curve->Value(parameter).XYZ()));
+  }
+  return samples;
+}
+
+rust::Vec<double> element_distances(const Shape &shape, ElementKind kind, std::uint32_t index,
+                                    rust::Slice<const Vec3> points) {
+  const TopoDS_Shape &element = element_at(shape, kind, index);
+  rust::Vec<double> distances;
+  for (const Vec3 &point : points) {
+    BRepExtrema_DistShapeShape distance(BRepBuilderAPI_MakeVertex(to_point(point)).Vertex(),
+                                        element);
+    if (!distance.IsDone()) {
+      raise_not_done("BRepExtrema_DistShapeShape found no distance");
+    }
+    distances.push_back(distance.Value());
+  }
+  return distances;
+}
+
