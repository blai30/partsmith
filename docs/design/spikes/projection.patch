 //! The web core module `partsmith_core`: an Emscripten executable whose runtime stays alive after `main` returns, so JavaScript can call `ps_alloc`, `ps_free` and `ps_call` (protocol.md section 2.10, ADR 0009).
 
+use std::hint::black_box;
+
+use partsmith_occt_sys::{
+    Interrupt, Plane, Vector, make_box, make_cylinder, project_by_prism, project_on_plane,
+    section_by_plane, silhouette_exact, silhouette_from_mesh,
+};
+
 fn main() {
     // Creating the session here pays its setup cost while the module is instantiated. Calling into the library also keeps it, and with it the three exports, in the link.
     partsmith_wasm::initialize_session();
+    keep_projection_spike();
+}
+
+/// Calls the projection spike's functions on small inputs so the linker keeps their code for the size measurement (kernel spec section 8.1 items 2 and 4): each construction once, so each function with each value of its option, the projections and the section on a 1 x 2 x 3 mm box and the silhouettes on a cylinder of radius 1 and height 2, each by or along the plane through the origin with normal (0, 1, 1).
+fn keep_projection_spike() {
+    let (Ok(block), Ok(cylinder)) = (
+        make_box(&Plane::XY, 1.0, 2.0, 3.0),
+        make_cylinder(&Plane::XY, 1.0, 2.0),
+    ) else {
+        return;
+    };
+    let (block, cylinder) = (block.shape, cylinder.shape);
+    let plane = Plane {
+        normal: Vector::new(0.0, 1.0, 1.0),
+        ..Plane::XY
+    };
+    let edges = [1, 2, 3];
+    let interrupt = Interrupt::new();
+    let _ = black_box(project_on_plane(&block, &edges, &plane, false, &interrupt));
+    let _ = black_box(project_on_plane(&block, &edges, &plane, true, &interrupt));
+    let _ = black_box(project_by_prism(&block, &edges, &plane, &interrupt));
+    let _ = black_box(section_by_plane(&block, &plane, true, &interrupt));
+    let _ = black_box(section_by_plane(&block, &plane, false, &interrupt));
+    let _ = black_box(silhouette_exact(&cylinder, &plane, false, &interrupt));
+    let _ = black_box(silhouette_exact(&cylinder, &plane, true, &interrupt));
+    let _ = black_box(silhouette_from_mesh(&cylinder, &plane, false, &interrupt));
+    let _ = black_box(silhouette_from_mesh(&cylinder, &plane, true, &interrupt));
 }
