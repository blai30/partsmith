+//! The projection spike (kernel spec section 8.7): edges of a body projected onto a plane, the
+//! section of a body by a plane and a body's silhouette along a plane's normal, with what the spike
+//! measures of each call. Spike code: it lives on the branch `spike/kernel-projection` and never
+//! merges (section 8.1).
+
+use std::time::Duration;
+
+use crate::error::{KernelError, Operation, call};
+use crate::ffi::bridge as sys;
+use crate::interrupt::Interrupt;
+use crate::shape::{Shape, SubShape, SubShapeKind};
+use crate::values::{Plane, Point, check_finite};
+
+/// How an edge or a vertex of a spike's curves came from an input element.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, PartialOrd, Ord, Hash)]
+pub enum CurveRelation {
+    /// The input element itself is in the result (OCCT's history: unchanged).
+    Kept,
+    /// In the input element's `Modified` list of the builder's history.
+    Modified,
+    /// In the input element's `Generated` list of the builder's history.
+    Generated,
+    /// Made by the shim's own call for that input edge: no OCCT history names it.
+    Projected,
+    /// Drawn by HLR's extractor for that input face alone: no OCCT history names it.
+    Outlined,
+}
+
+/// One edge or vertex of a spike's curves and an input element it came from.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, PartialOrd, Ord, Hash)]
+pub struct CurveOrigin {
+    /// The edge or vertex of the curves.
+    pub element: SubShape,
+    /// The element of the input it came from.
+    pub input: SubShape,
+    /// How it came from it.
+    pub relation: CurveRelation,
+}
+
+/// A source edge whose projection is shorter than the modeling tolerance: a point.
+#[derive(Debug, Clone, Copy, PartialEq)]
+pub struct ProjectedPoint {
+    /// The source edge.
+    pub edge: u32,
+    /// Where it projects.
+    pub point: Point,
+}
+
+/// A source edge that a projection could not turn into an edge.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct EdgeFailure {
+    /// The source edge.
+    pub edge: u32,
+    /// The exception OCCT raised or the status it reported.
+    pub message: String,
+}
+
+/// The polls of one call with an interrupt that is never requested (section 8.1 item 4).
+#[derive(Debug, Clone, Copy, PartialEq)]
+pub struct PollRecord {
+    /// The number of `UserBreak` calls.
+    pub count: u64,
+    /// From the call's start to its first poll.
+    pub first: Duration,
+    /// The longest gap between two polls.
+    pub longest: Duration,
+    /// How many polls came before the longest gap: it ends at poll `longest_after + 1`.
+    pub longest_after: u64,
+    /// From the last poll to the call's end.
+    pub last: Duration,
+    /// The whole call in the shim.
+    pub total: Duration,
+}
+
+/// The curves one projection, section or silhouette made, with what the spike measures of them.
+#[derive(Debug, Clone)]
+pub struct CurveSet {
+    /// A compound of edges on the plane.
+    pub shape: Shape,
+    /// Each input element an edge or a vertex of `shape` came from, ascending.
+    pub origins: Vec<CurveOrigin>,
+    /// For the exact silhouette with edges on the outline, a compound of the edges HLR drew in 3D,
+    /// which the call projects onto the plane; an empty compound otherwise.
+    pub drawn: Shape,
+    /// Each edge of `shape` projected from an edge of `drawn`, as an origin whose input is that
+    /// edge of `drawn`, in the order the edges were drawn.
+    pub drawn_origins: Vec<CurveOrigin>,
+    /// The source edges whose projection is a point.
+    pub points: Vec<ProjectedPoint>,
+    /// The source edges the projection could not turn into an edge.
+    pub failures: Vec<EdgeFailure>,
+    /// The largest tolerance of an edge or a vertex of `shape`.
+    pub tolerance: f64,
+    /// For a silhouette, the edges of the extractor's compound of the whole shape, which the
+    /// compounds of each face add up to; for a section, its edges; 0 for a projection.
+    pub whole_edges: u32,
+    /// The polls of the call.
+    pub polls: PollRecord,
+}
+
+const EMPTY_SHAPE_MESSAGE: &str = "The shape has no faces to cut or outline.";
+
+/// The milliseconds the shim reports, as a duration.
+fn duration(milliseconds: f64) -> Duration {
+    Duration::from_secs_f64(milliseconds.max(0.0) / 1000.0)
+}
+
+impl PollRecord {
+    fn from_ffi(data: sys::PollData) -> PollRecord {
+        PollRecord {
+            count: data.count,
+            first: duration(data.first),
+            longest: duration(data.longest),
+            longest_after: data.longest_after,
+            last: duration(data.last),
+            total: duration(data.total),
+        }
+    }
+}
+
+impl CurveRelation {
+    fn from_ffi(
+        operation: Operation,
+        relation: sys::RelationType,
+    ) -> Result<CurveRelation, KernelError> {
+        match relation {
+            sys::RelationType::Kept => Ok(CurveRelation::Kept),
+            sys::RelationType::Modified => Ok(CurveRelation::Modified),
+            sys::RelationType::Generated => Ok(CurveRelation::Generated),
+            sys::RelationType::Projected => Ok(CurveRelation::Projected),
+            sys::RelationType::Outlined => Ok(CurveRelation::Outlined),
+            _ => Err(KernelError::unknown_from_shim(
+                operation,
+                "relation",
+                relation.repr,
+            )),
+        }
+    }
+}
+
+/// A sub-shape the shim reports.
+fn sub_shape(operation: Operation, data: sys::SubShapeData) -> Result<SubShape, KernelError> {
+    Ok(SubShape {
+        kind: SubShapeKind::from_ffi(operation, data.kind)?,
+        index: data.index,
+    })
+}
+
+/// The origins the shim reports.
+fn origins(
+    operation: Operation,
+    origins: &[sys::OriginData],
+) -> Result<Vec<CurveOrigin>, KernelError> {
+    origins
+        .iter()
+        .map(|origin| {
+            Ok(CurveOrigin {
+                element: sub_shape(operation, origin.element)?,
+                input: sub_shape(operation, origin.input)?,
+                relation: CurveRelation::from_ffi(operation, origin.relation)?,
+            })
+        })
+        .collect()
+}
+
+impl CurveSet {
+    fn from_ffi(operation: Operation, data: sys::CurveSetData) -> Result<CurveSet, KernelError> {
+        Ok(CurveSet {
+            shape: Shape::from_ffi(operation, data.shape)?,
+            origins: origins(operation, &data.origins)?,
+            drawn: Shape::from_ffi(operation, data.drawn)?,
+            drawn_origins: origins(operation, &data.drawn_origins)?,
+            points: data
+                .points
+                .iter()
+                .map(|point| ProjectedPoint {
+                    edge: point.edge,
+                    point: Point::from_ffi(point.point),
+                })
+                .collect(),
+            failures: data
+                .failures
+                .into_iter()
+                .map(|failure| EdgeFailure {
+                    edge: failure.edge,
+                    message: failure.message,
+                })
+                .collect(),
+            tolerance: data.tolerance,
+            whole_edges: data.whole_edges,
+            polls: PollRecord::from_ffi(data.polls),
+        })
+    }
+}
+
+/// Checks the source edges of a projection.
+fn check_edges(shape: &Shape, edges: &[u32]) -> Result<(), KernelError> {
+    edges
+        .iter()
+        .try_for_each(|edge| shape.check_index(Operation::Project, SubShapeKind::Edge, *edge))
+}
+
+/// Checks that a section or a silhouette has faces to work on.
+fn check_faces(operation: Operation, shape: &Shape) -> Result<(), KernelError> {
+    if shape.count(SubShapeKind::Face) == 0 {
+        Err(KernelError::invalid_input(operation, EMPTY_SHAPE_MESSAGE))
+    } else {
+        Ok(())
+    }
+}
+
+/// Projects each of `edges` of `shape` onto `plane` along its normal with
+/// `GeomProjLib::ProjectOnPlane` of the edge's curve, one call per edge, keeping each curve's
+/// parametrization or not (its `KeepParametrization`).
+pub fn project_on_plane(
+    shape: &Shape,
+    edges: &[u32],
+    plane: &Plane,
+    keep_parametrization: bool,
+    interrupt: &Interrupt,
+) -> Result<CurveSet, KernelError> {
+    let operation = Operation::Project;
+    let frame = plane.frame(operation)?;
+    check_edges(shape, edges)?;
+    let data = call(operation, || {
+        sys::project_on_plane(
+            shape.inner(),
+            edges,
+            &frame.to_ffi(),
+            keep_parametrization,
+            interrupt,
+        )
+    })?;
+    CurveSet::from_ffi(operation, data)
+}
+
+/// Projects each of `edges` of `shape` onto `plane` along its normal with `BRepProj_Projection`,
+/// the section of the edge's prism by a face on the plane, one call per edge.
+pub fn project_by_prism(
+    shape: &Shape,
+    edges: &[u32],
+    plane: &Plane,
+    interrupt: &Interrupt,
+) -> Result<CurveSet, KernelError> {
+    let operation = Operation::Project;
+    let frame = plane.frame(operation)?;
+    check_edges(shape, edges)?;
+    let data = call(operation, || {
+        sys::project_by_prism(shape.inner(), edges, &frame.to_ffi(), interrupt)
+    })?;
+    CurveSet::from_ffi(operation, data)
+}
+
+/// The section of `shape` by `plane` with `BRepAlgoAPI_Section`, its curves approximated or not.
+pub fn section_by_plane(
+    shape: &Shape,
+    plane: &Plane,
+    approximation: bool,
+    interrupt: &Interrupt,
+) -> Result<CurveSet, KernelError> {
+    let operation = Operation::Section;
+    let frame = plane.frame(operation)?;
+    check_faces(operation, shape)?;
+    let data = call(operation, || {
+        sys::section_by_plane(shape.inner(), &frame.to_ffi(), approximation, interrupt)
+    })?;
+    CurveSet::from_ffi(operation, data)
+}
+
+/// The visible outlines of `shape` seen along `plane`'s normal, placed on `plane`, with
+/// `HLRBRep_Algo`: the outlines inside faces, `HLRBRep_HLRToShape::OutLineVCompound` of each
+/// face; with `edges_on_outline`, also the edges on the outline, `OutLineVCompound3d` of the
+/// whole shape with each edge projected onto `plane` by `GeomProjLib::ProjectOnPlane`, the drawn
+/// edges in [`CurveSet::drawn`].
+pub fn silhouette_exact(
+    shape: &Shape,
+    plane: &Plane,
+    edges_on_outline: bool,
+    interrupt: &Interrupt,
+) -> Result<CurveSet, KernelError> {
+    let operation = Operation::Silhouette;
+    let frame = plane.frame(operation)?;
+    check_faces(operation, shape)?;
+    let data = call(operation, || {
+        sys::silhouette_exact(shape.inner(), &frame.to_ffi(), edges_on_outline, interrupt)
+    })?;
+    CurveSet::from_ffi(operation, data)
+}
+
+/// The visible outlines of `shape` seen along `plane`'s normal, placed on `plane`, with
+/// `HLRBRep_PolyAlgo` on a mesh at 0.05 mm and 5 degrees: the outlines inside faces,
+/// `HLRBRep_PolyHLRToShape::OutLineVCompound` of each face; with `edges_on_outline`, also the
+/// edges on the outline, read from the algorithm's segments.
+pub fn silhouette_from_mesh(
+    shape: &Shape,
+    plane: &Plane,
+    edges_on_outline: bool,
+    interrupt: &Interrupt,
+) -> Result<CurveSet, KernelError> {
+    let operation = Operation::Silhouette;
+    let frame = plane.frame(operation)?;
+    check_faces(operation, shape)?;
+    let data = call(operation, || {
+        sys::silhouette_from_mesh(shape.inner(), &frame.to_ffi(), edges_on_outline, interrupt)
+    })?;
+    CurveSet::from_ffi(operation, data)
+}
+
+/// `count` points of `edge`'s curve at evenly spaced parameters from its first to its last, for
+/// the spike's checks.
+pub fn edge_samples(shape: &Shape, edge: u32, count: u32) -> Result<Vec<Point>, KernelError> {
+    let operation = Operation::Query;
+    shape.check_index(operation, SubShapeKind::Edge, edge)?;
+    let samples = call(operation, || sys::edge_samples(shape.inner(), edge, count))?;
+    Ok(samples.into_iter().map(Point::from_ffi).collect())
+}
+
+/// The distance from each of `points` to the element `index` of `kind` of `shape`, for the
+/// spike's checks.
+pub fn element_distances(
+    shape: &Shape,
+    kind: SubShapeKind,
+    index: u32,
+    points: &[Point],
+) -> Result<Vec<f64>, KernelError> {
+    let operation = Operation::Query;
+    Shape::check_element_kind(operation, kind)?;
+    shape.check_index(operation, kind, index)?;
+    let coordinates: Vec<f64> = points
+        .iter()
+        .flat_map(|point| [point.x, point.y, point.z])
+        .collect();
+    check_finite(operation, &coordinates)?;
+    let points: Vec<sys::Vec3> = points.iter().map(|point| point.to_ffi()).collect();
+    call(operation, || {
+        sys::element_distances(shape.inner(), kind.to_ffi(), index, &points)
+    })
+}
