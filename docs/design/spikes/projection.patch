+//! The inputs of the projection spike (kernel spec section 8.7) and the constructions each input
+//! runs, shared by `tests/projection.rs` and the spike's rows in `benches/budgets.rs`, which
+//! includes this module with `#[path]`.
+
+// The tests and the bench each use only some of these items.
+#![allow(dead_code)]
+
+use std::time::Duration;
+
+use partsmith_occt_sys::{
+    CurveSet, EdgeRadius, GeometryKind, Interrupt, KernelError, PlanarLoop, PlanarRegion, Plane,
+    Point, Shape, SubShapeKind, Vector, cut, extrude, fillet, make_cone, make_cylinder,
+    make_profile, make_torus, project_by_prism, project_on_plane, section_by_plane, shell,
+    silhouette_exact, silhouette_from_mesh,
+};
+
+use super::common;
+
+/// One construction of section 8.7.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum Construction {
+    /// `GeomProjLib::ProjectOnPlane` of each edge's curve.
+    CurveOnPlane,
+    /// The same with its option `KeepParametrization` on.
+    CurveOnPlaneKeepingParameters,
+    /// `BRepProj_Projection` of each edge.
+    Prism,
+    /// `BRepAlgoAPI_Section` with approximation on, as the facade's `section` runs it.
+    SectionApproximated,
+    /// `BRepAlgoAPI_Section` with approximation off.
+    SectionExact,
+    /// `HLRBRep_Algo` with `HLRBRep_HLRToShape::OutLineVCompound`.
+    SilhouetteExact,
+    /// `HLRBRep_Algo` with the edges on the outline too (`OutLineVCompound3d`, projected).
+    SilhouetteExactWithEdges,
+    /// `HLRBRep_PolyAlgo` with `HLRBRep_PolyHLRToShape::OutLineVCompound`.
+    SilhouetteMesh,
+    /// `HLRBRep_PolyAlgo` with the edges on the outline too.
+    SilhouetteMeshWithEdges,
+}
+
+/// The constructions of edge projections.
+pub const PROJECTIONS: &[Construction] = &[
+    Construction::CurveOnPlane,
+    Construction::CurveOnPlaneKeepingParameters,
+    Construction::Prism,
+];
+/// The constructions of the section by the sketch plane.
+pub const SECTIONS: &[Construction] = &[
+    Construction::SectionApproximated,
+    Construction::SectionExact,
+];
+/// The constructions of silhouettes.
+pub const SILHOUETTES: &[Construction] = &[
+    Construction::SilhouetteExact,
+    Construction::SilhouetteExactWithEdges,
+    Construction::SilhouetteMesh,
+    Construction::SilhouetteMeshWithEdges,
+];
+
+impl Construction {
+    /// The construction's name in test output and bench rows.
+    pub fn name(self) -> &'static str {
+        match self {
+            Construction::CurveOnPlane => "curve-on-plane",
+            Construction::CurveOnPlaneKeepingParameters => "curve-on-plane-keeping-parameters",
+            Construction::Prism => "prism",
+            Construction::SectionApproximated => "section-approximated",
+            Construction::SectionExact => "section-exact",
+            Construction::SilhouetteExact => "silhouette-exact",
+            Construction::SilhouetteExactWithEdges => "silhouette-exact-with-edges",
+            Construction::SilhouetteMesh => "silhouette-mesh",
+            Construction::SilhouetteMeshWithEdges => "silhouette-mesh-with-edges",
+        }
+    }
+
+    /// Runs the construction on `input`.
+    pub fn run(self, input: &Input, interrupt: &Interrupt) -> Result<CurveSet, KernelError> {
+        let (shape, edges, plane) = (&input.shape, input.edges.as_slice(), &input.plane);
+        match self {
+            Construction::CurveOnPlane => project_on_plane(shape, edges, plane, false, interrupt),
+            Construction::CurveOnPlaneKeepingParameters => {
+                project_on_plane(shape, edges, plane, true, interrupt)
+            }
+            Construction::Prism => project_by_prism(shape, edges, plane, interrupt),
+            Construction::SectionApproximated => section_by_plane(shape, plane, true, interrupt),
+            Construction::SectionExact => section_by_plane(shape, plane, false, interrupt),
+            Construction::SilhouetteExact => silhouette_exact(shape, plane, false, interrupt),
+            Construction::SilhouetteExactWithEdges => {
+                silhouette_exact(shape, plane, true, interrupt)
+            }
+            Construction::SilhouetteMesh => silhouette_from_mesh(shape, plane, false, interrupt),
+            Construction::SilhouetteMeshWithEdges => {
+                silhouette_from_mesh(shape, plane, true, interrupt)
+            }
+        }
+    }
+}
+
+/// The exact silhouette of a silhouette input, for the deviation the spike measures.
+#[derive(Debug, Clone, Copy)]
+pub enum Outline {
+    /// A cylinder of `radius` around the axis through `origin` along `axis`.
+    Cylinder {
+        origin: Point,
+        axis: Vector,
+        radius: f64,
+    },
+    /// A sphere.
+    Sphere { center: Point, radius: f64 },
+    /// A torus around the axis through `center` along `axis`.
+    Torus {
+        center: Point,
+        axis: Vector,
+        major_radius: f64,
+        minor_radius: f64,
+    },
+    /// A cone with its apex at `apex`, opening along `axis` at `half_angle`.
+    Cone {
+        apex: Point,
+        axis: Vector,
+        half_angle: f64,
+    },
+    /// Seen along Z: the rectangle from `min` to `max` in X and Y with corners rounded at `radius`.
+    RoundedRectangle {
+        min: (f64, f64),
+        max: (f64, f64),
+        radius: f64,
+    },
+}
+
+/// One input of section 8.7 with the constructions it runs.
+pub struct Input {
+    /// The input's name in test output and bench rows.
+    pub name: &'static str,
+    /// The body.
+    pub shape: Shape,
+    /// The edges a projection projects; none for a section or a silhouette.
+    pub edges: Vec<u32>,
+    /// The sketch plane: the projections run along its normal, the section is by it, and the
+    /// silhouette is seen along its normal and placed on it.
+    pub plane: Plane,
+    /// The constructions the input runs.
+    pub constructions: &'static [Construction],
+    /// The exact silhouette of a silhouette input.
+    pub outline: Option<Outline>,
+    /// Section 8.7's time natively, for the 56 edges of test 45's result (section 8.7 counts 50).
+    pub budget: Option<Duration>,
+}
+
+/// The plane through the origin with `normal` and x axis +X.
+fn plane_with_normal(normal: Vector) -> Plane {
+    Plane {
+        origin: common::ORIGIN,
+        normal,
+        x_axis: Vector::new(1.0, 0.0, 0.0),
+    }
+}
+
+/// Every edge of `shape`, ascending.
+fn every_edge(shape: &Shape) -> Vec<u32> {
+    (1..=shape.count(SubShapeKind::Edge)).collect()
+}
+
+/// The direction oblique to the primitives' Z axes: 45 degrees from it, (0, 1, 1).
+const OBLIQUE: Vector = Vector::new(0.0, 1.0, 1.0);
+
+/// The top circle of test 10's cylinder, at z = 10.
+fn top_circle(cylinder: &Shape) -> u32 {
+    let circles = common::elements_where(cylinder, SubShapeKind::Edge, |edge| {
+        edge.kind == GeometryKind::Circle && (edge.centroid.z - 10.0).abs() < 1e-9
+    });
+    assert_eq!(circles.len(), 1, "the cylinder has one top circle");
+    circles[0]
+}
+
+/// The part of spec section 5, as `benches/budgets.rs` builds it: the 80 x 50 x 30 extrude of
+/// naming spec test 81 with its four vertical edges rounded (radius 5), a hole and a slot cut
+/// through it, then shelled to 2 mm walls with the top face removed. Its sketch plane is
+/// `Plane::XY`, the plane of the extrude's profile.
+pub fn section_five_part() -> Shape {
+    let interrupt = Interrupt::new();
+    let rectangle = make_profile(
+        &Plane::XY,
+        &[common::region(common::rectangle((0.0, 0.0), (80.0, 50.0)))],
+    )
+    .expect("the rectangle is a profile");
+    let block = extrude(&rectangle, common::UP, 0.0, 30.0, &interrupt)
+        .expect("the block extrudes")
+        .shape;
+    let vertical: Vec<EdgeRadius> = common::elements_where(&block, SubShapeKind::Edge, |edge| {
+        edge.direction
+            .is_some_and(|direction| direction.z.abs() > 0.5)
+    })
+    .into_iter()
+    .map(|edge| EdgeRadius { edge, radius: 5.0 })
+    .collect();
+    let rounded = fillet(&block, &vertical, &interrupt)
+        .expect("the vertical edges round")
+        .shape;
+    let hole = make_cylinder(&common::xy_plane_at(20.0, 25.0, -1.0), 5.0, 32.0)
+        .expect("the hole cylinder builds")
+        .shape;
+    let slot_outline = PlanarLoop {
+        curves: vec![
+            common::line(1, (50.0, 21.0), (65.0, 21.0)),
+            common::arc(2, (65.0, 25.0), 4.0, (65.0, 21.0), (65.0, 29.0)),
+            common::line(3, (65.0, 29.0), (50.0, 29.0)),
+            common::arc(4, (50.0, 25.0), 4.0, (50.0, 29.0), (50.0, 21.0)),
+        ],
+    };
+    let slot_profile = make_profile(
+        &Plane::XY,
+        &[PlanarRegion {
+            outer: slot_outline,
+            holes: Vec::new(),
+        }],
+    )
+    .expect("the slot is a profile");
+    let slot = extrude(&slot_profile, common::UP, -1.0, 31.0, &interrupt)
+        .expect("the slot extrudes")
+        .shape;
+    let drilled = cut(&rounded, &[hole, slot], &interrupt)
+        .expect("the hole and slot cut")
+        .shape;
+    let top = common::elements_where(&drilled, SubShapeKind::Face, |face| {
+        face.kind == GeometryKind::Plane
+            && face
+                .direction
+                .is_some_and(|direction| direction.dot(common::UP) > 1.0 - 1e-9)
+            && (face.centroid.z - 30.0).abs() < 1e-9
+    });
+    shell(&drilled, &top, 2.0, &interrupt)
+        .expect("the part shells")
+        .shape
+}
