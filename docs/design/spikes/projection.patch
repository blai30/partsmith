+// The projection spike (kernel spec section 8.7): edges of a body projected onto a plane along
+// its normal, the section of a body by a plane, and a body's silhouette seen along a plane's
+// normal and placed on the plane, each with the polls of its call. Spike code: it lives on the
+// branch spike/kernel-projection and never merges (section 8.1).
+#include <algorithm>
+#include <chrono>
+#include <cmath>
+#include <cstdint>
+#include <optional>
+#include <string>
+#include <tuple>
+#include <vector>
+
