+"""Steps 2 and 3 of ADR 0070's method: puts Pyodide's runtime files and the `partsmith` package into ui/public/pyodide.
+
+Run it from any directory after `pnpm -C ui install`, which installs the development dependency pyodide 314.0.7:
+
+    python3 spike/pyodide/prepare.py
+
+It copies the five runtime files from ui/node_modules/pyodide and writes partsmith.zip: every `.py` file of
+python/partsmith under `partsmith/`, with spike/pyodide/_core.py as `partsmith/_core.py`. The zip holds no `_core.pyi`,
+no `_core.abi3.so` and no `__pycache__`. Git ignores ui/public/pyodide, so the branch commits no file of Pyodide.
+"""
+
+import shutil
+import zipfile
+from pathlib import Path
+
+REPOSITORY_ROOT = Path(__file__).resolve().parents[2]
+"""The repository root (this script is two levels below it)."""
+
+PYODIDE_PACKAGE = REPOSITORY_ROOT / "ui" / "node_modules" / "pyodide"
+"""The npm package that `pnpm -C ui install` installs."""
+
+RUNTIME_FILES = ["pyodide.mjs", "pyodide.asm.mjs", "pyodide.asm.wasm", "python_stdlib.zip", "pyodide-lock.json"]
+"""The runtime files that `loadPyodide` fetches from its `indexURL`."""
+
+DESTINATION = REPOSITORY_ROOT / "ui" / "public" / "pyodide"
+"""The folder the web build serves as `/pyodide/`."""
+
+PACKAGE = REPOSITORY_ROOT / "python" / "partsmith"
+"""The pure-Python package, unchanged."""
+
+CORE = Path(__file__).with_name("_core.py")
+"""The pure-Python `partsmith._core` that takes the place of the extension module."""
+
+
+def main() -> None:
+    DESTINATION.mkdir(parents=True, exist_ok=True)
+    for name in RUNTIME_FILES:
+        shutil.copyfile(PYODIDE_PACKAGE / name, DESTINATION / name)
+    with zipfile.ZipFile(DESTINATION / "partsmith.zip", "w", compression=zipfile.ZIP_DEFLATED) as archive:
+        for source in sorted(PACKAGE.rglob("*.py")):
+            archive.write(source, f"partsmith/{source.relative_to(PACKAGE).as_posix()}")
+        archive.write(CORE, "partsmith/_core.py")
+    for path in sorted(DESTINATION.iterdir()):
+        print(f"{path.relative_to(REPOSITORY_ROOT)}: {path.stat().st_size} bytes")
+
+
+if __name__ == "__main__":
+    main()
