+// One name of one element of the loft (see LoftRoleData).
+struct Role {
+  TopoDS_Shape element;
+  LoftOriginType origin;
+  std::uint32_t owner;
+  ElementKind input_kind;
+  std::uint32_t input;
+  LoftSourceType source;
