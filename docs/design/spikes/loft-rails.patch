@@ -0,0 +1,341 @@
+//! The inputs and constructions of the loft-rails spike (kernel spec section 8.4), shared by its
+//! tests and the bench's rows.
+
+use std::f64::consts::{FRAC_PI_2, FRAC_PI_4, TAU};
+
+use partsmith_occt_sys::{
+    EndConditions, EndMethod, EndOrder, GuideRail, LoftConstruction, LoftCurve, LoftSection,
+    LoftSpec, Point, RailContact, Vector,
+};
+
+/// The axis the straight lofts run along.
+pub const UP: Vector = Vector::new(0.0, 0.0, 1.0);
+
+/// The offsets of an end condition's extra sections that the spike tries, in millimeters.
+pub const OFFSETS: [f64; 3] = [1.0, 0.1, 0.01];
+
+/// One input of section 8.4.
+#[derive(Debug, Clone)]
+pub struct Input {
+    /// The row's name.
+    pub name: &'static str,
+    /// The sections in order.
+    pub sections: Vec<LoftSection>,
+    /// The centerline from the first section to the last, the pipe shell's spine.
+    pub centerline: Vec<LoftCurve>,
+    /// The guide rail.
+    pub rail: Option<Vec<LoftCurve>>,
+    /// The loft's tangent at its first and last wire sections, where end conditions are asked
+    /// or measured.
+    pub start: Option<Vector>,
+    /// See `start`.
+    pub end: Option<Vector>,
+    /// The end condition asked, or none when the input only measures the plain loft.
+    pub order: Option<EndOrder>,
+    /// Whether the input is the three-section loft that section 8.4 times.
+    pub three_sections: bool,
+}
+
+/// One construction tried on one input.
+#[derive(Debug, Clone)]
+pub struct Run {
+    /// The input's name.
+    pub input: &'static str,
+    /// The construction's name.
+    pub construction: String,
+    /// The loft to build.
+    pub spec: LoftSpec,
+    /// Whether section 8.4's 100 ms applies to it natively.
+    pub timed: bool,
+}
+
+/// A closed polygon through `corners`, one line per side.
+fn polygon(corners: &[Point]) -> LoftSection {
+    LoftSection::Wire(
+        (0..corners.len())
+            .map(|corner| LoftCurve::Line {
+                start: corners[corner],
+                end: corners[(corner + 1) % corners.len()],
+            })
+            .collect(),
+    )
+}
+
+/// The corners of a regular polygon of `count` corners about the Z axis at height `z`, `radius`
+/// from the axis, the first at angle `angle`, counterclockwise.
+fn regular_corners(count: usize, radius: f64, z: f64, angle: f64) -> Vec<Point> {
+    (0..count)
+        .map(|corner| {
+            let at = angle + TAU * corner as f64 / count as f64;
+            Point::new(radius * at.cos(), radius * at.sin(), z)
+        })
+        .collect()
+}
+
+/// A square of side `side` centered on the Z axis at height `z`, turned by `turn` about it (0:
+/// sides along X and Y).
+fn square(side: f64, z: f64, turn: f64) -> LoftSection {
+    polygon(&regular_corners(
+        4,
+        side / 2.0_f64.sqrt(),
+        z,
+        turn + FRAC_PI_4,
+    ))
+}
+
+/// A circle of radius `radius` about `axis` through `center`, starting at `start`.
+fn circle(center: Point, axis: Vector, start: Point) -> LoftSection {
+    LoftSection::Wire(vec![LoftCurve::Arc {
+        center,
+        axis,
+        start,
+        sweep: TAU,
+    }])
+}
+
+/// The line along the Z axis from height 0 to `height`.
+fn z_line(height: f64) -> Vec<LoftCurve> {
+    vec![LoftCurve::Line {
+        start: Point::new(0.0, 0.0, 0.0),
+        end: Point::new(0.0, 0.0, height),
+    }]
+}
+
+/// The inputs of section 8.4, with the dimensions it leaves open (see the spike's record): the
+/// three sections, the square to a point, the two squares with a rail, the square and circle
+/// along an arc, and the square to a triangle; then the first, second and fifth with a tangent
+/// and with a curvature condition at each wire end.
+pub fn inputs() -> Vec<Input> {
+    let three = Input {
+        name: "three-sections",
+        sections: vec![
+            square(40.0, 0.0, 0.0),
+            circle(Point::new(0.0, 0.0, 30.0), UP, Point::new(15.0, 0.0, 30.0)),
+            square(20.0, 60.0, FRAC_PI_4),
+        ],
+        centerline: z_line(60.0),
+        rail: None,
+        start: Some(UP),
+        end: Some(UP),
+        order: None,
+        three_sections: true,
+    };
+    let point = Input {
+        name: "point-end",
+        sections: vec![
+            square(40.0, 0.0, 0.0),
+            LoftSection::Point(Point::new(0.0, 0.0, 40.0)),
+        ],
+        centerline: z_line(40.0),
+        rail: None,
+        start: Some(UP),
+        end: None,
+        order: None,
+        three_sections: false,
+    };
+    let rail = Input {
+        name: "guide-rail",
+        sections: vec![square(40.0, 0.0, 0.0), square(20.0, 40.0, 0.0)],
+        centerline: z_line(40.0),
+        rail: Some(vec![LoftCurve::Bspline {
+            degree: 3,
+            poles: vec![
+                Point::new(20.0, 20.0, 0.0),
+                Point::new(26.0, 26.0, 12.0),
+                Point::new(18.0, 18.0, 28.0),
+                Point::new(10.0, 10.0, 40.0),
+            ],
+            knots: vec![0.0, 1.0],
+            multiplicities: vec![4, 4],
+        }]),
+        start: None,
+        end: None,
+        order: None,
+        three_sections: false,
+    };
+    let arc = Input {
+        name: "arc-centerline",
+        sections: vec![
+            square(20.0, 0.0, 0.0),
+            circle(
+                Point::new(60.0, 0.0, 60.0),
+                Vector::new(1.0, 0.0, 0.0),
+                Point::new(60.0, 0.0, 70.0),
+            ),
+        ],
+        centerline: vec![LoftCurve::Arc {
+            center: Point::new(60.0, 0.0, 0.0),
+            axis: Vector::new(0.0, 1.0, 0.0),
+            start: Point::new(0.0, 0.0, 0.0),
+            sweep: FRAC_PI_2,
+        }],
+        rail: None,
+        start: None,
+        end: None,
+        order: None,
+        three_sections: false,
+    };
+    let four_to_three = Input {
+        name: "four-to-three",
+        sections: vec![
+            square(40.0, 0.0, 0.0),
+            polygon(&regular_corners(3, 20.0, 40.0, FRAC_PI_2)),
+        ],
+        centerline: z_line(40.0),
+        rail: None,
+        start: Some(UP),
+        end: Some(UP),
+        order: None,
+        three_sections: false,
+    };
+    let mut inputs = vec![
+        three.clone(),
+        point.clone(),
+        rail,
+        arc,
+        four_to_three.clone(),
+    ];
+    for (base, tangent, curvature) in [
+        (three, "three-sections tangent", "three-sections curvature"),
+        (point, "point-end tangent", "point-end curvature"),
+        (
+            four_to_three,
+            "four-to-three tangent",
+            "four-to-three curvature",
+        ),
+    ] {
+        for (name, order) in [
+            (tangent, EndOrder::Tangent),
+            (curvature, EndOrder::Curvature),
+        ] {
+            inputs.push(Input {
+                name,
+                order: Some(order),
+                three_sections: false,
+                ..base.clone()
+            });
+        }
+    }
+    inputs
+}
+
+/// A loft of `input` by `construction` with end conditions by `method`.
+fn spec(input: &Input, construction: LoftConstruction, method: EndMethod) -> LoftSpec {
+    let end_conditions = (input.start.is_some() || input.end.is_some()).then_some(EndConditions {
+        order: input.order.unwrap_or(EndOrder::Tangent),
+        method,
+        start: input.start,
+        end: input.end,
+    });
+    LoftSpec {
+        sections: input.sections.clone(),
+        construction,
+        end_conditions,
+    }
+}
+
+/// The pipe shell of `input` along its centerline, guided by its rail with `contact`.
+fn pipe_shell(input: &Input, contact: RailContact, curvilinear: bool) -> LoftConstruction {
+    LoftConstruction::PipeShell {
+        spine: input.centerline.clone(),
+        rail: input.rail.as_ref().map(|curves| GuideRail {
+            curves: curves.clone(),
+            contact,
+            curvilinear,
+        }),
+    }
+}
+
+/// The name of an offset in millimeters as a row shows it.
+fn offset_name(offset: f64) -> String {
+    format!("{offset}")
+}
+
+/// Every construction section 8.4 names on every input it applies to: `BRepOffsetAPI_ThruSections`
+/// ruled and smooth between profiles (not along a rail or a curved centerline, which it cannot
+/// follow), the pipe shell along the centerline, in each of the rail's six modes on the rail's
+/// input; and on the inputs with end conditions, the extra sections at each offset on the three
+/// lofts and the filling on the smooth loft, with the filling's plate order 2 besides for the
+/// curvature conditions.
+pub fn runs() -> Vec<Run> {
+    let mut runs = Vec::new();
+    for input in inputs() {
+        let mut add = |construction: String, spec: LoftSpec, timed: bool| {
+            runs.push(Run {
+                input: input.name,
+                construction,
+                spec,
+                timed,
+            });
+        };
+        let bases = [
+            ("ruled", LoftConstruction::Ruled),
+            ("smooth", LoftConstruction::Smooth),
+            ("pipe-shell", pipe_shell(&input, RailContact::Free, false)),
+        ];
+        match input.order {
+            None if input.rail.is_some() => {
+                for (contact, contact_name) in [
+                    (RailContact::Free, "free"),
+                    (RailContact::Contact, "contact"),
+                    (RailContact::ContactOnBorder, "border"),
+                ] {
+                    for curvilinear in [false, true] {
+                        let name = if curvilinear {
+                            format!("pipe-shell {contact_name} curvilinear")
+                        } else {
+                            format!("pipe-shell {contact_name}")
+                        };
+                        let construction = pipe_shell(&input, contact, curvilinear);
+                        add(name, spec(&input, construction, EndMethod::Measured), false);
+                    }
+                }
+            }
+            None if input.name == "arc-centerline" => {
+                let construction = pipe_shell(&input, RailContact::Free, false);
+                add(
+                    "pipe-shell".to_owned(),
+                    spec(&input, construction, EndMethod::Measured),
+                    false,
+                );
+            }
+            None => {
+                for (name, construction) in bases {
+                    add(
+                        name.to_owned(),
+                        spec(&input, construction, EndMethod::Measured),
+                        input.three_sections,
+                    );
+                }
+            }
+            Some(order) => {
+                for (name, construction) in bases {
+                    for offset in OFFSETS {
+                        add(
+                            format!("{name} extra {}", offset_name(offset)),
+                            spec(
+                                &input,
+                                construction.clone(),
+                                EndMethod::ExtraSection { offset },
+                            ),
+                            false,
+                        );
+                    }
+                }
+                add(
+                    "smooth filling".to_owned(),
+                    spec(&input, LoftConstruction::Smooth, EndMethod::Filling),
+                    false,
+                );
+                if order == EndOrder::Curvature {
+                    add(
+                        "smooth filling order 2".to_owned(),
+                        spec(&input, LoftConstruction::Smooth, EndMethod::FillingOrderTwo),
+                        false,
+                    );
+                }
+            }
+        }
+    }
+    runs
+}
diff --git a/crates/partsmith-occt-sys/tests/loft_rails.rs b/crates/partsmith-occt-sys/tests/loft_rails.rs
new file mode 100644
index 0000000..674a0f4
--- /dev/null
+++ b/crates/partsmith-occt-sys/tests/loft_rails.rs
@@ -0,0 +1,559 @@
+//! The loft-rails spike (kernel spec section 8.4): every construction on every input it applies
+//! to, measured as section 8.1 item 4 asks. Each test prints its measurements, with one canonical
+//! `parity` line per loft that the native and WebAssembly runs compare (ADR 0042), and pins the
+//! criteria of section 8.4's Pass but time and parity that the run fails, as the spike recorded
+//! them.
+
+use std::collections::BTreeMap;
+
+use partsmith_mesh::{TessellationTolerance, WELD_TOLERANCE};
+use partsmith_occt_sys::{
+    EndMethod, EndOrder, Interrupt, LoftConstruction, LoftCurve, LoftOrigin, LoftResult,
+    LoftSection, LoftSource, Point, Shape, SubShapeKind, Validity, Vector, face_distances, loft,
+    normal_curvature_across,
+};
+
+use crate::common::assert_closed;
+use crate::loft_inputs::{Input, Run, inputs, runs};
+
+/// The tolerance of tests 137 and 138: 0.05 mm and 5 degrees.
+const FINE: TessellationTolerance = TessellationTolerance {
+    chord_deviation: 0.05,
+    angular_deviation: 0.087_266_462_599_716_48,
+};
+
+/// The points sampled along each curve of a section and along the rail.
+const SAMPLES: usize = 20;
+
+/// How far a section or the rail may lie from the loft (section 8.4's Checks), in millimeters.
+const DISTANCE_TOLERANCE: f64 = 1e-6;
+
+/// How far the angle of an end condition may lie from the one asked for, in radians.
+const ANGLE_TOLERANCE: f64 = 1e-6;
+
+/// The angle an end condition asks between the loft's face and the neighbor's side face along
+/// an end edge: 0, the loft continuing the neighbor's side.
+const ASKED_ANGLE: f64 = 0.0;
+
+/// The canonical summary of a shape that the native and WebAssembly runs compare.
+fn parity_line(key: &str, shape: &Shape) -> String {
+    let volume = shape.volume().expect("the shape is measured");
+    let area = shape.area().expect("the shape is measured");
+    let Ok(bounds) = shape.bounding_box() else {
+        return format!("parity {key}: empty");
+    };
+    format!(
+        "parity {key}: faces={} edges={} vertices={} volume={volume:?} area={area:?} min={:?} max={:?}",
+        shape.count(SubShapeKind::Face),
+        shape.count(SubShapeKind::Edge),
+        shape.count(SubShapeKind::Vertex),
+        bounds.min,
+        bounds.max
+    )
+}
+
+/// The undirected edges of the welded mesh that are not used by exactly two triangles, or the
+/// tessellation's error (test 138's check).
+fn open_mesh_edges(shape: &Shape) -> Result<usize, String> {
+    let mesh = shape
+        .tessellate(&FINE, &Interrupt::new())
+        .map_err(|error| error.detail())?;
+    let welded = mesh
+        .weld(WELD_TOLERANCE)
+        .expect("WELD_TOLERANCE is a valid weld tolerance")
+        .mesh;
+    let triangles: Vec<[usize; 3]> = welded
+        .triangles()
+        .iter()
+        .map(|corners| corners.map(|vertex| vertex as usize))
+        .collect();
+    let mut uses: BTreeMap<(usize, usize), usize> = BTreeMap::new();
+    for [first, second, third] in &triangles {
+        for (start, end) in [(*first, *second), (*second, *third), (*third, *first)] {
+            *uses.entry((start.min(end), start.max(end))).or_insert(0) += 1;
+        }
+    }
+    let open = uses.values().filter(|count| **count != 2).count();
+    if open == 0 {
+        assert_closed(&triangles);
+    }
+    Ok(open)
+}
+
+/// The vector from `from` to `to`.
+fn between(from: Point, to: Point) -> Vector {
+    Vector::new(to.x - from.x, to.y - from.y, to.z - from.z)
+}
+
+/// `vector` turned by `angle` about the unit vector `axis` (Rodrigues' formula).
+fn turned(vector: Vector, axis: Vector, angle: f64) -> Vector {
+    let along = axis.scaled(axis.dot(vector) * (1.0 - angle.cos()));
+    let across = axis.cross(vector).scaled(angle.sin());
+    let kept = vector.scaled(angle.cos());
+    Vector::new(
+        kept.x + across.x + along.x,
+        kept.y + across.y + along.y,
+        kept.z + across.z + along.z,
+    )
+}
+
+/// The point of a single-span B-spline (a Bezier curve) at `parameter` from 0 to 1, by de
+/// Casteljau's algorithm.
+fn bezier_point(poles: &[Point], parameter: f64) -> Point {
+    let mut points = poles.to_vec();
+    for level in 1..points.len() {
+        for index in 0..points.len() - level {
+            let (first, second) = (points[index], points[index + 1]);
+            points[index] = first.offset(between(first, second).scaled(parameter));
+        }
+    }
+    points[0]
+}
+
+/// `SAMPLES` points of a curve from its start to its end, from its definition.
+fn curve_points(curve: &LoftCurve) -> Vec<Point> {
+    (0..SAMPLES)
+        .map(|sample| {
+            let parameter = sample as f64 / (SAMPLES - 1) as f64;
+            match curve {
+                LoftCurve::Line { start, end } => {
+                    start.offset(between(*start, *end).scaled(parameter))
+                }
+                LoftCurve::Arc {
+                    center,
+                    axis,
+                    start,
+                    sweep,
+                } => {
+                    let axis = axis.normalized().expect("the arc has an axis");
+                    center.offset(turned(between(*center, *start), axis, sweep * parameter))
+                }
+                LoftCurve::Bspline {
+                    poles,
+                    knots,
+                    multiplicities,
+                    degree,
+                } => {
+                    assert!(
+                        knots.len() == 2 && multiplicities.iter().all(|count| *count == degree + 1),
+                        "the spike's B-splines are single spans"
+                    );
+                    bezier_point(poles, parameter)
+                }
+            }
+        })
+        .collect()
+}
+
+/// The points sampled on a section: along each of its curves, or the point itself.
+fn section_points(section: &LoftSection) -> Vec<Point> {
+    match section {
+        LoftSection::Wire(curves) => curves.iter().flat_map(curve_points).collect(),
+        LoftSection::Point(point) => vec![*point],
+    }
+}
+
+/// The end faces of the loft, first and last, from its roles.
+fn end_faces(result: &LoftResult) -> (Option<u32>, Option<u32>) {
+    let face = |source: LoftSource| {
+        result
+            .roles
+            .iter()
+            .find(|role| role.source == source && role.element.kind == SubShapeKind::Face)
+            .map(|role| role.element.index)
+    };
+    (face(LoftSource::FirstShape), face(LoftSource::LastShape))
+}
+
+/// The largest distance from the points to the faces of `shape` but `skipped`, or NaN.
+fn largest_distance(shape: &Shape, skipped: &[u32], points: &[Point]) -> f64 {
+    let faces: Vec<u32> = (1..=shape.count(SubShapeKind::Face))
+        .filter(|face| !skipped.contains(face))
+        .collect();
+    face_distances(shape, &faces, points)
+        .map(|distances| distances.into_iter().fold(0.0, f64::max))
+        .unwrap_or(f64::NAN)
+}
+
+/// The angle between two unit normals.
+fn angle_between(first: Vector, second: Vector) -> f64 {
+    first.cross(second).length().atan2(first.dot(second))
+}
+
+/// What an end condition's check measured at one end: the largest angle between the loft's
+/// face and the neighbor's side face over the end edges (at each edge's middle, from
+/// `Shape::edge_normals`), the largest normal curvature of the loft's face across them, and how
+/// many end edges found no neighbor edge.
+#[derive(Debug, Clone, Copy, Default)]
+struct EndMeasure {
+    angle: f64,
+    curvature: f64,
+    edges: usize,
+    unmatched: usize,
+}
+
+/// Measures the loft against its neighbor at the end closed by face `end_face`, whose tangent
+/// is `direction`.
+fn measure_end(result: &LoftResult, end_face: u32, direction: Vector) -> EndMeasure {
+    let topology = result.shape.topology().expect("the loft has a topology");
+    let neighbor_edges: Vec<_> = (1..=result.neighbors.count(SubShapeKind::Edge))
+        .filter_map(|edge| result.neighbors.edge_normals(edge).ok())
+        .collect();
+    let mut measure = EndMeasure::default();
+    for &edge in &topology.faces[end_face as usize - 1].edges {
+        let normals = result
+            .shape
+            .edge_normals(edge)
+            .expect("the end edge has normals");
+        let Some(loft_face) = normals.faces.iter().find(|face| face.face != end_face) else {
+            measure.unmatched += 1;
+            continue;
+        };
+        measure.edges += 1;
+        let side = neighbor_edges
+            .iter()
+            .filter(|other| other.point.distance(normals.point) <= DISTANCE_TOLERANCE)
+            .flat_map(|other| other.faces.iter())
+            .find(|face| face.normal.dot(direction).abs() < 0.5);
+        let Some(side) = side else {
+            measure.unmatched += 1;
+            continue;
+        };
+        measure.angle = measure
+            .angle
+            .max((angle_between(loft_face.normal, side.normal) - ASKED_ANGLE).abs());
+        let curvature = normal_curvature_across(&result.shape, loft_face.face, edge)
+            .expect("the curvature is measured");
+        measure.curvature = measure.curvature.max(curvature.abs());
+    }
+    measure
+}
+
+/// The largest angle between the two faces of an edge whose middle lies at one of `offsets`
+/// from the plane through `origin` normal to `direction`: the creases the extra sections leave.
+fn crease(shape: &Shape, origin: Point, direction: Vector, offsets: &[f64]) -> f64 {
+    let mut largest: f64 = 0.0;
+    for edge in 1..=shape.count(SubShapeKind::Edge) {
+        let Ok(normals) = shape.edge_normals(edge) else {
+            continue;
+        };
+        let height = between(origin, normals.point).dot(direction);
+        if normals.faces.len() == 2
+            && offsets
+                .iter()
+                .any(|offset| (height - offset).abs() <= DISTANCE_TOLERANCE)
+        {
+            largest = largest.max(angle_between(
+                normals.faces[0].normal,
+                normals.faces[1].normal,
+            ));
+        }
+    }
+    largest
+}
+
+/// The first point of a wire section.
+fn section_origin(section: &LoftSection) -> Point {
+    match section {
+        LoftSection::Wire(curves) => match &curves[0] {
+            LoftCurve::Line { start, .. } | LoftCurve::Arc { start, .. } => *start,
+            LoftCurve::Bspline { poles, .. } => poles[0],
+        },
+        LoftSection::Point(point) => *point,
+    }
+}
+
+/// One name of a result element: what its input element belongs to, the section's number (0 for
+/// the spine and the rail), the input element's kind (none for an end face as a whole), the
+/// builder call, and whether a filling replaced it.
+type Name = (LoftOrigin, u32, Option<SubShapeKind>, LoftSource, bool);
+
+/// The names of a result element, deduplicated and sorted.
+type Names = Vec<Name>;
+
+/// For each kind, how many loft elements have each set of names (none for an unnamed element).
+fn history_counts(result: &LoftResult) -> BTreeMap<(SubShapeKind, Names), usize> {
+    let mut names: BTreeMap<(SubShapeKind, u32), Names> = BTreeMap::new();
+    for role in &result.roles {
+        names
+            .entry((role.element.kind, role.element.index))
+            .or_default()
+            .push((
+                role.origin,
+                role.owner,
+                role.input.map(|(kind, _)| kind),
+                role.source,
+                role.filled,
+            ));
+    }
+    let mut counts = BTreeMap::new();
+    for kind in [SubShapeKind::Face, SubShapeKind::Edge, SubShapeKind::Vertex] {
+        for index in 1..=result.shape.count(kind) {
+            let mut element = names.get(&(kind, index)).cloned().unwrap_or_default();
+            element.sort();
+            element.dedup();
+            *counts.entry((kind, element)).or_insert(0) += 1;
+        }
+    }
+    counts
+}
+
+/// True when `value` is at most `limit`; false for NaN.
+fn within(value: f64, limit: f64) -> bool {
+    value <= limit
+}
+
+/// The end condition of a run: its order, and its method when it enforces one.
+fn enforced(run: &Run) -> Option<(EndOrder, EndMethod)> {
+    let conditions = run.spec.end_conditions?;
+    (conditions.method != EndMethod::Measured).then_some((conditions.order, conditions.method))
+}
+
+/// Runs one construction on one input, prints its measurements and returns the criteria of
+/// section 8.4's Pass but time and parity that it fails (or the failure of the call).
+fn measure(input: &Input, run: &Run) -> Vec<String> {
+    let key = format!("{} {}", run.input, run.construction);
+    println!(
+        "{key}: {} sections; the three-section loft that section 8.4 times: {}",
+        run.spec.sections.len(),
+        run.timed
+    );
+    let result = match loft(&run.spec, &Interrupt::new()) {
+        Ok(result) => result,
+        Err(error) => {
+            println!("{key}: failed: {}", error.detail());
+            println!("parity {key}: failed: {}", error.detail());
+            return vec![format!("failed: {}", error.detail())];
+        }
+    };
+    let mut failures = Vec::new();
+    let valid = result.shape.is_valid().expect("the check runs");
+    let solids = result.shape.count(SubShapeKind::Solid);
+    println!(
+        "{key}: {:?} (is_valid {valid}), {solids} solids; open mesh edges {:?}; surface error {:.3e}, tangency error {:.3e}, curvature error {:.3e}",
+        result.validity,
+        open_mesh_edges(&result.shape),
+        result.surface_error,
+        result.tangency_error,
+        result.curvature_error
+    );
+    if result.validity != Validity::AsBuilt || !valid {
+        failures.push("the loft is not valid as built".to_owned());
+    }
+    if solids != 1 {
+        failures.push("the loft is not one solid".to_owned());
+    }
+
+    let (first, last) = end_faces(&result);
+    let mut section_distance: f64 = 0.0;
+    for (place, section) in run.spec.sections.iter().enumerate() {
+        let distance = largest_distance(&result.shape, &[], &section_points(section));
+        println!(
+            "{key}: section {} lies {distance:.3e} mm off the loft",
+            place + 1
+        );
+        section_distance = if distance.is_nan() {
+            f64::NAN
+        } else {
+            section_distance.max(distance)
+        };
+    }
+    if !within(section_distance, DISTANCE_TOLERANCE) {
+        failures.push("a section is off the loft".to_owned());
+    }
+    if let Some(rail) = &input.rail {
+        let ends: Vec<u32> = first.into_iter().chain(last).collect();
+        let points: Vec<Point> = rail.iter().flat_map(curve_points).collect();
+        let distance = largest_distance(&result.shape, &ends, &points);
+        println!("{key}: the rail lies {distance:.3e} mm off the lateral faces");
+        if !within(distance, DISTANCE_TOLERANCE) {
+            failures.push("the rail is off its lateral faces".to_owned());
+        }
+    }
+
+    let ends = [
+        (input.start, first, run.spec.sections.first()),
+        (input.end, last, run.spec.sections.last()),
+    ];
+    let mut angle: f64 = 0.0;
+    for (place, (direction, face, section)) in ends.into_iter().enumerate() {
+        let (Some(direction), Some(section)) = (direction, section) else {
+            continue;
+        };
+        let end = if place == 0 { "start" } else { "end" };
+        let Some(face) = face else {
+            println!("{key}: {end}: no end face");
+            angle = f64::NAN;
+            continue;
+        };
+        let measured = measure_end(&result, face, direction);
+        println!(
+            "{key}: {end}: angle to the neighbor {:.3e} rad over {} end edges ({} unmatched), curvature across {:.3e} per mm",
+            measured.angle, measured.edges, measured.unmatched, measured.curvature
+        );
+        if measured.unmatched > 0 || measured.edges == 0 {
+            angle = f64::NAN;
+        } else if !angle.is_nan() {
+            angle = angle.max(measured.angle);
+        }
+        if let Some((_, EndMethod::ExtraSection { offset })) = enforced(run) {
+            let toward = if place == 0 {
+                direction
+            } else {
+                direction.scaled(-1.0)
+            };
+            let creases = crease(
+                &result.shape,
+                section_origin(section),
+                toward,
+                &[offset, 2.0 * offset],
+            );
+            println!("{key}: {end}: crease at the extra sections {creases:.3e} rad");
+        }
+    }
+    if enforced(run).is_some() && !within(angle, ANGLE_TOLERANCE) {
+        failures.push("an end condition's angle is off".to_owned());
+    }
+
+    println!(
+        "{key}: polls {} first {:.3?} longest {:.3?} after poll {} last {:.3?} total {:.3?} (debug build)",
+        result.polls.count,
+        result.polls.first,
+        result.polls.longest,
+        result.polls.longest_after,
+        result.polls.last,
+        result.polls.total
+    );
+    for ((kind, names), count) in history_counts(&result) {
+        println!("{key}: history {kind:?} x{count} named by {names:?}");
+    }
+    println!("{}", parity_line(&key, &result.shape));
+    failures
+}
+
+/// Runs one construction on one input and checks the failures the spike recorded for it.
+fn check(input_name: &str, construction: &str, expected: &[&str]) {
+    let input = inputs()
+        .into_iter()
+        .find(|input| input.name == input_name)
+        .expect("the input exists");
+    let run = runs()
+        .into_iter()
+        .find(|run| run.input == input_name && run.construction == construction)
+        .expect("the construction runs on the input");
+    let failures = measure(&input, &run);
+    println!("{input_name} {construction}: fails {failures:?}");
+    let failures: Vec<&str> = failures
+        .iter()
+        .map(|failure| {
+            if failure.starts_with("failed: ") {
+                "failed"
+            } else {
+                failure.as_str()
+            }
+        })
+        .collect();
+    assert_eq!(failures, expected, "{input_name} {construction}");
+}
