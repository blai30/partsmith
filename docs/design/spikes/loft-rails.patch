+/// The median of a value over a row's runs, and its largest value.
+fn median_and_most(values: impl IntoIterator<Item = Duration>) -> (Duration, Duration) {
+    let mut values: Vec<Duration> = values.into_iter().collect();
+    values.sort();
+    (values[values.len() / 2], values[values.len() - 1])
