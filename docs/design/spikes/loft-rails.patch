+#[test]
+fn every_run_has_a_test() {
+    assert_eq!(runs().len(), 79);
+    assert!(runs().iter().all(|run| !matches!(
+        run.spec.construction,
+        LoftConstruction::PipeShell { .. }
+    ) || run.construction.starts_with("pipe-shell")));
+}
+
+macro_rules! spike_tests {
+    ($($test:ident: $input:literal, $construction:literal, [$($failure:literal),*];)*) => {
+        $(
+            #[test]
+            fn $test() {
+                check($input, $construction, &[$($failure),*]);
+            }
+        )*
+    };
+}
