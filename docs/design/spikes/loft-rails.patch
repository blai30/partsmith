+using Clock = std::chrono::steady_clock;
+
+// The milliseconds of a duration.
+double milliseconds(Clock::duration duration) {
+  return std::chrono::duration<double, std::milli>(duration).count();
+}
+
+// The spike's indicator: answers as the shim's indicator does, and records the time of each
+// poll, so the spike can report the polls of a call and the longest gap between them.
+class PollRecorder : public Interruption {
+ public:
+  explicit PollRecorder(const Interrupt &interrupt)
+      : Interruption(interrupt), start_(Clock::now()), last_(start_) {}
+
+  Standard_Boolean UserBreak() override {
+    const Clock::time_point now = Clock::now();
+    if (count_ == 0) {
+      first_ = now - start_;
+    } else if (now - last_ > longest_) {
+      longest_ = now - last_;
+      longest_after_ = count_;
+    }
+    last_ = now;
+    ++count_;
+    return Interruption::UserBreak();
+  }
+
+  // The polls so far, with the time from the last one to now as the end of the call.
+  PollData data() const {
+    const Clock::time_point now = Clock::now();
+    return PollData{count_,         milliseconds(first_),      milliseconds(longest_),
+                    longest_after_, milliseconds(now - last_), milliseconds(now - start_)};
+  }
+
+ private:
+  Clock::time_point start_;
+  Clock::time_point last_;
+  Clock::duration first_{};
+  Clock::duration longest_{};
+  std::uint64_t longest_after_ = 0;
+  std::uint64_t count_ = 0;
+};
+
+// How far a neighbor prism reaches from the end it continues, in millimeters.
+constexpr double kNeighborLength = 10.0;
+
+// The angular tolerance of the pipe shell's approximation and of the filling's tangency.
+constexpr double kAngularTolerance = 1e-6;
+
+// The largest cosine between an arc's axis and the vector from its center to its start.
+constexpr double kPerpendicularTolerance = 1e-9;
+
+// A curve of the loft's input with the parameter range it runs over.
+struct InputCurve {
+  Handle(Geom_Curve) curve;
+  double first;
+  double last;
+
+  gp_Pnt start() const { return curve->Value(first); }
+  gp_Pnt end() const { return curve->Value(last); }
+};
+
+// The curve a loft curve describes, from its start to its end. Raises Partsmith_InvalidInput for
+// a line whose ends coincide, an arc whose start lies on its center or off its plane, or a
+// B-spline OCCT refuses.
+InputCurve input_curve(const LoftCurveData &data) {
+  switch (data.kind) {
+    case LoftCurveType::Line: {
+      const gp_Pnt start = to_point(data.start);
+      const gp_Pnt end = to_point(data.end);
+      const double length = start.Distance(end);
+      if (length < kLinear) {
+        raise_invalid_input("A loft line needs two distinct ends.");
+      }
+      return {new Geom_Line(start, gp_Dir(gp_Vec(start, end))), 0.0, length};
+    }
+    case LoftCurveType::Arc: {
+      const gp_Pnt center = to_point(data.center);
+      const gp_Vec radial(center, to_point(data.start));
+      const gp_Dir axis = to_direction(data.axis);
+      if (radial.Magnitude() < kLinear ||
+          std::abs(gp_Dir(radial).Dot(axis)) > kPerpendicularTolerance) {
+        raise_invalid_input("A loft arc needs a start off its center, in the plane of its axis.");
+      }
+      return {new Geom_Circle(gp_Ax2(center, axis, gp_Dir(radial)), radial.Magnitude()), 0.0,
+              data.sweep};
+    }
+    case LoftCurveType::Bspline: {
+      TColgp_Array1OfPnt poles(1, static_cast<int>(data.poles.size()));
+      for (std::size_t pole = 0; pole < data.poles.size(); ++pole) {
+        poles.SetValue(static_cast<int>(pole) + 1, to_point(data.poles[pole]));
+      }
+      TColStd_Array1OfReal knots(1, static_cast<int>(data.knots.size()));
+      TColStd_Array1OfInteger multiplicities(1, static_cast<int>(data.knots.size()));
+      for (std::size_t knot = 0; knot < data.knots.size(); ++knot) {
+        knots.SetValue(static_cast<int>(knot) + 1, data.knots[knot]);
+        multiplicities.SetValue(static_cast<int>(knot) + 1,
+                                static_cast<int>(data.multiplicities[knot]));
+      }
+      const Handle(Geom_BSplineCurve) curve =
+          new Geom_BSplineCurve(poles, knots, multiplicities, static_cast<int>(data.degree));
+      return {Handle(Geom_Curve)(curve), curve->FirstParameter(), curve->LastParameter()};
+    }
+  }
+  raise_invalid_input("The loft curve has an unknown kind.");
+}
+
+// A wire of the input with its edges in curve order and its vertices at each curve's start (and
+// at the last curve's end when it is open), or a point section's vertex.
+struct Path {
+  TopoDS_Shape shape;
+  std::vector<TopoDS_Shape> edges;
+  std::vector<TopoDS_Shape> vertices;
+};
+
+// The wire of `count` curves from `first`, consecutive curves sharing the vertex where they meet,
+// closed when the last curve ends where the first starts. Raises Partsmith_InvalidInput when
+// consecutive curves do not meet within the modeling tolerance.
+Path wire_of(rust::Slice<const LoftCurveData> curves, std::size_t first, std::size_t count) {
+  std::vector<InputCurve> parts;
+  for (std::size_t position = 0; position < count; ++position) {
+    parts.push_back(input_curve(curves[first + position]));
+  }
+  for (std::size_t position = 0; position + 1 < count; ++position) {
+    if (parts[position].end().Distance(parts[position + 1].start()) > kLinear) {
+      raise_invalid_input("The curves of a loft section, spine or rail must meet end to end.");
+    }
+  }
+  const bool closed = parts.back().end().Distance(parts.front().start()) <= kLinear;
+  Path path;
+  for (const InputCurve &part : parts) {
+    path.vertices.push_back(BRepBuilderAPI_MakeVertex(part.start()).Vertex());
+  }
+  if (!closed) {
+    path.vertices.push_back(BRepBuilderAPI_MakeVertex(parts.back().end()).Vertex());
+  }
+  BRep_Builder builder;
+  TopoDS_Wire wire;
+  builder.MakeWire(wire);
+  for (std::size_t position = 0; position < count; ++position) {
+    const TopoDS_Shape &next = path.vertices[closed ? (position + 1) % count : position + 1];
+    BRepBuilderAPI_MakeEdge edge(parts[position].curve, TopoDS::Vertex(path.vertices[position]),
+                                 TopoDS::Vertex(next), parts[position].first,
+                                 parts[position].last);
+    if (!edge.IsDone()) {
+      raise_not_done("BRepBuilderAPI_MakeEdge failed with status " +
+                     std::to_string(static_cast<int>(edge.Error())));
+    }
+    builder.Add(wire, edge.Edge());
+    path.edges.push_back(edge.Edge());
+  }
+  wire.Closed(closed);
+  path.shape = wire;
+  return path;
+}
+
+// A section of the loft as its builder gets it, with what it is.
+struct Section {
+  Path path;
+  LoftOriginType origin;
+  std::uint32_t owner;
+};
+
+// The given sections in order: a closed wire of their curves, or a vertex. Advances `next` past
+// their curves. Raises Partsmith_InvalidInput for a section that is not closed.
+std::vector<Section> given_sections(rust::Slice<const LoftSectionData> sections,
+                                    rust::Slice<const LoftCurveData> curves, std::size_t &next) {
+  std::vector<Section> given;
+  for (const LoftSectionData &section : sections) {
+    const auto owner = static_cast<std::uint32_t>(given.size() + 1);
+    if (section.count == 0) {
+      const TopoDS_Vertex vertex = BRepBuilderAPI_MakeVertex(to_point(section.point)).Vertex();
+      given.push_back({Path{vertex, {}, {vertex}}, LoftOriginType::Section, owner});
+      continue;
+    }
+    Path path = wire_of(curves, next, section.count);
+    next += section.count;
+    if (!path.shape.Closed()) {
+      raise_invalid_input("A loft section must be a closed loop of curves.");
+    }
+    given.push_back({std::move(path), LoftOriginType::Section, owner});
+  }
+  return given;
+}
+
+// A copy of `section` moved by `offset`, an extra section of the end it copies.
+Section moved(const Section &section, const gp_Vec &offset) {
+  gp_Trsf shift;
+  shift.SetTranslation(offset);
+  BRepBuilderAPI_Transform transform(section.path.shape, shift, Standard_True);
+  Path path{transform.Shape(), {}, {}};
+  for (const TopoDS_Shape &edge : section.path.edges) {
+    path.edges.push_back(transform.ModifiedShape(edge));
+  }
+  for (const TopoDS_Shape &vertex : section.path.vertices) {
+    path.vertices.push_back(transform.ModifiedShape(vertex));
+  }
+  return {std::move(path), LoftOriginType::ExtraSection, section.owner};
+}
+
+// The sections with the extra sections of each end condition: one copy of the end section
+// offset by `spec.offset` along the end's tangent into the loft for a tangent condition, two
+// (at the offset and twice it) for a curvature condition.
+std::vector<Section> with_extra_sections(const std::vector<Section> &given,
+                                         const LoftSpecData &spec, Polls &polls) {
+  const int copies = spec.curvature ? 2 : 1;
+  std::vector<Section> sections{given.front()};
+  if (spec.start_condition) {
+    const gp_Vec direction(to_direction(spec.start_direction));
+    for (int copy = 1; copy <= copies; ++copy) {
+      polls.before("BRepBuilderAPI_Transform");
+      sections.push_back(moved(given.front(), direction * (copy * spec.offset)));
+    }
+  }
+  sections.insert(sections.end(), given.begin() + 1, given.end() - 1);
+  if (spec.end_condition) {
+    const gp_Vec direction(to_direction(spec.end_direction));
+    for (int copy = copies; copy >= 1; --copy) {
+      polls.before("BRepBuilderAPI_Transform");
+      sections.push_back(moved(given.back(), direction * (-copy * spec.offset)));
+    }
+  }
+  sections.push_back(given.back());
+  return sections;
+}
