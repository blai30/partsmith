+
+// Names the elements of `result` that are the elements of `path` themselves or that `generated`
+// lists for them.
+template <class Generated>
+void add_roles(const TopTools_IndexedMapOfShape &elements, const Path &path, LoftOriginType origin,
+               std::uint32_t owner, Generated &&generated, std::vector<Role> &roles) {
+  auto name = [&](const TopoDS_Shape &input, ElementKind kind, std::size_t position) {
+    const auto number = static_cast<std::uint32_t>(position + 1);
+    if (elements.Contains(input)) {
+      roles.push_back({input, origin, owner, kind, number, LoftSourceType::Itself, false});
+    }
+    for (const TopoDS_Shape &image : generated(input)) {
+      if (elements.Contains(image)) {
+        roles.push_back({image, origin, owner, kind, number, LoftSourceType::Generated, false});
+      }
+    }
+  };
+  for (std::size_t position = 0; position < path.edges.size(); ++position) {
+    name(path.edges[position], ElementKind::Edge, position);
+  }
+  for (std::size_t position = 0; position < path.vertices.size(); ++position) {
+    name(path.vertices[position], ElementKind::Vertex, position);
+  }
+}
+
+// The kind of a face, edge or vertex; nothing for other types.
+std::optional<ElementKind> element_kind(TopAbs_ShapeEnum type) {
+  switch (type) {
+    case TopAbs_FACE:
+      return ElementKind::Face;
+    case TopAbs_EDGE:
+      return ElementKind::Edge;
+    case TopAbs_VERTEX:
+      return ElementKind::Vertex;
+    default:
+      return std::nullopt;
+  }
+}
+
+// The face of `result` that closes the end `end` (a face, or the wire a pipe shell gives): `end`
+// itself when it is a face of the result, else the face whose edges are all edges of `end`; a
+// null shape for a punctual end. Names it, its edges and its vertices by `source`.
+TopoDS_Shape end_face(const TopoDS_Shape &result, const TopoDS_Shape &end, std::uint32_t owner,
+                      LoftSourceType source, std::vector<Role> &roles) {
+  if (end.IsNull()) {
+    return TopoDS_Shape();
+  }
+  TopTools_IndexedMapOfShape end_edges;
+  TopExp::MapShapes(end, TopAbs_EDGE, end_edges);
+  TopoDS_Shape face;
+  for (TopExp_Explorer explorer(result, TopAbs_FACE); explorer.More() && face.IsNull();
+       explorer.Next()) {
+    bool bounded = true;
+    bool any = false;
+    for (TopExp_Explorer edges(explorer.Current(), TopAbs_EDGE); edges.More(); edges.Next()) {
+      any = true;
+      bounded = bounded && end_edges.Contains(edges.Current());
+    }
+    if (any && bounded) {
+      face = explorer.Current();
+    }
+  }
+  if (face.IsNull()) {
+    return face;
+  }
+  TopTools_IndexedMapOfShape elements;
+  TopExp::MapShapes(face, elements);
+  for (int index = 1; index <= elements.Extent(); ++index) {
+    const TopoDS_Shape &element = elements(index);
+    if (const std::optional<ElementKind> kind = element_kind(element.ShapeType())) {
+      roles.push_back({element, LoftOriginType::Section, owner, *kind, 0, source, false});
+    }
+  }
+  return face;
+}
+
+// The loft's shape with its end faces and the error its builder reports on its surfaces.
+struct Built {
+  TopoDS_Shape shape;
+  TopoDS_Shape first;
+  TopoDS_Shape last;
+  double surface_error;
+};
+
+// BRepOffsetAPI_ThruSections through `sections` as a solid, ruled or smooth, with the wires'
+// compatibility checked (CheckCompatibility), and the roles its history gives.
+Built thru_sections(const std::vector<Section> &sections, bool ruled, std::vector<Role> &roles,
+                    Polls &polls) {
+  BRepOffsetAPI_ThruSections maker(Standard_True, ruled ? Standard_True : Standard_False, kLinear);
+  maker.CheckCompatibility(Standard_True);
+  for (const Section &section : sections) {
+    if (section.path.shape.ShapeType() == TopAbs_VERTEX) {
+      maker.AddVertex(TopoDS::Vertex(section.path.shape));
+    } else {
+      maker.AddWire(TopoDS::Wire(section.path.shape));
+    }
+  }
+  polls.run("BRepOffsetAPI_ThruSections",
+            [&](const Message_ProgressRange &range) { maker.Build(range); });
+  if (!maker.IsDone()) {
+    raise_not_done("BRepOffsetAPI_ThruSections failed with status " +
+                   std::to_string(static_cast<int>(maker.GetStatus())));
+  }
+  const TopoDS_Shape shape = maker.Shape();
+  polls.before("BRepOffsetAPI_ThruSections::Generated");
+  TopTools_IndexedMapOfShape elements;
+  TopExp::MapShapes(shape, elements);
+  for (const Section &section : sections) {
+    add_roles(
+        elements, section.path, section.origin, section.owner,
+        [&](const TopoDS_Shape &input) { return TopTools_ListOfShape(maker.Generated(input)); },
+        roles);
+  }
+  const TopoDS_Shape first =
+      end_face(shape, maker.FirstShape(), 1, LoftSourceType::FirstShape, roles);
+  const TopoDS_Shape last = end_face(shape, maker.LastShape(), sections.back().owner,
+                                     LoftSourceType::LastShape, roles);
+  return {shape, first, last, 0.0};
+}
+
+// The guide rail's mode of BRepOffsetAPI_MakePipeShell::SetMode.
+BRepFill_TypeOfContact contact_of(RailContactType contact) {
+  switch (contact) {
+    case RailContactType::Contact:
+      return BRepFill_Contact;
+    case RailContactType::ContactOnBorder:
+      return BRepFill_ContactOnBorder;
+    default:
+      return BRepFill_NoContact;
+  }
+}
+
+// BRepOffsetAPI_MakePipeShell along `spine` with each section added at the point of the spine the
+// builder finds for it, guided by `rail` in the spec's mode when there is one, approximated
+// within the modeling tolerance and made a solid, and the roles its history gives.
+Built pipe_shell(const std::vector<Section> &sections, const Path &spine,
+                 const std::optional<Path> &rail, const LoftSpecData &spec,
+                 std::vector<Role> &roles, Polls &polls) {
+  BRepOffsetAPI_MakePipeShell maker(TopoDS::Wire(spine.shape));
+  if (rail) {
+    maker.SetMode(TopoDS::Wire(rail->shape), spec.curvilinear ? Standard_True : Standard_False,
+                  contact_of(spec.contact));
+  }
+  maker.SetTolerance(kLinear, kLinear, kAngularTolerance);
+  for (const Section &section : sections) {
+    maker.Add(section.path.shape);
+  }
+  polls.run("BRepOffsetAPI_MakePipeShell",
+            [&](const Message_ProgressRange &range) { maker.Build(range); });
+  if (!maker.IsDone()) {
+    raise_not_done("BRepOffsetAPI_MakePipeShell failed with status " +
+                   std::to_string(static_cast<int>(maker.GetStatus())));
+  }
+  polls.before("BRepOffsetAPI_MakePipeShell::MakeSolid");
+  if (!maker.MakeSolid()) {
+    raise_not_done("BRepOffsetAPI_MakePipeShell::MakeSolid could not close the shell");
+  }
+  const TopoDS_Shape shape = maker.Shape();
+  polls.before("BRepOffsetAPI_MakePipeShell::Generated");
+  TopTools_IndexedMapOfShape elements;
+  TopExp::MapShapes(shape, elements);
+  auto generated = [&](const TopoDS_Shape &input) {
+    return TopTools_ListOfShape(maker.Generated(input));
+  };
+  for (const Section &section : sections) {
+    add_roles(elements, section.path, section.origin, section.owner, generated, roles);
+  }
+  add_roles(elements, spine, LoftOriginType::Spine, 0, generated, roles);
+  if (rail) {
+    add_roles(elements, *rail, LoftOriginType::Rail, 0, generated, roles);
+  }
+  const TopoDS_Shape first =
+      end_face(shape, maker.FirstShape(), 1, LoftSourceType::FirstShape, roles);
+  const TopoDS_Shape last = end_face(shape, maker.LastShape(), sections.back().owner,
+                                     LoftSourceType::LastShape, roles);
+  return {shape, first, last, maker.ErrorOnSurface()};
+}
+
+// The prism the loft continues at an end: its end face swept `kNeighborLength` along `outward`,
+// built on a copy. Records the side face of the prism along each edge of the end face in
+// `supports`.
+TopoDS_Shape neighbor(const TopoDS_Shape &end, const gp_Dir &outward,
+                      TopTools_DataMapOfShapeShape &supports, Polls &polls) {
+  polls.before("BRepPrimAPI_MakePrism");
+  BRepPrimAPI_MakePrism prism(end, gp_Vec(outward) * kNeighborLength, Standard_True,
+                              Standard_True);
+  if (!prism.IsDone()) {
+    raise_not_done("BRepPrimAPI_MakePrism could not sweep the loft's end face");
+  }
+  for (TopExp_Explorer explorer(end, TopAbs_EDGE); explorer.More(); explorer.Next()) {
+    for (const TopoDS_Shape &side : prism.Generated(explorer.Current())) {
+      if (side.ShapeType() == TopAbs_FACE) {
+        supports.Bind(explorer.Current(), side);
+      }
+    }
+  }
+  return prism.Shape();
+}
+
+// Gives `edge` a curve on `face` when it has none, projected from its 3D curve:
+// BRepOffsetAPI_MakeFilling reads the curve of each constrained edge on its support face, which
+// OCCT computes on the fly only on planes, and dereferences a missing one. Writes to the edge, an
+// edge of the loft this call built.
+void ensure_curve_on_face(const TopoDS_Edge &edge, const TopoDS_Face &face) {
+  double first = 0.0;
+  double last = 0.0;
+  if (!BRep_Tool::CurveOnSurface(edge, face, first, last).IsNull()) {
+    return;
+  }
+  const Handle(Geom_Curve) curve = BRep_Tool::Curve(edge, first, last);
+  double tolerance = kLinear;
+  const Handle(Geom2d_Curve) projected =
+      GeomProjLib::Curve2d(curve, first, last, BRep_Tool::Surface(face), tolerance);
+  if (projected.IsNull()) {
+    raise_not_done("GeomProjLib could not project an end edge onto its neighbor face");
+  }
+  BRep_Builder().UpdateEdge(edge, projected, face,
+                            std::max(tolerance, BRep_Tool::Tolerance(edge)));
+}
+
+// The largest errors the fillings report: distance, angle and curvature.
+struct FillingErrors {
+  double distance = 0.0;
+  double angle = 0.0;
+  double curvature = 0.0;
+};
+
+// Replaces each face of `built` but its end faces with an edge in `supports` by a
+// BRepOffsetAPI_MakeFilling face bounded by the same edges: each such edge constrained to its
+// neighbor's side face at `order`, every other edge at C0. Sews the faces, kept and filled, into
+// a shell within the largest distance error of the fillings and makes it a solid. The roles of
+// the replaced faces move to their fillings, and every role follows the fillings' and the
+// sewing's histories.
+TopoDS_Shape filled(const Built &built, const TopTools_DataMapOfShapeShape &supports,
+                    GeomAbs_Shape order, std::vector<Role> &roles, FillingErrors &errors,
+                    Polls &polls) {
+  TopTools_IndexedMapOfShape faces;
+  TopExp::MapShapes(built.shape, TopAbs_FACE, faces);
+  TopTools_DataMapOfShapeShape images;
+  std::vector<TopoDS_Shape> kept;
+  for (int index = 1; index <= faces.Extent(); ++index) {
+    const TopoDS_Shape &face = faces(index);
+    TopTools_IndexedMapOfShape edges;
+    TopExp::MapShapes(face, TopAbs_EDGE, edges);
+    const bool closes_an_end = face.IsSame(built.first) || face.IsSame(built.last);
+    const bool constrained =
+        std::any_of(edges.cbegin(), edges.cend(),
+                    [&](const TopoDS_Shape &edge) { return supports.IsBound(edge); });
+    if (closes_an_end || !constrained) {
+      kept.push_back(face);
+      continue;
+    }
+    BRepOffsetAPI_MakeFilling filling(3, 15, 2, Standard_False, 1e-5, kLinear, kAngularTolerance);
+    for (int position = 1; position <= edges.Extent(); ++position) {
+      const TopoDS_Shape &edge = edges(position);
+      if (BRep_Tool::Degenerated(TopoDS::Edge(edge))) {
+        continue;
+      }
+      if (supports.IsBound(edge)) {
+        const TopoDS_Face &support = TopoDS::Face(supports.Find(edge));
+        polls.before("GeomProjLib::Curve2d");
+        ensure_curve_on_face(TopoDS::Edge(edge), support);
+        filling.Add(TopoDS::Edge(edge), support, order);
+      } else {
+        filling.Add(TopoDS::Edge(edge), GeomAbs_C0);
+      }
+    }
+    polls.run("BRepOffsetAPI_MakeFilling",
+              [&](const Message_ProgressRange &range) { filling.Build(range); });
+    if (!filling.IsDone()) {
+      raise_not_done("BRepOffsetAPI_MakeFilling could not fill a face of the loft");
+    }
+    errors.distance = std::max(errors.distance, filling.G0Error());
+    errors.angle = std::max(errors.angle, filling.G1Error());
+    if (order != GeomAbs_G1) {
+      errors.curvature = std::max(errors.curvature, filling.G2Error());
+    }
+    images.Bind(face, filling.Shape());
+    for (TopExp_Explorer explorer(face, TopAbs_EDGE); explorer.More(); explorer.Next()) {
+      for (const TopoDS_Shape &image : filling.Generated(explorer.Current())) {
+        images.Bind(explorer.Current(), image);
+      }
+    }
+    for (TopExp_Explorer explorer(face, TopAbs_VERTEX); explorer.More(); explorer.Next()) {
+      for (const TopoDS_Shape &image : filling.Generated(explorer.Current())) {
+        images.Bind(explorer.Current(), image);
+      }
+    }
+    kept.push_back(filling.Shape());
+  }
+  BRepBuilderAPI_Sewing sewing(std::max(kLinear, errors.distance));
+  for (const TopoDS_Shape &face : kept) {
+    sewing.Add(face);
+  }
+  polls.run("BRepBuilderAPI_Sewing",
+            [&](const Message_ProgressRange &range) { sewing.Perform(range); });
+  const TopoDS_Shape sewn = sewing.SewedShape();
+  if (sewn.ShapeType() != TopAbs_SHELL) {
+    raise_not_done("BRepBuilderAPI_Sewing left the filled loft's faces apart");
+  }
+  polls.before("BRepBuilderAPI_MakeSolid");
+  BRepBuilderAPI_MakeSolid solid(TopoDS::Shell(sewn));
+  if (!solid.IsDone()) {
+    raise_not_done("BRepBuilderAPI_MakeSolid could not close the filled loft");
+  }
+  TopoDS_Solid result = solid.Solid();
+  BRepLib::OrientClosedSolid(result);
+  for (Role &role : roles) {
+    if (images.IsBound(role.element)) {
+      role.element = images.Find(role.element);
+      role.filled = true;
+    }
+    if (sewing.IsModifiedSubShape(role.element)) {
+      role.element = sewing.ModifiedSubShape(role.element);
+    }
+  }
+  return result;
+}
+
+// Replaces each role's element by its images in `history`, dropping removed elements.
+void follow(std::vector<Role> &roles, const Handle(BRepTools_History) &history) {
+  std::vector<Role> followed;
+  for (const Role &role : roles) {
+    if (history->IsRemoved(role.element)) {
+      continue;
+    }
+    const TopTools_ListOfShape &images = history->Modified(role.element);
+    if (images.IsEmpty()) {
+      followed.push_back(role);
+    }
+    for (const TopoDS_Shape &image : images) {
+      Role moved_role = role;
+      moved_role.element = image;
+      followed.push_back(moved_role);
+    }
+  }
+  roles = std::move(followed);
+}
+
+// Checks a whole shape and repairs it when it is not valid, as section 3.5 does, recording which.
+ValidityType check_and_repair(TopoDS_Shape &shape, const Handle(BRepTools_History) &history,
+                              Polls &polls) {
+  polls.before("BRepCheck_Analyzer");
+  if (BRepCheck_Analyzer(shape).IsValid()) {
+    return ValidityType::AsBuilt;
+  }
+  return repair(shape, history, polls) ? ValidityType::AfterRepair : ValidityType::Invalid;
+}
+
+// The order of the filling's constraints along each end edge: G1 for a tangent condition; G2,
+// or for `FillingOrderTwo` GeomAbs_C1, which OCCT 7.9.3 hands to the plate as its order 2
+// (BRepFill_Filling::AddConstraints passes the GeomAbs_Shape value as the order), for a
+// curvature condition.
+GeomAbs_Shape filling_order(const LoftSpecData &spec) {
+  if (!spec.curvature) {
+    return GeomAbs_G1;
+  }
+  return spec.method == EndMethodType::FillingOrderTwo ? GeomAbs_C1 : GeomAbs_G2;
+}
+
+}  // namespace
+
+LoftData loft(const LoftSpecData &spec, rust::Slice<const LoftSectionData> sections,
+              rust::Slice<const LoftCurveData> curves, const Interrupt &interrupt) {
+  const Handle(PollRecorder) recorder = new PollRecorder(interrupt);
+  Polls polls{Handle(Interruption)(recorder)};
+  polls.before("BRepBuilderAPI_MakeWire");
+  std::size_t next = 0;
+  const std::vector<Section> given = given_sections(sections, curves, next);
+  std::optional<Path> spine;
+  if (spec.spine > 0) {
+    spine = wire_of(curves, next, spec.spine);
+    next += spec.spine;
+  }
+  std::optional<Path> rail;
+  if (spec.rail > 0) {
+    rail = wire_of(curves, next, spec.rail);
+  }
+  const std::vector<Section> all = spec.method == EndMethodType::ExtraSection
+                                       ? with_extra_sections(given, spec, polls)
+                                       : given;
+
+  if (spec.construction == LoftType::PipeShell && !spine) {
+    raise_invalid_input("A pipe shell needs a spine.");
+  }
+  std::vector<Role> roles;
+  Built built = spec.construction == LoftType::PipeShell
+                    ? pipe_shell(all, *spine, rail, spec, roles, polls)
+                    : thru_sections(all, spec.construction == LoftType::Ruled, roles, polls);
+
+  std::vector<TopoDS_Shape> prisms;
+  TopTools_DataMapOfShapeShape supports;
+  if (spec.start_condition && !built.first.IsNull()) {
+    prisms.push_back(
+        neighbor(built.first, to_direction(spec.start_direction).Reversed(), supports, polls));
+  }
+  if (spec.end_condition && !built.last.IsNull()) {
+    prisms.push_back(neighbor(built.last, to_direction(spec.end_direction), supports, polls));
+  }
+
+  FillingErrors errors;
+  TopoDS_Shape shape = built.shape;
+  if (spec.method == EndMethodType::Filling || spec.method == EndMethodType::FillingOrderTwo) {
+    shape = filled(built, supports, filling_order(spec), roles, errors, polls);
+    built.surface_error = errors.distance;
+  }
+  Handle(BRepTools_History) history = new BRepTools_History;
+  const ValidityType validity = check_and_repair(shape, history, polls);
+  polls.before("BRepTools_History");
+  follow(roles, history);
+
+  const std::shared_ptr<Shape> result = make_shape(shape);
+  rust::Vec<LoftRoleData> role_data;
+  for (const Role &role : roles) {
+    const std::optional<ElementKind> kind = element_kind(role.element.ShapeType());
+    const int index = kind ? result->map(*kind).FindIndex(role.element) : 0;
+    if (index > 0) {
+      role_data.push_back(LoftRoleData{*kind, static_cast<std::uint32_t>(index), role.origin,
+                                       role.owner, role.input_kind, role.input, role.source,
+                                       role.filled});
+    }
+  }
+  return LoftData{result,
+                  make_shape(compound_of(prisms)),
+                  std::move(role_data),
+                  validity,
+                  recorder->data(),
+                  built.surface_error,
+                  errors.angle,
+                  errors.curvature};
+}
+
+rust::Vec<double> face_distances(const Shape &shape, rust::Slice<const std::uint32_t> faces,
+                                 rust::Slice<const Vec3> points) {
+  std::vector<TopoDS_Shape> chosen;
+  for (const std::uint32_t face : faces) {
+    chosen.push_back(element_at(shape, ElementKind::Face, face));
+  }
+  BRepExtrema_DistShapeShape distance;
+  distance.LoadS2(compound_of(chosen));
+  rust::Vec<double> distances;
+  for (const Vec3 &point : points) {
+    distance.LoadS1(BRepBuilderAPI_MakeVertex(to_point(point)).Vertex());
+    if (!distance.Perform()) {
+      raise_not_done("BRepExtrema_DistShapeShape found no distance to the faces");
+    }
+    distances.push_back(distance.Value());
+  }
+  return distances;
+}
+
+double normal_curvature_across(const Shape &shape, std::uint32_t face, std::uint32_t edge) {
+  const TopoDS_Face &surface_face = TopoDS::Face(element_at(shape, ElementKind::Face, face));
+  const TopoDS_Edge &curve_edge = TopoDS::Edge(element_at(shape, ElementKind::Edge, edge));
+  double first = 0.0;
+  double last = 0.0;
+  const Handle(Geom2d_Curve) pcurve =
+      BRep_Tool::CurveOnSurface(curve_edge, surface_face, first, last);
+  if (pcurve.IsNull()) {
+    raise_invalid_input("Edge " + std::to_string(edge) + " is not an edge of face " +
+                        std::to_string(face) + ".");
+  }
+  const double middle = (first + last) / 2.0;
+  const gp_Pnt2d parameters = pcurve->Value(middle);
+  const BRepAdaptor_Surface surface(surface_face);
+  gp_Pnt point;
+  gp_Vec along_u;
+  gp_Vec along_v;
+  gp_Vec second_u;
+  gp_Vec second_v;
+  gp_Vec mixed;
+  surface.D2(parameters.X(), parameters.Y(), point, along_u, along_v, second_u, second_v, mixed);
+  gp_Vec normal = along_u.Crossed(along_v);
+  normal.Normalize();
+  gp_Pnt curve_point;
+  gp_Vec tangent;
+  BRepAdaptor_Curve(curve_edge).D1(middle, curve_point, tangent);
+  gp_Vec across = normal.Crossed(tangent);
+  across.Normalize();
+  // The direction across the edge in the surface's parameters, through its first fundamental
+  // form, then the second fundamental form along it.
+  const double u_squared = along_u.Dot(along_u);
+  const double u_by_v = along_u.Dot(along_v);
+  const double v_squared = along_v.Dot(along_v);
+  const double across_u = across.Dot(along_u);
+  const double across_v = across.Dot(along_v);
+  const double determinant = u_squared * v_squared - u_by_v * u_by_v;
+  const double step_u = (across_u * v_squared - across_v * u_by_v) / determinant;
+  const double step_v = (across_v * u_squared - across_u * u_by_v) / determinant;
+  const double second_form = step_u * step_u * second_u.Dot(normal) +
+                             2.0 * step_u * step_v * mixed.Dot(normal) +
+                             step_v * step_v * second_v.Dot(normal);
+  const double first_form = step_u * step_u * u_squared + 2.0 * step_u * step_v * u_by_v +
+                            step_v * step_v * v_squared;
+  const double curvature = second_form / first_form;
+  return surface_face.Orientation() == TopAbs_REVERSED ? -curvature : curvature;
+}
