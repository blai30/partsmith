+
+/// The rows of the loft-rails spike: for each input and construction, the median of 5 runs of
+/// the loft with its check and names, and the polls of those runs with an interrupt that is
+/// never requested, with the time each run spends in the facade outside the shim, whose polls
+/// cover only the call inside it. Natively the rows of the three-section loft have section 8.4's
+/// 100 ms; the other rows, and every row under Node, print their medians.
+fn measure_loft_rails(report: &mut Report) {
+    for run in runs() {
+        let row = format!("loft-rails {} {}", run.input, run.construction);
+        if !report.includes(&row) {
+            continue;
+        }
+        let mut polls: Vec<PollRecord> = Vec::with_capacity(SPIKE_RUNS);
+        let mut outside = Vec::with_capacity(SPIKE_RUNS);
+        let time = median(SPIKE_RUNS, |_| {
+            let start = Instant::now();
+            let result = loft(&run.spec, &Interrupt::new());
+            let elapsed = start.elapsed();
+            match result {
+                Ok(result) => {
+                    outside.push(elapsed.saturating_sub(result.polls.total));
+                    polls.push(result.polls);
+                }
+                Err(error) => println!("{row}: {}", error.detail()),
+            }
+            elapsed
+        });
+        if !polls.is_empty() {
+            let (longest, most) = median_and_most(polls.iter().map(|record| record.longest));
+            let (first, _) = median_and_most(polls.iter().map(|record| record.first));
+            let (last, last_most) = median_and_most(polls.iter().map(|record| record.last));
+            let (outside, outside_most) = median_and_most(outside);
+            let after: Vec<u64> = polls.iter().map(|record| record.longest_after).collect();
+            println!(
+                "{row}: polls {} first {first:.3?} longest {longest:.3?} (most {most:.3?}, after polls {after:?}) last {last:.3?} (most {last_most:.3?}) outside the shim {outside:.3?} (most {outside_most:.3?})",
+                polls[0].count
+            );
+        }
+        if cfg!(not(target_os = "emscripten")) && run.timed {
+            report.record_time(&row, time, THREE_SECTION_BUDGET);
+        } else {
+            println!("{row}: median {time:.3?} (no budget)");
+        }
+    }
+}
