{
  "scripts": [
    {
      "name": "taller-box",
      "description": "The box becomes 40 mm tall instead of 30 mm.",
      "edits": [
        {
          "type": "update_parameter",
          "parameter": {
            "id": "p-height",
            "name": "height",
            "expr": "40 mm"
          }
        }
      ],
      "expect": {
        "f-fil1": {
          "/edges/0": "edge(f-box1/front|f-box1/left)",
          "/edges/1": "edge(f-box1/front|f-box1/right)",
          "/edges/2": "edge(f-box1/back|f-box1/left)",
          "/edges/3": "edge(f-box1/back|f-box1/right)"
        },
        "f-sh1": {
          "/remove_faces/0": "f-box1/top"
        },
        "f-sk1": {
          "/plane/face": "f-box1/front"
        },
        "f-sk2": {
          "/plane/face": "f-box1/bottom"
        },
        "f-cha1": {
          "/edges/0": "edge(f-box1/bottom|f-box1/front)"
        }
      }
    },
    {
      "name": "thicker-walls",
      "description": "The walls become 3 mm thick instead of 2 mm.",
      "edits": [
        {
          "type": "update_parameter",
          "parameter": {
            "id": "p-wall",
            "name": "wall",
            "expr": "3 mm"
          }
        }
      ],
      "expect": {
        "f-sk1": {
          "/plane/face": "f-box1/front"
        },
        "f-sk2": {
          "/plane/face": "f-box1/bottom"
        },
        "f-cha1": {
          "/edges/0": "edge(f-box1/bottom|f-box1/front)"
        }
      }
    },
    {
      "name": "top-chamfer-first",
      "description": "The top outer edge gets a 1 mm chamfer before the box is shelled.",
      "edits": [
        {
          "type": "add_feature",
          "index": 2,
          "feature": {
            "id": "f-cha2",
            "type": "chamfer",
            "body": "b-1",
            "edges": [
              {
                "q": "edge(f-box1/front|f-box1/top)",
                "fp": "line|n=1,0,0|c=0,-30,30|l=70|adj=2,2"
              }
            ],
            "distance": {
              "kind": "equal",
              "expr": "1"
            }
          }
        }
      ],
      "expect": {
        "f-sh1": {
          "/remove_faces/0": "f-box1/top"
        },
        "f-sk1": {
          "/plane/face": "f-box1/front"
        },
        "f-sk2": {
          "/plane/face": "f-box1/bottom"
        },
        "f-cha1": {
          "/edges/0": "edge(f-box1/bottom|f-box1/front)"
        }
      }
    },
    {
      "name": "square-corners",
      "description": "The corner rounds are removed.",
      "edits": [
        {
          "type": "remove_feature",
          "id": "f-fil1"
        }
      ],
      "expect": {
        "f-sh1": {
          "/remove_faces/0": "f-box1/top"
        },
        "f-sk1": {
          "/plane/face": "f-box1/front"
        },
        "f-sk2": {
          "/plane/face": "f-box1/bottom"
        },
        "f-cha1": {
          "/edges/0": "edge(f-box1/bottom|f-box1/front)"
        }
      }
    }
  ]
}
