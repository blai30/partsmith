{
  "format": "partsmith",
  "format_version": 3,
  "units": "mm",
  "parameters": [
    {"id": "p-width", "name": "width", "expr": "80 mm"},
    {"id": "p-depth", "name": "depth", "expr": "60 mm"},
    {"id": "p-height", "name": "height", "expr": "30 mm"},
    {"id": "p-wall", "name": "wall", "expr": "2 mm"}
  ],
  "bodies": [
    {"id": "b-1", "name": "Body 1"}
  ],
  "features": [
    {"id": "f-box1", "type": "box", "body": "b-1", "size": ["width", "depth", "height"], "op": "new"},
    {
      "id": "f-fil1",
      "type": "fillet",
      "body": "b-1",
      "edges": [
        {"q": "edge(f-box1/front|f-box1/left)", "fp": "line|n=0,0,1|c=-40,-30,15|l=30|adj=2,2"},
        {"q": "edge(f-box1/front|f-box1/right)", "fp": "line|n=0,0,1|c=40,-30,15|l=30|adj=2,2"},
        {"q": "edge(f-box1/back|f-box1/left)", "fp": "line|n=0,0,1|c=-40,30,15|l=30|adj=2,2"},
        {"q": "edge(f-box1/back|f-box1/right)", "fp": "line|n=0,0,1|c=40,30,15|l=30|adj=2,2"}
      ],
      "radius": "5"
    },
    {
      "id": "f-sh1",
      "type": "shell",
      "body": "b-1",
      "thickness": "wall",
      "remove_faces": [
        {"q": "f-box1/top", "fp": "plane|n=0,0,1|c=0,0,30|a=4778.539816|adj=8,8"}
      ]
    },
    {
      "id": "f-sk1",
      "type": "sketch",
      "plane": {
        "kind": "face",
        "body": "b-1",
        "face": {"q": "f-box1/front", "fp": "plane|n=0,-1,0|c=0,-30,15|a=2100|adj=4,4"},
        "fallback": {"origin": [0, -30, 0], "x_axis": [1, 0, 0], "normal": [0, -1, 0]},
        "fallback_frame": "body"
      },
      "entities": [
        {"id": "e-1", "type": "line", "start": [-8, 5], "end": [8, 5]},
        {"id": "e-2", "type": "line", "start": [8, 5], "end": [8, 11]},
        {"id": "e-3", "type": "line", "start": [8, 11], "end": [-8, 11]},
        {"id": "e-4", "type": "line", "start": [-8, 11], "end": [-8, 5]}
      ],
      "constraints": []
    },
    {
      "id": "f-ext1",
      "type": "extrude",
      "body": "b-1",
      "profile": {
        "sketch": "f-sk1",
        "regions": [
          {"key": "e-1,e-2,e-3,e-4", "fp": "c=0,8|a=96", "outline": "e-1,e-2,e-3,e-4"}
        ]
      },
      "extent": {"kind": "distance", "expr": "2 * wall"},
      "reverse": true,
      "op": "cut"
    },
    {
      "id": "f-sk2",
      "type": "sketch",
      "plane": {
        "kind": "face",
        "body": "b-1",
        "face": {"q": "f-box1/bottom", "fp": "plane|n=0,0,-1|c=0,0,0|a=4778.539816|adj=8,8"},
        "fallback": {"origin": [0, 0, 0], "x_axis": [1, 0, 0], "normal": [0, 0, -1]},
        "fallback_frame": "body"
      },
      "entities": [
        {"id": "e-5", "type": "point", "position": [-30, 20]},
        {"id": "e-6", "type": "point", "position": [30, 20]},
        {"id": "e-7", "type": "point", "position": [30, -20]},
        {"id": "e-8", "type": "point", "position": [-30, -20]}
      ],
      "constraints": []
    },
    {
      "id": "f-hole1",
      "type": "hole",
      "body": "b-1",
      "sketch": "f-sk2",
      "points": ["e-5", "e-6", "e-7", "e-8"],
      "diameter": "3",
      "extent": {"kind": "through_all"}
    },
    {
      "id": "f-cha1",
      "type": "chamfer",
      "body": "b-1",
      "edges": [
        {"q": "edge(f-box1/bottom|f-box1/front)", "fp": "line|n=1,0,0|c=0,-30,0|l=70|adj=2,2"}
      ],
      "distance": {"kind": "equal", "expr": "0.5"}
    }
  ]
}
