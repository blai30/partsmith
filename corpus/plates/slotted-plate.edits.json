{
  "scripts": [
    {
      "name": "thicker-plate",
      "description": "The plate becomes 8 mm thick and the 6 mm deep slot no longer goes through.",
      "edits": [
        {
          "type": "update_feature",
          "feature": {
            "id": "f-box1",
            "type": "box",
            "body": "b-1",
            "size": [
              "100",
              "40",
              "8"
            ],
            "op": "new"
          }
        }
      ],
      "expect": {
        "f-sk1": {
          "/plane/face": "f-box1/top"
        },
        "f-cha1": {
          "/edges/0": "edge(f-box1/front|f-box1/top)"
        },
        "f-fil1": {
          "/edges/0": "edge(f-box1/left|f-box1/top)"
        },
        "f-sk2": {
          "/plane/face": "f-box1/top"
        }
      }
    },
    {
      "name": "groove-across",
      "description": "A 2 mm deep groove across the plate near its right end comes right after the plate.",
      "edits": [
        {
          "type": "add_feature",
          "index": 1,
          "feature": {
            "id": "f-box2",
            "type": "box",
            "body": "b-1",
            "size": [
              "4",
              "50",
              "2"
            ],
            "position": [
              "40",
              "0",
              "4"
            ],
            "op": "cut"
          }
        }
      ],
      "expect": {
        "f-sk1": {
          "/plane/face": [
            "f-box1/top#1",
            "f-box1/top#2"
          ]
        },
        "f-cha1": {
          "/edges/0": [
            "edge(f-box1/front|f-box1/top#1)",
            "edge(f-box1/front|f-box1/top#2)"
          ]
        },
        "f-fil1": {
          "/edges/0": "edge(f-box1/left|f-box1/top#1)"
        },
        "f-sk2": {
          "/plane/face": [
            "f-box1/top#1",
            "f-box1/top#2"
          ]
        }
      }
    },
    {
      "name": "no-chamfer",
      "description": "The front chamfer is removed.",
      "edits": [
        {
          "type": "remove_feature",
          "id": "f-cha1"
        }
      ],
      "expect": {
        "f-fil1": {
          "/edges/0": "edge(f-box1/left|f-box1/top)"
        },
        "f-sk2": {
          "/plane/face": "f-box1/top"
        }
      }
    }
  ]
}
