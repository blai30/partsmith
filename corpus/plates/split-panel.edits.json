{
  "scripts": [
    {
      "name": "block-further-left",
      "description": "The block moves 10 mm to the left and the split moves with it.",
      "edits": [
        {
          "type": "update_feature",
          "feature": {
            "id": "f-box2",
            "type": "box",
            "body": "b-2",
            "size": [
              "20",
              "20",
              "20"
            ],
            "position": [
              "20",
              "40",
              "0"
            ],
            "op": "new"
          }
        }
      ],
      "expect": {
        "f-split1": {
          "/plane/face": "f-box2/left"
        },
        "f-fil1": {
          "/edges/0": "edge(f-box1/front#1|f-box1/left)",
          "/edges/1": "edge(f-box1/back#1|f-box1/left)"
        },
        "f-cha1": {
          "/edges/0": "edge(f-box1/right|f-box1/top#2)"
        },
        "f-sk1": {
          "/plane/face": "f-box1/top#2"
        }
      }
    },
    {
      "name": "left-notch",
      "description": "A 10 mm notch is cut into the middle of the panel's left end right after the panel.",
      "edits": [
        {
          "type": "add_feature",
          "index": 1,
          "feature": {
            "id": "f-box3",
            "type": "box",
            "body": "b-1",
            "size": [
              "10",
              "10",
              "4"
            ],
            "position": [
              "-50",
              "0",
              "0"
            ],
            "op": "cut"
          }
        }
      ],
      "expect": {
        "f-split1": {
          "/plane/face": "f-box2/left"
        },
        "f-cha1": {
          "/edges/0": "edge(f-box1/right|f-box1/top#2)"
        },
        "f-sk1": {
          "/plane/face": "f-box1/top#2"
        },
        "f-fil1": {
          "/edges/0": "edge(f-box1/front#1|f-box1/left#1)",
          "/edges/1": "edge(f-box1/back#1|f-box1/left#2)"
        }
      }
    },
    {
      "name": "one-piece",
      "description": "The split is removed and the panel stays in one piece.",
      "edits": [
        {
          "type": "remove_feature",
          "id": "f-split1"
        }
      ],
      "expect": {
        "f-fil1": {
          "/edges/0": "edge(f-box1/front|f-box1/left)",
          "/edges/1": "edge(f-box1/back|f-box1/left)"
        },
        "f-cha1": {
          "/edges/0": "lost"
        },
        "f-sk1": {
          "/plane/face": "lost"
        }
      }
    }
  ]
}
