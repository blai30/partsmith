{
  "scripts": [
    {
      "name": "larger-plate",
      "description": "The plate radius grows from 30 mm to 35 mm.",
      "edits": [
        {
          "type": "update_feature",
          "feature": {
            "id": "f-cyl1",
            "type": "cylinder",
            "body": "b-1",
            "radius": "35",
            "height": "5",
            "op": "new"
          }
        }
      ],
      "expect": {
        "f-cp1": {
          "/axis/face": "f-cyl1/side"
        },
        "f-sk1": {
          "/plane/face": "f-cyl1/top"
        },
        "f-cha1": {
          "/edges/0": "edge(f-cyl1/side|f-cyl1/top)"
        }
      }
    },
    {
      "name": "bottom-chamfer-first",
      "description": "A 1 mm chamfer on the bottom edge comes right after the plate.",
      "edits": [
        {
          "type": "add_feature",
          "index": 1,
          "feature": {
            "id": "f-cha2",
            "type": "chamfer",
            "body": "b-1",
            "edges": [
              {
                "q": "edge(f-cyl1/bottom|f-cyl1/side)",
                "fp": "circle|n=0,0,1|c=0,0,0|l=188.495559|r=30|adj=2,1"
              }
            ],
            "distance": {
              "kind": "equal",
              "expr": "1"
            }
          }
        }
      ],
      "expect": {
        "f-cp1": {
          "/axis/face": "f-cyl1/side"
        },
        "f-sk1": {
          "/plane/face": "f-cyl1/top"
        },
        "f-cha1": {
          "/edges/0": "edge(f-cyl1/side|f-cyl1/top)"
        }
      }
    },
    {
      "name": "one-hole",
      "description": "The hole pattern is suppressed.",
      "edits": [
        {
          "type": "update_feature",
          "feature": {
            "id": "f-cp1",
            "type": "circular_pattern",
            "body": "b-2",
            "axis": {
              "kind": "face",
              "body": "b-1",
              "face": {
                "q": "f-cyl1/side",
                "fp": "cylinder|n=0,0,1|c=0,0,2.5|a=942.477796|r=30|adj=2,3"
              },
              "direction": [
                0,
                0,
                1
              ]
            },
            "count": "6",
            "suppressed": true
          }
        }
      ],
      "expect": {
        "f-sk1": {
          "/plane/face": "f-cyl1/top"
        },
        "f-cha1": {
          "/edges/0": "edge(f-cyl1/side|f-cyl1/top)"
        }
      }
    },
    {
      "name": "chamfer-first",
      "description": "The top chamfer moves to right after the plate.",
      "edits": [
        {
          "type": "move_feature",
          "id": "f-cha1",
          "index": 1
        }
      ],
      "expect": {
        "f-cha1": {
          "/edges/0": "edge(f-cyl1/side|f-cyl1/top)"
        },
        "f-cp1": {
          "/axis/face": "f-cyl1/side"
        },
        "f-sk1": {
          "/plane/face": "f-cyl1/top"
        }
      }
    }
  ]
}
