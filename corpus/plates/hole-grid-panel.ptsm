{
  "format": "partsmith",
  "format_version": 3,
  "units": "mm",
  "parameters": [],
  "bodies": [
    {"id": "b-1", "name": "Body 1"},
    {"id": "b-2", "name": "Body 2"}
  ],
  "features": [
    {"id": "f-box1", "type": "box", "body": "b-1", "size": ["120", "80", "4"], "op": "new"},
    {
      "id": "f-cyl1",
      "type": "cylinder",
      "body": "b-2",
      "radius": "2.5",
      "height": "10",
      "position": ["-45", "-25", "-3"],
      "op": "new"
    },
    {
      "id": "f-lp1",
      "type": "linear_pattern",
      "body": "b-2",
      "direction": {
        "axis": {
          "kind": "edge",
          "body": "b-1",
          "edge": {"q": "edge(f-box1/front|f-box1/top)", "fp": "line|n=1,0,0|c=0,-40,4|l=120|adj=2,2"},
          "direction": [1, 0, 0]
        },
        "count": "4",
        "spacing": "30"
      },
      "second_direction": {
        "axis": {
          "kind": "edge",
          "body": "b-1",
          "edge": {"q": "edge(f-box1/left|f-box1/top)", "fp": "line|n=0,1,0|c=-60,0,4|l=80|adj=2,2"},
          "direction": [0, 1, 0]
        },
        "count": "3",
        "spacing": "25"
      }
    },
    {"id": "f-bool1", "type": "boolean", "target": "b-1", "tools": ["b-2"], "op": "cut"},
    {
      "id": "f-fil1",
      "type": "fillet",
      "body": "b-1",
      "edges": [
        {"q": "edge(f-box1/front|f-box1/left)", "fp": "line|n=0,0,1|c=-60,-40,2|l=4|adj=2,2"},
        {"q": "edge(f-box1/front|f-box1/right)", "fp": "line|n=0,0,1|c=60,-40,2|l=4|adj=2,2"},
        {"q": "edge(f-box1/back|f-box1/left)", "fp": "line|n=0,0,1|c=-60,40,2|l=4|adj=2,2"},
        {"q": "edge(f-box1/back|f-box1/right)", "fp": "line|n=0,0,1|c=60,40,2|l=4|adj=2,2"}
      ],
      "radius": "5"
    },
    {
      "id": "f-cha1",
      "type": "chamfer",
      "body": "b-1",
      "edges": [
        {"q": "edge(f-box1/front|f-box1/top)", "fp": "line|n=1,0,0|c=0,-40,4|l=110|adj=2,2"}
      ],
      "distance": {"kind": "equal", "expr": "0.5"}
    }
  ]
}
