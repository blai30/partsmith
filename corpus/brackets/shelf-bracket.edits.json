{
  "scripts": [
    {
      "name": "longer-shelf",
      "description": "The shelf becomes 60 mm long instead of 50 mm.",
      "edits": [
        {
          "type": "update_feature",
          "feature": {
            "id": "f-box2",
            "type": "box",
            "body": "b-1",
            "size": [
              "60",
              "40",
              "4"
            ],
            "position": [
              "32",
              "0",
              "56"
            ],
            "op": "join"
          }
        }
      ],
      "expect": {
        "f-fil1": {
          "/edges/0": "edge(f-box1/right|f-box2/bottom)"
        },
        "f-dp1": {
          "/base/face": "f-box1/front"
        },
        "f-sk2": {
          "/plane/face": "f-box1/left"
        },
        "f-sk3": {
          "/plane/face": "f-box1/top"
        }
      }
    },
    {
      "name": "outer-chamfer",
      "description": "The shelf's outer top edge gets a 1 mm chamfer right after the inner fillet.",
      "edits": [
        {
          "type": "add_feature",
          "index": 3,
          "feature": {
            "id": "f-cha1",
            "type": "chamfer",
            "body": "b-1",
            "edges": [
              {
                "q": "edge(f-box1/top|f-box2/right)",
                "fp": "line|n=0,1,0|c=52,0,60|l=40|adj=2,2",
                "merged": {
                  "f-box1/top": [
                    "f-box2/top"
                  ]
                }
              }
            ],
            "distance": {
              "kind": "equal",
              "expr": "1"
            }
          }
        }
      ],
      "expect": {
        "f-dp1": {
          "/base/face": "f-box1/front"
        },
        "f-sk2": {
          "/plane/face": "f-box1/left"
        },
        "f-sk3": {
          "/plane/face": "f-box1/top"
        }
      }
    },
    {
      "name": "no-fillet",
      "description": "The inner fillet is removed.",
      "edits": [
        {
          "type": "remove_feature",
          "id": "f-fil1"
        }
      ],
      "expect": {
        "f-dp1": {
          "/base/face": "f-box1/front"
        },
        "f-sk2": {
          "/plane/face": "f-box1/left"
        },
        "f-sk3": {
          "/plane/face": "f-box1/top"
        }
      }
    }
  ]
}
