{
  "format": "partsmith",
  "format_version": 3,
  "units": "mm",
  "parameters": [],
  "bodies": [
    {"id": "b-1", "name": "Body 1"},
    {"id": "b-2", "name": "Body 2"}
  ],
  "features": [
    {"id": "f-box1", "type": "box", "body": "b-1", "size": ["60", "40", "5"], "op": "new"},
    {"id": "f-box2", "type": "box", "body": "b-2", "size": ["60", "40", "5"], "position": ["0", "0", "-5"], "op": "new"},
    {
      "id": "f-mv1",
      "type": "move_body",
      "body": "b-2",
      "rotation": {
        "axis": {
          "kind": "edge",
          "body": "b-1",
          "edge": {"q": "edge(f-box1/back|f-box1/bottom)", "fp": "line|n=1,0,0|c=0,20,0|l=60|adj=2,2"},
          "direction": [1, 0, 0]
        },
        "angle": "-90 deg"
      }
    },
    {"id": "f-bool1", "type": "boolean", "target": "b-1", "tools": ["b-2"], "op": "join"},
    {
      "id": "f-sk1",
      "type": "sketch",
      "plane": {
        "kind": "face",
        "body": "b-1",
        "face": {"q": "f-box1/top", "fp": "plane|n=0,0,1|c=0,-2.5,5|a=2100|adj=4,4"},
        "fallback": {"origin": [0, 0, 5], "x_axis": [1, 0, 0], "normal": [0, 0, 1]},
        "fallback_frame": "body"
      },
      "entities": [
        {"id": "e-1", "type": "point", "position": [-20, -10]},
        {"id": "e-2", "type": "point", "position": [20, -10]}
      ],
      "constraints": []
    },
    {
      "id": "f-hole1",
      "type": "hole",
      "body": "b-1",
      "sketch": "f-sk1",
      "points": ["e-1", "e-2"],
      "diameter": "5",
      "extent": {"kind": "through_all"}
    },
    {
      "id": "f-fil1",
      "type": "fillet",
      "body": "b-1",
      "edges": [
        {"q": "edge(f-box1/top|f-box2/bottom)", "fp": "line|n=1,0,0|c=0,15,5|l=60|adj=2,2"}
      ],
      "radius": "3"
    },
    {
      "id": "f-cha1",
      "type": "chamfer",
      "body": "b-1",
      "edges": [
        {
          "q": "edge(f-box1/back|f-box2/front)",
          "fp": "line|n=1,0,0|c=0,20,40|l=60|adj=2,2",
          "merged": {"f-box1/back": ["f-box2/top"]}
        }
      ],
      "distance": {"kind": "equal", "expr": "1"}
    }
  ]
}
