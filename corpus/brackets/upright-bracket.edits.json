{
  "scripts": [
    {
      "name": "deeper-base",
      "description": "The base becomes 50 mm deep instead of 40 mm.",
      "edits": [
        {
          "type": "update_feature",
          "feature": {
            "id": "f-box1",
            "type": "box",
            "body": "b-1",
            "size": [
              "60",
              "50",
              "5"
            ],
            "op": "new"
          }
        }
      ],
      "expect": {
        "f-mv1": {
          "/rotation/axis/edge": "edge(f-box1/back|f-box1/bottom)"
        },
        "f-sk1": {
          "/plane/face": "f-box1/top"
        },
        "f-fil1": {
          "/edges/0": "edge(f-box1/top|f-box2/bottom)"
        },
        "f-cha1": {
          "/edges/0": "edge(f-box1/back|f-box2/front)"
        }
      }
    },
    {
      "name": "lean-back",
      "description": "The upright leans back 10 degrees.",
      "edits": [
        {
          "type": "update_feature",
          "feature": {
            "id": "f-mv1",
            "type": "move_body",
            "body": "b-2",
            "rotation": {
              "axis": {
                "kind": "edge",
                "body": "b-1",
                "edge": {
                  "q": "edge(f-box1/back|f-box1/bottom)",
                  "fp": "line|n=1,0,0|c=0,20,0|l=60|adj=2,2"
                },
                "direction": [
                  1,
                  0,
                  0
                ]
              },
              "angle": "-100 deg"
            }
          }
        }
      ],
      "expect": {
        "f-sk1": {
          "/plane/face": "f-box1/top"
        },
        "f-fil1": {
          "/edges/0": "edge(f-box1/top|f-box2/bottom)"
        },
        "f-cha1": {
          "/edges/0": "edge(f-box2/front|f-box2/top)"
        }
      }
    },
    {
      "name": "front-chamfer-first",
      "description": "The base's front top edge gets a 1 mm chamfer right after the base.",
      "edits": [
        {
          "type": "add_feature",
          "index": 1,
          "feature": {
            "id": "f-cha0",
            "type": "chamfer",
            "body": "b-1",
            "edges": [
              {
                "q": "edge(f-box1/front|f-box1/top)",
                "fp": "line|n=1,0,0|c=0,-20,5|l=60|adj=2,2"
              }
            ],
            "distance": {
              "kind": "equal",
              "expr": "1"
            }
          }
        }
      ],
      "expect": {
        "f-mv1": {
          "/rotation/axis/edge": "edge(f-box1/back|f-box1/bottom)"
        },
        "f-sk1": {
          "/plane/face": "f-box1/top"
        },
        "f-fil1": {
          "/edges/0": "edge(f-box1/top|f-box2/bottom)"
        },
        "f-cha1": {
          "/edges/0": "edge(f-box1/back|f-box2/front)"
        }
      }
    }
  ]
}
