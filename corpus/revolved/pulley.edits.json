            "type": "cylinder",
            "body": "b-1",
            "radius": "8",
            "height": "10",
            "plane": {
              "kind": "face",
              "body": "b-1",
              "face": {
                "q": "f-rev1/lateral/e-6",
                "fp": "plane|n=0,0,1|c=0,0,12|a=1256.637061|adj=1,1"
              }
            },
            "op": "join"
          }
        }
      ],
      "expect": {
