{
  "scripts": [
    {
      "name": "thicker-flange",
      "description": "The flange becomes 6 mm thick instead of 5 mm.",
      "edits": [
        {
          "type": "update_feature",
          "feature": {
            "id": "f-cyl1",
            "type": "cylinder",
            "body": "b-1",
            "radius": "20",
            "height": "6",
            "op": "new"
          }
        }
      ],
      "expect": {
        "f-cone1": {
          "/plane/face": "f-cyl1/top"
        },
        "f-cyl2": {
          "/plane/face": "f-cone1/top"
        },
        "f-sh1": {
          "/remove_faces/0": "f-cyl2/top",
          "/remove_faces/1": "f-cyl1/bottom"
        },
        "f-cha1": {
          "/edges/0": "edge(f-cyl1/side|f-cyl1/top)"
        }
      }
    },
    {
      "name": "taller-cone",
      "description": "The cone becomes 30 mm tall instead of 25 mm.",
      "edits": [
        {
          "type": "update_feature",
          "feature": {
            "id": "f-cone1",
            "type": "cone",
            "body": "b-1",
            "bottom_radius": "12",
            "top_radius": "5",
            "height": "30",
            "plane": {
              "kind": "face",
              "body": "b-1",
              "face": {
                "q": "f-cyl1/top",
                "fp": "plane|n=0,0,1|c=0,0,5|a=1256.637061|adj=1,1"
              }
            },
            "op": "join"
          }
        }
      ],
      "expect": {
        "f-cyl2": {
          "/plane/face": "f-cone1/top"
        },
        "f-sh1": {
          "/remove_faces/0": "f-cyl2/top",
          "/remove_faces/1": "f-cyl1/bottom"
        },
        "f-cha1": {
          "/edges/0": "edge(f-cyl1/side|f-cyl1/top)"
        }
      }
    },
    {
      "name": "bottom-chamfer-first",
      "description": "The flange's bottom edge gets a 0.5 mm chamfer right after the flange.",
      "edits": [
        {
          "type": "add_feature",
          "index": 1,
          "feature": {
            "id": "f-cha0",
            "type": "chamfer",
            "body": "b-1",
            "edges": [
              {
                "q": "edge(f-cyl1/bottom|f-cyl1/side)",
                "fp": "circle|n=0,0,1|c=0,0,0|l=125.663706|r=20|adj=2,1"
              }
            ],
            "distance": {
              "kind": "equal",
              "expr": "0.5"
            }
          }
        }
      ],
      "expect": {
        "f-cone1": {
          "/plane/face": "f-cyl1/top"
        },
        "f-cyl2": {
          "/plane/face": "f-cone1/top"
        },
        "f-sh1": {
          "/remove_faces/0": "f-cyl2/top",
          "/remove_faces/1": "f-cyl1/bottom"
        },
        "f-cha1": {
          "/edges/0": "edge(f-cyl1/side|f-cyl1/top)"
        }
      }
    },
    {
      "name": "no-spout",
      "description": "The spout is removed.",
      "edits": [
        {
          "type": "remove_feature",
          "id": "f-cyl2"
        }
      ],
      "expect": {
        "f-sh1": {
          "/remove_faces/0": "lost",
          "/remove_faces/1": "f-cyl1/bottom"
        },
        "f-cha1": {
          "/edges/0": "edge(f-cyl1/side|f-cyl1/top)"
        }
      }
    }
  ]
}
